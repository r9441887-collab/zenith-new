app gui tool

# ================ CHIP-8 emulator (GUI) — SNAKE =================
# Управление: Q=вверх W=вниз A=влево E=вправо
# Запуск:  chip8_snake.exe                 — окно 640x320
#          chip8_snake.exe --non-display   — без окна, дамп регистров раз в 60 кадров
#          chip8_snake.exe --regs          — окно + дамп регистров раз в 60 кадров

@import("kernel32.dll")

extern func GetCommandLineA() -> int from "kernel32.dll"
extern func GetStdHandle(n: int) -> int from "kernel32.dll"
extern func WriteFile(h: int, buf: int, n: int, written: int, ov: int) -> int from "kernel32.dll"
extern func VirtualAlloc(addr: int, size: int, type: int, protect: int) -> int from "kernel32.dll"
var mem: [4096]int
var V: [16]int
var disp: [2048]int
var stk: [16]int
var keys: [16]int
var I: int = 0
var pc: int = 512
var sp: int = 0
var dt: int = 0
var st: int = 0
var rng: int = 12345
var waitKey: int = -1
var nonDisplay: int = 0
var dumpRegs: int = 0
var dumpCount: int = 0
var g_out: int = 0

func loadFont()
    mem[80] = 0xF0
    mem[81] = 0x90
    mem[82] = 0x90
    mem[83] = 0x90
    mem[84] = 0xF0
    mem[85] = 0x20
    mem[86] = 0x60
    mem[87] = 0x20
