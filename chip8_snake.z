    mem[94] = 0xF0
    mem[95] = 0xF0
    mem[96] = 0x10
    mem[97] = 0xF0
    mem[98] = 0x10
    mem[99] = 0xF0
    mem[100] = 0x90
    mem[101] = 0x90
    mem[102] = 0xF0
    mem[103] = 0x10
    mem[104] = 0x10
    mem[105] = 0xF0
    mem[106] = 0x80
    mem[107] = 0xF0
    mem[108] = 0x10
    mem[109] = 0xF0
    mem[110] = 0xF0
    mem[111] = 0x80
    mem[112] = 0xF0
    mem[113] = 0x90
    mem[114] = 0xF0
    mem[115] = 0xF0
    mem[116] = 0x10
    mem[117] = 0x20
    mem[118] = 0x40
    mem[119] = 0x40
    mem[120] = 0xF0
    mem[121] = 0x90
    mem[122] = 0xF0
    mem[123] = 0x90
    mem[124] = 0xF0
    mem[125] = 0xF0
    mem[126] = 0x90
    mem[127] = 0xF0
    mem[128] = 0x10
    mem[129] = 0xF0
    mem[130] = 0xF0
    mem[131] = 0x90
    mem[132] = 0xF0
    mem[133] = 0x90
    mem[134] = 0x90
    mem[135] = 0xE0
    mem[136] = 0x90
    mem[137] = 0xE0
    mem[138] = 0x90
    mem[139] = 0xE0
    mem[140] = 0xF0
    mem[141] = 0x80
    mem[142] = 0x80
    mem[143] = 0x80
    mem[144] = 0xF0
    mem[145] = 0xE0
    mem[146] = 0x90
    mem[147] = 0x90
    mem[148] = 0x90
    mem[149] = 0xE0
