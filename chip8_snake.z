# SNAKE ROM (0x200-0x38F, данные: xs[0x500], ys[0x540], еда 0x580/0x581, спрайт 0x5A0)
# V0=headX V1=headY V2=dir(0up 1down 2left 3right) V5=len V6=headIdx V7=tailIdx
# V8/V9=head save, VA=loop idx, VC=foodX, VD=foodY, VE=newDir
func loadRom()
    mem[512] = 0x00   # 0x200 CLS
    mem[513] = 0xE0
    mem[514] = 0x60   # V0 = 6
    mem[515] = 0x06
    mem[516] = 0x61   # V1 = 8
    mem[517] = 0x08
    mem[518] = 0x62   # V2 = 3 (right)
    mem[519] = 0x03
    mem[520] = 0x65   # V5 = 3 (len)
    mem[521] = 0x03
    mem[522] = 0x66   # V6 = 2 (head idx)
    mem[523] = 0x02
    mem[524] = 0x67   # V7 = 0 (tail idx)
    mem[525] = 0x00
    mem[526] = 0xA5   # I = 0x500
    mem[527] = 0x00
    mem[528] = 0xF0   # [0x500] = 8 (xs[0])
    mem[529] = 0x55
    mem[530] = 0x70   # V0 += 1
    mem[531] = 0x01
    mem[532] = 0xA5   # I = 0x501
    mem[533] = 0x01
    mem[534] = 0xF0   # [0x501] = 7
    mem[535] = 0x55
    mem[536] = 0x70   # V0 += 1
    mem[537] = 0x01
    mem[538] = 0xA5   # I = 0x502
    mem[539] = 0x02
    mem[540] = 0xF0   # [0x502] = 6
    mem[541] = 0x55
    mem[542] = 0x60   # V0 = 8
    mem[543] = 0x08
    mem[544] = 0xA5   # I = 0x540
    mem[545] = 0x40
    mem[546] = 0xF0   # [0x540] = 8 (ys[0])
    mem[547] = 0x55
    mem[548] = 0xA5   # I = 0x541
    mem[549] = 0x41
    mem[550] = 0xF0   # [0x541] = 8
    mem[551] = 0x55
    mem[552] = 0xA5   # I = 0x542
    mem[553] = 0x42
    mem[554] = 0xF0   # [0x542] = 8
    mem[555] = 0x55
    mem[556] = 0xA5   # I = 0x5A0 (sprite)
    mem[557] = 0xA0
    mem[558] = 0x60   # V0 = 6
    mem[559] = 0x06
    mem[560] = 0x61   # V1 = 8
    mem[561] = 0x08
    mem[562] = 0xD0   # draw (6,8)
    mem[563] = 0x11
    mem[564] = 0x70   # V0 += 1
    mem[565] = 0x01
    mem[566] = 0xD0   # draw (7,8)
    mem[567] = 0x11
    mem[568] = 0x70   # V0 += 1
    mem[569] = 0x01
    mem[570] = 0xD0   # draw (6,8)
    mem[571] = 0x11
    mem[572] = 0xC0   # FOODGEN: V0 = rnd & 0x3F
    mem[573] = 0x3F
    mem[574] = 0x8C   # VC = V0
    mem[575] = 0x00
    mem[576] = 0xC0   # V1 = rnd & 0x1F
    mem[577] = 0x1F
    mem[578] = 0x8D   # VD = V0 (второй rnd)
    mem[579] = 0x00
    mem[580] = 0xA5   # I = 0x580
    mem[581] = 0x80
    mem[582] = 0x80   # V0 = VC
    mem[583] = 0xC0
    mem[584] = 0xF0   # [0x580] = fx
    mem[585] = 0x55
    mem[586] = 0xA5   # I = 0x581
    mem[587] = 0x81
    mem[588] = 0x80   # V0 = VD
    mem[589] = 0xD0
    mem[590] = 0xF0   # [0x581] = fy
    mem[591] = 0x55
    mem[592] = 0xA5   # I = 0x5A0
    mem[593] = 0xA0
    mem[594] = 0xDC   # draw food (VC,VD)
    mem[595] = 0xD1
    mem[596] = 0x6A   # FOODLOOP: VA = 0
    mem[597] = 0x00
    mem[598] = 0xA5   # I = 0x500
    mem[599] = 0x00
    mem[600] = 0xFA   # I += VA
    mem[601] = 0x1E
    mem[602] = 0xF0   # V0 = xs[i]
    mem[603] = 0x65
    mem[604] = 0x90   # if V0 != VC skip 2
    mem[605] = 0xC0
    mem[606] = 0x12   # -> food-y (0x262)
    mem[607] = 0x62
    mem[608] = 0x12   # -> next-i (0x26C)
    mem[609] = 0x6C
    mem[610] = 0xA5   # food-y: I = 0x540
    mem[611] = 0x40
    mem[612] = 0xFA   # I += VA
    mem[613] = 0x1E
    mem[614] = 0xF0   # V0 = ys[i]
    mem[615] = 0x65
    mem[616] = 0x90   # if V0 != VD skip 2
    mem[617] = 0xD0
    mem[618] = 0x12   # -> FOODGEN (еда на змейке)
    mem[619] = 0x3C
    mem[620] = 0x7A   # next-i: VA += 1
    mem[621] = 0x01
    mem[622] = 0x9A   # if VA != V5 skip 2
    mem[623] = 0x50
    mem[624] = 0x12   # -> LOOPTOP (0x274)
    mem[625] = 0x74
    mem[626] = 0x12   # -> FOODLOOP (0x256)
    mem[627] = 0x56
    mem[628] = 0x64   # LOOPTOP: V4 = 0 (нет клавиши)
    mem[629] = 0x00
    mem[630] = 0x6C   # вверх: VC = 4
    mem[631] = 0x04
    mem[632] = 0xEC   # if key VC pressed skip
    mem[633] = 0x9E
    mem[634] = 0x12   # -> down
    mem[635] = 0x82
    mem[636] = 0x6E   # VE = 0 (up)
    mem[637] = 0x00
    mem[638] = 0x64   # V4 = 1
    mem[639] = 0x01
    mem[640] = 0x12   # -> input-done
    mem[641] = 0xA6
    mem[642] = 0x6C   # вниз: VC = 5 (W)
    mem[643] = 0x05
    mem[644] = 0xEC
    mem[645] = 0x9E
    mem[646] = 0x12   # -> left (0x28E)
    mem[647] = 0x8E
    mem[648] = 0x6E   # VE = 1 (down)
    mem[649] = 0x01
    mem[650] = 0x64   # V4 = 1
    mem[651] = 0x01
    mem[652] = 0x12   # -> input-done
    mem[653] = 0xA6
    mem[654] = 0x6C   # влево: VC = 8
    mem[655] = 0x08
    mem[656] = 0xEC
    mem[657] = 0x9E
    mem[658] = 0x12   # -> right (0x29A)
    mem[659] = 0x9A
    mem[660] = 0x6E   # VE = 2 (left)
    mem[661] = 0x02
    mem[662] = 0x64   # V4 = 1
    mem[663] = 0x01
    mem[664] = 0x12   # -> input-done
    mem[665] = 0xA6
    mem[666] = 0x6C   # вправо: VC = 6
    mem[667] = 0x06
    mem[668] = 0xEC
    mem[669] = 0x9E
    mem[670] = 0x12   # -> input-done
    mem[671] = 0xA6
    mem[672] = 0x6E   # VE = 3 (right)
    mem[673] = 0x03
    mem[674] = 0x64   # V4 = 1
    mem[675] = 0x01
    mem[676] = 0x12   # -> input-done
    mem[677] = 0xA6
    mem[678] = 0x44   # input-done: if V4 != 0 skip
    mem[679] = 0x00
    mem[680] = 0x12   # -> move (без клавиши)
    mem[681] = 0xB2
    mem[682] = 0x69   # V9 = 1
    mem[683] = 0x01
    mem[684] = 0x82   # V2 = V2 ^ 1 (анти-разворот)
    mem[685] = 0x93
    mem[686] = 0x5E   # if VE == V2 skip
    mem[687] = 0x20
    mem[688] = 0x82   # V2 = VE
    mem[689] = 0xE0
    mem[690] = 0x42   # move: if V2 != 0 skip
    mem[691] = 0x00
    mem[692] = 0x71   # V1 -= 1 (up)
    mem[693] = 0xFF
    mem[694] = 0x12   # -> down-check (0x2B8)
    mem[695] = 0xB8
    mem[696] = 0x42   # if V2 != 1 skip
    mem[697] = 0x01
    mem[698] = 0x71   # V1 += 1 (down)
    mem[699] = 0x01
    mem[700] = 0x12   # -> left-check (0x2BE)
    mem[701] = 0xBE
    mem[702] = 0x42   # if V2 != 2 skip
    mem[703] = 0x02
    mem[704] = 0x70   # V0 -= 1 (left)
    mem[705] = 0xFF
    mem[706] = 0x12   # -> right-check (0x2C4)
    mem[707] = 0xC4
    mem[708] = 0x42   # if V2 != 3 skip
    mem[709] = 0x03
    mem[710] = 0x70   # V0 += 1 (right)
    mem[711] = 0x01
    mem[712] = 0x12   # -> wall
    mem[713] = 0xCA
    mem[714] = 0x40   # wall: if V0 != 255 skip
    mem[715] = 0xFF
    mem[716] = 0x12   # die -> restart
    mem[717] = 0x00
    mem[718] = 0x40   # if V0 != 64 skip
    mem[719] = 0x40
    mem[720] = 0x12   # die
    mem[721] = 0x00
    mem[722] = 0x41   # if V1 != 255 skip
    mem[723] = 0xFF
    mem[724] = 0x12   # die
    mem[725] = 0x00
    mem[726] = 0x41   # if V1 != 32 skip
    mem[727] = 0x20
    mem[728] = 0x12   # die
    mem[729] = 0x00
    mem[730] = 0x88   # V8 = V0 (save head)
    mem[731] = 0x00
    mem[732] = 0x89   # V9 = V1
    mem[733] = 0x10
    mem[734] = 0x8A   # VA = V7 (цикл с хвоста)
    mem[735] = 0x70
    mem[736] = 0x13   # -> SELFLOOP (0x3E8)
    mem[737] = 0xE8
    mem[738] = 0xFA   # I += VA
    mem[739] = 0x1E
    mem[740] = 0xF0   # V0 = xs[i]
    mem[741] = 0x65
    mem[742] = 0x90   # if V0 != V8 skip 2 (-> next-i)
    mem[743] = 0x80
    mem[744] = 0x12   # -> self-y (0x2EC)
    mem[745] = 0xEC
    mem[746] = 0x12   # -> next-i (0x2F6)
    mem[747] = 0xF6
    mem[748] = 0xA5   # self-y: I = 0x540
    mem[749] = 0x40
    mem[750] = 0xFA   # I += VA
    mem[751] = 0x1E
    mem[752] = 0xF0   # V0 = ys[i]
    mem[753] = 0x65
    mem[754] = 0x90   # if V0 != V9 skip 2 (-> next-i)
    mem[755] = 0x90
    mem[756] = 0x12   # die -> restart (укусил себя)
    mem[757] = 0x00
    mem[758] = 0x7A   # next-i: VA += 1
    mem[759] = 0x01
    mem[760] = 0x9A   # if VA != V6 skip 2 (-> SELFLOOP)
    mem[761] = 0x60
    mem[762] = 0x12   # -> self-done (0x2FE)
    mem[763] = 0xFE
    mem[764] = 0x12   # -> SELFLOOP (0x2E0)
    mem[765] = 0xE0
    mem[766] = 0xA5   # self-done: I = 0x580 (еда x)
    mem[767] = 0x80
    mem[768] = 0xF0   # V0 = fx
    mem[769] = 0x65
    mem[770] = 0x50   # if V0 == V8 skip 2 (еда x == голова x)
    mem[771] = 0x80
    mem[772] = 0x13   # -> erase-tail (не съедено)
    mem[773] = 0x14
    mem[774] = 0xA5   # I = 0x581 (еда y)
    mem[775] = 0x81
    mem[776] = 0xF0   # V0 = fy
    mem[777] = 0x65
    mem[778] = 0x50   # if V0 == V9 skip 2 (еда y == голова y)
    mem[779] = 0x90
    mem[780] = 0x13   # -> erase-tail (не съедено)
    mem[781] = 0x14
    mem[782] = 0x13   # -> EAT (съедено)
    mem[783] = 0x10
    mem[784] = 0x75   # EAT: V5 += 1
    mem[785] = 0x01
    mem[786] = 0x13   # -> FOODGEN
    mem[787] = 0x30
    mem[788] = 0xA5   # erase-tail: I = 0x500
    mem[789] = 0x00
    mem[790] = 0xF7   # I += V7
    mem[791] = 0x1E
    mem[792] = 0xF0   # V0 = xs[tail]
    mem[793] = 0x65
    mem[794] = 0x8D   # VD = V0 (хвост x)
    mem[795] = 0x00
    mem[796] = 0xA5   # I = 0x540
    mem[797] = 0x40
    mem[798] = 0xF7   # I += V7
    mem[799] = 0x1E
    mem[800] = 0xF0   # V0 = ys[tail]
    mem[801] = 0x65
    mem[802] = 0x8E   # VE = V0 (хвост y)
    mem[803] = 0x00
    mem[804] = 0xA5   # I = 0x5A0
    mem[805] = 0xA0
    mem[806] = 0xDD   # draw (VD,VE) - стереть хвост
    mem[807] = 0xE1
    mem[808] = 0x77   # V7 += 1
    mem[809] = 0x01
    mem[810] = 0x47   # if V7 != 64 skip
    mem[811] = 0x40
    mem[812] = 0x67   # V7 = 0
    mem[813] = 0x00
    mem[814] = 0x13   # -> store-head (0x368)
    mem[815] = 0x68
    mem[816] = 0xC0   # FOODGEN: V0 = rnd & 0x3F
    mem[817] = 0x3F
    mem[818] = 0x8C   # VC = V0
    mem[819] = 0x00
    mem[820] = 0xC0   # V1 = rnd & 0x1F
    mem[821] = 0x1F
    mem[822] = 0x8D   # VD = V0 (второй rnd)
    mem[823] = 0x00
    mem[824] = 0xA5   # I = 0x580
    mem[825] = 0x80
    mem[826] = 0x80   # V0 = VC
    mem[827] = 0xC0
    mem[828] = 0xF0   # [0x580] = fx
    mem[829] = 0x55
    mem[830] = 0xA5   # I = 0x581
    mem[831] = 0x81
    mem[832] = 0x80   # V0 = VD
    mem[833] = 0xD0
    mem[834] = 0xF0   # [0x581] = fy
    mem[835] = 0x55
    mem[836] = 0xA5   # I = 0x5A0
    mem[837] = 0xA0
    mem[838] = 0xDC   # draw food (VC,VD)
    mem[839] = 0xD1
    mem[840] = 0x6A   # FOODLOOP: VA = 0
    mem[841] = 0x00
    mem[842] = 0xA5   # I = 0x500
    mem[843] = 0x00
    mem[844] = 0xFA   # I += VA
    mem[845] = 0x1E
    mem[846] = 0xF0   # V0 = xs[i]
    mem[847] = 0x65
    mem[848] = 0x90   # if V0 != VC skip 2
    mem[849] = 0xC0
    mem[850] = 0x13   # -> food-y (0x356)
    mem[851] = 0x56
    mem[852] = 0x13   # -> next-i (0x360)
    mem[853] = 0x60
    mem[854] = 0xA5   # food-y: I = 0x540
    mem[855] = 0x40
    mem[856] = 0xFA   # I += VA
    mem[857] = 0x1E
    mem[858] = 0xF0   # V0 = ys[i]
    mem[859] = 0x65
    mem[860] = 0x90   # if V0 != VD skip 2
    mem[861] = 0xD0
    mem[862] = 0x13   # -> FOODGEN (еда на змейке)
    mem[863] = 0x30
    mem[864] = 0x7A   # next-i: VA += 1
    mem[865] = 0x01
    mem[866] = 0x9A   # if VA != V5 skip 2
    mem[867] = 0x50
    mem[868] = 0x13   # -> store-head (0x368)
    mem[869] = 0x68
    mem[870] = 0x13   # -> FOODLOOP (0x34A)
    mem[871] = 0x4A
    mem[872] = 0x80   # store-head: V0 = V8
    mem[873] = 0x80
    mem[874] = 0x81   # V1 = V9
    mem[875] = 0x90
    mem[876] = 0x76   # V6 += 1
    mem[877] = 0x01
    mem[878] = 0x46   # if V6 != 64 skip
    mem[879] = 0x40
    mem[880] = 0x66   # V6 = 0
    mem[881] = 0x00
    mem[882] = 0xA5   # I = 0x500
    mem[883] = 0x00
    mem[884] = 0xF6   # I += V6
    mem[885] = 0x1E
    mem[886] = 0xF0   # [0x500+V6] = headX
    mem[887] = 0x55
    mem[888] = 0x80   # V0 = V1
    mem[889] = 0x10
    mem[890] = 0xA5   # I = 0x540
    mem[891] = 0x40
    mem[892] = 0xF6   # I += V6
    mem[893] = 0x1E
    mem[894] = 0xF0   # [0x540+V6] = headY
    mem[895] = 0x55
    mem[896] = 0xA5   # I = 0x5A0
    mem[897] = 0xA0
    mem[898] = 0xD8   # draw head (V8,V9)
    mem[899] = 0x91
    mem[900] = 0x80   # V0 = V8 (восстановить)
    mem[901] = 0x80
    mem[902] = 0x6D   # delay: VD = 10
    mem[903] = 0x0A
    mem[904] = 0xFD   # DT = VD
    mem[905] = 0x15
    mem[906] = 0xFD   # WAIT: VD = DT
    mem[907] = 0x07
    mem[908] = 0x4D   # if VD != 0 skip
    mem[909] = 0x00
    mem[910] = 0x13   # -> WAIT (крутится, пока VD != 0)
    mem[911] = 0x88
    mem[912] = 0x12   # -> LOOPTOP (VD == 0)
    mem[913] = 0x74
    mem[1440] = 0x80   # 0x5A0 спрайт 1x1
    mem[1000] = 0xA5   # SELFLOOP (0x3E8): I = 0x500
    mem[1001] = 0x00
    mem[1002] = 0xFA   # I += VA
    mem[1003] = 0x1E
    mem[1004] = 0xF0   # V0 = xs[VA]
    mem[1005] = 0x65
    mem[1006] = 0x90   # if V0 != V8 skip
    mem[1007] = 0x80
    mem[1008] = 0x13   # -> self-y (0x3F4)
    mem[1009] = 0xF4
    mem[1010] = 0x13   # -> next-i (0x3FE)
    mem[1011] = 0xFE
    mem[1012] = 0xA5   # self-y: I = 0x540
    mem[1013] = 0x40
    mem[1014] = 0xFA   # I += VA
    mem[1015] = 0x1E
    mem[1016] = 0xF0   # V0 = ys[VA]
    mem[1017] = 0x65
    mem[1018] = 0x90   # if V0 != V9 skip
    mem[1019] = 0x90
    mem[1020] = 0x12   # die -> restart
    mem[1021] = 0x00
    mem[1022] = 0x7A   # next-i: VA += 1
    mem[1023] = 0x01
    mem[1024] = 0x4A   # if VA != 64 skip
    mem[1025] = 0x40
    mem[1026] = 0x6A   # VA = 0
    mem[1027] = 0x00
    mem[1028] = 0x9A   # if VA != V6 skip
    mem[1029] = 0x60
    mem[1030] = 0x12   # -> self-done (0x2FE)
    mem[1031] = 0xFE
    mem[1032] = 0x13   # -> SELFLOOP (0x3E8)
    mem[1033] = 0xE8
end

func fetch() -> int
    var hi = mem[pc] & 255
    var lo = mem[pc + 1] & 255
    return hi * 256 + lo
end

func runOp()
    var op: int = fetch()
    var x = (op / 256) % 16
    var y = (op / 16) % 16
    var n = op % 16
    var nn = op % 256
    var nnn = op % 4096
    pc = pc + 2
    switch op / 4096
        case 0
            if op == 0x00E0
                var i = 0
                for i = 0, 2048
                    disp[i] = 0
                end
            else if op == 0x00EE
                sp = sp - 1
                pc = stk[sp]
            end
        case 1
            pc = nnn
        case 2
            stk[sp] = pc
            sp = sp + 1
            pc = nnn
        case 3
            if V[x] == nn
                pc = pc + 2
            end
        case 4
            if V[x] != nn
                pc = pc + 2
            end
        case 5
            if V[x] == V[y]
                pc = pc + 2
            end
        case 6
            V[x] = nn
        case 7
            V[x] = (V[x] + nn) & 255
        case 8
            switch n
                case 0
                    V[x] = V[y]
                case 1
                    V[x] = V[x] | V[y]
                case 2
                    V[x] = V[x] & V[y]
                case 3
                    V[x] = V[x] ^ V[y]
                case 4
                    var sum = V[x] + V[y]
                    if sum > 255
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = sum & 255
                case 5
                    if V[x] > V[y]
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = (V[x] - V[y]) & 255
                case 6
                    V[15] = V[x] & 1
                    V[x] = V[x] / 2
                case 7
                    if V[y] > V[x]
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = (V[y] - V[x]) & 255
                case 0xE
                    V[15] = (V[x] / 128) & 1
                    V[x] = (V[x] << 1) & 255
            end
        case 9
            if V[x] != V[y]
                pc = pc + 2
            end
        case 0xA
            I = nnn
        case 0xB
            pc = V[0] + nnn
        case 0xC
            rng = (rng * 1103515245 + 12345) & 2147483647
            V[x] = (rng / 16) & nn
        case 0xD
            var x0 = V[x] % 64
            var y0 = V[y] % 32
            V[15] = 0
            var row = 0
            for row = 0, n
                var px = mem[I + row] & 255
                var col = 0
                for col = 0, 8
                    var bit = (px / 128) & 1
                    px = (px << 1) & 255
                    if bit == 1
                        var idx = ((y0 + row) % 32) * 64 + ((x0 + col) % 64)
                        if disp[idx] == 1
                            V[15] = 1
                        end
                        disp[idx] = disp[idx] ^ 1
                    end
                end
            end
        case 0xE
            if nn == 0x9E
                if keys[V[x] & 15] == 1
                    pc = pc + 2
                end
            else
                if keys[V[x] & 15] == 0
                    pc = pc + 2
                end
            end
        case 0xF
            switch nn
                case 0x07
                    V[x] = dt
                case 0x0A
                    waitKey = x
                case 0x15
                    dt = V[x]
                case 0x18
                    st = V[x]
                case 0x1E
                    I = I + V[x]
                case 0x29
                    I = 80 + V[x] * 5
                case 0x33
                    mem[I] = V[x] / 100
                    mem[I + 1] = (V[x] / 10) % 10
                    mem[I + 2] = V[x] % 10
                case 0x55
                    var si = 0
                    for si = 0, x + 1
                        mem[I + si] = V[si]
                    end
                    I = I + x + 1
                case 0x65
                    var di = 0
                    for di = 0, x + 1
                        V[di] = mem[I + di] & 255
                    end
                    I = I + x + 1
            end
    end
end

func keyVk(k: int) -> int
    if k == 0
        return 0x31
    else if k == 1
        return 0x32
    else if k == 2
        return 0x33
    else if k == 3
        return 0x34
    else if k == 4
        return 0x51
    else if k == 5
        return 0x57
    else if k == 6
        return 0x45
    else if k == 7
        return 0x52
    else if k == 8
        return 0x41
    else if k == 9
        return 0x53
    else if k == 10
        return 0x44
    else if k == 11
        return 0x46
    else if k == 12
        return 0x5A
    else if k == 13
        return 0x58
    else if k == 14
        return 0x43
    end
    return 0x56
end

func renderScreen()
    var y = 0
    var x = 0
    for y = 0, 32
        for x = 0, 64
            if disp[y * 64 + x] == 1
                drawRect(x * 10, y * 10, 10, 10, 0xFFFFFFFF)
            end
        end
    end
end

func scanFlag() -> int
    var cmd: int = GetCommandLineA()
    var i: int = 0
    while peek8(cmd + i) != 0
        if peek8(cmd + i) == 45 && peek8(cmd + i + 1) == 45
            var k: int = i + 2
            if (peek8(cmd + k) == 110 && peek8(cmd + k + 1) == 111 && peek8(cmd + k + 2) == 110 && peek8(cmd + k + 3) == 45 && peek8(cmd + k + 4) == 100 && peek8(cmd + k + 5) == 105 && peek8(cmd + k + 6) == 115 && peek8(cmd + k + 7) == 112 && peek8(cmd + k + 8) == 108 && peek8(cmd + k + 9) == 97 && peek8(cmd + k + 10) == 121) && (peek8(cmd + k + 11) == 0 || peek8(cmd + k + 11) == 32)
                return 1
            end
            if (peek8(cmd + k) == 114 && peek8(cmd + k + 1) == 101 && peek8(cmd + k + 2) == 103 && peek8(cmd + k + 3) == 115) && (peek8(cmd + k + 4) == 0 || peek8(cmd + k + 4) == 32)
                return 2
            end
        end
        while peek8(cmd + i) != 0 && peek8(cmd + i) != 32
            i = i + 1
        end
        while peek8(cmd + i) == 32
            i = i + 1
        end
    end
    return 0
end

func flushOut(len: int)
    var h: int = GetStdHandle(-11)
    WriteFile(h, g_out, len, 0, 0)
end

func pokeHex2(p: int, v: int)
    var ch = 0
    var d = (v / 16) % 16
    var e = v % 16
    if d < 10
        ch = 48 + d
    else
        ch = 65 + d - 10
    end
    poke8(g_out + p, ch)
    if e < 10
        ch = 48 + e
    else
        ch = 65 + e - 10
    end
    poke8(g_out + p + 1, ch)
end

func pokeHex8(p: int, v: int)
    var t = (v / 16777216) % 256
    pokeHex2(p, t)
    t = (v / 65536) % 256
    pokeHex2(p + 2, t)
    t = (v / 256) % 256
    pokeHex2(p + 4, t)
    t = v % 256
    pokeHex2(p + 6, t)
end

func pokeVreg(p: int, c: int, v: int)
    poke8(g_out + p, 86)     # 'V'
    var ch = 0
    if c < 10
        ch = 48 + c
    else
        ch = 65 + c - 10
    end
    poke8(g_out + p + 1, ch)
    poke8(g_out + p + 2, 61) # '='
    pokeHex8(p + 3, v)
    poke8(g_out + p + 11, 32) # ' '
end

func dumpRegs()
    var p = 0
    var r = 0
    for r = 0, 16
        pokeVreg(p, r, V[r])
        p = p + 12
        if r == 7 || r == 15
            poke8(g_out + p, 13)   # '\r'
            poke8(g_out + p + 1, 10) # '\n'
            p = p + 2
        end
    end
    poke8(g_out + p, 80)     # 'P'
    poke8(g_out + p + 1, 67) # 'C'
    poke8(g_out + p + 2, 61) # '='
    pokeHex8(p + 3, pc)
    poke8(g_out + p + 11, 32) # ' '
    p = p + 12
    poke8(g_out + p, 73)     # 'I'
    poke8(g_out + p + 1, 61) # '='
    pokeHex8(p + 2, I)
    poke8(g_out + p + 10, 32) # ' '
    p = p + 11
    poke8(g_out + p, 68)     # 'D'
    poke8(g_out + p + 1, 84) # 'T'
    poke8(g_out + p + 2, 61) # '='
    pokeHex8(p + 3, dt)
    poke8(g_out + p + 11, 32) # ' '
    p = p + 12
    poke8(g_out + p, 83)     # 'S'
    poke8(g_out + p + 1, 84) # 'T'
    poke8(g_out + p + 2, 61) # '='
    pokeHex8(p + 3, st)
    poke8(g_out + p + 11, 32) # ' '
    p = p + 12
    poke8(g_out + p, 83)     # 'S'
    poke8(g_out + p + 1, 80) # 'P'
    poke8(g_out + p + 2, 61) # '='
    pokeHex8(p + 3, sp)
    poke8(g_out + p + 11, 32) # ' '
    p = p + 12
    poke8(g_out + p, 13)
    poke8(g_out + p + 1, 10)
    flushOut(p + 2)
end

func main() -> int
    print("SNAKE: Q=up W=down A=left E=right")
    loadFont()
    loadRom()
    g_out = VirtualAlloc(0, 512, 0x3000, 0x40)
    var fl: int = scanFlag()
    if fl == 1
        nonDisplay = 1
        print("non-display mode: register dump every 60 frames")
    else if fl == 2
        dumpRegs = 1
        print("regs mode: register dump every 60 frames")
    end
    if nonDisplay == 0
        createWindow(640, 320, "SNAKE")
    end
    loop
        if nonDisplay == 0
            if processMessages() == 0
                break
            end
        end
        var k = 0
        for k = 0, 16
            keys[k] = 0
        end
        if nonDisplay == 0
            for k = 0, 16
                if getKey(keyVk(k)) == 1
                    keys[k] = 1
                end
            end
        end
        if waitKey >= 0
            if nonDisplay == 0
                var j = 0
                for j = 0, 16
                    if keys[j] == 1
                        V[waitKey] = j
                        waitKey = -1
                    end
                end
            else
                waitKey = -1
            end
        else
            var i = 0
            for i = 0, 6
                runOp()
            end
        end
        if dumpRegs == 1 || nonDisplay == 1
            dumpCount = dumpCount + 1
            if dumpCount == 60
                dumpRegs()
                dumpCount = 0
            end
        end
        if dt > 0
            dt = dt - 1
        end
        if st > 0
            st = st - 1
        end
        if nonDisplay == 0
            clear(0xFF000000)
            renderScreen()
            present()
        end
        sleep(0.016)
    end
    if nonDisplay == 0
        closeWindow()
    end
    return 0
end