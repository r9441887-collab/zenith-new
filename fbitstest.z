app gui tool

func main() -> int
    print(fbits(cos(0.0)))
    print(fbits(sin(0.0)))
    print(fbits(cos(1.0)))
    print(fbits(cos(0.05)))
    var ang: float = 0.0
    ang = ang + 0.05
    var ca: float = cos(ang)
    var sa: float = sin(ang)
    print(fbits(ca))
    print(fbits(sa))
    return 0
end