app console

func main() -> int
    js_reset()

    var r1: int = js_eval("[1,2,3,4].find(function(x) { return x > 2; })")
    if r1 != 3
        print("FAIL r1=")
        print(r1)
        print("\n")
        return 1
    end

    var r2: int = js_eval("[5,7,9].findIndex(function(x) { return x == 7; })")
    if r2 != 1
        print("FAIL r2=")
        print(r2)
        print("\n")
        return 2
    end

    var r3: int = js_eval("[2,4,6].some(function(x) { return x % 2 == 1; }) ? 1 : 0")
    if r3 != 0
        print("FAIL r3=")
        print(r3)
        print("\n")
        return 3
    end

    js_eval("var ok = [2,4,6].every(function(x) { return x % 2 == 0; }); var s = [1,2,3].reduce(function(a, b) { return a + b; }); var t = 'x'.repeat(1); 0")
    var r4: int = js_eval("(ok && s == 6) ? 1 : 0")
    if r4 != 1
        print("FAIL r4=")
        print(r4)
        print("\n")
        return 4
    end

    var r5: int = js_eval("Array.isArray([1]) && !Array.isArray('x') ? 1 : 0")
    if r5 != 1
        print("FAIL r5=")
        print(r5)
        print("\n")
        return 5
    end

    var r6: int = js_eval("Object.keys({a:1,b:2}).length")
    if r6 != 2
        print("FAIL r6=")
        print(r6)
        print("\n")
        return 6
    end

    js_eval("var v = Object.values({x:1, y:2}); var en = Object.entries({x:1, y:2}); 0")
    var r7: int = js_eval("(v[0] == 1 && v[1] == 2 && en[0][0] == 'x' && en[1][1] == 2) ? 1 : 0")
    if r7 != 1
        print("FAIL r7=")
        print(r7)
        print("\n")
        return 7
    end

    var r8: int = js_eval("'hello world'.lastIndexOf('o')")
    if r8 != 7
        print("FAIL r8=")
        print(r8)
        print("\n")
        return 8
    end

    js_eval("var p = '5'.padStart(3, '0'); var q = '5'.padEnd(3, 'x'); 0")
    var r9: int = js_eval("(p == '005' && q == '5xx') ? 1 : 0")
    if r9 != 1
        print("FAIL r9=")
        print(r9)
        print("\n")
        return 9
    end

    print("STDLIB Z TESTS OK (1,9)\n")
    return 0
end