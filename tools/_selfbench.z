app console
# Single-function heavy compute benchmark for the SELFHOST compiler.
# Everything is inline in main() (no helper functions) — the selfhost codegen.z
# currently hits an unported "backend builtin dispatch" path on helper calls
# after optimization, but handles builtins in a single function fine.
# ~0.5s CPU-bound per run; prints a checksum (must be identical at every level).

func main() -> int
    var n: int = 56
    var sz: int = n * n
    var a: int = alloc(sz * 4)
    var b: int = alloc(sz * 4)
    var c: int = alloc(sz * 4)
    var total: int = 0
    var round: int = 0
    while round < 8
        # fill matrices
        var i: int = 0
        while i < sz
            poke32(a + i * 4, (i * 7 + round) % 251)
            poke32(b + i * 4, (i * 13 + round * 3) % 241)
            poke32(c + i * 4, 0)
            i = i + 1
        end
        # integer matmul
        var r: int = 0
        while r < n
            var cc: int = 0
            while cc < n
                var k: int = 0
                var sum: int = 0
                while k < n
                    sum = sum + peek32(a + (r * n + k) * 4) * peek32(b + (k * n + cc) * 4)
                    k = k + 1
                end
                poke32(c + (r * n + cc) * 4, sum)
                cc = cc + 1
            end
            r = r + 1
        end
        # checksum matmul result
        i = 0
        while i < sz
            total = (total + (peek32(c + i * 4) & 65535)) & 2147483647
            i = i + 1
        end
        # integer hash-mix loop (xorshift + constant div/mul)
        var x: int = round * 2654435761 + 1
        var s: int = 0
        i = 0
        while i < 400000
            x = x ^ (x << 13)
            x = x ^ (x >> 7)
            x = x ^ (x << 17)
            s = s + (x & 255) + (x / 7) + (x % 11) + (x * 3) + (x / 8) + (x % 16) + (x * 5)
            s = s + (x >> 3) + (x << 2) - (x / 13)
            i = i + 1
        end
        total = (total + (s ^ x)) & 2147483647
        round = round + 1
    end
    free(a)
    free(b)
    free(c)
    println(total)
    return 0
end
