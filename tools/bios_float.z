# BIOS float suite — проверки математики в 32-битном x87-бэкенде (app bios).
#
# Протокол: каждая проверка пишет в порт 0xE9 (QEMU debug console) один байт:
#   0x41+idx (65+idx) — OK, 0x61+idx (97+idx) — FAIL, idx = 1..N.
# В конце — байт 0x0A (перевод строки), он же признак конца прогона.
# tools/run_bios_tests.sh разбирает этот поток и печатает итог.

app bios

func mark(idx: int, ok: int)
    if ok == 1
        outb(0xE9, 65 + idx)
    else
        outb(0xE9, 97 + idx)
    end
end

func main() -> int
    # ---- одноаргументные ----
    mark(1, sqrt(4.0) == 2.0)
    mark(2, sqrt(9.0) == 3.0)
    mark(3, abs(0.0 - 3.5) == 3.5)
    mark(4, abs(2.5) == 2.5)
    mark(5, floor(2.7) == 2.0)
    mark(6, floor(0.0 - 2.7) == 0.0 - 3.0)
    mark(7, ceil(2.1) == 3.0)
    mark(8, ceil(0.0 - 2.1) == 0.0 - 2.0)
    mark(9, trunc(2.9) == 2.0)
    mark(10, trunc(0.0 - 2.9) == 0.0 - 2.0)
    # ---- двухаргументные ----
    mark(11, min(2.0, 3.0) == 2.0)
    mark(12, max(2.0, 3.0) == 3.0)
    mark(13, fmod(6.0, 3.0) == 0.0)
    mark(14, fmod(7.0, 3.0) == 1.0)
    mark(15, fmod(10.0, 4.0) == 2.0)
    mark(16, fmod(7.0, 4.0) == 3.0)
    mark(17, fmod(5.5, 2.0) == 1.5)
    mark(18, fmod(7.5, 2.0) == 1.5)
    mark(19, fmod(0.0 - 7.0, 3.0) == 0.0 - 1.0)
    mark(20, pow(2.0, 10.0) == 1024.0)
    mark(21, pow(4.0, 0.5) == 2.0)
    mark(22, pow(2.0, 0.0) == 1.0)
    mark(23, pow(3.0, 2.0) == 9.0)
    # ---- арифметика ----
    mark(24, 7.0 - 3.0 == 4.0)
    mark(25, 6.0 / 2.0 == 3.0)
    mark(26, 2.5 + 2.5 == 5.0)
    mark(27, 1.5 * 4.0 == 6.0)
    # ---- atan2/тригонометрия (грубая проверка знака) ----
    mark(28, atan2(1.0, 1.0) > 0.7)
    mark(29, atan2(1.0, 1.0) < 0.8)
    mark(30, sin(0.0) == 0.0)
    mark(31, cos(0.0) == 1.0)
    outb(0xE9, 10)
    outb(0xF4, 0)              # isa-debug-exit: QEMU завершается сам
    return 0
end
