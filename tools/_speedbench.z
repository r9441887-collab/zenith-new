app console
# Heavy CPU-bound speed benchmark. ~0.5-1s of pure computation per run, so
# process startup (<1ms) is negligible and the measurement reflects the
# GENERATED CODE's speed. Mixes the patterns the optimizer's speed axis (-3)
# targets: division/modulo/multiply BY CONSTANTS (strength reduce -> shifts),
# bit-twiddling, and branchy integer work. Prints a checksum that must be
# IDENTICAL at every opt level (correctness guard).

func mix(a: int, b: int) -> int
    # integer hash-mix: heavy xor/shift, plus constant div/mul the optimizer
    # can strength-reduce
    var x: int = a
    var y: int = b
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    var s: int = 0
    var i: int = 0
    while i < 64
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        # constant div/mul/mod -> strength-reduce candidates
        s = s + (x & 255) + (x / 7) + (x % 11) + (x * 3) + (x / 8) + (x % 16) + (x * 5)
        s = s + (x >> 3) + (x << 2) - (x / 13)
        i = i + 1
    end
    return s ^ x
end

func matmul(n: int, seed: int) -> int
    # n x n integer matmul into flat buffers (alloc/free fine under C++ back end)
    var sz: int = n * n
    var a: int = alloc(sz * 4)
    var b: int = alloc(sz * 4)
    var c: int = alloc(sz * 4)
    var i: int = 0
    while i < sz
        poke32(a + i * 4, (i * 7 + seed) % 251)
        poke32(b + i * 4, (i * 13 + seed * 3) % 241)
        poke32(c + i * 4, 0)
        i = i + 1
    end
    var acc: int = 0
    var r: int = 0
    while r < n
        var cc: int = 0
        while cc < n
            var k: int = 0
            var sum: int = 0
            while k < n
                sum = sum + peek32(a + (r * n + k) * 4) * peek32(b + (k * n + cc) * 4)
                k = k + 1
            end
            poke32(c + (r * n + cc) * 4, sum)
            acc = acc + (sum & 65535)
            cc = cc + 1
        end
        r = r + 1
    end
    free(a)
    free(b)
    free(c)
    return acc & 2147483647
end

func main() -> int
    var total: int = 0
    var round: int = 0
    while round < 8
        total = (total + matmul(56, round + 1) + mix(round * 2654435761, round + 7)) & 2147483647
        round = round + 1
    end
    println(total)
    return 0
end
