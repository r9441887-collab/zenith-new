app linux

func lp01() -> int
  print("hello linux")
  return 0
end

func lp02(a: int) -> int
  print(a)
  return a
end

func lp03(a: int) -> int
  println(a + 1)
  return a
end

func lp04(a: int) -> int
  print(a - a)
  return a
end

func lp05(a: int) -> int
  print(a - 1000)
  return a
end

func lp06(s: string) -> int
  eprintln(s)
  return 0
end

func lp07(a: int) -> int
  eprint(a * 2)
  return a
end

func lp08(a: int) -> int
  print(a * a + 7)
  return a
end

func lp09() -> int
  print(3.5)
  return 0
end

func lp10(f: float) -> int
  print(f)
  return 0
end

func lp11(f: float) -> int
  eprintln(f - 0.25)
  return 0
end

func lp12() -> int
  halt()
  return 0
end

func lp13(c: int) -> int
  exit(c)
  return 0
end

func lp14(c: int) -> int
  exit_process(c + 1)
  return 0
end

func lp15(n: int) -> int
  var p: int = memNew(n)
  memByteW(p, 0, 65)
  memQw(p, 8, 42)
  var v: int = memByte(p, 0) + memQ(p, 8)
  memDel(p)
  return v
end
