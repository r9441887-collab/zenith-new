app linux

func main() -> int
    print("vulkan loader+instance")

    var ver: int = vk_api_version()
    print(ver)

    var iver: int = vk_instance_version()
    print(iver)

    var h: int = vk_instance_create()
    print(h)

    if h == -1
        print("instance create failed (expected in sandbox)")
        print("done")
        halt()
        return 1
    end

    var gpuN: int = vk_gpu_count(h)
    print(gpuN)

    if gpuN > 0
        var buf: [256]char
        var rc: int = vk_gpu_name(h, 0, &buf)
        print(rc)

        var api: int = vk_gpu_api(h, 0)
        print(api)

        var ven: int = vk_gpu_vendor(h, 0)
        print(ven)

        var dev: int = vk_gpu_device(h, 0)
        print(dev)
    end

    vk_destroy_instance(h)

    print("done")
    halt()
    return 0
end
