app console

func main() -> int
    js_reset()

    var y: int = js_eval("var a = 40; var b = 2; a + b")
    if y != 42
        print("FAIL y=")
        print(y)
        print("\n")
        return 1
    end

    js_eval("function fib(n) { if (n < 2) { return n; } return fib(n-1) + fib(n-2); }")
    var ff: int = js_eval("fib(10)")
    var loopy: int = js_eval("var s = 0; for (var i = 1; i <= 100; i = i + 1) { s = s + i; } s")
    var objy: int = js_eval("var o = {x: 21}; o.x * 2")
    var arry: int = js_eval("var a = [1,2,3]; a[0] + a[1] + a[2]")
    var wht: int = js_eval("var n = 0; var k = 0; while (k < 5) { n = n + k; k = k + 1; } n")

    var brk: int = js_eval("var s = 0; var i = 0; while (true) { i = i + 1; if (i == 3) { break } s = s + i; } s + i")
    var cont: int = js_eval("var cnt = 0; for (var i = 0; i < 5; i = i + 1) { if (i == 2) { continue } cnt = cnt + 1; } cnt")
    var dolo: int = js_eval("var d = 0; do { d = d + 2; } while (d < 6) d")
    var slen: int = js_eval("'hello'.length")
    var sidx: int = js_eval("var ch = 'hello'[1]; if (ch != 'e') { return 99; } 1")
    var plen: int = js_eval("var a = [1,2]; a.push(3); a.length")
    var pv: int = js_eval("var a = [1,2,3]; a.pop()")
    var sub: int = js_eval("var t = 'hello'.substring(1,3); if (t != 'el') { return 88; } 1")
    var ca: int = js_eval("var c = 'hello'.charAt(0); if (c != 'h') { return 77; } 1")

    var bad: int = js_eval("var q = 5; q()")
    var alive: int = js_eval("6 * 7")

    var to32: int = js_eval("if (typeof 5 != 'number') { return 90; } if (1 === '1') { return 89; } 1")
    var strict: int = js_eval("var a = 1; var b = 2; if ((a === 1) && (b !== 3)) { 1 } else { 0 }")
    var pi: int = js_eval("parseInt('ff', 16)")
    var pf: int = js_eval("parseFloat('2.5') * 2")
    var nan: int = js_eval("if (isNaN('abc')) { 1 } else { 0 }")
    var chkni: int = js_eval("if (isNaN('42')) { 99 } else { 1 }")
    var fl: int = js_eval("Math.floor(5.9)")
    var sq: int = js_eval("Math.sqrt(81)")
    var pw: int = js_eval("Math.pow(2, 8)")
    var mx: int = js_eval("Math.max(3, 9)")
    var lc: int = js_eval("if ('HeLLo'.toLowerCase() != 'hello') { 99 } else { 5 }")
    var swl: int = js_eval("var x = 2; switch (x) { case 1: { x = 10; break } case 2: { x = 20; break } default: { x = 30 } } x")
    var jo: int = js_eval("[1,2,3].join('-').length")
    var sp: int = js_eval("var p = 'a,b,c'.split(',')[1]; if (p != 'b') { return 87; } 1")
    var sh: int = js_eval("var a = [1,2,3]; a.shift()")
    var ush: int = js_eval("var a = [2]; a.unshift(1); a[0]")
    var idx: int = js_eval("[1,2,3].indexOf(2)")
    var del: int = js_eval("var o = {a: 5, b: 6}; delete o.a; if ('a' in o) { return 86; } o.b")
    var keys: int = js_eval("var o = {x: 1, y: 2, z: 3}; Object.keys(o).length")
    var tpl: int = js_eval("var n = 4; var t = `n=${n + 1}`; if (t == 'n=5') { 1 } else { 0 }")
    var cmt: int = js_eval("var c = 1 + /* two */ 2; // end\n c")

    var cei: int = js_eval("Math.ceil(4.2)")
    var rou: int = js_eval("Math.round(3.5)")
    var tru: int = js_eval("Math.trunc(7.9)")
    var sgn: int = js_eval("if (Math.sign(-4) == -1) { 1 } else { 0 }")
    var clz: int = js_eval("if (Math.clz32(1) == 31) { 1 } else { 0 }")
    var iml: int = js_eval("Math.imul(3,5)")
    var hyp: int = js_eval("Math.hypot(6,8)")
    var cbr: int = js_eval("Math.cbrt(27)")
    var exp1: int = js_eval("if (Math.abs(Math.exp(1) - 2.7182818) < 0.00001) { 1 } else { 0 }")
    var lg2a: int = js_eval("if (Math.log2(16) == 4) { 1 } else { 0 }")
    var lg1a: int = js_eval("if (Math.log10(1000) == 3) { 1 } else { 0 }")
    var sin0: int = js_eval("if (Math.sin(0) == 0) { 1 } else { 0 }")
    var sin9: int = js_eval("if (Math.abs(Math.sin(Math.PI/2) - 1) < 0.000001) { 1 } else { 0 }")
    var cs0: int = js_eval("if (Math.abs(Math.cos(0) - 1) < 0.000001) { 1 } else { 0 }")
    var tn0: int = js_eval("if (Math.tan(0) == 0) { 1 } else { 0 }")
    var atn: int = js_eval("if (Math.abs(Math.atan2(0,-1) - 3.1415927) < 0.000001) { 1 } else { 0 }")
    var sh0: int = js_eval("if (Math.sinh(0) == 0) { 1 } else { 0 }")
    var ch0: int = js_eval("if (Math.cosh(0) == 1) { 1 } else { 0 }")
    var th0: int = js_eval("if (Math.tanh(0) == 0) { 1 } else { 0 }")
    var frm: int = js_eval("if (Math.fround(1.5) == 1.5) { 1 } else { 0 }")
    var pic: int = js_eval("if (Math.PI > 3 && Math.PI < 4) { 1 } else { 0 }")

    if ff != 55 || loopy != 5050 || objy != 42 || arry != 6 || wht != 10 || brk != 6 || cont != 4 || dolo != 6 || slen != 5 || sidx != 1 || plen != 3 || pv != 3 || sub != 1 || ca != 1 || alive != 42 || to32 != 1 || strict != 1 || pi != 255 || pf != 5 || nan != 1 || chkni != 1 || fl != 5 || sq != 9 || pw != 256 || mx != 9 || lc != 5 || swl != 20 || jo != 5 || sp != 1 || sh != 1 || ush != 1 || idx != 1 || del != 6 || keys != 3 || tpl != 1 || cmt != 3 || cei != 5 || rou != 4 || tru != 7 || sgn != 1 || clz != 1 || iml != 15 || hyp != 10 || cbr != 3 || exp1 != 1 || lg2a != 1 || lg1a != 1 || sin0 != 1 || sin9 != 1 || cs0 != 1 || tn0 != 1 || atn != 1 || sh0 != 1 || ch0 != 1 || th0 != 1 || frm != 1 || pic != 1
        print("FAIL ff=")
        print(ff)
        print(" loopy=")
        print(loopy)
        print(" objy=")
        print(objy)
        print(" arry=")
        print(arry)
        print(" wht=")
        print(wht)
        print(" brk=")
        print(brk)
        print(" cont=")
        print(cont)
        print(" dolo=")
        print(dolo)
        print(" slen=")
        print(slen)
        print(" sidx=")
        print(sidx)
        print(" plen=")
        print(plen)
        print(" pv=")
        print(pv)
        print(" sub=")
        print(sub)
        print(" ca=")
        print(ca)
        print(" exp1=")
        print(exp1)
        print("\n")
        return 1
    end

    print("ALL JS TESTS OK (y=")
    print(y)
    print(" fib10=")
    print(ff)
    print(" sum1_100=")
    print(loopy)
    print(" objx2=")
    print(objy)
    print(" arrsum=")
    print(arry)
    print(" whilesum=")
    print(wht)
    print(" break=")
    print(brk)
    print(" continue=")
    print(cont)
    print(" do=")
    print(dolo)
    print(" len=")
    print(slen)
    print(" methods=")
    print(pv)
    print(" errcheck=")
    print(bad)
    print(" alive=")
    print(alive)
    print(" strict=")
    print(strict)
    print(" pi=")
    print(pi)
    print(" fl=")
    print(fl)
    print(" swl=")
    print(swl)
    print(" jo=")
    print(jo)
    print(" keys=")
    print(keys)
    print(" tpl=")
    print(tpl)
    print(" cmt=")
    print(cmt)
    print(" pi2=")
    print(cei)
    print(" round=")
    print(rou)
    print(" trunc=")
    print(tru)
    print(" sign=")
    print(sgn)
    print(" clz=")
    print(clz)
    print(" imul=")
    print(iml)
    print(" hypot=")
    print(hyp)
    print(" cbrt=")
    print(cbr)
    print(" exp=")
    print(exp1)
    print(" log2=")
    print(lg2a)
    print(" log10=")
    print(lg1a)
    print(" sin=")
    print(sin0)
    print(" sin90=")
    print(sin9)
    print(" cos=")
    print(cs0)
    print(" tan=")
    print(tn0)
    print(" atan2=")
    print(atn)
    print(" sinh=")
    print(sh0)
    print(" cosh=")
    print(ch0)
    print(" tanh=")
    print(th0)
    print(" fround=")
    print(frm)
    print(" pi=")
    print(pic)
    print(")\n")

    return 0
end