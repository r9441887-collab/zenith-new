app linux

func main() -> int
    print("winwl: open display")
    var fd: int = wl_open()
    if fd < 0
        print("wl_open failed")
        return 1
    end

    var w: int = 400
    var h: int = 300
    var rc: int = wl_create_window(w, h, "Zenith Window Test")
    if rc != 0
        print("wl_create_window failed")
        wl_close(fd)
        return 1
    end
    print("window created")

    var fb: int = wl_fb()
    if fb == 0
        print("no framebuffer")
        wl_close_window()
        wl_close(fd)
        return 1
    end

    var y: int = 0
    while y < h
        var x: int = 0
        while x < w
            var r: int = (x * 6) % 255
            var g: int = (y * 6) % 255
            var b: int = (x * 8 + y * 4) % 255
            var col: int = (0xFF << 24) | (r << 16) | (g << 8) | b
            wl_pixel(x, y, col)
            x = x + 1
        end
        y = y + 1
    end
    print("drawn gradient")

    wl_present()

    var running: int = 1
    while running == 1
        running = wl_process()
    end
    print("window closed")
    wl_close_window()
    print("done")
    return 0
end