app gui dx tool

# Baseline: the exact red triangle from 10_directx_11.txt.
# If this does NOT show a red triangle on your machine, the DX11 runtime/env is broken.

func main() -> int
    createWindow(800, 600, "DX11")

    var verts: [3]int
    var p: int = alloc(64)
    poke32(p, 0x3F800000)   # ( 1.0,  1.0)
    poke32(p + 4, 0x3F800000)
    poke32(p + 8, 0xBF800000)  # (-1.0,  1.0)
    poke32(p + 12, 0x3F800000)
    poke32(p + 16, 0)          # ( 0.0, -1.0)
    poke32(p + 20, 0xBF800000)

    var hlsl: int = 0
    var vs: int = dxCreateVertexShader("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var ps: int = dxCreatePixelShader("float4 main() : SV_Target { return float4(1, 0, 0, 1); }")
    var layout: int = dxCreateInputLayout("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var vbuf: int = dxCreateBuffer(24, p)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 8)
    dxSetTopology(4)

    var running: int = 1
    while running == 1
        dxDraw(3)
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end

    closeWindow()
    return 0
end
