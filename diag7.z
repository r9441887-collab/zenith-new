app gui dx tool

# Decisive in-process test:
#  dxTrace() -> GetBuffer -> CreateRTV -> OMSetRT -> ClearRT RED ->
#              staging -> CopyResource -> Map -> read 4 px -> Present(0,0),
#              with HRESULT capture + readback BEFORE present.
#  trace.bin: red pixels (0000ff, bgra) => clear+readback chain works,
#              black bug is upstream (draw/present/DWM).
func main() -> int
    createWindow(800, 600, "DX11")
    dxCheckSwapChain()
    var running: int = 1
    while running == 1
        dxTrace()
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end
    closeWindow()
    return 0
end