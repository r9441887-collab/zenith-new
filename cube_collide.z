app gui dx tool

# 3D: куб едет по X к статичному треугольнику-стене и сталкивается с ним.
# Оба объекта в одном vertex buffer (треугольник = verts 0-2, куб = verts 3-26),
# общий VS с перспективным делением и вращением вокруг Y.
# Между draw-вызовами переключается constant buffer (dxUpdateBuffer+dxSetVertexConstants)
# чтобы задать каждой модели свою трансформацию (перемещение/поворот).
# Столкновение: когда правый край куба достигает левого края треугольника -> impact.

var F1: int = 0x3F800000    # 1.0
var F00: int = 0            # 0.0

func vert(pos: int, x: int, y: int, z: int, r: int, g: int, b: int, a: int)
    poke32(pos, x)
    poke32(pos + 4, y)
    poke32(pos + 8, z)
    poke32(pos + 12, r)
    poke32(pos + 16, g)
    poke32(pos + 20, b)
    poke32(pos + 24, a)
end

func main() -> int
    createWindow(800, 600, "Cube collides with triangle")

    # --- vertex buffer: 27 verts x 28 bytes = 756 bytes ---
    # layout: triangle verts 0..2, cube verts 3..26
    var vb: int = alloc(756)

    # triangle (verts 0-2), centered at origin, white wall, z=0
    vert(vb + 0  * 28, F00, 0x3F0CCCCD, F00, F1, F1, F1, F1)   # apex
    vert(vb + 1  * 28, 0xBF000000, 0xBF333333, F00, F1, F1, F1, F1) # bottom-left (-0.5,-0.4)
    vert(vb + 2  * 28, 0x3F000000, 0xBF333333, F00, F1, F1, F1, F1) # bottom-right (0.5,-0.4)

    # cube (verts 3-26), 24 verts, half-size 1, same face colors as cube3d
    var o: int = 3
    # face 0: z=-1 (back), RED
    vert(vb + (o+0)  * 28, 0xBF800000, 0xBF800000, 0xBF800000, F1, F00, F00, F1)
    vert(vb + (o+1)  * 28, 0x3F800000, 0xBF800000, 0xBF800000, F1, F00, F00, F1)
    vert(vb + (o+2)  * 28, 0x3F800000, 0x3F800000, 0xBF800000, F1, F00, F00, F1)
    vert(vb + (o+3)  * 28, 0xBF800000, 0x3F800000, 0xBF800000, F1, F00, F00, F1)
    # face 1: z=+1 (front), GREEN
    vert(vb + (o+4)  * 28, 0xBF800000, 0xBF800000, 0x3F800000, F00, F1, F00, F1)
    vert(vb + (o+5)  * 28, 0x3F800000, 0xBF800000, 0x3F800000, F00, F1, F00, F1)
    vert(vb + (o+6)  * 28, 0x3F800000, 0x3F800000, 0x3F800000, F00, F1, F00, F1)
    vert(vb + (o+7)  * 28, 0xBF800000, 0x3F800000, 0x3F800000, F00, F1, F00, F1)
    # face 2: x=-1 (left), BLUE
    vert(vb + (o+8)  * 28, 0xBF800000, 0xBF800000, 0xBF800000, F00, F00, F1, F1)
    vert(vb + (o+9)  * 28, 0xBF800000, 0x3F800000, 0xBF800000, F00, F00, F1, F1)
    vert(vb + (o+10) * 28, 0xBF800000, 0x3F800000, 0x3F800000, F00, F00, F1, F1)
    vert(vb + (o+11) * 28, 0xBF800000, 0xBF800000, 0x3F800000, F00, F00, F1, F1)
    # face 3: x=+1 (right), YELLOW
    vert(vb + (o+12) * 28, 0x3F800000, 0xBF800000, 0xBF800000, F1, F1, F00, F1)
    vert(vb + (o+13) * 28, 0x3F800000, 0xBF800000, 0x3F800000, F1, F1, F00, F1)
    vert(vb + (o+14) * 28, 0x3F800000, 0x3F800000, 0x3F800000, F1, F1, F00, F1)
    vert(vb + (o+15) * 28, 0x3F800000, 0x3F800000, 0xBF800000, F1, F1, F00, F1)
    # face 4: y=-1 (bottom), CYAN
    vert(vb + (o+16) * 28, 0xBF800000, 0xBF800000, 0xBF800000, F00, F1, F1, F1)
    vert(vb + (o+17) * 28, 0xBF800000, 0xBF800000, 0x3F800000, F00, F1, F1, F1)
    vert(vb + (o+18) * 28, 0x3F800000, 0xBF800000, 0x3F800000, F00, F1, F1, F1)
    vert(vb + (o+19) * 28, 0x3F800000, 0xBF800000, 0xBF800000, F00, F1, F1, F1)
    # face 5: y=+1 (top), MAGENTA
    vert(vb + (o+20) * 28, 0xBF800000, 0x3F800000, 0xBF800000, F1, F00, F1, F1)
    vert(vb + (o+21) * 28, 0xBF800000, 0x3F800000, 0x3F800000, F1, F00, F1, F1)
    vert(vb + (o+22) * 28, 0x3F800000, 0x3F800000, 0x3F800000, F1, F00, F1, F1)
    vert(vb + (o+23) * 28, 0x3F800000, 0x3F800000, 0xBF800000, F1, F00, F1, F1)

    # --- index buffer: cube only, 36 x uint16, verts 3..26 (18 packed dwords) ---
    var ip: int = alloc(72)
    # face0 (verts 3-6): 3,4,5 5,6,3
    poke32(ip + 0  * 4, (3) | (4 << 16))
    poke32(ip + 1  * 4, (5) | (5 << 16))
    poke32(ip + 2  * 4, (6) | (3 << 16))
    # face1 (verts 7-10): 8,7,10 10,9,8
    poke32(ip + 3  * 4, (8) | (7 << 16))
    poke32(ip + 4  * 4, (10) | (10 << 16))
    poke32(ip + 5  * 4, (9) | (8 << 16))
    # face2 (verts 11-14, x=-1): 11,12,13 13,14,11
    poke32(ip + 6  * 4, (11) | (12 << 16))
    poke32(ip + 7  * 4, (13) | (13 << 16))
    poke32(ip + 8  * 4, (14) | (11 << 16))
    # face3 (verts 15-18, x=+1): 15,16,17 17,18,15
    poke32(ip + 9  * 4, (15) | (16 << 16))
    poke32(ip + 10 * 4, (17) | (17 << 16))
    poke32(ip + 11 * 4, (18) | (15 << 16))
    # face4 (verts 19-22, y=-1): 19,20,21 21,22,19
    poke32(ip + 12 * 4, (19) | (20 << 16))
    poke32(ip + 13 * 4, (21) | (21 << 16))
    poke32(ip + 14 * 4, (22) | (19 << 16))
    # face5 (verts 23-26, y=+1): 23,26,25 25,24,23
    poke32(ip + 15 * 4, (23) | (26 << 16))
    poke32(ip + 16 * 4, (25) | (25 << 16))
    poke32(ip + 17 * 4, (24) | (23 << 16))

    # --- shaders ---
    var vs: int = dxCreateVertexShader("cbuffer CB : register(b0) { float4 cs; float4 cs2; }; struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float ca = cs.x; float sa = cs.y; float x = ca*i.pos.x + sa*i.pos.z; float z = -sa*i.pos.x + ca*i.pos.z; x = x + cs.z; float y = i.pos.y + cs.w; float f = 2.0 / (z + 5.0); VOut o; o.pos = float4(x*f, y*f, cs2.z, 1); o.col = i.col; return o; }")
    var ps: int = dxCreatePixelShader("struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; float4 main(VOut i) : SV_Target { return i.col; }")
    var layout: int = dxCreateInputLayout("cbuffer CB : register(b0) { float4 cs; float4 cs2; }; struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float ca = cs.x; float sa = cs.y; float x = ca*i.pos.x + sa*i.pos.z; float z = -sa*i.pos.x + ca*i.pos.z; x = x + cs.z; float y = i.pos.y + cs.w; float f = 2.0 / (z + 5.0); VOut o; o.pos = float4(x*f, y*f, cs2.z, 1); o.col = i.col; return o; }", "POSITION", 6, 0, "COLOR", 2, 12)
    var vbuf: int = dxCreateBuffer(756, vb)
    var ibuf: int = dxCreateBuffer(72, ip)

    # --- constant buffers: cube and triangle transforms (32 bytes each) ---
    var rcub: int = alloc(32)
    var rtri: int = alloc(32)
    var cub: int = dxCreateConstantBuffer(32, rcub)
    var tricb: int = dxCreateConstantBuffer(32, rtri)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 28)
    dxSetIndexBuffer(ibuf)
    dxSetTopology(4)

    var cubeX: float = 0.0 - 2.2     # start left of triangle
    var triX: float = 1.6            # triangle center x (world)
    var impact: int = 0
    var touchX: float = 0.1          # collision when cubeX reaches this (cube right edge ~ cubeX+1 vs tri left ~1.1)

    loop
        if processMessages() == 0
            break
        end
        if impact == 0
            cubeX = cubeX + 0.004
            if cubeX >= touchX
                cubeX = touchX
                impact = 1
            end
        end

        # --- triangle constant buffer (static, back wall, deeper z=0) ---
        poke32(rtri + 0, F1)
        poke32(rtri + 4, F00)
        poke32(rtri + 8, fbits(triX))
        poke32(rtri + 12, fbits(0.0))
        poke32(rtri + 24, 0x3ECCCCCD)   # cs2.z = 0.4f (farther wall)
        dxUpdateBuffer(tricb, rtri)
        dxSetVertexConstants(tricb)
        dxClear()
        dxClearDepthStencil()
        dxDraw(3)

        # --- cube constant buffer (no rotation, straight slide, nearer z=-0.1) ---
        poke32(rcub + 0, F1)
        poke32(rcub + 4, F00)
        poke32(rcub + 8, fbits(cubeX))
        poke32(rcub + 12, fbits(0.0))
        poke32(rcub + 24, 0x3DCCCCCD)   # cs2.z = 0.1f (in front of wall)
        dxUpdateBuffer(cub, rcub)
        dxSetVertexConstants(cub)
        dxDrawIndexed(36)

        present()
        sleep(0.016)
        if getKey(0x1B) == 1
            break
        end
    end

    closeWindow()
    return 0
end
