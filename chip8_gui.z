app gui tool

# ================ CHIP-8 emulator (GUI) =================
var mem: [4096]int
var V: [16]int
var disp: [2048]int
var stk: [16]int
var keys: [16]int
var I: int = 0
var pc: int = 512
var sp: int = 0
var dt: int = 0
var st: int = 0
var rng: int = 12345
var waitKey: int = -1

func loadFont()
    mem[80] = 0xF0
    mem[81] = 0x90
    mem[82] = 0x90
    mem[83] = 0x90
    mem[84] = 0xF0
    mem[85] = 0x20
    mem[86] = 0x60
    mem[87] = 0x20
    mem[88] = 0x20
    mem[89] = 0x70
    mem[90] = 0xF0
    mem[91] = 0x10
    mem[92] = 0xF0
    mem[93] = 0x80
    mem[94] = 0xF0
    mem[95] = 0xF0
    mem[96] = 0x10
    mem[97] = 0xF0
    mem[98] = 0x10
    mem[99] = 0xF0
    mem[100] = 0x90
    mem[101] = 0x90
    mem[102] = 0xF0
    mem[103] = 0x10
    mem[104] = 0x10
    mem[105] = 0xF0
    mem[106] = 0x80
    mem[107] = 0xF0
    mem[108] = 0x10
    mem[109] = 0xF0
    mem[110] = 0xF0
    mem[111] = 0x80
    mem[112] = 0xF0
    mem[113] = 0x90
    mem[114] = 0xF0
    mem[115] = 0xF0
    mem[116] = 0x10
    mem[117] = 0x20
    mem[118] = 0x40
    mem[119] = 0x40
    mem[120] = 0xF0
    mem[121] = 0x90
    mem[122] = 0xF0
    mem[123] = 0x90
    mem[124] = 0xF0
    mem[125] = 0xF0
    mem[126] = 0x90
    mem[127] = 0xF0
    mem[128] = 0x10
    mem[129] = 0xF0
    mem[130] = 0xF0
    mem[131] = 0x90
    mem[132] = 0xF0
    mem[133] = 0x90
    mem[134] = 0x90
    mem[135] = 0xE0
    mem[136] = 0x90
    mem[137] = 0xE0
    mem[138] = 0x90
    mem[139] = 0xE0
    mem[140] = 0xF0
    mem[141] = 0x80
    mem[142] = 0x80
    mem[143] = 0x80
    mem[144] = 0xF0
    mem[145] = 0xE0
    mem[146] = 0x90
    mem[147] = 0x90
    mem[148] = 0x90
    mem[149] = 0xE0
    mem[150] = 0xF0
    mem[151] = 0x80
    mem[152] = 0xF0
    mem[153] = 0x80
    mem[154] = 0xF0
    mem[155] = 0xF0
    mem[156] = 0x80
    mem[157] = 0xF0
    mem[158] = 0x80
    mem[159] = 0x80
end

func loadRom()
    mem[512] = 0x00
    mem[513] = 0xE0
    mem[514] = 0x6A
    mem[515] = 0x04
    mem[516] = 0x6B
    mem[517] = 0x04
    mem[518] = 0x6C
    mem[519] = 0x01
    mem[520] = 0x6D
    mem[521] = 0x01
    mem[522] = 0xA2
    mem[523] = 0x24
    mem[524] = 0xDA
    mem[525] = 0xB1
    mem[526] = 0x8A
    mem[527] = 0xC4
    mem[528] = 0x8B
    mem[529] = 0xD4
    mem[530] = 0x4A
    mem[531] = 0x3F
    mem[532] = 0x6C
    mem[533] = 0xFF
    mem[534] = 0x4A
    mem[535] = 0x01
    mem[536] = 0x6C
    mem[537] = 0x01
    mem[538] = 0x4B
    mem[539] = 0x1F
    mem[540] = 0x6D
    mem[541] = 0xFF
    mem[542] = 0x4B
    mem[543] = 0x01
    mem[544] = 0x6D
    mem[545] = 0x01
    mem[546] = 0x12
    mem[547] = 0x0C
    mem[548] = 0x80
    mem[549] = 0x00
end

func fetch() -> int
    var hi = mem[pc] & 255
    var lo = mem[pc + 1] & 255
    return hi * 256 + lo
end

func runOp()
    var op: int = fetch()
    var x = (op / 256) % 16
    var y = (op / 16) % 16
    var n = op % 16
    var nn = op % 256
    var nnn = op % 4096
    pc = pc + 2
    switch op / 4096
        case 0
            if op == 0x00E0
                var i = 0
                for i = 0, 2048
                    disp[i] = 0
                end
            else if op == 0x00EE
                sp = sp - 1
                pc = stk[sp]
            end
        case 1
            pc = nnn
        case 2
            stk[sp] = pc
            sp = sp + 1
            pc = nnn
        case 3
            if V[x] == nn
                pc = pc + 2
            end
        case 4
            if V[x] != nn
                pc = pc + 2
            end
        case 5
            if V[x] == V[y]
                pc = pc + 2
            end
        case 6
            V[x] = nn
        case 7
            V[x] = V[x] + nn
        case 8
            switch n
                case 0
                    V[x] = V[y]
                case 1
                    V[x] = V[x] | V[y]
                case 2
                    V[x] = V[x] & V[y]
                case 3
                    V[x] = V[x] ^ V[y]
                case 4
                    var sum = V[x] + V[y]
                    if sum > 255
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = sum & 255
                case 5
                    if V[x] > V[y]
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = (V[x] - V[y]) & 255
                case 6
                    V[15] = V[x] & 1
                    V[x] = V[x] / 2
                case 7
                    if V[y] > V[x]
                        V[15] = 1
                    else
                        V[15] = 0
                    end
                    V[x] = (V[y] - V[x]) & 255
                case 0xE
                    V[15] = (V[x] / 128) & 1
                    V[x] = (V[x] << 1) & 255
            end
        case 9
            if V[x] != V[y]
                pc = pc + 2
            end
        case 0xA
            I = nnn
        case 0xB
            pc = V[0] + nnn
        case 0xC
            rng = (rng * 1103515245 + 12345) & 2147483647
            V[x] = (rng / 16) & nn
        case 0xD
            var x0 = V[x] % 64
            var y0 = V[y] % 32
            V[15] = 0
            var row = 0
            for row = 0, n
                var px = mem[I + row] & 255
                var col = 0
                for col = 0, 8
                    var bit = (px / 128) & 1
                    px = (px << 1) & 255
                    if bit == 1
                        var idx = ((y0 + row) % 32) * 64 + ((x0 + col) % 64)
                        if disp[idx] == 1
                            V[15] = 1
                        end
                        disp[idx] = disp[idx] ^ 1
                    end
                end
            end
        case 0xE
            if nn == 0x9E
                if keys[V[x] & 15] == 1
                    pc = pc + 2
                end
            else
                if keys[V[x] & 15] == 0
                    pc = pc + 2
                end
            end
        case 0xF
            switch nn
                case 0x07
                    V[x] = dt
                case 0x0A
                    waitKey = x
                case 0x15
                    dt = V[x]
                case 0x18
                    st = V[x]
                case 0x1E
                    I = I + V[x]
                case 0x29
                    I = 80 + V[x] * 5
                case 0x33
                    mem[I] = V[x] / 100
                    mem[I + 1] = (V[x] / 10) % 10
                    mem[I + 2] = V[x] % 10
                case 0x55
                    var si = 0
                    for si = 0, x + 1
                        mem[I + si] = V[si]
                    end
                    I = I + x + 1
                case 0x65
                    var di = 0
                    for di = 0, x + 1
                        V[di] = mem[I + di] & 255
                    end
                    I = I + x + 1
            end
    end
end

func keyVk(k: int) -> int
    if k == 0
        return 0x31
    else if k == 1
        return 0x32
    else if k == 2
        return 0x33
    else if k == 3
        return 0x34
    else if k == 4
        return 0x51
    else if k == 5
        return 0x57
    else if k == 6
        return 0x45
    else if k == 7
        return 0x52
    else if k == 8
        return 0x41
    else if k == 9
        return 0x53
    else if k == 10
        return 0x44
    else if k == 11
        return 0x46
    else if k == 12
        return 0x5A
    else if k == 13
        return 0x58
    else if k == 14
        return 0x43
    end
    return 0x56
end

func renderScreen()
    var y = 0
    var x = 0
    for y = 0, 32
        for x = 0, 64
            if disp[y * 64 + x] == 1
                drawRect(x * 10, y * 10, 10, 10, 0xFFFFFFFF)
            end
        end
    end
end

func main() -> int
    loadFont()
    loadRom()
    createWindow(640, 320, "CHIP-8")
    loop
        if processMessages() == 0
            break
        end
        var k = 0
        for k = 0, 16
            keys[k] = 0
        end
        for k = 0, 16
            if getKey(keyVk(k)) == 1
                keys[k] = 1
            end
        end
        if waitKey >= 0
            var j = 0
            for j = 0, 16
                if keys[j] == 1
                    V[waitKey] = j
                    waitKey = -1
                end
            end
        else
            var i = 0
            for i = 0, 6
                runOp()
            end
        end
        if dt > 0
            dt = dt - 1
        end
        if st > 0
            st = st - 1
        end
        clear(0xFF000000)
        renderScreen()
        present()
        sleep(0.016)
    end
    closeWindow()
    return 0
end