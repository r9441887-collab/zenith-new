app linux driver
module_description: "zenith lifecycle module (multi-session state)"
module_author: "zenith"
module_version: "0.9"

# Minimal module that keeps state in globals across load/unload: the
# cleanup_module hook reports a counter that main incremented, proving
# init/cleanup wiring and global lifetime in .data.
var g_loads: int = 0
var g_value: int = 42

func main() -> int
    g_loads = g_loads + 1
    g_value = g_value + 7
    print("lifecycle: loaded #")
    print(g_loads)
    print(", new value=")
    print(g_value)
    if g_value == 49
        print(" lifecycle first-load PASS")
    else
        print(" lifecycle value unexpected FAIL")
    end
    return 0
end

func cleanup()
    print("lifecycle: cleanup, value still=")
    print(g_value)
    print("load count=")
    print(g_loads)
end