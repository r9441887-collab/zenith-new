app console

# ============================================================
# Zenith x86-64 Disassembler (console version)
# Loads any file (Zenith PE binaries preferred), parses the
# PE headers and disassembles the executable sections as real
# x86-64 machine code, printed as text lines: virtual address,
# raw bytes and Intel-syntax instructions.
#
# Usage:  disasm_console.exe <file>
# ============================================================

@import("kernel32.dll")

extern func CreateFileA(name: int, access: int, share: int, sec: int, disp: int, flags: int, tmpl: int) -> int from "kernel32.dll"
extern func GetFileSize(h: int, high: int) -> int from "kernel32.dll"
extern func ReadFile(h: int, buf: int, n: int, read: int, ov: int) -> int from "kernel32.dll"
extern func CloseHandle(h: int) -> int from "kernel32.dll"
extern func SetFilePointer(h: int, dist: int, distHi: int, method: int) -> int from "kernel32.dll"
extern func WriteFile(h: int, buf: int, n: int, written: int, ov: int) -> int from "kernel32.dll"
extern func GetStdHandle(n: int) -> int from "kernel32.dll"
extern func GetCommandLineA() -> int from "kernel32.dll"
extern func GetModuleFileNameA(h: int, buf: int, n: int) -> int from "kernel32.dll"
extern func VirtualAlloc(addr: int, size: int, type: int, protect: int) -> int from "kernel32.dll"

func valloc(size: int) -> int
    return VirtualAlloc(0, size, 0x3000, 0x40)
end

var g_outH: int = 0
var g_outFile: int = 0
var g_saveMode: int = 0
var g_savePath: int = 0
var g_oBuf: int = 0
var g_oLen: int = 0

func oEnsure()
    if g_saveMode == 1
        if g_outFile == 0
            g_outFile = CreateFileA(g_savePath, 0x40000000, 0, 0, 2, 0x80, 0)
        end
    else
        if g_outH == 0
            g_outH = GetStdHandle(-11)
        end
    end
end

func oFlush()
    if g_oLen > 0
        var w: int = 0
        if g_saveMode == 1
            WriteFile(g_outFile, g_oBuf, g_oLen, w, 0)
        else
            WriteFile(g_outH, g_oBuf, g_oLen, w, 0)
        end
        g_oLen = 0
    end
end

func oApp(p: int, n: int)
    oEnsure()
    if n > 65536
        oFlush()
        var w: int = 0
        if g_saveMode == 1
            WriteFile(g_outFile, p, n, w, 0)
        else
            WriteFile(g_outH, p, n, w, 0)
        end
        return
    end
    if g_oLen + n > 65536
        oFlush()
    end
    var i: int = 0
    for i = 0, n - 1, 1
        poke8(g_oBuf + g_oLen, peek8(p + i))
        g_oLen = g_oLen + 1
    end
end

func outStr(p: int)
    var len: int = 0
    while peek8(p + len) != 0
        len = len + 1
    end
    oApp(p, len)
end

func outNL()
    oEnsure()
    poke8(g_oBuf + g_oLen, 13)
    poke8(g_oBuf + g_oLen + 1, 10)
    g_oLen = g_oLen + 2
end

