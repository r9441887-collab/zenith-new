app console

func main() -> int
    var resp: int = http_get("https://example.com")
    if resp == 0
        print("fail\n")
        return 1
    end

    var status: int = peek32(resp)
    var bodyLen: int = peek32(resp + 4)
    var body: int = resp + 8

    print("status=")
    print(status)
    print(" len=")
    print(bodyLen)
    print("\n")

    return 0
end