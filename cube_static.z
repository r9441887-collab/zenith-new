app gui dx tool

# 3D cube (static, no rotation) + diagnostics.
# Isolates: extended input layout (POSITION float3 + COLOR float4) + indexed draw.

var F1: int = 0x3F800000    # 1.0
var FN1: int = 0xBF800000   # -1.0
var F05: int = 0x3F000000   # 0.5

func vert(b: int, x: int, y: int, z: int, r: int, g: int, bl: int, a: int)
    poke32(b, x)
    poke32(b + 4, y)
    poke32(b + 8, z)
    poke32(b + 12, r)
    poke32(b + 16, g)
    poke32(b + 20, bl)
    poke32(b + 24, a)
end

func main() -> int
    createWindow(640, 480, "static cube")
    print("window ok")

    var vp: int = alloc(224)
    vert(vp + 0   * 28, FN1,  FN1,  FN1,  F1,  0,     0,     F1)
    vert(vp + 1   * 28, F1,   FN1,  FN1,  0,   F1,    0,     F1)
    vert(vp + 2   * 28, F1,   F1,   FN1,  0,   0,     F1,    F1)
    vert(vp + 3   * 28, FN1,  F1,   FN1,  F1,  F1,    0,     F1)
    vert(vp + 4   * 28, FN1,  FN1,  F1,   0,   F1,    F1,    F1)
    vert(vp + 5   * 28, F1,   FN1,  F1,   F1,  0,     F1,    F1)
    vert(vp + 6   * 28, F1,   F1,   F1,   F1,  F1,    F1,    F1)
    vert(vp + 7   * 28, FN1,  F1,   F1,   F1,  F05,   0,     F1)

    var ip: int = alloc(72)
    poke32(ip + 0  * 4, (0) | (1 << 16))
    poke32(ip + 1  * 4, (2) | (2 << 16))
    poke32(ip + 2  * 4, (3) | (0 << 16))
    poke32(ip + 3  * 4, (5) | (4 << 16))
    poke32(ip + 4  * 4, (7) | (7 << 16))
    poke32(ip + 5  * 4, (6) | (5 << 16))
    poke32(ip + 6  * 4, (0) | (3 << 16))
    poke32(ip + 7  * 4, (7) | (7 << 16))
    poke32(ip + 8  * 4, (4) | (0 << 16))
    poke32(ip + 9  * 4, (1) | (5 << 16))
    poke32(ip + 10 * 4, (6) | (6 << 16))
    poke32(ip + 11 * 4, (2) | (1 << 16))
    poke32(ip + 12 * 4, (3) | (2 << 16))
    poke32(ip + 13 * 4, (6) | (6 << 16))
    poke32(ip + 14 * 4, (7) | (3 << 16))
    poke32(ip + 15 * 4, (0) | (4 << 16))
    poke32(ip + 16 * 4, (5) | (5 << 16))
    poke32(ip + 17 * 4, (1) | (0 << 16))

    var vs: int = dxCreateVertexShader("struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float x = i.pos.x; float y = i.pos.y; float z = i.pos.z; float f = 2.0 / (z + 5.0); VOut o; o.pos = float4(x*f, y*f, 0, 1); o.col = i.col; return o; }")
    var ps: int = dxCreatePixelShader("struct VIn { float4 pos : SV_Position; float4 col : COLOR; }; float4 main(VIn i) : SV_Target { return i.col; }")
    print(vs)
    print(ps)

    var layout: int = dxCreateInputLayout("struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float x = i.pos.x; float y = i.pos.y; float z = i.pos.z; float f = 2.0 / (z + 5.0); VOut o; o.pos = float4(x*f, y*f, 0, 1); o.col = i.col; return o; }",
        "POSITION", 6, 0,
        "COLOR",    2, 12)
    print(layout)

    var vbuf: int = dxCreateBuffer(224, vp)
    var ibuf: int = dxCreateBuffer(72, ip)
    print(vbuf)
    print(ibuf)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 28)
    dxSetIndexBuffer(ibuf)
    dxSetTopology(4)

    loop
        if processMessages() == 0
            break
        end
        dxClearDepthStencil()
        dxDrawIndexed(36)
        present()
        sleep(0.016)
        if getKey(0x1B) == 1
            break
        end
    end

    closeWindow()
    return 0
end
