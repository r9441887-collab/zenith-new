app gui dx tool

# Diagnostic: write which DX11 handles are non-zero to a file
# 0='O'(79)=nonzero  1='X'(88)=zero
# buf[0]=vs buf[1]=ps buf[2]=layout buf[3]=vbuf buf[4]=vertex-shader-retry buf[5]=indexbuf

func main() -> int
    createWindow(320, 240, "DIAG")

    var buf: int = memNew(16)

    var vs: int = dxCreateVertexShader("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    if vs == 0
        memByteW(buf, 0, 88)
    else
        memByteW(buf, 0, 79)
    end

    var ps: int = dxCreatePixelShader("float4 main() : SV_Target { return float4(1, 0, 0, 1); }")
    if ps == 0
        memByteW(buf, 1, 88)
    else
        memByteW(buf, 1, 79)
    end

    var layout: int = dxCreateInputLayout("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    if layout == 0
        memByteW(buf, 2, 88)
    else
        memByteW(buf, 2, 79)
    end

    var p: int = alloc(64)
    poke32(p, 0x3F800000)
    poke32(p + 4, 0x3F800000)
    poke32(p + 8, 0xBF800000)
    poke32(p + 12, 0x3F800000)
    poke32(p + 16, 0)
    poke32(p + 20, 0xBF800000)

    var vbuf: int = dxCreateBuffer(24, p)
    if vbuf == 0
        memByteW(buf, 3, 88)
    else
        memByteW(buf, 3, 79)
    end

    var f: int = fileSave("C:\\Users\\user\\Desktop\\b\\zenith\\build\\diag.bin", buf, 6)
    var f2: int = fileExists("C:\\Users\\user\\Desktop\\b\\zenith\\build\\diag.bin")

    var running: int = 1
    while running == 1
        dxSetShaders(vs, ps)
        dxSetInputLayout(layout)
        dxSetVertexBuffer(vbuf, 8)
        dxSetTopology(4)
        dxDraw(3)
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end
    closeWindow()
    return 0
end
