# Linux target (app linux): ELF64 executable emitter + SysV runtime support.
#
# Порт src/codegen_elf.cpp (1345 строк), слой 1 плана (Linux/x86).
# Провенанс: каждая функция ниже помечена строкой откуда она перенесена.
#
# RVA model (internal, base = 0):
#   RVA(.text)  = textRVA  = 0x1000
#   RVA(.rdata) = rdataRVA = textRVA + 0x1000 = 0x2000
#   RVA(.data)  = dataRVA  = rdataRVA + 0x1000 = 0x3000
# The machine code vector `code` occupies .text; `rdata` and `data` hold the
# string pool / read-only data and writable globals / GOT respectively. All
# RIP-relative disp32 fixups emitted by the shared x86 backend are computed
# as (targetRVA - (textRVA + codePos + 4)), which stays identical under the
# base-0 ELF mapping — so resolveFixups() output is reused as-is.
#
# The actual load base is LOAD_BASE, added to every VA written into the ELF
# header / program headers (e_entry, p_vaddr, p_paddr). Modern Linux kernels
# reject ET_EXEC whose survivable LOAD starts below mmap_min_addr (0x10000);
# 0x1000-loaded binaries segfault at exec. Because every code reference is
# RIP-relative, shifting the whole image by a constant base changes ONLY the
# header VAs, never any disp32.
use cg_expr

# ---- ELF64 constants (codegen_elf.cpp:45..85) ----
const CG_EI_NIDENT = 16
const CG_ET_EXEC = 2
const CG_ET_DYN = 3
const CG_EM_X86_64 = 62
const CG_ELFCLASS64 = 2
const CG_ELFDATA2LSB = 1
const CG_EV_CURRENT = 1
const CG_ELFOSABI_SYSV = 0

const CG_PT_LOAD = 1
const CG_PT_DYNAMIC = 2
const CG_PT_INTERP = 3
const CG_PF_X = 1
const CG_PF_W = 2
const CG_PF_R = 4

const CG_DT_NULL = 0
const CG_DT_NEEDED = 1
const CG_DT_STRTAB = 5
const CG_DT_SYMTAB = 6
const CG_DT_RELA = 7
const CG_DT_RELASZ = 8
const CG_DT_RELAENT = 9
const CG_DT_STRSZ = 10
const CG_DT_HASH = 4
const CG_DT_SYMENT = 11
const CG_DT_INIT = 12

const CG_R_X86_64_64 = 1
const CG_R_X86_64_COPY = 5
const CG_R_X86_64_RELATIVE = 8
const CG_STB_GLOBAL = 1
const CG_STT_FUNC = 2
const CG_STT_OBJECT = 1

# Load base for the ELF image (conventional non-PIE text start, same as gcc).
# Must be >= mmap_min_addr (default 0x10000); use 0x400000 for safety.
# codegen.h:15 kLinuxLoadBase
const CG_LOAD_BASE = 4194304

# ===================== image buffer =====================
#
# C++ собирает заголовок в локальный std::vector<uint8_t> hdr, а секции пишет
# сразу в ofstream. Здесь всё складывается в один образ cgImg: сначала ehdr,
# потом phdrs, потом .text/.rdata/.data — и файл получается как
# последовательность байтов от начала.
var cgImg: int = 0
var cgImgCap: int = 0
var cgImgLen: int = 0

func cgImgReset()
    cgImgLen = 0
end

func cgImgEnsure(n: int)
    if cgImgLen + n <= cgImgCap
        return
    end
    var nc: int = cgImgCap * 2
    if nc < 65536
        nc = 65536
    end
    while nc < cgImgLen + n
        nc = nc * 2
    end
    var nb: int = alloc(nc)
    if nb == 0
        cgErrSet("out of memory while growing the ELF image buffer")
        return
    end
    if cgImgLen > 0
        cgCopyBytes(nb, cgImg, cgImgLen)
    end
    if cgImg != 0
        free(cgImg)
    end
    cgImg = nb
    cgImgCap = nc
end

# codegen_elf.cpp:87..96 put16/put32/put64 — семантика байтов ровно как у
# emit16/emit32/emit64 из cg_emit.z (маска + сдвиг), т.к. v может быть
# отрицательным (disp32), а в C++ там uint32_t/uint64_t.
func cgImgPut8(v: int)
    cgImgEnsure(1)
    if cgImgLen + 1 > cgImgCap
        return
    end
    poke8(cgImg + cgImgLen, v & 0xFF)
    cgImgLen = cgImgLen + 1
end

func cgImgPut16(v: int)
    cgImgEnsure(2)
    if cgImgLen + 2 > cgImgCap
        return
    end
    poke8(cgImg + cgImgLen, v & 0xFF)
    poke8(cgImg + cgImgLen + 1, (v >> 8) & 0xFF)
    cgImgLen = cgImgLen + 2
end

func cgImgPut32(v: int)
    cgImgEnsure(4)
    if cgImgLen + 4 > cgImgCap
        return
    end
    poke8(cgImg + cgImgLen, v & 0xFF)
    poke8(cgImg + cgImgLen + 1, (v >> 8) & 0xFF)
    poke8(cgImg + cgImgLen + 2, (v >> 16) & 0xFF)
    poke8(cgImg + cgImgLen + 3, (v >> 24) & 0xFF)
    cgImgLen = cgImgLen + 4
end

func cgImgPut64(v: int)
    cgImgEnsure(8)
    if cgImgLen + 8 > cgImgCap
        return
    end
    poke8(cgImg + cgImgLen, v & 0xFF)
    poke8(cgImg + cgImgLen + 1, (v >> 8) & 0xFF)
    poke8(cgImg + cgImgLen + 2, (v >> 16) & 0xFF)
    poke8(cgImg + cgImgLen + 3, (v >> 24) & 0xFF)
    poke8(cgImg + cgImgLen + 4, (v >> 32) & 0xFF)
    poke8(cgImg + cgImgLen + 5, (v >> 40) & 0xFF)
    poke8(cgImg + cgImgLen + 6, (v >> 48) & 0xFF)
    poke8(cgImg + cgImgLen + 7, (v >> 56) & 0xFF)
    cgImgLen = cgImgLen + 8
end

func cgImgAppend(src: int, n: int)
    cgImgEnsure(n)
    cgCopyBytes(cgImg + cgImgLen, src, n)
    cgImgLen = cgImgLen + n
end

func cgImgAppendFill(v: int, n: int)
    cgImgEnsure(n)
    var i: int = 0
    while i < n
        poke8(cgImg + cgImgLen + i, v)
        i = i + 1
    end
    cgImgLen = cgImgLen + n
end

# alignUp(x, a) — a степень двойки
func cgAlignUp(x: int, a: int)
    return (x + a - 1) / a * a
end

# ============================================================================
# Detect which subsystems the program uses. Mirrors detectSoundUsage etc. but
# must NOT create PE-only import state. Called after collectStrings().
# codegen_elf.cpp:107..111 — пустой placeholder, оставлен как hook.
# ============================================================================
func cgDetectLinuxNeed()
end

# ============================================================================
# computeSectionRVAs: .rdata ровно через страницу от .text, .data — через
# страницу от .rdata. Цель-агностичный шаг (в C++ лежит рядом с PE-кодом);
# для Linux его дубликата нет — вызывается один раз до сборки образа.
# codegen_pe.cpp:459..463
# ============================================================================
func cgComputeSectionRVAs()
    cgRdataRVA = cgTextRVA + 0x1000
    cgDataRVA = cgRdataRVA + 0x1000
end

# ===================== fixupSectionRVAs (codegen_pe.cpp:583..736) =====================
#
# Пересчитывает базы .rdata/.data под реальные размеры (округление до страницы)
# и сдвигает все уже запечённые RVA на разницу. Вызывается безусловно
# (codegen.cpp:8744, затем ещё раз на :8786), до resolveFixups/buildELF. На
# типичных программах дельты = 0 и функция выходит сразу.
#
# Не перенесено (на Linux всегда пусто): дескрипторы импорта
# (importDescCount / importDataSize / externFuncMap, :622..649) и встроенные
# DLL (embeddedDLLs / embeddedLEAFixups, :711..731) — их заполняет только
# PE/EFI-путь.
func cgRdDW(buf: int, off: int) -> int
    return peek8(buf + off) | (peek8(buf + off + 1) << 8) | (peek8(buf + off + 2) << 16) | (peek8(buf + off + 3) << 24)
end

func cgWrDW(buf: int, off: int, v: int)
    poke8(buf + off, v & 0xFF)
    poke8(buf + off + 1, (v >> 8) & 0xFF)
    poke8(buf + off + 2, (v >> 16) & 0xFF)
    poke8(buf + off + 3, (v >> 24) & 0xFF)
end

func cgRdDQ(buf: int, off: int) -> int
    return cgRdDW(buf, off) | (cgRdDW(buf, off + 4) << 32)
end

func cgWrDQ(buf: int, off: int, v: int)
    cgWrDW(buf, off, v & 0xFFFFFFFF)
    cgWrDW(buf, off + 4, (v >> 32) & 0xFFFFFFFF)
end

func cgFixupSectionRVAs()
    var textSize: int = cgCodeLen
    var rdataSize: int = cgRDataLen
    var dataSize: int = cgDataLen

    var alignedText: int = cgAlignUp(textSize, 4096)
    var alignedRdata: int = cgAlignUp(rdataSize, 4096)

    var newRdataRVA: int = cgTextRVA + alignedText
    var newDataRVA: int = newRdataRVA + alignedRdata

    var dRdata: int = newRdataRVA - cgRdataRVA
    var dData: int = newDataRVA - cgDataRVA

    if dRdata == 0 && dData == 0
        return
    end

    var oldRdataRVA: int = newRdataRVA - dRdata
    var oldDataRVA: int = newDataRVA - dData

    # 4. heap fixups: всегда целят в .data/.bss, но их провизорные RVA лежат в
    # хвосте .data и численно перекрывают старое окно .rdata — проверка
    # oldDataRVA обязана идти первой, иначе сдвиг пойдёт по dRdata и слот
    # уедет на страницу ниже, в RX-сегмент.
    var hi: int = 0
    while hi < cgHeapFixN
        var t: int = cgHeapFixTarget[hi]
        if t >= oldDataRVA && t <= oldDataRVA + dataSize
            cgHeapFixTarget[hi] = t + dData
        else
            if t >= oldRdataRVA && t < oldRdataRVA + rdataSize
                cgHeapFixTarget[hi] = t + dRdata
            end
        end
        hi = hi + 1
    end

    # 4b. user global fixups (глобалы живут в .data; встроенные строки
    # бэкендов, вроде wlXdgRVA — в .rdata)
    var gi: int = 0
    while gi < cgGlobalFixN
        var gt: int = cgGlobalFixRva[gi]
        if gt >= oldRdataRVA && gt < oldRdataRVA + rdataSize
            cgGlobalFixRva[gi] = gt + dRdata
        else
            if gt >= oldDataRVA && gt <= oldDataRVA + dataSize
                cgGlobalFixRva[gi] = gt + dData
            end
        end
        gi = gi + 1
    end
    if cgGlobalsSize > 0
        cgGlobalsRVA = cgGlobalsRVA + dData
    end

    # 5. scalar RVAs
    cgStringRVA = cgStringRVA + dRdata
    if cgH(H_APPTYPE) == 1
        cgClassNameRVA = cgClassNameRVA + dRdata
        cgFontRVA = cgFontRVA + dRdata
    end
    if cgH(H_APPTYPE) == 2
        cgFontCyrRVA = cgFontCyrRVA + dRdata
    end
    cgHeapOffsetRVA = cgHeapOffsetRVA + dData
    cgHeapFreeHeadRVA = cgHeapFreeHeadRVA + dData
    cgHeapAreaRVA = cgHeapAreaRVA + dData
    cgRandSeedRVA = cgRandSeedRVA + dData
    cgNetStatusRVA = cgNetStatusRVA + dData
    cgNetStatusLenRVA = cgNetStatusLenRVA + dData
    cgNetBytesReadRVA = cgNetBytesReadRVA + dData
    cgNetLenRVA = cgNetLenRVA + dData
    cgNetErrRVA = cgNetErrRVA + dData
    cgNetHdrLenRVA = cgNetHdrLenRVA + dData
    cgSockWsaStartedRVA = cgSockWsaStartedRVA + dData
    cgSockWsadataRVA = cgSockWsadataRVA + dData
    cgSockPeerRVA = cgSockPeerRVA + dData
    cgSockPeerLenRVA = cgSockPeerLenRVA + dData
    cgSoundOpenedRVA = cgSoundOpenedRVA + dData
    cgSoundHwoRVA = cgSoundHwoRVA + dData
    cgSoundFmtRVA = cgSoundFmtRVA + dData
    cgSoundBpfRVA = cgSoundBpfRVA + dData
    cgSoundHdrRVA = cgSoundHdrRVA + dData
    cgSoundSeedRVA = cgSoundSeedRVA + dData
    cgSoundLutRVA = cgSoundLutRVA + dData
    if cgH(H_APPTYPE) == 1 || cgH(H_APPTYPE) == 2
        cgWin32GlobalsRVA = cgWin32GlobalsRVA + dData
    end

    # 5b. embedded DLL RVAs (на Linux всегда 0, но C++ двигает безусловно)
    cgEmbeddedFullPathRVA = cgEmbeddedFullPathRVA + dData
    cgEmbeddedHFileRVA = cgEmbeddedHFileRVA + dData
    cgEmbeddedHModuleRVA = cgEmbeddedHModuleRVA + dData
    cgEmbeddedWrittenRVA = cgEmbeddedWrittenRVA + dData

    # 5c. embeddedLEAFixups (:723..731) — на Linux пусто, см. шапку.

    # 6. Update section RVAs
    cgRdataRVA = newRdataRVA
    cgDataRVA = newDataRVA
end

# ============================================================================
# Пул строк: ZAST-строки (cgStrPoolId[i] >= 0) и «сырые» .z-литералы
# (cgStrPoolId[i] < 0, байты лежат по cgStrPoolRaw[i]) — оба варианта
# разрешаются в NUL-терминированный указатель.
# ============================================================================
func cgPoolPtr(i: int) -> int
    if cgStrPoolId[i] < 0
        return cgStrPoolRaw[i]
    end
    return cgStrPtr(cgStrPoolId[i])
end

func cgPoolLen(i: int) -> int
    if cgStrPoolId[i] < 0
        return cgLitLen(cgStrPoolRaw[i])
    end
    return cgStrLen(cgStrPoolId[i])
end

# addRdataStr lambda (codegen_elf.cpp:225..230): RVA до записи, затем
# байты + NUL. s — NUL-терминированный указатель на литерал.
func cgAddRdataStr(s: int) -> int
    var rva: int = cgRdataRVA + cgRDataLen
    var p: int = s
    while peek8(p) != 0
        cgRDataPush(peek8(p))
        p = p + 1
    end
    cgRDataPush(0)
    return rva
end

# putAbsPtr (codegen_elf.cpp:407..417): абсолютный VA = LOAD_BASE + strRVA,
# little-endian 8 байт в .data.
func cgPutAbsPtr(base: int, pos: int, strRVA: int)
    var va: int = CG_LOAD_BASE + strRVA
    var k: int = 0
    while k < 8
        poke8(cgData + base + pos + k, (va >> (k * 8)) & 0xFF)
        k = k + 1
    end
end

# ============================================================================
# buildLinuxImportData (codegen_elf.cpp:120..509): собирает .rdata/.data
# ровно как хвост buildImportData() (пул строк, class name, heap, слоты
# net/sound/tls/js, vk/wl-состояние, глобалы), но без PE-дескрипторов
# импорта. Тот же RVA-контур, поэтому общий fixup-патчинг buildELF работает
# без изменений.
#
# Не перенесено (мёртвое в Linux-пути): writeDQ (:124) и hasNl (:129) —
# объявлены в C++ и нигде не читаются.
# ============================================================================
func cgBuildLinuxImportData()
    cgRDataLen = 0
    cgDataLen = 0
    cgStringOffsetsN = 0

    # ---- String pool — pool-relative offsets (:132..140) ----
    var poolStart: int = cgRDataLen
    cgStringRVA = cgRdataRVA + poolStart
    var i: int = 0
    while i < cgStrPoolN
        cgStringOffsets[cgStringOffsetsN] = cgRDataLen - poolStart
        cgStringOffsetsN = cgStringOffsetsN + 1
        var q: int = cgPoolPtr(i)
        var n: int = cgPoolLen(i)
        var k: int = 0
        while k < n
            cgRDataPush(peek8(q + k))
            k = k + 1
        end
        cgRDataPush(0)
        i = i + 1
    end
    while cgRDataLen % 16 != 0
        cgRDataPush(0)
    end

    # ---- GUI class name (:142..148) ----
    if cgH(H_APPTYPE) == 1
        cgClassNameRVA = cgRdataRVA + cgRDataLen
        cgAddRdataStr("ZenithWnd")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end
    end

    # ---- Re-space .data from the real .rdata size (:150..160) ----
    # computeSectionRVAs() кладёт .data ровно на страницу выше .rdata; пул
    # строк больше страницы заставил бы окна fixupSectionRVAs() накладываться,
    # и фикстапы первых глобалов уезжали бы на страницу ниже — в RX-сегмент.
    var spacedDataRVA: int = cgAlignUp(cgRdataRVA + cgRDataLen, 4096)
    if cgDataRVA < spacedDataRVA
        cgDataRVA = spacedDataRVA
    end

    # ---- Heap offset + free-list head + rand seed (:162..168) ----
    cgHeapOffsetRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)
    cgHeapFreeHeadRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)
    cgRandSeedRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)

    # ---- Socket / sound / tls / js slot state (:170..217) ----
    if cgNetSocksUsed != 0
        cgSockWsaStartedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSockWsadataRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 416)
        cgSockPeerRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16)
        cgSockPeerLenRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        # Linux net: last-error slot + peer IP buffer (PE пользуется wininet/wsa;
        # эти два слота есть только в codegen_net_linux.cpp).
        cgLinNetErrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgLinNetIpBufRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16)
    end
    if cgSoundUsed != 0
        cgSoundOpenedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundHwoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundFmtRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 24)
        cgSoundBpfRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundHdrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 56)
        cgSoundSeedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundLutRVA = cgDataRVA + cgDataLen
        # std::lround(sin(2*pi*i/512) * 32767) — half-away-from-zero.
        var si: int = 0
        while si < 512
            var v: float = sin(2.0 * 3.14159265358979323846 * itof(si) / 512.0)
            var x: float = v * 32767.0
            var r: float = 0.0
            if x >= 0.0
                r = floor(x + 0.5)
            else
                r = ceil(x - 0.5)
            end
            var s: int = r
            cgDataPush(s & 0xFF)
            cgDataPush((s >> 8) & 0xFF)
            si = si + 1
        end
    end
    if cgTlsUsed != 0
        cgTlsIoDoneRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
    end
    if cgJsUsed != 0
        cgJsResultRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
        cgJsErrorRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
    end

    # ---- Linux Vulkan (:219..252) ----
    if cgVkUsed != 0
        cgVkZenithStrRVA = cgAddRdataStr("Zenith")
        cgVkDestroyStrRVA = cgAddRdataStr("vkDestroyInstance")
        cgVkEnumPhyStrRVA = cgAddRdataStr("vkEnumeratePhysicalDevices")
        cgVkPhyPropsStrRVA = cgAddRdataStr("vkGetPhysicalDeviceProperties")
        cgVkDevProcStrRVA = cgAddRdataStr("vkGetDeviceProcAddr")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end
        cgVkInstRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkAppInfoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 48)
        cgVkInstInfoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 64)
        cgVkFnTableRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 48)
        cgVkCountRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkPhyBufRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
        cgVkPropsRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 2048)
    end

    # ---- Linux Wayland (:254..334) ----
    # Сырые syscall'ы (codegen_wl_linux.cpp) — путь display-сокета приходит из
    # envp; emitLinuxEntryPoint кладёт envp в cgWlEnvRVA сразу на старте.
    if cgWlUsed != 0
        cgWlXdgRVA = cgAddRdataStr("XDG_RUNTIME_DIR=")
        cgWlSfxRVA = cgAddRdataStr("/wayland-0")
        cgWlColonRVA = cgAddRdataStr(":")
        cgWlNlRVA = cgAddRdataStr("\n")
        # Window builtins (codegen_wl_window.cpp): interface-строки сверяются
        # с анонсами registry.global и уходят как есть в bind/app_id.
        cgWlCompositorStrRVA = cgAddRdataStr("wl_compositor")
        cgWlXdgWmBaseStrRVA = cgAddRdataStr("xdg_wm_base")
        cgWlShmStrRVA = cgAddRdataStr("wl_shm")
        cgWlMemfdNameRVA = cgAddRdataStr("z-wl-fb")
        cgWlAppIdRVA = cgAddRdataStr("zenith-app")

        # Two-way init handshake — статичный блоб на 24 байта. Проводной
        # заголовок 8 байт: u32 object id | u16 opcode | u16 size (с заголовком),
        # у запроса с одним new_id размер запроса = 12:
        #   wl_display.get_registry(new_id=2): id=1 opcode=1 size=12 + uint(2)
        #   wl_display.sync(new_id=3):         id=1 opcode=0 size=12 + uint(3)
        cgWlInitReqRVA = cgRdataRVA + cgRDataLen
        var initReq: [24]int
        initReq[0] = 0x01
        initReq[1] = 0x00
        initReq[2] = 0x00
        initReq[3] = 0x00
        initReq[4] = 0x01
        initReq[5] = 0x00
        initReq[6] = 0x0c
        initReq[7] = 0x00
        initReq[8] = 0x02
        initReq[9] = 0x00
        initReq[10] = 0x00
        initReq[11] = 0x00
        initReq[12] = 0x01
        initReq[13] = 0x00
        initReq[14] = 0x00
        initReq[15] = 0x00
        initReq[16] = 0x00
        initReq[17] = 0x00
        initReq[18] = 0x0c
        initReq[19] = 0x00
        initReq[20] = 0x03
        initReq[21] = 0x00
        initReq[22] = 0x00
        initReq[23] = 0x00
        var ik: int = 0
        while ik < 24
            cgRDataPush(initReq[ik])
            ik = ik + 1
        end

        cgWlEnvRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlFdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlPathRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 128)
        cgWlInRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4096)
        cgWlTmpRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 32)

        # Window / shm-framebuffer state (codegen_wl_window.cpp).
        cgWlWNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlXdgNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlShmNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlSurfIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlXdgIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlTopIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlShmIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlPoolIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlBufIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlFbPtrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlBufFdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlWinWRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlWinHRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlConfiguredRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlClosedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlOutRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 256)
    end

    # ---- Linux Vulkan WSI surface (:336..465) ----
    # Wayland client + surface/swapchain state, собран на libwayland-client.so.0
    # (импорты) + libvulkan (слоты vk_*).
    if cgVkSurfaceUsed != 0
        cgVkSurfaceKHRStrRVA = cgAddRdataStr("VK_KHR_surface")
        cgVkWaylandSurfaceStrRVA = cgAddRdataStr("VK_KHR_wayland_surface")
        cgVkSwapchainStrRVA = cgAddRdataStr("VK_KHR_swapchain")
        cgVkCreateSurfaceStrRVA = cgAddRdataStr("vkCreateWaylandSurfaceKHR")
        cgVkDestroySurfStrRVA = cgAddRdataStr("vkDestroySurfaceKHR")
        cgVkDestroyDeviceStrRVA = cgAddRdataStr("vkDestroyDevice")
        cgVkSurfaceProcsStrRVA[0] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceCapabilitiesKHR")
        cgVkSurfaceProcsStrRVA[1] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceFormatsKHR")
        cgVkSurfaceProcsStrRVA[2] = cgAddRdataStr("vkGetPhysicalDeviceSurfacePresentModesKHR")
        cgVkSurfaceProcsStrRVA[3] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceSupportKHR")
        cgVkSurfaceProcsStrRVA[4] = cgAddRdataStr("vkCreateSwapchainKHR")
        cgVkSurfaceProcsStrRVA[5] = cgAddRdataStr("vkGetSwapchainImagesKHR")
        cgVkSurfaceProcsStrRVA[6] = cgAddRdataStr("vkDestroySwapchainKHR")
        cgVkSurfaceProcsStrRVA[7] = cgAddRdataStr("vkCreateImageView")
        cgVkSurfaceProcsStrRVA[8] = cgAddRdataStr("vkCreateFramebuffer")
        cgVkSurfaceProcsStrRVA[9] = cgAddRdataStr("vkCreateRenderPass")
        cgVkSurfaceProcsStrRVA[10] = cgAddRdataStr("vkCreateGraphicsPipelines")
        cgVkSurfaceProcsStrRVA[11] = cgAddRdataStr("vkCreatePipelineLayout")
        cgVkSurfaceProcsStrRVA[12] = cgAddRdataStr("vkCreateCommandPool")
        cgVkSurfaceProcsStrRVA[13] = cgAddRdataStr("vkAllocateCommandBuffers")
        cgVkSurfaceProcsStrRVA[14] = cgAddRdataStr("vkBeginCommandBuffer")
        cgVkSurfaceProcsStrRVA[15] = cgAddRdataStr("vkCmdBeginRenderPass")
        cgVkSurfaceProcsStrRVA[16] = cgAddRdataStr("vkCmdBindPipeline")
        cgVkSurfaceProcsStrRVA[17] = cgAddRdataStr("vkCmdDraw")
        cgVkSurfaceProcsStrRVA[18] = cgAddRdataStr("vkCmdEndRenderPass")
        cgVkSurfaceProcsStrRVA[19] = cgAddRdataStr("vkEndCommandBuffer")
        cgVkSurfaceProcsStrRVA[20] = cgAddRdataStr("vkAcquireNextImageKHR")
        cgVkSurfaceProcsStrRVA[21] = cgAddRdataStr("vkWaitForFences")
        cgVkSurfaceProcsStrRVA[22] = cgAddRdataStr("vkResetFences")
        cgVkSurfaceProcsStrRVA[23] = cgAddRdataStr("vkQueueSubmit")
        cgVkSurfaceProcsStrRVA[24] = cgAddRdataStr("vkQueuePresentKHR")
        cgVkSurfaceProcsStrRVA[25] = cgAddRdataStr("vkQueueWaitIdle")
        cgVkSurfaceProcsStrRVA[26] = cgAddRdataStr("vkDeviceWaitIdle")
        cgVkSurfaceProcsStrRVA[27] = cgAddRdataStr("vkCreateSemaphore")
        cgVkSurfaceProcsStrRVA[28] = cgAddRdataStr("vkGetDeviceQueue")
        cgVkSurfaceProcsStrRVA[29] = cgAddRdataStr("vkCreateBuffer")
        cgVkSurfaceProcsStrRVA[30] = cgAddRdataStr("vkGetBufferMemoryRequirements")
        cgVkSurfaceProcsStrRVA[31] = cgAddRdataStr("vkAllocateMemory")
        cgVkSurfaceProcsStrRVA[32] = cgAddRdataStr("vkBindBufferMemory")
        cgVkSurfaceProcsStrRVA[33] = cgAddRdataStr("vkMapMemory")
        cgVkSurfaceProcsStrRVA[34] = cgAddRdataStr("vkUnmapMemory")
        cgVkSurfaceProcsStrRVA[35] = cgAddRdataStr("vkGetPhysicalDeviceMemoryProperties")
        cgVkSurfaceProcsStrRVA[36] = cgAddRdataStr("vkCmdSetViewport")
        cgVkSurfaceProcsStrRVA[37] = cgAddRdataStr("vkCmdSetScissor")
        cgVkSurfaceProcsStrRVA[38] = cgAddRdataStr("vkCmdBindVertexBuffers")
        cgVkSurfaceProcsStrRVA[39] = cgAddRdataStr("vkCreateShaderModule")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end

        # Массив extension-указателей: два абсолютных указателя внутрь .rdata —
        # vk_instance_create включает surface + wayland surface, давая
        # ppEnabledExtensionNames на эту 2*8B ячейку.
        var vkSfcExtArrayPos: int = cgDataLen
        cgDataFill(0, 16)
        cgVkExtArrayRVA = cgDataRVA + vkSfcExtArrayPos
        # Абсолютные VA запекаются сразу (ET_EXEC грузится на LOAD_BASE, RVA
        # строк на момент buildLinuxImportData уже финальны).
        cgPutAbsPtr(vkSfcExtArrayPos, 0, cgVkSurfaceKHRStrRVA)
        cgPutAbsPtr(vkSfcExtArrayPos, 8, cgVkWaylandSurfaceStrRVA)

        # Wayland client state.
        cgWlSfcDisplayRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcRegistryRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcCompositorRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcSurfaceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        # Vulkan surface/device state.
        cgVkSfcSurfaceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcGpuRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcQueueFamilyRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcDeviceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcQueueRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcSwapchainRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcFormatRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcExtentRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcImageCountRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcRenderPassRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcPipeRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcFrameImageRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcFrameCBRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        # Device-level fn table (16 слотов), держатели image view/framebuffer и
        # scratch arena.
        cgVkSfcDevTableRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16 * 8)
        cgVkSfcScratchRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4096)
    end

    # ---- Heap area -> .bss (:467..468) ----
    # zero-init; buildELF расширяет RW-сегмент.
    cgHeapAreaRVA = cgDataRVA + cgDataLen

    # ---- User global variables (:470..498) ----
    # C++ ходит по prog.globals (имя/тип/arraySize) и строит globalOffsets;
    # здесь список глобалов — side-список H_GLOBALS, ключ — ZAST strId.
    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    if gl > 0
        cgGoN = 0
        var total: int = 0
        var gi: int = 0
        while gi < gl
            var gid: int = cgSide(gs + gi)
            var fsz: int = 8
            var tp: int = cgFAddr(gid, 1)
            var arr: int = cgF(gid, 8)
            if arr > 0
                fsz = cgArrayElemStride(tp) * arr
            else
                if cgTk(tp) == TK_STRUCT
                    var it: int = cgSlFind(cgTStruct(tp))
                    if it >= 0
                        fsz = cgSlSize[it]
                    end
                else
                    if cgTk(tp) == TK_BOOL || cgTk(tp) == TK_FLOAT
                        fsz = 4
                    else
                        if cgTk(tp) == TK_VEC2
                            fsz = 8
                        else
                            if cgTk(tp) == TK_VEC3
                                fsz = 12
                            else
                                if cgTk(tp) == TK_COLOR
                                    fsz = 16
                                end
                            end
                        end
                    end
                end
            end
            if fsz % 8 != 0
                fsz = fsz + 8 - (fsz % 8)
            end
            if cgGoN < 8192
                cgGoName[cgGoN] = cgF(gid, 0)
                cgGoOff[cgGoN] = total
                cgGoN = cgGoN + 1
            end
            total = total + fsz
            gi = gi + 1
        end
        cgGlobalsSize = total
        cgGlobalsRVA = cgDataRVA + cgDataLen
        cgDataFill(0, cgGlobalsSize)
    end

    # ---- Resolve heap-slot fixups (:500..505) ----
    var hi: int = 0
    while hi < cgHeapFixN
        if cgHeapFixTarget[hi] == 0xFFFFFF00
            cgHeapFixTarget[hi] = cgHeapAreaRVA
        else
            if cgHeapFixTarget[hi] == 0xFFFFFE00
                cgHeapFixTarget[hi] = cgHeapFreeHeadRVA
            else
                if cgHeapFixTarget[hi] == 0xFFFFFD00
                    cgHeapFixTarget[hi] = cgHeapOffsetRVA
                end
            end
        end
        hi = hi + 1
    end

    # ---- SPIR-V shader records -> .rdata (:507..508) ----
    # codegen_shader.cpp в .z не перенесён: собственные шейдеры в тестах не
    # используются, поэтому здесь заглушка (пусто, как и в C++ без шейдеров).
    cgEmitShaderModules()
end

# codegen_elf.cpp:507 -> Codegen::emitShaderModules() (codegen_shader.cpp).
# Пока не перенесён: .z-программы с собственными шейдерами не поддерживаются.
func cgEmitShaderModules()
end

# ===================== emitLinux* (codegen_elf.cpp:518..630) =====================

# emitMixCrt0Call (mix.cpp:1453). mixCtx is a `--cxx` driver construct with no
# selfhost equivalent, so `hasAny` never turns on here — kept as a hook so the
# four call sites (entry/libInit/PE entry) stay byte-for-byte transcribable.
var cgMixHasAny: int = 0

func cgEmitMixCrt0Call()
    if cgMixHasAny == 0
        return
    end
    if cgKoDriverFlag != 0
        return
    end
    emit8(0xE8)
    cgPushCallFix(cgCodeLen, cgStrSynth("$mixcrt0"))
    emit32(0)
end

# emitStartupRelocator (codegen_elf.cpp:625). On Linux the GOT slots for OS
# imports are resolved eagerly by the dynamic linker before _start runs
# (buildELF's PT_INTERP/PT_DYNAMIC/.rela), so there is nothing to do — kept as
# a hook for uniformity across targets, exactly as in C++.
func cgEmitStartupRelocator()
    if cgElfImpN == 0
        return
    end
end

func cgEmitLinuxExitSyscall()
    emit8(0xB8)
    emit32(231)
    emit8(0x31)
    emit8(0xFF)
    emit8(0x0F)
    emit8(0x05)
end

# emitLinuxExitViaLibc (codegen_elf.cpp:593) — returns 1 when it emitted the
# libc path. The raw exit_group above discards whatever libc has buffered, so
# a dynamically linked image routes the exit through libc's atexit/stdio
# flushing instead; a statically linked one (no imports) keeps the raw syscall
# and would otherwise pay a DT_NEEDED just to exit. rdi already holds the code.
func cgEmitLinuxExitViaLibc() -> int
    if cgElfImpN == 0
        return 0
    end
    emit8(0xFF)
    emit8(0x15)
    var ex: int = cgStrSynth("exit")
    cgPushElfImport(cgCodeLen, ex, cgLinuxSonameFor(ex))
    emit32(0)
    emit8(0xEB)
    emit8(0xFE)
    return 1
end

# emitLinuxLibInit (codegen_elf.cpp:610) — the DT_INIT target of an ET_DYN
# shared library: the global initializers + $mixcrt0, then straight back to
# the caller (dlopen's init loop). Minus _exit, which is _start's job.
func cgEmitLinuxLibInit()
    cgEntryPointCodeOffset = cgCodeLen
    cgEmitGlobalInit()
    cgEmitMixCrt0Call()
    emit8(0xC3)
end

# emitLinuxEntryPoint (codegen_elf.cpp:518) — the ELF `_start`. Emitted at the
# end of .text after every function, so it only forward-calls into
# already-emitted code. rsp is 16-aligned at process entry, which is exactly
# what SysV wants immediately before `call`, so nothing is padded.
func cgEmitLinuxEntryPoint()
    cgEntryPointCodeOffset = cgCodeLen

    # stash envp (envp = rsp + 8*(argc+2); argc at [rsp]) for the Wayland
    # backend, which resolves $XDG_RUNTIME_DIR itself, with no libc getenv.
    if cgWlUsed != 0
        emit8(0x48)
        emit8(0x8B)
        emit8(0x04)
        emit8(0x24)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x8C)
        emit8(0xC4)
        emit8(0x10)
        emit8(0x00)
        emit8(0x00)
        emit8(0x00)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x15)
        cgPushGlobalFix(cgCodeLen, cgWlEnvRVA)
        emit32(0)
        emit8(0x48)
        emit8(0x89)
        emit8(0x0A)
    end

    cgEmitStartupRelocator()

    # prefer 'main', else the first non-extern function (codegen.cpp:546)
    var entry: int = 0
    var i: int = 0
    while i < cgFoN
        if cgStrEqId(cgFoName[i], "main") == 1
            entry = cgFoName[i]
        end
        i = i + 1
    end
    if entry == 0
        var fs: int = cgH(H_FUNCS)
        var fl: int = cgH(H_FUNCS + 1)
        var j: int = 0
        var done: int = 0
        while j < fl && done == 0
            var fid: int = cgSide(fs + j)
            if fid != 0
                if cgTag(fid) == N_FUNC
                    if cgF(fid, 11) == 0
                        entry = cgF(fid, 0)
                        done = 1
                    end
                end
            end
            j = j + 1
        end
    end

    cgEmitGlobalInit()

    if entry != 0
        cgEmitMixCrt0Call()
        emit8(0xE8)
        cgPushCallFix(cgCodeLen, entry)
        emit32(0)
    end

    # exit status is always 0 here; set rdi before either path, since
    # cgEmitLinuxExitViaLibc() reads it.
    emit8(0x31)
    emit8(0xFF)
    if cgEmitLinuxExitViaLibc() == 0
        emit8(0xB8)
        emit32(231)
        emit8(0x0F)
        emit8(0x05)
    end
    emit8(0xF4)
    emit8(0xEB)
    emit8(0xFE)
end

# Готовый образ: C++ resize(x, 0)/append — только вверх. Отрицательная дельта
# (.z) сжала бы буфер, поэтому лениво отрезаем только когда место не занято.
func cgImgPadTo(target: int)
    if cgImgLen < target
        cgImgAppendFill(0, target - cgImgLen)
    end
end

func cgImgAppendStr(s: int)
    var i: int = 0
    while peek8(s + i) != 0
        cgImgPut8(peek8(s + i))
        i = i + 1
    end
end

# ===================== checkFixupOverlaps =====================
#
# codegen_pe.cpp:350..392. Диагностика: два списка фикстур не должны
# адресовать один и тот же disp32-слот — иначе поле записалось бы дважды.
# На байты не влияет; в C++ это std::cerr + throw, здесь — cgErrSet.
#
# Слияние ключей вида (codePos << 4) | listId: сортировка по нему группирует
# одинаковые codePos (порядок listId внутри группы C++ не гарантирует, он на
# исход не влияет). Списки sock/tls/sound/efiStr придут вместе со своими
# эмиттерами (codegen_net/tls/sound/PE) — здесь они пустые и не перечислены.
const CG_OV_LISTS: int = 10
var cgOvItem: [65536]int
var cgOvN: int = 0

func cgOvListN(id: int) -> int
    if id == 0
        return cgCallFixN
    else if id == 1
        return cgFuncRefN
    else if id == 2
        return cgFixN
    else if id == 3
        return cgStrFixN
    else if id == 4
        return cgImpCallN
    else if id == 5
        return cgHeapFixN
    else if id == 6
        return cgGlobalFixN
    else if id == 7
        return cgNetFixN
    else if id == 8
        return cgElfImpN
    end
    return cgJsFixN
end

func cgOvListPos(id: int, i: int) -> int
    if id == 0
        return cgCallFixPos[i]
    else if id == 1
        return cgFuncRefPos[i]
    else if id == 2
        return cgFixPos[i]
    else if id == 3
        return cgStrFixPos[i]
    else if id == 4
        return cgImpCallPos[i]
    else if id == 5
        return cgHeapFixPos[i]
    else if id == 6
        return cgGlobalFixPos[i]
    else if id == 7
        return cgNetFixPos[i]
    else if id == 8
        return cgElfImpPos[i]
    end
    return cgJsFixPos[i]
end

func cgCheckFixupOverlaps()
    cgOvN = 0
    var L: int = 0
    while L < CG_OV_LISTS
        var n: int = cgOvListN(L)
        var i: int = 0
        while i < n
            if cgOvN < 65536
                cgOvItem[cgOvN] = cgOvListPos(L, i) * 16 + L
                cgOvN = cgOvN + 1
            end
            i = i + 1
        end
        L = L + 1
    end
    # shell sort по (codePos << 4 | listId)
    var gap: int = cgOvN / 2
    while gap > 0
        var i2: int = gap
        while i2 < cgOvN
            var v: int = cgOvItem[i2]
            var j: int = i2
            var done: int = 0
            while j >= gap && done == 0
                if cgOvItem[j - gap] > v
                    cgOvItem[j] = cgOvItem[j - gap]
                    j = j - gap
                else
                    done = 1
                end
            end
            cgOvItem[j] = v
            i2 = i2 + 1
        end
        gap = gap / 2
    end
    var bad: int = 0
    var k: int = 1
    while k < cgOvN
        if cgOvItem[k] / 16 == cgOvItem[k - 1] / 16
            if bad == 0
                cgErrSet("overlapping fixups in ELF: disp32 would be written twice")
            end
            bad = bad + 1
        end
        k = k + 1
    end
end

# ===================== buildELF =====================
#
# codegen_elf.cpp:631..1017 — сборка ET_EXEC. Отличие от C++: параметра
# path нет, файл целиком ложится в буфер cgImg[0..cgImgLen] (запись на диск —
# забота драйвера), и .dynstr/.dynsym/.rela/.hash строятся в одном временным
# буфере cgElTmp, потому что .z не умеет передавать массивы в функции.
# mixDynCells/copyRelocs в selfhost-версии пусты: mixCtx — конструкция
# `--cxx`-драйвера (см. cgEmitMixCrt0Call), а copyRelocs порождает только
# эта же смесь, поэтому их ветки здесь нулевые и помечены комментарием.
var cgElTmp: int = 0
var cgElTmpCap: int = 0
var cgElW: int = 0
var cgElDynStrStart: int = 0
var cgElDynStrLen: int = 0
var cgElDynSymStart: int = 0
var cgElDynSymLen: int = 0
var cgElRelaStart: int = 0
var cgElRelaLen: int = 0
var cgElHashStart: int = 0
var cgElHashLen: int = 0

# gotRelocs: symbol/soname — ZAST strId, slotRVA — RVA слота в .data
var cgGotN: int = 0
var cgGotSym: [8192]int
var cgGotSoname: [8192]int
var cgGotSlot: [8192]int

# dynstr-индексы: sonames/symbols сохраняют порядок первого появления
# (std::vector + std::find в C++), strOff/symIdx — это std::map/std::unordered_map
# в C++, но их читают ТОЛЬКО по ключу, поэтому достаточно линейного поиска.
var cgElSonN: int = 0
var cgElSon: [1024]int
var cgElSymN: int = 0
var cgElSym: [4096]int
var cgElOffKeyN: int = 0
var cgElOffKey: [4096]int
var cgElOffVal: [4096]int
var cgElIdxKeyN: int = 0
var cgElIdxKey: [4096]int
var cgElIdxVal: [4096]int

func cgElEnsure(n: int)
    if cgElW + n <= cgElTmpCap
        return
    end
    var nc: int = cgElTmpCap * 2
    if nc < 65536
        nc = 65536
    end
    while nc < cgElW + n
        nc = nc * 2
    end
    var nb: int = alloc(nc)
    if nb == 0
        cgErrSet("out of memory while growing the ELF dynamic buffer")
        return
    end
    if cgElW > 0
        cgCopyBytes(nb, cgElTmp, cgElW)
    end
    if cgElTmp != 0
        free(cgElTmp)
    end
    cgElTmp = nb
    cgElTmpCap = nc
end

func cgElPut8(v: int)
    cgElEnsure(1)
    if cgElW + 1 > cgElTmpCap
        return
    end
    poke8(cgElTmp + cgElW, v & 0xFF)
    cgElW = cgElW + 1
end

func cgElPut16(v: int)
    cgElPut8(v)
    cgElPut8(v >> 8)
end

func cgElPut32(v: int)
    cgElPut8(v)
    cgElPut8(v >> 8)
    cgElPut8(v >> 16)
    cgElPut8(v >> 24)
end

func cgElPut64(v: int)
    var i: int = 0
    while i < 8
        cgElPut8(v >> (i * 8))
        i = i + 1
    end
end

func cgElPutStr(id: int)
    var p: int = cgStrPtr(id)
    var n: int = cgStrLen(id)
    var i: int = 0
    while i < n
        cgElPut8(peek8(p + i))
        i = i + 1
    end
end

func cgElStrOffFind(key: int) -> int
    var i: int = 0
    while i < cgElOffKeyN
        if cgStrIdsEq(cgElOffKey[i], key) == 1
            return cgElOffVal[i]
        end
        i = i + 1
    end
    return -1
end

func cgElStrOffPut(key: int, val: int)
    var i: int = 0
    while i < cgElOffKeyN
        if cgStrIdsEq(cgElOffKey[i], key) == 1
            cgElOffVal[i] = val
            return
        end
        i = i + 1
    end
    if cgElOffKeyN < 4096
        cgElOffKey[cgElOffKeyN] = key
        cgElOffVal[cgElOffKeyN] = val
        cgElOffKeyN = cgElOffKeyN + 1
    end
end

func cgElSymIdxFind(key: int) -> int
    var i: int = 0
    while i < cgElIdxKeyN
        if cgStrIdsEq(cgElIdxKey[i], key) == 1
            return cgElIdxVal[i]
        end
        i = i + 1
    end
    return -1
end

func cgElSymIdxPut(key: int, val: int)
    if cgElIdxKeyN < 4096
        cgElIdxKey[cgElIdxKeyN] = key
        cgElIdxVal[cgElIdxKeyN] = val
        cgElIdxKeyN = cgElIdxKeyN + 1
    end
end

# elf_hash(3) для .hash: 32-битная арифметика как в uint32_t-цикле C++.
func cgElfHash(id: int) -> int
    var h: int = 0
    var p: int = cgStrPtr(id)
    var n: int = cgStrLen(id)
    var i: int = 0
    while i < n
        h = ((h << 4) + (peek8(p + i) & 0xFF)) & 0xFFFFFFFF
        var g: int = h & 0xF0000000
        if g != 0
            h = (h ^ (g >> 24)) & 0xFFFFFFFF
        end
        # h &= ~g  (в .z нет ~, но h & ~g == h - (h & g))
        h = (h - (h & g)) & 0xFFFFFFFF
        i = i + 1
    end
    return h
end

func cgElfPatchDisp(at: int, target: int)
    var disp: int = target - (cgTextRVA + at + 4)
    poke8(cgCode + at, disp & 0xFF)
    poke8(cgCode + at + 1, (disp >> 8) & 0xFF)
    poke8(cgCode + at + 2, (disp >> 16) & 0xFF)
    poke8(cgCode + at + 3, (disp >> 24) & 0xFF)
end

# codegen_elf.cpp:631..1017
func cgBuildELF()
    cgCheckFixupOverlaps()
    if cgHasErr() != 0
        return
    end

    # .rdata/.data строит buildImportData (Linux-ветка = buildLinuxImportData);
    # ниже только защитный фоллбэк как в C++ (codegen_elf.cpp:643).
    if cgRDataLen == 0 && cgDataLen == 0 && cgStrPoolN != 0
        cgBuildLinuxImportData()
    end

    # ---- GOT: слот на каждый OS-импорт (:651..664) ----
    # slotRVA = dataRVA + data.size() + got.size(). В C++ `got` — отдельный
    # вектор, вставляемый в data УЖЕ после цикла, поэтому data.size() внутри
    # цикла не растёт. cgDataFill(0,8) внутри цикла как раз и есть вставка в
    # конец data — значит базу надо заморозить ДО цикла, иначе i-й слот
    # получит удвоенный прирост (dataBase + 2*i*8 вместо dataBase + i*8).
    var gotBase: int = cgDataLen
    cgGotN = 0
    var i: int = 0
    while i < cgElfImpN
        var slot: int = cgDataRVA + gotBase + cgGotN * 8
        cgGotSym[cgGotN] = cgElfImpName[i]
        cgGotSoname[cgGotN] = cgElfImpSoname[i]
        cgGotSlot[cgGotN] = slot
        cgGotN = cgGotN + 1
        cgDataFill(0, 8)
        var dispPos: int = cgElfImpPos[i]
        var disp: int = slot - (cgTextRVA + dispPos + 4)
        poke8(cgCode + dispPos, disp & 0xFF)
        poke8(cgCode + dispPos + 1, (disp >> 8) & 0xFF)
        poke8(cgCode + dispPos + 2, (disp >> 16) & 0xFF)
        poke8(cgCode + dispPos + 3, (disp >> 24) & 0xFF)
        i = i + 1
    end
    # mixDynCells (codegen_elf.cpp:666) — пусто: mixCtx есть только у `--cxx`.

    # ---- .dynstr / .dynsym / .rela / .hash (:690..810) ----
    var dynBlobSize: int = 0
    var dynArraySize: int = 0
    var interpLen: int = 28
    var dynTabOff: int = 0
    var dynstrOff: int = 0
    var dynsymOff: int = 0
    var relaOff: int = 0
    var hashOff: int = 0
    var dynTabVA: int = 0
    var dynstrVA: int = 0
    var dynsymVA: int = 0
    var relaVA: int = 0
    var hashVA: int = 0
    var dataSize: int = cgDataLen

    if cgGotN > 0
        cgElW = 0
        cgElDynStrStart = 0
        cgElOffKeyN = 0
        cgElIdxKeyN = 0
        cgElSonN = 0
        cgElSymN = 0

        # ---- .dynstr: '\0' + sonames + symbols, смещения фиксируются по
        # мере добавления (сыновья и символы перемежаются — codegen_elf.cpp:697)
        cgElPut8(0)
        var j: int = 0
        while j < cgGotN
            var son: int = cgGotSoname[j]
            var sym: int = cgGotSym[j]
            var k: int = 0
            var seen: int = 0
            while k < cgElSonN
                if cgStrIdsEq(cgElSon[k], son) == 1
                    seen = 1
                end
                k = k + 1
            end
            if seen == 0
                cgElStrOffPut(son, cgElW - cgElDynStrStart)
                if cgElSonN < 1024
                    cgElSon[cgElSonN] = son
                    cgElSonN = cgElSonN + 1
                end
                cgElPutStr(son)
                cgElPut8(0)
            end
            if cgElSymIdxFind(sym) < 0
                cgElSymIdxPut(sym, cgElSymN)
                if cgElSymN < 4096
                    cgElSym[cgElSymN] = sym
                    cgElSymN = cgElSymN + 1
                end
                cgElStrOffPut(sym, cgElW - cgElDynStrStart)
                cgElPutStr(sym)
                cgElPut8(0)
            end
            j = j + 1
        end
        cgElDynStrLen = cgElW - cgElDynStrStart

        # ---- .dynsym: нулевой вход + по одному на каждый символ (:734..760) ----
        # copyRelocs (R_X86_64_COPY) даёт здесь определённые OBJECT-записи;
        # в selfhost они пусты (их даёт только mix), так что каждый вход —
        # неопределённый STT_FUNC.
        cgElDynSymStart = cgElW
        var z: int = 0
        while z < 24
            cgElPut8(0)
            z = z + 1
        end
        var si: int = 0
        while si < cgElSymN
            var s: int = cgElSym[si]
            cgElPut32(cgElStrOffFind(s))
            cgElPut8((CG_STB_GLOBAL * 16) + CG_STT_FUNC)
            cgElPut8(0)
            cgElPut16(0)
            cgElPut64(0)
            cgElPut64(8)
            si = si + 1
        end
        cgElDynSymLen = cgElW - cgElDynSymStart

        # ---- .rela: R_X86_64_64 на каждый слот GOT (:764..770) ----
        cgElRelaStart = cgElW
        var ri: int = 0
        while ri < cgGotN
            cgElPut64(CG_LOAD_BASE + cgGotSlot[ri])
            cgElPut64(((cgElSymIdxFind(cgGotSym[ri]) + 1) * 4294967296) + CG_R_X86_64_64)
            cgElPut64(0)
            ri = ri + 1
        end
        cgElRelaLen = cgElW - cgElRelaStart

        # ---- SysV .hash: nbucket, nchain, buckets[], chains[] (:773..796) ----
        var nsym: int = cgElDynSymLen / 24
        var nbucket: int = 4
        var bucket0: int = 0
        var bucket1: int = 0
        var bucket2: int = 0
        var bucket3: int = 0
        var chain: [4096]int
        var ci: int = 1
        while ci < nsym
            var b: int = cgElfHash(cgElSym[ci - 1]) % nbucket
            var prev: int = 0
            if b == 0
                prev = bucket0
                bucket0 = ci
            else if b == 1
                prev = bucket1
                bucket1 = ci
            else if b == 2
                prev = bucket2
                bucket2 = ci
            else if b == 3
                prev = bucket3
                bucket3 = ci
            end
            chain[ci] = prev
            ci = ci + 1
        end
        cgElHashStart = cgElW
        cgElPut32(nbucket)
        cgElPut32(nsym)
        cgElPut32(bucket0)
        cgElPut32(bucket1)
        cgElPut32(bucket2)
        cgElPut32(bucket3)
        var chi: int = 0
        while chi < nsym
            cgElPut32(chain[chi])
            chi = chi + 1
        end
        cgElHashLen = cgElW - cgElHashStart

        # ---- Layout blob'а (:799..812) ----
        dynArraySize = (cgElSonN + 9) * 16
        dynTabOff = 32                        # align8(0 + 28)
        dynstrOff = cgAlignUp(dynTabOff + dynArraySize, 8)
        dynsymOff = cgAlignUp(dynstrOff + cgElDynStrLen, 8)
        relaOff = cgAlignUp(dynsymOff + cgElDynSymLen, 8)
        hashOff = cgAlignUp(relaOff + cgElRelaLen, 8)
        dynBlobSize = hashOff + cgElHashLen

        # C++ собирает blob ДО заголовка, поэтому VAs нужны уже здесь —
        # PT_DYNAMIC ниже пишет dynTabVA.
        var baseVA: int = CG_LOAD_BASE + cgDataRVA + dataSize
        dynTabVA = baseVA + dynTabOff
        dynstrVA = baseVA + dynstrOff
        dynsymVA = baseVA + dynsymOff
        relaVA = baseVA + relaOff
        hashVA = baseVA + hashOff
    end

    # ---- heapAreaRVA -> .bss (:824..836) ----
    var rawDataEnd: int = cgDataRVA + dataSize + dynBlobSize
    var bssRVA: int = cgAlignUp(rawDataEnd, 4096)
    if cgHeapAreaRVA != bssRVA
        var delta: int = bssRVA - cgHeapAreaRVA
        var hf: int = 0
        while hf < cgHeapFixN
            if cgHeapFixTarget[hf] == cgHeapAreaRVA
                cgHeapFixTarget[hf] = cgHeapFixTarget[hf] + delta
            end
            hf = hf + 1
        end
        cgHeapAreaRVA = bssRVA
    end

    # ---- RIP-relative disp32 (:846..911) ----
    var sf: int = 0
    while sf < cgStrFixN
        var idx: int = cgStrFixIdx[sf]
        if idx >= 0 && idx < cgStringOffsetsN
            cgElfPatchDisp(cgStrFixPos[sf], cgStringRVA + cgStringOffsets[idx])
        end
        sf = sf + 1
    end
    var hh: int = 0
    while hh < cgHeapFixN
        cgElfPatchDisp(cgHeapFixPos[hh], cgHeapFixTarget[hh])
        hh = hh + 1
    end
    var gf: int = 0
    while gf < cgGlobalFixN
        cgElfPatchDisp(cgGlobalFixPos[gf], cgGlobalFixRva[gf])
        gf = gf + 1
    end
    # jsFixups — только если detectJsUsage() выставил jsUsed; в слой 1 билтины
    # js_* не портированы, поэтому список всегда пуст.
    if cgJsUsed != 0
        var jf: int = 0
        while jf < cgJsFixN
            var tgt: int = cgJsResultRVA
            if cgJsFixSlot[jf] == CG_JS_SLOT_ERROR
                tgt = cgJsErrorRVA
            end
            cgElfPatchDisp(cgJsFixPos[jf], tgt)
            jf = jf + 1
        end
    end

    # ---- File layout (:914..940) ----
    var textSize: int = cgCodeLen
    var rdataSize: int = cgRDataLen
    var bssSize: int = 64 * 1024 * 1024
    var phnum: int = 2
    if cgGotN > 0
        phnum = 4
    end
    var headerSize: int = 64 + 56 * phnum
    var textOff: int = cgAlignUp(headerSize, 4096)
    var rdataOff: int = cgAlignUp(textOff + textSize, 4096)
    var dataOff: int = cgAlignUp(rdataOff + rdataSize, 4096)
    var dynOff: int = dataOff + dataSize
    var bssVA: int = cgAlignUp(cgDataRVA + dataSize + dynBlobSize, 4096)
    var codeEndVA: int = cgAlignUp(cgRdataRVA + rdataSize, 4096)

    # ---- ELF header (:943..966) ----
    cgImgReset()
    cgImgPut8(0x7F)
    cgImgPut8(0x45)
    cgImgPut8(0x4C)
    cgImgPut8(0x46)
    cgImgPut8(CG_ELFCLASS64)
    cgImgPut8(CG_ELFDATA2LSB)
    cgImgPut8(CG_EV_CURRENT)
    cgImgPut8(CG_ELFOSABI_SYSV)
    var pad: int = 8
    while pad < CG_EI_NIDENT
        cgImgPut8(0)
        pad = pad + 1
    end
    cgImgPut16(CG_ET_EXEC)
    cgImgPut16(CG_EM_X86_64)
    cgImgPut32(1)
    cgImgPut64(CG_LOAD_BASE + cgTextRVA + cgEntryPointCodeOffset)
    cgImgPut64(64)
    cgImgPut64(0)
    cgImgPut32(0)
    cgImgPut16(64)
    cgImgPut16(56)
    cgImgPut16(phnum)
    cgImgPut16(0)
    cgImgPut16(0)
    cgImgPut16(0)

    # ---- PT_LOAD 1: RX, файловый сдвиг 0 (:969..985) ----
    # js/tls/disasm/httpdl пишут в .text运行时, поэтому сегмент RWX —
    # та же правило, что у PE (Characteristics 0xE0000020 при jsUsed).
    cgImgPut32(CG_PT_LOAD)
    var pflags: int = CG_PF_R + CG_PF_X
    if cgJsUsed != 0 || cgTlsUsed != 0 || cgDisasmUsed != 0 || cgHttpDlUsed != 0
        pflags = CG_PF_R + CG_PF_W + CG_PF_X
    end
    cgImgPut32(pflags)
    cgImgPut64(0)
    cgImgPut64(CG_LOAD_BASE)
    cgImgPut64(CG_LOAD_BASE)
    cgImgPut64(rdataOff + rdataSize)
    cgImgPut64(codeEndVA)
    cgImgPut64(4096)

    # ---- PT_LOAD 2: RW, .data .. .bss (:988..996) ----
    cgImgPut32(CG_PT_LOAD)
    cgImgPut32(CG_PF_R + CG_PF_W)
    cgImgPut64(dataOff)
    cgImgPut64(CG_LOAD_BASE + cgDataRVA)
    cgImgPut64(CG_LOAD_BASE + cgDataRVA)
    cgImgPut64(dataSize + dynBlobSize)
    cgImgPut64((bssVA + bssSize) - cgDataRVA)
    cgImgPut64(4096)

    if cgElfImpN > 0
        # ---- PT_INTERP (:1000..1010) ----
        cgImgPut32(CG_PT_INTERP)
        cgImgPut32(CG_PF_R)
        cgImgPut64(dynOff)
        cgImgPut64(CG_LOAD_BASE + cgDataRVA + dataSize)
        cgImgPut64(CG_LOAD_BASE + cgDataRVA + dataSize)
        cgImgPut64(interpLen)
        cgImgPut64(interpLen)
        cgImgPut64(1)
        # ---- PT_DYNAMIC (:1013..1023) ----
        cgImgPut32(CG_PT_DYNAMIC)
        cgImgPut32(CG_PF_R + CG_PF_W)
        cgImgPut64(dynOff + dynTabOff)
        cgImgPut64(dynTabVA)
        cgImgPut64(dynTabVA)
        cgImgPut64(dynArraySize)
        cgImgPut64(dynArraySize)
        cgImgPut64(8)
    end

    # ---- Сборка файла (:1026..1040) ----
    cgImgPadTo(textOff)
    cgImgAppend(cgCode, textSize)
    cgImgPadTo(rdataOff)
    cgImgAppend(cgRData, rdataSize)
    cgImgPadTo(dataOff)
    cgImgAppend(cgData, dataSize)

    # ---- Dynamic blob (interp | .dynamic | .dynstr | .dynsym | .rela | hash) ----
    # VAs абсолютные (ET_EXEC грузится на LOAD_BASE); blob ложится вплотную за
    # .data, и dynOff ровно равен текущей длине образа.
    if dynBlobSize > 0
        cgImgAppendStr("/lib64/ld-linux-x86-64.so.2")
        cgImgPut8(0)
        cgImgPadTo(dynOff + dynTabOff)
        var d: int = 0
        while d < cgElSonN
            cgImgPut64(CG_DT_NEEDED)
            cgImgPut64(cgElStrOffFind(cgElSon[d]))
            d = d + 1
        end
        cgImgPut64(CG_DT_SYMTAB)
        cgImgPut64(dynsymVA)
        cgImgPut64(CG_DT_SYMENT)
        cgImgPut64(24)
        cgImgPut64(CG_DT_STRTAB)
        cgImgPut64(dynstrVA)
        cgImgPut64(CG_DT_STRSZ)
        cgImgPut64(cgElDynStrLen)
        cgImgPut64(CG_DT_RELA)
        cgImgPut64(relaVA)
        cgImgPut64(CG_DT_RELASZ)
        cgImgPut64(cgElRelaLen)
        cgImgPut64(CG_DT_RELAENT)
        cgImgPut64(24)
        cgImgPut64(CG_DT_HASH)
        cgImgPut64(hashVA)
        cgImgPut64(CG_DT_NULL)
        cgImgPut64(0)

        cgImgPadTo(dynOff + dynstrOff)
        cgImgAppend(cgElTmp + cgElDynStrStart, cgElDynStrLen)
        cgImgPadTo(dynOff + dynsymOff)
        cgImgAppend(cgElTmp + cgElDynSymStart, cgElDynSymLen)
        cgImgPadTo(dynOff + relaOff)
        cgImgAppend(cgElTmp + cgElRelaStart, cgElRelaLen)
        cgImgPadTo(dynOff + hashOff)
        cgImgAppend(cgElTmp + cgElHashStart, cgElHashLen)
    end

    cgImgAppend("Zenith", 6)
end

# ===================== свежий Codegen =====================
#
# В C++ каждый прогон — новый объект Codegen, и все его std::vector/map
# начинаются пустыми, а скалярные члены — со значениями из codegen.h. Ниже —
# эти же начальные значения: без них второй вызов cgGenerateWide() в одном
# процессе унаследовал бы фикстуры, пул и RVA первого. Реальному драйверу
# один прогон на процесс это не нужно, но тесту (src/_cgimg.z строит два
# образа) — нужно.
func cgFreshState()
    cgCodeLen = 0
    cgRegsUsed = 0
    cgXmmUsed = 0
    cgLabelNext = 0
    cgLabelsClear()
    cgErrClear()
    cgFixN = 0
    cgStrFixN = 0
    cgKoStrFixN = 0
    cgCallFixN = 0
    cgFuncRefN = 0
    cgGlobalFixN = 0
    cgHeapFixN = 0
    cgElfImpN = 0
    cgImpCallN = 0
    cgNetFixN = 0
    cgJsFixN = 0
    cgGotN = 0
    cgStrPoolN = 0
    cgStringOffsetsN = 0
    cgRDataLen = 0
    cgDataLen = 0
    cgFoN = 0
    cgGoN = 0
    cgFuncOffsetsReset()
    cgHttpJsonHelperEmitted = 0
    cgHttpJsonHelperLabel = -1
    # codegen.h:477..484, :840..843 — дефолты членов Codegen
    cgEntryPointCodeOffset = 0
    cgStringRVA = 0
    cgHeapOffsetRVA = 0xFFFFFD00
    cgHeapFreeHeadRVA = 0xFFFFFE00
    cgHeapAreaRVA = 0xFFFFFF00
    cgRandSeedRVA = 0
    cgGlobalsRVA = 0
    cgFuncRVA = 0
    cgTextRVA = 0x1000
    cgRdataRVA = 0x10000
    cgDataRVA = 0x20000
    cgImgLen = 0
    cgElW = 0
    cgElDynStrLen = 0
    cgElDynSymLen = 0
    cgElRelaLen = 0
    cgElHashLen = 0
    cgElOffKeyN = 0
    cgElIdxKeyN = 0
    cgElSonN = 0
    cgElSymN = 0
end

# ===================== generateWide (Linux-ветка) =====================
#
# codegen.cpp:8565..8829, только `appType == AppType::Linux` без lib/ko/mix.
# Каждый шаг вызывается в том же порядке, что и в C++; ветки, отваливающиеся
# на пустых списках (tls/js/httpdl/disasm-блобы, mixCtx, koDriver, PE-export),
# опущены как в остальных местах порта — их даёт только не портированный код.
#
# Предусловие: состояние такое же, как у свежего `Codegen` — фикстуры, пул
# строк и RVA должны быть пусты/дефолтны, поэтому первый же вызов в процессе.
func cgGenerateWide()
    cgFreshState()
    # codegen.cpp:8575: isLinux/sysvAbi следуют только из appType
    cgIsLinux = 0
    cgSysvAbi = 0
    if cgH(H_APPTYPE) == 8
        cgIsLinux = 1
        cgSysvAbi = 1
    end
    if cgIsLinux == 0
        cgErrSet("generateWide: PE/слой 2 не портирован (нужен app linux)")
        return
    end
    cgWordSize = 64

    cgComputeStructLayouts()
    cgCollectStrings()
    cgComputeSectionRVAs()

    # detect*Usage (codegen.cpp:8650..8660) — не портированы. Для программ,
    # не зовущих net/sound/tls/js/http_download/vk/wayland/shader-билтины,
    # все *_Used и в эталоне остаются 0, поэтому результат совпадает; как
    # только появится первый такой билтин, придётся переносить и их.
    cgBuildLinuxImportData()

    # cgPerFuncReset() из харнесса здесь не нужен: cgFreshState() уже обнулил
    # cgCodeLen и таблицы фикстур, а между ним и первой функцией ничего не
    # пишет в .text (C++ просто эмитит в пустой std::vector).
    var fs: int = cgH(H_FUNCS)
    var fl: int = cgH(H_FUNCS + 1)
    var fi: int = 0
    while fi < fl
        var fid: int = cgSide(fs + fi)
        if cgTag(fid) == N_FUNC && cgF(fid, 11) == 0
            cgEmitFunction(fid)
        end
        fi = fi + 1
    end

    cgEmitLinuxEntryPoint()
    cgEmitStartupRelocator()

    cgFixupSectionRVAs()
    cgResolveFixups()
    cgApplyFixups(0)

    # Поздние строки: пул уже лежит в .rdata (stringOffsets выстроен
    # buildLinuxImportData), но некоторые билтины добавляют свои строки уже
    # ПОСЛЕ (http_json pretty-print) — codegen.cpp:8778..8790.
    if cgStrPoolN > cgStringOffsetsN
        var poolStart: int = cgStringRVA - cgRdataRVA
        var si: int = cgStringOffsetsN
        while si < cgStrPoolN
            if cgStringOffsetsN < 4096
                cgStringOffsets[cgStringOffsetsN] = cgRDataLen - poolStart
                cgStringOffsetsN = cgStringOffsetsN + 1
            end
            var p: int = 0
            var n: int = 0
            if cgStrPoolId[si] < 0
                p = cgStrPoolRaw[si]
                n = cgLitLen(p)
            else
                p = cgStrPtr(cgStrPoolId[si])
                n = cgStrLen(cgStrPoolId[si])
            end
            var k: int = 0
            while k < n
                cgRDataPush(peek8(p + k))
                k = k + 1
            end
            cgRDataPush(0)
            si = si + 1
        end
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end
    end

    cgBuildELF()
end
