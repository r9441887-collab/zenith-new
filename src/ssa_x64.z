    emit8(0x85)
    emit8(0xC0)
    emitJccRaw(0x85, ilpF)
    emitJmp(iwF)
    emitLabel(izF)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC8)
    emit8(0x41)
    emit8(0xC6)
    emit8(0x00)
    emit8(0x30)
    emit8(0x41)
    emit8(0xFF)
    emit8(0xC1)
    emitLabel(iwF)
    emit8(0x4C)
    emit8(0x89)
    emit8(0xC6)
    emit8(0x4C)
    emit8(0x89)
    emit8(0xCA)
    cgLinWsys(fd, 1)
    emit8(0xB0)
    emit8(0x2E)
    cgLinWriteOneByte(fd)
    emit8(0xF3)
    emit8(0x0F)
    emit8(0x10)
    emit8(0x44)
    emit8(0x24)
    emit8(0x20)
    emit8(0x48)
    emit8(0x8B)
    emit8(0x4C)
