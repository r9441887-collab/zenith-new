# spvasm.cpp:301..305 kResultFirst — result id ПЕРЕД остальными операндами
# (без Result Type); у всех остальных — [Result Type][Result id]...
func cgSpvResultFirst(opcode: int) -> int
    if opcode == 5
        return 1
    end
    if opcode == 6
        return 1
    end
    if opcode == 248
        return 1
    end
    if opcode == 11
        return 1
    end
    if opcode == 19
        return 1
    end
    if opcode == 20
        return 1
    end
    if opcode == 21
        return 1
    end
    if opcode == 22
        return 1
    end
    if opcode == 23
        return 1
    end
    if opcode == 24
        return 1
    end
    if opcode == 30
        return 1
    end
    if opcode == 32
        return 1
    end
    if opcode == 33
        return 1
    end
    if opcode == 28
        return 1
    end
    if opcode == 29
        return 1
    end
    return 0
end
