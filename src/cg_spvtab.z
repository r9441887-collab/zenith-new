# src/cg_spvtab.z — СГЕНЕРИРОВАНО tools/gen_spvtab_z.py, НЕ РЕДАКТИРОВАТЬ.
#
# Таблицы SPIR-V ассемблера из spvasm.cpp:
#   cgSpvOpCode       <- kOps      (имя опкода -> номер)
#   cgSpvEnumVal      <- kEnums    (имя енума -> u32, первый матч выигрывает)
#   cgSpvResultFirst  <- kResultFirst (опкоды, чей result id идёт ПЕРВЫМ словом)
#
# Имена сравниваются побайтово со срезом (p,n) ассемблируемого текста и
# .z-литералом, поэтому нужен cgSliceEqLit: ZAST-строки тут ни при чём —
# текст шейдера лежит в ZAST-строке, а её токены — просто срезы байтов.
# Опкодов: 83, енумов: 124, result-first: 15.

func cgSliceEqLit(p: int, n: int, lit: int) -> int
    var m: int = cgLitLen(lit)
    if m != n
        return 0
    end
    var i: int = 0
    while i < n
        if peek8(p + i) != peek8(lit + i)
            return 0
        end
        i = i + 1
    end
    return 1
end

