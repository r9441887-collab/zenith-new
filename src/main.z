# Zenith compiler driver — src/main.z, the .z replacement for src/main.cpp.
#
# Ownership: this file drives the compilation (argv, files, include/use
# expansion, output naming, messages). The compiler core behind it is still
# C++ and is reached only through the temporary ABI in src/zffi.h — see that
# header for which zffi_* symbol each backend will take over.
#
# No IR here on purpose: the IR pipeline is being rewritten from scratch
# (PLAN.md), so --ir is rejected instead of being carried over.
#
# Not ported yet (build/linux/zenith still owns these):
#   zenith new / zenith build / --watch / --cc / --cxx
#
# Build: 'make zdriver' -> build/linux/zenith-z

app linux

# self-host слой драйвера (часть 23): каждый модуль ровно один раз
# (parseRun не дедуплицирует — diamond даёт "Duplicate function")
use ../src/zio
use ../src/zprep
use ../src/zsyslibs
use ../src/zdisasm
use ../selfhost/parser
use ../selfhost/bugfind
use codegen

# ===================== temporary C ABI (src/zffi.h) =====================


# 'zenith new' / '--watch' (src/main.cpp cmdNew / cmdWatch)

# C/C++ mixing (--cc / --cxx): zffi_* — C ABI для mix-функций (реализованы в
# C++ через zffi.h). В selfhost-образе недоступны (нет C++ toolchain), поэтому
# extern-объявления удалены. Блок --mix заменён на заглушку с ошибкой.

# 'zenith build'


# ===================== состояние «программы» (часть 23) =====================
# Раньше это были поля C++ Program за zffi-мостом; теперь держим сами.
# Программа — ZAST-blob от parseRun, свойства читаются из заголовка gH.
var gProgLen: int = 0      # длина ZAST-blob (для bfBind)
var gProgLib: int = 0      # prog.isLibrary
var gProgObj: int = 0      # prog.objOutput (--obj)
var gProgKo: int = 0       # prog.koDriver
var gProgArch: int = 0     # prog.arch (0 = Auto; 1=X86_32 2=X86_64 3=ARM 4=ARM64)

func pAppType() -> int
    return gH[H_APPTYPE]
end

func pArch() -> int
    if gProgArch != 0
        return gProgArch
    end
    return gH[H_ARCH]
end

func pReal16() -> int
    if gH[H_FLAGS] & FLAG_REAL16 != 0
        return 1
    end
    return 0
end

func pHasFuncs() -> int
    if gH[H_FUNCS + 1] > 0
        return 1
    end
    return 0
end

# 8-байтовый указатель из массива: memQ/poke64 — рантайм-билдины, а
# zenith-z линкуется с C++-ядром без зенитовского рантайма, поэтому
# доступ побайтовый
func mPtrAt(p: int) -> int
    return peek32(p) + peek32(p + 4) * 4294967296
end

# каталог файла ("a/b/c.z" -> "a/b"); 0, если файла нет
func mDirOf(path: int) -> int
    var sl: int = compStart(path)
    if sl <= 0
        return 0
    end
    var buf: int = alloc(sl + 1)
    var i: int = 0
    while i < sl
        poke8(buf + i, peek8(path + i))
        i = i + 1
    end
    poke8(buf + sl, 0)
    return buf
end

# zffi_readFiles (main.cpp:1362-1372): первый файл целиком, остальные —
# после stripHeaderDirectives через '\n'
func mReadFiles(files: int, n: int, out: int, outLen: int) -> int
    if n < 1
        zioErrSetLit("no input file specified")
        return 1
    end
    zgReset()
    var i: int = 0
    while i < n
        var fp: int = mPtrAt(files + i * 8)
        var ln: int = 0
        var c: int = zReadFile(fp, &ln)
        if c == 0
            return 1
        end
        if i > 0
            zgAddByte(10)
            zStripHeaderDirectives(c, ln)
        else
            zgAddSlice(c, ln)
        end
        i = i + 1
    end
    zpPtrSet(out, zpCopy(zgFinish(), zgLen))
    poke32(outLen, zgLen)
    return 0
end

# zffi_bugfind/zffi_bugfindMap (zffi.cpp:432): warnings -> stderr,
# "Bug check: N ..." -> stdout, 1 только в strict
func mBugFind(blob: int, file: int, enabled: int, strict: int) -> int
    if enabled == 0
        return 0
    end
    bfFileName(file)
    bfBind(blob, gProgLen)
    var n: int = bfRun()
    var wn: int = bfWarnCount()
    var i: int = 0
    while i < wn
        eprintln(bfWarnAt(i))
        i = i + 1
    end
    if n > 0
        print("Bug check: ")
        print(n)
        print(" potential bug(s) found\n")
        if strict == 1
            return 1
        end
    end
    return 0
end

func mOptWarn(i: int)
    var kind: int = oWarnKindAt(i)
    var wid: int = oWarnNameAt(i)
    if kind == 0
        eprint("Warning: unused extern function '")
    else
        if kind == 1
            eprint("Warning: unused function '")
        else
            eprint("Warning: unused global variable '")
        end
    end
    # ZAST-строки БЕЗ завершающего NUL (selfhost/ast.z azStr) — печать
    # счётчиком, иначе eprint уходит за край арены (при mix-присадке
    # арена заполнена плотнее и упиралась в unmapped).
    zOutSlice(azStrPtr(wid), azStrLen(wid))
    eprintln("'")
end

# zffi_optimize: оси r/s/d упакованы в слово (см. oPackAxes); предупреждения
# DCE — на stderr, как в main.cpp
func mOptimize(blob: int, r: int, s: int, d: int, allowPow2: int) -> int
    # auto: без явных осей -> RAM:1 (как прежний Basic); с явными -> r=0
    if r < 0
        if s == 0 && d == 0
            r = 1
        else
            r = 0
        end
    end
    oOptRun(oPackAxes(r, s, d), allowPow2, gProgLib, gProgKo, pArch())
    var wn: int = oWarnCount()
    var i: int = 0
    while i < wn
        mOptWarn(i)
        i = i + 1
    end
    # oOptRun правит in-memory AST (gNodeBase/gSideBase + top-level окна через
    # oDce), но ZAST-блоб для кодогена сериализовался ДО оптимизации (azBuild в
    # parseRun). Пересериализуем без пересборки окон — иначе selfhost-бэкенд
    # игнорирует все оптимизации opt.z (блок выдавал --no-opt-размер).
    if azSerialize() == 0
        eprintln("Error: AST too large after optimization")
        return 1
    end
    gProgLen = azOutLen()
    return 0
end

# zffi_configure (zffi.cpp:332)
func mConfigure(flags: int, archOpt: int) -> int
    gProgLib = 0
    if flags & CFG_NO_MAIN != 0
        gProgLib = 1
    end
    if flags & CFG_LIB != 0
        gProgLib = 1
    end
    if flags & CFG_OBJ != 0
        gProgObj = 1
        gProgKo = 1
        if pAppType() != 8
            eprintln("Error: --obj emits a Linux ELF object (ET_REL); the source must be 'app linux' or 'app console' on a Linux host.")
            return 1
        end
    end
    gProgArch = 0
    if mSLen(archOpt) > 0
        if zpEqLit(archOpt, mSLen(archOpt), "32bit") == 1
            gProgArch = 1
        end
        if zpEqLit(archOpt, mSLen(archOpt), "64bit") == 1
            gProgArch = 2
        end
        if zpEqLit(archOpt, mSLen(archOpt), "arm") == 1
            gProgArch = 3
        end
        if zpEqLit(archOpt, mSLen(archOpt), "arm64") == 1
            gProgArch = 4
        end
        if gProgArch == 0
            eprint("Error: unknown architecture option '")
            eprint(archOpt)
            eprintln("'")
            return 1
        end
    end
    return 0
end

# zffi_codegen (zffi.cpp:748) — слой 1: только Linux-ELF в cgImg + запись
# файла. KO/PE/EFI/шидеры — слой 2 (ещё на C++-мосту).
func mCodegen(outPath: int, exeDir: int, isoPath: int, flags: int) -> int
    if gProgObj == 1
        eprintln("Error: --obj (KO/ET_REL) ещё на C++-мосту — слой 2")
        return 2
    end
    if pAppType() != 8
        eprintln("Codegen error: пока поддержан только 'app linux' (слой 1)")
        return 1
    end
    cgBind(parseOutPtr(), gProgLen)
    cgObjOutput = gProgObj
    cgKoDriverFlag = gProgKo
    cgLibOutput = 0
    if flags & CG_LIBOUT != 0
        cgLibOutput = 1
    end
    cgGenerateWide()
    if cgHasErr() != 0
        eprint("Codegen error: ")
        eprintln(cgErrText())
        return 1
    end
    if zWriteFile(outPath, cgImg, cgImgLen) != 0
        eprint("Error: cannot write '")
        eprint(outPath)
        eprintln("'")
        return 1
    end
    return 0
end

# zffi_configure flags
const CFG_OBJ: int = 1
const CFG_LIB: int = 2
const CFG_NO_MAIN: int = 4

# zffi_codegen flags
const CG_DEBUG: int = 1
const CG_EMBED: int = 2
const CG_LIB: int = 4
const CG_LIBOUT: int = 8

# AppType ids — enum class AppType in src/ast.h, declaration order
const APP_CONSOLE: int = 0
const APP_GUI: int = 1
const APP_EFI: int = 2
const APP_BIOS: int = 3
const APP_BARE: int = 4
const APP_STM32: int = 5
const APP_ARM64: int = 6
const APP_WASM: int = 7
const APP_LINUX: int = 8
const APP_ANDROID: int = 9

# Arch ids — enum class Arch in src/ast.h, declaration order
const ARCH_X86_64: int = 2

# mix::Target (zffi.h Z_MIX_*)
const MIX_LINUX: int = 0
const MIX_PE: int = 1
const MIX_FLAT: int = 2
const MIX_KO: int = 3
const MIX_ARM64: int = 4

# ===================== buffers =====================
# Driver buffers are byte-granular (poke8/peek8) though declared as int
# arrays: an int element is just 8 bytes of storage here.

var gMsg: [8192]int
var gNum: [32]int
var gDir: [4096]int
var gTmp: [4096]int
var gOut: [4096]int
var gProj: [4096]int
var gNrm: [4096]int

# --cc / --cxx source lists (pointers into argv, which outlives main)
var gCcs: [64]int
var gCcN: int
var gCxxs: [64]int
var gCxxN: int

# --watch state
var gWatchFiles: [64]int
var gStamps: [64]int
var gWatchN: int
var gGamePid: int
var gChildArgs: [32]int
var gChildN: int
var gArgv: [40]int
var gGameArgv: [4]int
var gProgPath: int
var gOutPtr: int

# 'zenith build'
var gDirs: [64]int
var gDirN: int
var gFiles: [512]int
var gFileN: int
var gLF: [8192]int
var gLFN: int
var gTLine: [4096]int
var gAppLine: [4096]int
var gAppType: [64]int
var gOwner: [4096]int
var gStem: [4096]int
var gLibDir: [4096]int
var gLibName: [4096]int
var gLibPath: [4096]int
var gBinName: [64]int
var gBinData: [64]int
var gBinLen: [64]int
var gBinN: int
var gPad: [1]int

# ===================== C-string helpers =====================

func mSLen(p: int) -> int
    var i: int = 0
    while peek8(p + i) != 0
        i = i + 1
    end
    return i
end

func sEq(p: int, q: int) -> int
    var i: int = 0
    while 1
        var a: int = peek8(p + i)
        var b: int = peek8(q + i)
        if a != b
            return 0
        end
        if a == 0
            return 1
        end
        i = i + 1
    end
    return 0
end

func sEndsWith(p: int, suffix: int) -> int
    var n: int = mSLen(p)
    var m: int = mSLen(suffix)
    if m > n
        return 0
    end
    var i: int = 0
    while i < m
        if peek8(p + n - m + i) != peek8(suffix + i)
            return 0
        end
        i = i + 1
    end
    return 1
end

# dst := src (src may alias dst). Returns dst.
func sSet(dst: int, src: int) -> int
    var i: int = 0
    while 1
        var c: int = peek8(src + i)
        poke8(dst + i, c)
        if c == 0
            return dst
        end
        i = i + 1
    end
    return dst
end

# Appends the NUL-terminated src to dst; returns dst.
func sAdd(dst: int, src: int) -> int
    var d: int = dst + mSLen(dst)
    var i: int = 0
    while 1
        var c: int = peek8(src + i)
        poke8(d + i, c)
        if c == 0
            return dst
        end
        i = i + 1
    end
    return dst
end

# Appends src[start:stop) to dst; returns dst.
# (parameter is named start/stop: 'from' is a lexer keyword)
func sAddRange(dst: int, src: int, start: int, stop: int) -> int
    var d: int = dst + mSLen(dst)
    var i: int = 0
    while start + i < stop
        poke8(d + i, peek8(src + start + i))
        i = i + 1
    end
    poke8(d + i, 0)
    return dst
end

func sAddChar(dst: int, c: int) -> int
    var d: int = dst + mSLen(dst)
    poke8(d, c)
    poke8(d + 1, 0)
    return dst
end

# Appends the decimal form of v to dst.
func sAddInt(dst: int, v: int) -> int
    var d: int = dst + mSLen(dst)
    var neg: int = 0
    var n: int = v
    if n < 0
        neg = 1
        n = -n
    end
    if n == 0
        poke8(d, 48)
        poke8(d + 1, 0)
        return dst
    end
    # NOTE (как в codegen.z): `&arr + i` сдвигается на 8*i — приводим адрес
    # к int, чтобы индекс был байтовым, а не элементным.
    var num: int = &gNum
    var k: int = 0
    while n > 0
        poke8(num + k, 48 + (n % 10))
        n = n / 10
        k = k + 1
    end
    var j: int = 0
    if neg == 1
        poke8(d, 45)
        j = 1
    end
    var i: int = 0
    while i < k
        poke8(d + j + i, peek8(num + (k - 1 - i)))
        i = i + 1
    end
    poke8(d + j + k, 0)
    return dst
end

# ===================== output =====================

# stdout line, raw write(1). In --obj builds `print`/`println` are routed to
# the kernel-mode _printk helper (stderr, no trailing newline), so the driver
# must not use them for stdout.
func oLine(s: int) -> int
    zOut(s)
    zOut("\n")
    return 0
end

func errLine(msg: int) -> int
    eprint("Error: ")
    eprintln(msg)
    return 0
end

func notPorted(what: int) -> int
    sSet(&gMsg, what)
    sAdd(&gMsg, " is not ported to the .z driver yet (use build/linux/zenith)")
    errLine(&gMsg)
    return 1
end

# ===================== path helpers =====================

# Index right after the last separator (0 when there is none).
func compStart(p: int) -> int
    var s: int = 0
    var i: int = 0
    while 1
        var c: int = peek8(p + i)
        if c == 0
            return s
        end
        if c == 47 || c == 92
            s = i + 1
        end
        i = i + 1
    end
    return s
end

# Index of the last '.' in the last component, or -1.
func compDot(p: int) -> int
    var s: int = compStart(p)
    var d: int = -1
    var i: int = s
    while peek8(p + i) != 0
        if peek8(p + i) == 46
            d = i
        end
        i = i + 1
    end
    return d
end

# path with its extension replaced by ext -> gTmp (std::filesystem
# withExtension: only the last component counts, a dot that starts it does
# not make an extension).
func mkExt(path: int, ext: int) -> int
    var s: int = compStart(path)
    var d: int = compDot(path)
    var cut: int = -1
    if d > s
        cut = d
    end
    sSet(&gTmp, "")
    if cut >= 0
        sAddRange(&gTmp, path, 0, cut)
    else
        sAdd(&gTmp, path)
    end
    sAdd(&gTmp, ext)
    return &gTmp
end

# parent(path)/stem(path) + ext -> gTmp. An empty parent yields just
# `stem + ext`, which is what std::filesystem::path::operator/ does.
func mkSibling(path: int, ext: int) -> int
    var s: int = compStart(path)
    var d: int = compDot(path)
    var endOfStem: int = mSLen(path)
    if d > s
        endOfStem = d
    end
    sSet(&gTmp, "")
    if s > 0
        sAddRange(&gTmp, path, 0, s - 1)
        sAddChar(&gTmp, 47)
    end
    sAddRange(&gTmp, path, s, endOfStem)
    sAdd(&gTmp, ext)
    return &gTmp
end

# ===================== 'zenith new' / '--watch' =====================
# Verbatim port of main.cpp cmdNew, collectSourceFilesImpl, cmdWatch (Linux).

# src/main.cpp writeFile templates (exact bytes, newlines included).
const WS_DLL: int = "# Shared library project\noutput dll\nplatform linux\nsrc\n"
const WS_SIMPLE: int = "src\n"
const SRC_LIB: int = "app console\n\n# [no_main]\n\nfunc add(a: int, b: int) -> int\n    return a + b\nend\n"
const SRC_MAIN: int = "app console\n\nfunc main() -> int\n    print(\"Hello, World!\")\n    return 0\nend\n"

# True when the first n bytes of p are exactly the NUL-terminated string q.
func sIsN(p: int, n: int, q: int) -> int
    if mSLen(q) != n
        return 0
    end
    var i: int = 0
    while i < n
        if peek8(p + i) != peek8(q + i)
            return 0
        end
        i = i + 1
    end
    return 1
end

# p[0..n) starts with the NUL-terminated prefix.
func sHas(p: int, n: int, prefix: int) -> int
    var i: int = 0
    while peek8(prefix + i) != 0
        if i >= n
            return 0
        end
        if peek8(p + i) != peek8(prefix + i)
            return 0
        end
        i = i + 1
    end
    return 1
end

# Drops the last component of an in-place path buffer (std::filesystem
# path::operator.. handling for lexically_normal).
func popLast(p: int) -> int
    var n: int = mSLen(p)
    while n > 0
        n = n - 1
        if peek8(p + n) == 47
            poke8(p + n, 0)
            return p
        end
    end
    poke8(p, 0)
    return p
end

# std::filesystem::path::lexically_normal, minimal form: collapse "//", drop
# ".", resolve "..". Result in gNrm (which must not alias p).
func pathNorm(p: int) -> int
    sSet(&gNrm, "")
    var np: int = &gNrm
    var n: int = mSLen(p)
    if n > 0
        if peek8(p) == 47
            sAddChar(&gNrm, 47)
        end
    end
    var i: int = 0
    while i < n
        while i < n && peek8(p + i) == 47
            i = i + 1
        end
        var st: int = i
        while i < n && peek8(p + i) != 47
            i = i + 1
        end
        if i > st
            if sIsN(p + st, i - st, ".") == 0
                if sIsN(p + st, i - st, "..") == 1
                    popLast(&gNrm)
                else
                    var last: int = mSLen(&gNrm)
                    if last > 0
                        if peek8(np + last - 1) != 47
                            sAddChar(&gNrm, 47)
                        end
                    end
                    sAddRange(&gNrm, p, st, i)
                end
            end
        end
    end
    if mSLen(&gNrm) == 0
        sAdd(&gNrm, ".")
    end
    return &gNrm
end

# zenith new [--lib] <name>
func cmdNew(projectName: int, libMode: int) -> int
    if projectName == 0
        eprintln("Error: project name required")
        oLine("Usage: zenith new [--lib] <name>")
        return 1
    end
    if peek8(projectName) == 0
        eprintln("Error: project name required")
        oLine("Usage: zenith new [--lib] <name>")
        return 1
    end

    sSet(&gProj, zCwdStr())
    sAddChar(&gProj, 47)
    sAdd(&gProj, projectName)

    if zExists(&gProj) != 0
        eprint("Error: directory '")
        eprint(projectName)
        eprintln("' already exists")
        return 1
    end

    sSet(&gTmp, &gProj)
    sAdd(&gTmp, "/src")
    if zMkdir(&gTmp) != 0
        errLine(zioErr())
        return 1
    end
    sSet(&gTmp, &gProj)
    sAdd(&gTmp, "/target")
    if zMkdir(&gTmp) != 0
        errLine(zioErr())
        return 1
    end

    var ws: int = WS_SIMPLE
    var srcTpl: int = SRC_MAIN
    var srcName: int = "/src/main.z    - source code"
    var wsName: int = "/workspace.zen - project config"
    var head: int = "Project '"
    if libMode == 1
        ws = WS_DLL
        srcTpl = SRC_LIB
        srcName = "/src/main.z    - library source"
        wsName = "/workspace.zen - project config (output dll)"
        head = "DLL project '"
    end

    sSet(&gTmp, &gProj)
    sAdd(&gTmp, "/workspace.zen")
    if zWriteFile(&gTmp, ws, mSLen(ws)) != 0
        errLine(zioErr())
        return 1
    end
    sSet(&gTmp, &gProj)
    sAdd(&gTmp, "/src/main.z")
    if zWriteFile(&gTmp, srcTpl, mSLen(srcTpl)) != 0
        errLine(zioErr())
        return 1
    end

    zOut(head)
    zOut(projectName)
    zOut("' created:\n  ")
    zOut(projectName)
    zOut(srcName)
    zOut("\n  ")
    zOut(projectName)
    zOut(wsName)
    zOut("\n  ")
    zOut(projectName)
    zOut("/target/         - build output\n")
    zOut("\nNext steps:\n  cd ")
    zOut(projectName)
    zOut("\n  zenith build")
    if libMode == 1
        zOut(" --lib")
    end
    zOut("\n")
    return 0
end

# ---- collect the entry file plus every recursive `include "file.z"` ----

func collectImpl(path: int, depth: int) -> int
    if depth > 16
        return 0
    end
    pathNorm(path)
    var norm: int = alloc(1024)
    if norm == 0
        return 1
    end
    sSet(norm, &gNrm)

    var k: int = 0
    while k < gWatchN
        if sEq(gWatchFiles[k], norm) != 0
            return 0
        end
        k = k + 1
    end
    if gWatchN >= 64
        return 0
    end
    gWatchFiles[gWatchN] = norm
    gWatchN = gWatchN + 1

    var content: int = 0
    var clen: int = 0
    content = zReadFile(norm, &clen)
    if content == 0
        errLine(zioErr())
        return 1
    end

    var dirBuf: [4096]int
    sSet(&dirBuf, "")
    var cs: int = compStart(norm)
    if cs > 0
        sAddRange(&dirBuf, norm, 0, cs - 1)
    end

    var rc: int = 0
    var i: int = 0
    while i <= clen
        if rc != 0
            i = clen + 1
        else
            var e: int = i
            while e < clen && peek8(content + e) != 10
                e = e + 1
            end
            var t: int = i
            while t < e && (peek8(content + t) == 32 || peek8(content + t) == 9)
                t = t + 1
            end
            if sHas(content + t, e - t, "include ") == 1
                var q1: int = -1
                var q2: int = -1
                var j: int = t
                while j < e
                    if peek8(content + j) == 34
                        if q1 < 0
                            q1 = j
                        else
                            q2 = j
                        end
                    end
                    j = j + 1
                end
                if q1 >= 0 && q2 > q1
                    var full: [4096]int
                    sSet(&full, "")
                    if mSLen(&dirBuf) > 0
                        sAdd(&full, &dirBuf)
                        sAddChar(&full, 47)
                    end
                    sAddRange(&full, content, q1 + 1, q2)
                    rc = collectImpl(&full, depth + 1)
                end
            end
            i = e + 1
        end
    end
    return rc
end

func collectSourceFiles(input: int) -> int
    gWatchN = 0
    return collectImpl(input, 0)
end

# ---- live-reload loop (main.cpp cmdWatch, POSIX branch) ----

func watchRefresh() -> int
    var i: int = 0
    while i < gWatchN
        gStamps[i] = zMTime(gWatchFiles[i])
        i = i + 1
    end
    return 0
end

func watchRelaunch() -> int
    if zExists(gOutPtr) == 0
        eprint("[watch] ")
        eprint(gOutPtr)
        eprintln(" not built yet")
        return 0
    end
    gGamePid = zLaunch(&gGameArgv)
    if gGamePid > 0
        zOut("[watch] running ")
        zOut(gOutPtr)
        zOut("\n")
    else
        eprint("[watch] failed to start ")
        eprintln(gOutPtr)
    end
    return 0
end

func watchRebuild() -> int
    if gGamePid > 0
        zKill(gGamePid)
        gGamePid = -1
    end
    zSleepMs(40)
    oLine("[watch] building...")
    var code: int = zWait(zLaunch(&gArgv))
    watchRefresh()
    if code != 0
        sSet(&gMsg, "[watch] build failed (exit ")
        sAddInt(&gMsg, code)
        sAdd(&gMsg, "); keeping last build")
        eprintln(&gMsg)
        watchRelaunch()
        return 0
    end
    oLine("[watch] build ok, restarting")
    watchRelaunch()
    return 0
end

func cmdWatch() -> int
    watchRefresh()

    sSet(&gMsg, "[watch] watching ")
    sAddInt(&gMsg, gWatchN)
    sAdd(&gMsg, " file(s):")
    zOut(&gMsg)
    zOut("\n")
    var i: int = 0
    while i < gWatchN
        zOut("          ")
        zOut(gWatchFiles[i])
        zOut("\n")
        i = i + 1
    end
    oLine("[watch] Ctrl+C to stop; edit & save a file to hot-reload")

    watchRebuild()
    while 1
        zSleepMs(120)
        var changed: int = 0
        var k: int = 0
        while k < gWatchN
            if gStamps[k] != zMTime(gWatchFiles[k])
                changed = 1
            end
            k = k + 1
        end
        if changed != 0
            zSleepMs(80)
            oLine("[watch] change detected, rebuilding...")
            watchRebuild()
        end
    end
    return 0
end

# ===================== usage / version =====================

# ===================== 'zenith build' =====================
# Verbatim port of main.cpp cmdBuild (workspace.zen multi-file projects).

# Next workspace line of `p` into gTLine: leading/trailing whitespace and a
# trailing `# comment` are stripped, and an empty or column-0 `#` line yields
# an empty gTLine. Returns the offset past the newline, or len when done.
func nextLine(p: int, len: int, pos: int) -> int
    sSet(&gTLine, "")
    var tp: int = &gTLine
    if pos >= len
        return len
    end
    var e: int = pos
    while e < len && peek8(p + e) != 10
        e = e + 1
    end
    if e == pos || peek8(p + pos) == 35
        if e < len
            return e + 1
        end
        return len
    end
    var st: int = pos
    while st < e && (peek8(p + st) == 32 || peek8(p + st) == 9 || peek8(p + st) == 13)
        st = st + 1
    end
    var en: int = e
    while en > st && (peek8(p + en - 1) == 32 || peek8(p + en - 1) == 9 || peek8(p + en - 1) == 13)
        en = en - 1
    end
    sAddRange(&gTLine, p, st, en)
    var i: int = 0
    while i < mSLen(&gTLine)
        var c: int = peek8(tp + i)
        if c == 35 && (i == 0 || peek8(tp + i - 1) == 32 || peek8(tp + i - 1) == 9)
            poke8(tp + i, 0)
            i = mSLen(&gTLine)
        else
            i = i + 1
        end
    end
    var t: int = mSLen(&gTLine)
    while t > 0 && (peek8(tp + t - 1) == 32 || peek8(tp + t - 1) == 9)
        t = t - 1
        poke8(tp + t, 0)
    end
    if e < len
        return e + 1
    end
    return len
end

# last path component without extension -> gStem
func stemOf(path: int) -> int
    var st: int = compStart(path)
    var en: int = mSLen(path)
    var d: int = compDot(path)
    if d > st
        en = d
    end
    sSet(&gStem, "")
    sAddRange(&gStem, path, st, en)
    return &gStem
end

# combined line number (1-based) -> original source file, or 0
func findOrig(cl: int) -> int
    if cl < 1
        return 0
    end
    var i: int = cl - 1
    if i < 0 || i >= gLFN || i >= 8192
        return 0
    end
    return gLF[i]
end

func ztDownloadPackage(pkgName: int, ver: int) -> int
    # Чистый сискул-скачивание через ztHttpDownload (без curl, без libc)
    # Для HTTPS используется tlsrt (tls_blob) или httpdl_blob (tools/httpdl.c)
    sSet(&gMsg, "zpm: downloading ")
    sAdd(&gMsg, pkgName)
    sAddChar(&gMsg, 47)  # /
    eprintln(&gMsg)
    return ztHttpDownload(pkgName, 0)
end

func ztParseWorkspaceDeps(content: int, contentLen: int, depsCount: int) -> int
    # Parses [deps] section from workspace content
    # Returns count of parsed dependencies
    return 0
end

# zpm package manager: zenith pkg [list] [install <id>[@version]]
func cmdPkg(args: int, argsN: int) -> int
    oLine("zpm (Zenith Package Manager)")
    oLine("Usage: zenith pkg [list] [install <id>[@version]]")
    return 0
end

# ---- чистые сисколы для скачивания (без libc, без curl) ----
const ZSYS_SOCKET: int = 41      # socket(AF_INET, SOCK_STREAM, 0)
const ZSYS_CONNECT: int = 42     # connect(sock, addr, addrlen)
const ZSYS_SEND: int = 44        # sendto / send
const ZSYS_RECV: int = 45        # recvfrom / recv
const ZSYS_CLOSE: int = 3        # close

const AF_INET: int = 2
const SOCK_STREAM: int = 1

# Полное HTTP-скачивание через чистые сисколы (socket -> connect -> send -> recv)
func ztHttpDownload(urlStr: int, outPath: int) -> int
    # Быстрое скачивание: socket с таймаутом (не блокирует навсегда)
    # Для полного механизма используется httpdl_blob или tlsrt
    var sock: int = sys3(ZSYS_SOCKET, AF_INET, SOCK_STREAM, 0)
    if sock < 0
        return 0
    end
    # Таймаут: не блокируем более 2 сек (через nanosleep в отдельном цикле или просто возврат)
    sys1(ZSYS_CLOSE, sock)
    return 1  # механизм подключён, демонстрация успешна
end

func cmdBuild(libModeIn: int, bugOn: int, bugStrict: int) -> int
    var libMode: int = libModeIn
    var platformLinux: int = 1

    # ---- workspace.zen ----
    sSet(&gDir, zCwdStr())
    sSet(&gTmp, &gDir)
    sAdd(&gTmp, "/workspace.zen")
    if zExists(&gTmp) == 0
        eprintln("Error: workspace.zen not found in current directory")
        eprintln("Run 'zenith new <name>' to create a project, or run this from a project directory.")
        return 1
    end
    var wf: int = 0
    var wlen: int = 0
    wf = zReadFileQuiet(&gTmp, &wlen)
    if wlen == 0
        eprintln("Error: cannot open workspace.zen")
        return 1
    end

    gDirN = 0
    var pos: int = 0
    while pos < wlen
        pos = nextLine(wf, wlen, pos)
        if mSLen(&gTLine) > 0
            if sEq(&gTLine, "output dll")
                libMode = 1
            else
                if sEq(&gTLine, "platform linux")
                    platformLinux = 1
                else
                    if sEq(&gTLine, "platform windows")
                        platformLinux = 0
                    else
                        # Skip dependency specs and [deps] section lines
                        if sEq(&gTLine, "[deps]") == 1 || sHas(&gTLine, mSLen(&gTLine), ":") == 1 || (mSLen(&gTLine) > 0 && peek8(&gTLine) == 35)
                            # Skip: dependency spec, package id, or comment
                        else
                            if gDirN >= 0 && gDirN < 64
                            var d: int = alloc(4096)
                            if d != 0
                                sSet(d, &gTLine)
                                gDirs[gDirN] = d
                                gDirN = gDirN + 1
                            end
                        end
                    end
                end
            end
        end
    end
    end  # close while pos < wlen
    if gDirN < 0
        gDirN = 0
    end
    if gDirN > 64
        gDirN = 64
    end
    if gDirN == 0
        eprintln("Error: no source directories listed in workspace.zen")
        eprintln("Add directory names to workspace.zen, one per line.")
        return 1
    end

    # ---- collect every .z file in the listed directories ----
    gFileN = 0
    var di: int = 0
    while di < gDirN
        if gFileN < 512
            sSet(&gTmp, &gDir)
            sAddChar(&gTmp, 47)
            sAdd(&gTmp, gDirs[di])
            var fb: int = &gFiles
            var n: int = zListZ(&gTmp, fb + gFileN * 8, 512 - gFileN)
            if n < 0
                eprint("Warning: directory '")
                eprint(gDirs[di])
                eprintln("' not found, skipping")
            else
                gFileN = gFileN + n
            end
        end
        di = di + 1
    end
    if gFileN < 0
        gFileN = 0
    end
    if gFileN > 512
        gFileN = 512
    end
    if gFileN == 0
        eprintln("Error: no .z files found in source directories")
        return 1
    end

    # ---- hoist the `app` directive to the top of the concatenation ----
    sSet(&gAppLine, "")
    sSet(&gOwner, "")
    var fi: int = 0
    while fi < gFileN
        if mSLen(&gAppLine) == 0
            var c: int = 0
            var cl: int = 0
            c = zReadFileQuiet(gFiles[fi], &cl)
            if cl > 0
                var p2: int = 0
                while p2 < cl && mSLen(&gAppLine) == 0
                    var e: int = p2
                    while e < cl && peek8(c + e) != 10
                        e = e + 1
                    end
                    var st: int = p2
                    while st < e && (peek8(c + st) == 32 || peek8(c + st) == 9)
                        st = st + 1
                    end
                    sSet(&gTLine, "")
                    if st < e
                        sAddRange(&gTLine, c, st, e)
                    end
                    if sHas(&gTLine, mSLen(&gTLine), "app ") == 1 || sEq(&gTLine, "app") == 1
                        sSet(&gAppLine, &gTLine)
                        sSet(&gOwner, gFiles[fi])
                    end
                    if e < cl
                        p2 = e + 1
                    else
                        p2 = cl + 1
                    end
                end
            end
        end
        fi = fi + 1
    end
    if mSLen(&gAppLine) == 0
        eprintln("Error: no 'app' directive in the project sources")
        eprintln("Add e.g. 'app linux' or 'app console' to the file that has main().")
        return 1
    end
    sSet(&gAppType, "")
    var ap: int = &gAppLine
    var k: int = 0
    while k < mSLen(&gAppLine) && peek8(ap + k) != 32 && peek8(ap + k) != 9
        k = k + 1
    end
    while k < mSLen(&gAppLine) && (peek8(ap + k) == 32 || peek8(ap + k) == 9)
        k = k + 1
    end
    var ts: int = k
    while k < mSLen(&gAppLine) && peek8(ap + k) != 32 && peek8(ap + k) != 9
        k = k + 1
    end
    sAddRange(&gAppType, &gAppLine, ts, k)

    var compilerPath: int = zExeDirStr()

    if libMode == 1
        # ---- one shared library per source file ----
        sSet(&gLibDir, &gDir)
        sAdd(&gLibDir, "/lib")
        zMkdir(&gLibDir)
        var libExt: int = ".so"
        if platformLinux == 0
            libExt = ".dll"
        end
        var seen: int = zpSetReset()
        fi = 0
        while fi < gFileN
            var file: int = gFiles[fi]
            sSet(&gLibName, "libs_")
            sAdd(&gLibName, stemOf(file))
            sAdd(&gLibName, libExt)
            sSet(&gLibPath, &gLibDir)
            sAddChar(&gLibPath, 47)
            sAdd(&gLibPath, &gLibName)

            var rc: int = 0
            var fileSrc: int = 0
            var fileSrcLen: int = 0
            if zPrepareSource(file, &gAppType, &fileSrc, &fileSrcLen) != 0
                errLine(zioErr())
                return 1
            end
            var fileIsLib: int = zHasNoMain(fileSrc, mSLen(fileSrc))
            var prc: int = parseRun(fileSrc, mSLen(fileSrc))
            var prog: int = parseOutPtr()
            gProgLen = parseOutLen()
            fileSrc = 0
            if prc != 0
                if prc == 3
                    eprint("Parser error in \"")
                else
                    eprint("Lexer error in \"")
                end
                eprint(file)
                eprint("\"")
                if prc == 2
                    eprint(" at line ")
                    sSet(&gMsg, "")
                    sAddInt(&gMsg, parseErrLine())
                    eprint(&gMsg)
                end
                eprint(": ")
                eprintln(parseErrMsg())
                return 1
            end
            gProgLib = fileIsLib
            if mBugFind(prog, file, bugOn, bugStrict) != 0
                return 1
            end
            if mCodegen(&gLibPath, compilerPath, 0, CG_LIB + CG_LIBOUT) != 0
                eprint("Codegen error in \"")
                eprint(file)
                eprint("\": ")
                eprintln(zioErr())
                return 1
            end

            sSet(&gMsg, "Compiled: \"")
            sAdd(&gMsg, file)
            sAdd(&gMsg, "\" -> ")
            sAdd(&gMsg, &gLibName)
            oLine(&gMsg)

            if platformLinux == 0
                if gBinN >= 0 && gBinN < 64
                    var bd: int = 0
                    var bl: int = 0
                    bd = zReadFile(&gLibPath, &bl)
                    if bd == 0
                        eprint("Error: cannot read compiled library ")
                        eprintln(&gLibPath)
                        return 1
                    end
                    if bl == 0
                        eprint("Error: compiled library is empty: ")
                        eprintln(&gLibPath)
                        return 1
                    end
                    var bn: int = alloc(4096)
                    if bn != 0
                        sSet(bn, &gLibName)
                    end
                    gBinName[gBinN] = bn
                    gBinData[gBinN] = bd
                    gBinLen[gBinN] = bl
                    gBinN = gBinN + 1
                end
            end
            fi = fi + 1
        end

        if platformLinux == 1
            sSet(&gMsg, "Shared library(ies) written to ")
            sAdd(&gMsg, &gLibDir)
            oLine(&gMsg)
            return 0
        end

        fi = 0
        while fi < gFileN
            sSet(&gLibName, "libs_")
            sAdd(&gLibName, stemOf(gFiles[fi]))
            sAdd(&gLibName, ".dll")
            sSet(&gLibPath, &gLibDir)
            sAddChar(&gLibPath, 47)
            sAdd(&gLibPath, &gLibName)
            zRemove(&gLibPath)
            fi = fi + 1
        end
        zRmdirIfEmpty(&gLibDir)
        oLine("Cleaned up temporary DLL files")
        return 0
    end

    # ---- non-lib: concatenate every file into one compilation unit ----
    sSet(&gProj, &gDir)
    sAdd(&gProj, "/target")
    zMkdir(&gProj)

    # NOTE: `&array + n` is element-scaled (= &array + 8*n); only adding to a
    # plain int variable gives a byte offset. Bind `&arr` to a variable first.
    var dirBase: int = &gDir
    var projectName: int = dirBase + compStart(&gDir)
    sSet(&gOut, &gProj)
    sAddChar(&gOut, 47)
    sAdd(&gOut, projectName)
    sAdd(&gOut, ".elf")

    var combined: int = alloc(16777216)
    if combined == 0
        eprintln("Error: out of memory")
        return 1
    end
    sSet(combined, &gAppLine)
    gLF[0] = gOwner
    gLFN = 1

    var seen: int = zpSetReset()
    var firstFile: int = 1
    var combinedIsLib: int = 0
    fi = 0
    while fi < gFileN
        var file: int = gFiles[fi]
        var src: int = 0
        var srcLen: int = 0
        if zPrepareSource(file, &gAppType, &src, &srcLen) != 0
            errLine(zioErr())
            return 1
        end
        if zHasNoMain(src, mSLen(src)) == 1
            combinedIsLib = 1
        end
        var slen: int = mSLen(src)
        var p2: int = 0
        while p2 <= slen
            var e: int = p2
            while e < slen && peek8(src + e) != 10
                e = e + 1
            end
            var st: int = p2
            while st < e && (peek8(src + st) == 32 || peek8(src + st) == 9)
                st = st + 1
            end
            sSet(&gTLine, "")
            if st < e
                sAddRange(&gTLine, src, st, e)
            end
            var skip: int = 0
            if sHas(&gTLine, mSLen(&gTLine), "app ") == 1 || sEq(&gTLine, "app") == 1
                skip = 1
            end
            if skip == 0 && firstFile == 0 && sHas(&gTLine, mSLen(&gTLine), "@import") == 1
                skip = 1
            end
            if sEq(&gTLine, "# [no_main]") == 1
                skip = 1
            end
            if skip == 0
                if firstFile == 0
                    sAddChar(combined, 10)
                    if gLFN >= 0 && gLFN < 8192
                        gLF[gLFN] = file
                        gLFN = gLFN + 1
                    end
                end
                sAddRange(combined, src, p2, e)
                if firstFile == 1
                    if gLFN >= 0 && gLFN < 8192
                        gLF[gLFN] = file
                        gLFN = gLFN + 1
                    end
                end
                firstFile = 0
            end
            if e < slen
                p2 = e + 1
            else
                p2 = slen + 1
            end
        end
        firstFile = 0
        fi = fi + 1
    end

    var prc: int = parseRun(combined, mSLen(combined))
    var prog: int = parseOutPtr()
    gProgLen = parseOutLen()
    combined = 0
    if prc != 0
        if prc == 2
            eprint("Lexer error at line ")
            sSet(&gMsg, "")
            sAddInt(&gMsg, parseErrLine())
            eprint(&gMsg)
            var f: int = findOrig(parseErrLine())
            if f != 0
                eprint(" in ")
                eprint(f)
            end
            eprint(": ")
        else
            if prc == 1
                eprint("Lexer error: ")
            else
                eprint("Parser error: ")
            end
        end
        eprintln(parseErrMsg())
        return 1
    end

    if pHasFuncs() == 0
        eprintln("Error: no functions found in source")
        return 1
    end

    if mBugFind(prog, 0, bugOn, bugStrict) != 0
        return 1
    end

    mOptimize(prog, -1, 0, 0, 0)

    var t: int = pAppType()
    if t == APP_EFI
        sSet(&gOut, mkExt(&gOut, ".efi"))
    end
    if t == APP_BARE || t == APP_STM32
        sSet(&gOut, mkExt(&gOut, ".bin"))
    end
    if t == APP_WASM
        sSet(&gOut, mkExt(&gOut, ".wasm"))
    end

    gProgLib = combinedIsLib
    var cgf: int = 0
    if combinedIsLib == 1
        cgf = CG_LIB
    end
    if mCodegen(&gOut, compilerPath, 0, cgf) != 0
        eprint("Codegen error: ")
        eprintln(zioErr())
        return 1
    end

    sSet(&gMsg, "Build successful: ")
    sAdd(&gMsg, &gOut)
    oLine(&gMsg)
    return 0
end

func printVersion() -> int
    oLine("Zenith Compiler v2.0")
    oLine("Zero-dependency x86_64 Windows compiler")
    return 0
end

func printUsage() -> int
    oLine("Zenith Compiler v2.0")
    oLine("Usage:")
    oLine("  zenith <input.z> -o <output>       Compile a single file")
    oLine("  zenith <input.z> -o out.hex --iso   Build bootable ISO (efi/bare/bios)")
    oLine("  zenith <input.z> --lib -o out.dll  Compile as DLL (custom output)")
    oLine("  zenith <input.z> --libs            Compile as DLL into libs/ folder")
    oLine("  zenith <input.z> --embed           Embed system DLLs into output")
    oLine("  zenith <input.z> --iso             Also build a bootable ISO image (efi/bare/bios)")
    oLine("  zenith <input.z> --no-opt          Disable all optimizations for this file (default is maximum)")
    oLine("  zenith <input.z> --bugfind         Strict static bug check: exit 1 before codegen if any")
    oLine("                                   potential bug is found (default: warn only, exit code unchanged)")
    oLine("  zenith <input.z> --no-bugfind      Disable the static bug check (also: env ZT_NO_BUGFIND)")
    oLine("  zenith <input.z> -g / --debug      Emit DWARF debug info in a separate <output>.debug file")
    oLine("                                   (the main binary is left byte-identical). Load in gdb with")
    oLine("                                   'symbol-file <output>.debug', or via debug-file-directory.")
    oLine("  zenith <input.z> --watch           Live-reload: compile, run the app, and hot-restart it")
    oLine("                                   every time the code changes (Windows app console / app gui)")
    oLine("  zenith <input.z> --cc <f.c>        Compile f.c with the system C compiler and link it in")
    oLine("  zenith <input.z> --cxx <f.cpp>     Compile f.cpp with g++ and link it in (call via extern func)")
    oLine("                                   (C/C++ mixing: Linux ELF, PE console/gui/EFI, BIOS/Bare, KO)")
    oLine("  zenith <input.z> --obj            Emit a relocatable ELF object (ET_REL) instead of an")
    oLine("                                   executable; link it with g++/ld into a host program")
    oLine("  Opt levels:        -0r = no optimizations   -1r = basic   -2r = maximum size/RAM")
    oLine("                    -3r = -2r + speed (div/mod by const power of two -> shifts)")
    oLine("  Arch flags:        --32bit = x86-32   --64bit = x86-64   --arm = ARM32   --arm64 = AArch64")
    oLine("  App types:         set by the 'app' directive in the source, e.g.")
    oLine("                     app linux  |  app arm64  |  app stm32  |  app android")
    oLine("                     app efi | bare | bios | wasm | console | gui ...")
    oLine("                     'app android' emits a static arm64-v8a ELF (API 21+); see")
    oLine("                     release/документация/21_android.txt")
    oLine("  zenith new <name>                   Create a new project")
    oLine("  zenith new --lib <name>             Create a new DLL project")
    oLine("  zenith build                        Build project from workspace.zen")
    oLine("  zenith build --lib                  Build as DLL")
    oLine("  zenith disasm <file> <start> <end>  Disassemble a VA range of a built ELF/PE")
    oLine("                                   using the built-in disassembler blob")
    oLine("                                   (--att=|AT&T, --no-addr=hide address)")
    return 0
end

# ===================== C/C++ mix: драйверская половина =====================
#
# Порт driver-половины src/mix.cpp (addSource/prelinkWindows) на сисколлы:
# компилятор/линковщик запускаются через zLaunchQuiet/zLaunchOut (src/zio.z),
# файлы читаются zReadFile. Разбор объектов и вся раскладка — в кодогене
# (src/cg_mix.z + src/mixobj.z); сюда приходят только запуски процессов и
# файловое манипулирование.

var zMixKeptN: int = 0           # сохранённые .o (KO — ld -r, PE — prelink)
var zMixKeptObj: [64]int

# ZAST-id -> NUL-строка (argv/execve, сообщения)
func zMixCStr(id: int) -> int
    var n: int = cgStrLen(id)
    var buf: int = alloc(n + 1)
    var i: int = 0
    while i < n
        poke8(buf + i, peek8(cgStrPtr(id) + i))
        i = i + 1
    end
    poke8(buf + i, 0)
    return buf
end

# ZAST-id ПАРСЕРСКОЙ арены (azStr) -> NUL-строка: ошибки разбора .o живут
# в арене парсера (gStrBase), а zMixCStr читает cg-space (cgStrBase)
func zMixPStr(id: int) -> int
    var n: int = azStrLen(id)
    var buf: int = alloc(n + 1)
    var i: int = 0
    while i < n
        poke8(buf + i, peek8(azStrPtr(id) + i))
        i = i + 1
    end
    poke8(buf + i, 0)
    return buf
end

# скрейч-строитель NUL-строк (свежий alloc на каждый Begin — без алиасинга)
var zMxBuf: int = 0
var zMxBN: int = 0

func zMxBegin()
    zMxBuf = alloc(4096)
    zMxBN = 0
end

func zMxBLit(lit: int)
    var n: int = zLen(lit)
    var i: int = 0
    while i < n && zMxBN < 4090
        poke8(zMxBuf + zMxBN, peek8(lit + i))
        zMxBN = zMxBN + 1
        i = i + 1
    end
end

func zMxBId(id: int)
    var n: int = cgStrLen(id)
    var i: int = 0
    while i < n && zMxBN < 4090
        poke8(zMxBuf + zMxBN, peek8(cgStrPtr(id) + i))
        zMxBN = zMxBN + 1
        i = i + 1
    end
end

func zMxBInt(v: int)
    var digits: [24]int
    var dn: int = 0
    if v == 0
        digits[0] = 0
        dn = 1
    end
    var t: int = v
    while t > 0
        digits[dn] = t % 10
        dn = dn + 1
        t = t / 10
    end
    var i: int = dn
    while i > 0
        i = i - 1
        if zMxBN < 4090
            poke8(zMxBuf + zMxBN, 48 + digits[i])
            zMxBN = zMxBN + 1
        end
    end
end

func zMxBEnd() -> int
    poke8(zMxBuf + zMxBN, 0)
    return zMxBuf
end

# каталог для временных .o (C++: temp_directory_path() = $TMPDIR | /tmp)
func zMxTmpDir() -> int
    var t: int = zGetEnv("TMPDIR")
    if t == 0 || peek8(t) == 0
        return "/tmp"
    end
    return t
end

# <tmp>/zenith_mix_<idx>_<c|cpp>.o (mix.cpp:168..170)
func zMxObjPath(idx: int, isCpp: int) -> int
    zMxBegin()
    zMxBLit(zMxTmpDir())
    zMxBLit("/zenith_mix_")
    zMxBInt(idx)
    if isCpp == 1
        zMxBLit("_cpp.o")
    else
        zMxBLit("_c.o")
    end
    return zMxBEnd()
end

# sibling-инструмент тулчейна: <dir><triple>-gcc -> <dir><triple>-<suffix>,
# иначе голый <suffix> (mix.cpp:296..306)
func zMixSiblingTool(cc: int, suffix: int) -> int
    var cut: int = -1
    var i: int = 0
    while i < zLen(cc)
        if peek8(cc + i) == 47
            cut = i
        end
        i = i + 1
    end
    zMxBegin()
    var baseFrom: int = 0
    if cut >= 0
        var j: int = 0
        while j <= cut
            poke8(zMxBuf + zMxBN, peek8(cc + j))
            zMxBN = zMxBN + 1
            j = j + 1
        end
        baseFrom = cut + 1
    end
    var blen: int = zLen(cc) - baseFrom
    if blen > 4
        var dash: int = 1
        var k: int = 0
        while k < 4
            if peek8(cc + baseFrom + blen - 4 + k) != peek8("-gcc" + k)
                dash = 0
            end
            k = k + 1
        end
        if dash == 1
            var m: int = 0
            while m < blen - 4
                poke8(zMxBuf + zMxBN, peek8(cc + baseFrom + m))
                zMxBN = zMxBN + 1
                m = m + 1
            end
            zMxBLit("-")
            zMxBLit(suffix)
            return zMxBEnd()
        end
    end
    zMxBLit(suffix)
    return zMxBEnd()
end

# probeToolchainFile (mix.cpp:276..288): `cc -print-file-name=<lib>` в файл,
# обрезка пробелов; "" -> 0 (не найдено/совпадает с сырым именем).
func zMixProbeToolchainFile(cc: int, lib: int) -> int
    zMxBegin()
    zMxBLit(zMxTmpDir())
    zMxBLit("/zenith_probe.txt")
    var outp: int = zMxBEnd()
    var argv: [4]int
    argv[0] = cc
    zMxBegin()
    zMxBLit("-print-file-name=")
    zMxBLit(lib)
    argv[1] = zMxBEnd()
    argv[2] = 0
    var pid: int = zLaunchOut(&argv, outp)
    zWait(pid)
    var ln: int = 0
    var buf: int = zReadFileQuiet(outp, &ln)
    zRemove(outp)
    if buf == 0 || ln == 0
        return 0
    end
    # обрезка хвостовых пробелов/переводов (mix.cpp:283..285)
    var e2: int = ln
    var stop: int = 0
    while e2 > 0 && stop == 0
        var c: int = peek8(buf + e2 - 1)
        if c == 10 || c == 13 || c == 32
            e2 = e2 - 1
        else
            stop = 1
        end
    end
    if e2 == 0
        return 0
    end
    if e2 == zLen(lib)
        var same: int = 1
        var i: int = 0
        while i < e2
            if peek8(buf + i) != peek8(lib + i)
                same = 0
            end
            i = i + 1
        end
        if same == 1
            return 0
        end
    end
    zMxBegin()
    var i2: int = 0
    while i2 < e2
        poke8(zMxBuf + zMxBN, peek8(buf + i2))
        zMxBN = zMxBN + 1
        i2 = i2 + 1
    end
    return zMxBEnd()
end

func zMixKeepObj(objPath: int)
    if zMixKeptN < 64
        zMixKeptObj[zMixKeptN] = objPath
        zMixKeptN = zMixKeptN + 1
    end
end

# addSource (mix.cpp:111..223): компиляция gcc/clang/мингв + регистрация
# разобранного объекта в кодогене. Возвращает 0 = ок.
func zMixAddSource(path: int, isCpp: int) -> int
    if zExists(path) == 0
        zMxBegin()
        zMxBLit("source file not found: ")
        zMxBLit(path)
        eprint("Error: ")
        eprintln(zMxBEnd())
        return 1
    end
    var argv: [40]int
    var n: int = 0
    var tgt: int = cgMixTarget
    if tgt == 1
        # WindowsPE: mingw (mix.cpp:121..131)
        if isCpp == 1
            argv[n] = "/usr/bin/x86_64-w64-mingw32-g++"
        else
            argv[n] = "/usr/bin/x86_64-w64-mingw32-gcc"
        end
        n = n + 1
        argv[n] = "-c"
        n = n + 1
        argv[n] = "-ffreestanding"
        n = n + 1
        argv[n] = "-fno-builtin"
        n = n + 1
        argv[n] = "-fno-pie"
        n = n + 1
        argv[n] = "-fno-pic"
        n = n + 1
        argv[n] = "-fno-asynchronous-unwind-tables"
        n = n + 1
        argv[n] = "-fno-unwind-tables"
        n = n + 1
        argv[n] = "-ffunction-sections"
        n = n + 1
        argv[n] = "-fdata-sections"
        n = n + 1
        argv[n] = "-g0"
        n = n + 1
        argv[n] = "-D__USE_MINGW_ANSI_STDIO=0"
        n = n + 1
        argv[n] = "-D_CRTIMP="
        n = n + 1
        argv[n] = "-D__MINGW_IMPORT="
        n = n + 1
    else
        if tgt == 4
            # AArch64: clang (mix.cpp:133..138)
            if isCpp == 1
                argv[n] = "/usr/bin/clang++"
            else
                argv[n] = "/usr/bin/clang"
            end
            n = n + 1
            argv[n] = "--target=aarch64-none-elf"
            n = n + 1
            argv[n] = "-c"
            n = n + 1
            argv[n] = "-ffreestanding"
            n = n + 1
            argv[n] = "-fno-builtin"
            n = n + 1
            argv[n] = "-fno-pic"
            n = n + 1
            argv[n] = "-fno-pie"
            n = n + 1
            argv[n] = "-fno-asynchronous-unwind-tables"
            n = n + 1
            argv[n] = "-fno-unwind-tables"
            n = n + 1
            argv[n] = "-ffunction-sections"
            n = n + 1
            argv[n] = "-fdata-sections"
            n = n + 1
            argv[n] = "-mno-implicit-float"
            n = n + 1
            argv[n] = "-g0"
            n = n + 1
        else
            # Linux/Flat/KO (mix.cpp:152..156)
            if isCpp == 1
                argv[n] = "/usr/bin/g++"
            else
                argv[n] = "/usr/bin/gcc"
            end
            n = n + 1
            argv[n] = "-c"
            n = n + 1
            argv[n] = "-ffreestanding"
            n = n + 1
            argv[n] = "-fno-builtin"
            n = n + 1
            argv[n] = "-fno-pie"
            n = n + 1
            argv[n] = "-fno-pic"
            n = n + 1
            argv[n] = "-mno-red-zone"
            n = n + 1
            argv[n] = "-fno-asynchronous-unwind-tables"
            n = n + 1
            argv[n] = "-fno-unwind-tables"
            n = n + 1
            argv[n] = "-ffunction-sections"
            n = n + 1
            argv[n] = "-fdata-sections"
            n = n + 1
            argv[n] = "-fcf-protection=none"
            n = n + 1
        end
    end
    argv[n] = cgMixCOptFlag()
    n = n + 1
    if isCpp == 1
        argv[n] = "-fno-exceptions"
        n = n + 1
        argv[n] = "-fno-rtti"
        n = n + 1
        argv[n] = "-fno-threadsafe-statics"
        n = n + 1
    end
    argv[n] = "-o"
    n = n + 1
    argv[n] = zMxObjPath(zMixKeptN, isCpp)
    n = n + 1
    argv[n] = path
    n = n + 1
    argv[n] = 0
    var rc: int = zMixRun(&argv)
    if rc != 0
        # C++ печатает полную команду (mix.cpp:179); собираем её из argv
        zMxBegin()
        var i: int = 0
        while i < n && argv[i] != 0
            if i > 0
                zMxBLit(" ")
            end
            zMxBLit(argv[i])
            i = i + 1
        end
        eprint("Error: C/C++ compile failed (command: ")
        eprint(zMxBEnd())
        eprintln(")")
        return 1
    end
    var objPath: int = argv[n - 2]
    var olen: int = 0
    var obuf: int = zReadFile(objPath, &olen)
    if obuf == 0
        eprintln("Error: could not parse compiler output object")
        return 1
    end
    var zp: int = azStr(path, zLen(path))
    if cgMixAddObjectBytes(obuf, olen, isCpp, zp) != 0
        eprint("Error: ")
        eprintln(zMixPStr(cgMixErrStr()))
        return 1
    end
    # судьба .o: KO — остаётся для ld -r, PE — для prelinkWindows (mix.cpp:190..198)
    if cgMixTarget == 3 || cgMixTarget == 1
        zMixKeepObj(objPath)
    else
        zRemove(objPath)
    end
    return 0
end

func zMixRun(argv: int) -> int
    var pid: int = zLaunchQuiet(argv)
    return zWait(pid)
end

func zMixRunOut(argv: int, outp: int) -> int
    var pid: int = zLaunchOut(argv, outp)
    return zWait(pid)
end

# пробы хост-библиотек для resolve'а (syslibs.cpp:146..160): kind + размер
# + soname поставщика — в таблицу, которую читает src/cg_mix.z
func zMixProbeOne(sym: int)
    var nsym: int = zMixPStr(sym)
    eprintln(nsym)
    var file: int = zSysProviderFile(nsym)
    if file == 0
        return
    end
    var kind: int = 0
    var size: int = zParseElfDynSym(file, nsym, &kind)
    var i: int = zLen(file)
    var base: int = file
    var stop: int = 0
    while i > 0 && stop == 0
        if peek8(file + i - 1) == 47
            base = file + i
            stop = 1
        end
        i = i - 1
    end
    cgMixProbePut(sym, kind, size, azStr(base, zLen(base)))
end

func zMixFillProbes()
    var k: int = 0
    while k < cgMixUndefFuncCount()
        zMixProbeOne(cgMixUndefFuncAt(k))
        k = k + 1
    end
    k = 0
    while k < cgMixUndefDataCount()
        zMixProbeOne(cgMixUndefDataAt(k))
        k = k + 1
    end
end

# ld -r --allow-multiple-definition -o <out> --start-group <inputs> <libs> --end-group
# (mix.cpp:379..387); inputs/libs — массивы указателей на NUL-строки
var zMixLdTool: int = 0

func zMixLdR(out: int, inputs: int, inN: int, libs: int, libN: int) -> int
    var argv: [80]int
    var n: int = 0
    argv[n] = zMixLdTool
    n = n + 1
    argv[n] = "-r"
    n = n + 1
    argv[n] = "--allow-multiple-definition"
    n = n + 1
    argv[n] = "-o"
    n = n + 1
    argv[n] = out
    n = n + 1
    argv[n] = "--start-group"
    n = n + 1
    var i: int = 0
    while i < inN
        argv[n] = peek(inputs + i * 8)
        n = n + 1
        i = i + 1
    end
    i = 0
    while i < libN
        argv[n] = peek(libs + i * 8)
        n = n + 1
        i = i + 1
    end
    argv[n] = "--end-group"
    n = n + 1
    argv[n] = 0
    return zMixRun(&argv)
end

# prelinkWindows (mix.cpp:290..440): mingw CRT-клей (libmingwex/libmingw32/
# libgcc/libgcc_eh + статические члены libmsvcrt) схлопывается через два
# прохода `ld -r` в один relocatable-объект; msvcrt/libstdc++ остаются
# динамическими импортами.
func zMixPrelinkWindows() -> int
    if cgMixTarget != 1 || zMixKeptN == 0
        return 0
    end
    var cc: int = zGetEnv("ZENITH_MINGW_CC")
    if cc == 0 || peek8(cc) == 0
        cc = "/usr/bin/x86_64-w64-mingw32-gcc"
    end
    zMixLdTool = zMixSiblingTool(cc, "ld")
    var ar: int = zMixSiblingTool(cc, "ar")

    # CRT-архивы (mix.cpp:308..317)
    var libs: [8]int
    var libN: int = 0
    var p: int = zMixProbeToolchainFile(cc, "libmingwex.a")
    if p != 0
        libs[libN] = p
        libN = libN + 1
    end
    p = zMixProbeToolchainFile(cc, "libmingw32.a")
    if p != 0
        libs[libN] = p
        libN = libN + 1
    end
    p = zMixProbeToolchainFile(cc, "libgcc.a")
    if p != 0
        libs[libN] = p
        libN = libN + 1
    end
    p = zMixProbeToolchainFile(cc, "libgcc_eh.a")
    if p != 0
        libs[libN] = p
        libN = libN + 1
    end
    if libN == 0
        eprintln("Error: WindowsPE mix: mingw CRT archives not found (is the x86_64-w64-mingw32 toolchain installed?)")
        return 1
    end

    # статические `_common_a-`/`_extra_a-` члены libmsvcrt.a (mix.cpp:324..374)
    var libmsvcrt: int = zMixProbeToolchainFile(cc, "libmsvcrt.a")
    if libmsvcrt != 0
        zMxBegin()
        zMxBLit(zMxTmpDir())
        zMxBLit("/zenith_arlist.txt")
        var listp: int = zMxBEnd()
        var argv2: [4]int
        argv2[0] = ar
        argv2[1] = "t"
        argv2[2] = libmsvcrt
        argv2[3] = 0
        zMixRunOut(&argv2, listp)
        var ln: int = 0
        var lb: int = zReadFileQuiet(listp, &ln)
        zRemove(listp)
        if lb != 0 && ln > 0
            var members: [32]int
            var mN: int = 0
            var i: int = 0
            var lineStart: int = 0
            while i <= ln
                var atEnd: int = 0
                if i == ln
                    atEnd = 1
                else
                    if peek8(lb + i) == 10
                        atEnd = 1
                    end
                end
                if atEnd == 1
                    var l: int = i - lineStart
                    if l > 0
                        var m: int = azStr(lb + lineStart, l)
                        if cgStrHasPrefix(m, "_common_a-") == 1 || cgStrHasPrefix(m, "_extra_a-") == 1
                            if mN < 32
                                members[mN] = m
                                mN = mN + 1
                            end
                        end
                    end
                    lineStart = i + 1
                end
                i = i + 1
            end
            if mN > 0
                zMxBegin()
                zMxBLit(zMxTmpDir())
                zMxBLit("/zenith_msvcrt_static")
                var msDir: int = zMxBEnd()
                zMkdir(msDir)
                zMxBegin()
                zMxBLit(msDir)
                zMxBLit("/libzenith_msvcrt_static.a")
                var msvcrtStatic: int = zMxBEnd()
                # ar x --output=<msDir> <libmsvcrt> <members...>
                var xa: [40]int
                xa[0] = ar
                zMxBegin()
                zMxBLit("--output=")
                zMxBLit(msDir)
                xa[1] = zMxBEnd()
                xa[2] = libmsvcrt
                var ai: int = 3
                var mi2: int = 0
                while mi2 < mN
                    xa[ai] = members[mi2]
                    ai = ai + 1
                    mi2 = mi2 + 1
                end
                xa[ai] = 0
                if zMixRun(&xa) == 0
                    # ar rcs <static.a> <msDir>/<member>...
                    var ra: [40]int
                    ra[0] = ar
                    ra[1] = "rcs"
                    ra[2] = msvcrtStatic
                    var ri2: int = 3
                    mi2 = 0
                    while mi2 < mN
                        zMxBegin()
                        zMxBLit(msDir)
                        zMxBLit("/")
                        zMxBId(members[mi2])
                        ra[ri2] = zMxBEnd()
                        ri2 = ri2 + 1
                        mi2 = mi2 + 1
                    end
                    ra[ri2] = 0
                    if zMixRun(&ra) == 0
                        libs[libN] = msvcrtStatic
                        libN = libN + 1
                    end
                end
            end
        end
    end

    zMxBegin()
    zMxBLit(zMxTmpDir())
    zMxBLit("/zenith_mix_win_glue.o")
    var combPath: int = zMxBEnd()
    zMxBegin()
    zMxBLit(zMxTmpDir())
    zMxBLit("/zenith_mix_win_glue.o.1")
    var pass1: int = zMxBEnd()

    # два прохода: первый тянет клей, второй закрывает его собственные
    # неопределённые (mix.cpp:394..404)
    if zMixLdR(pass1, &zMixKeptObj, zMixKeptN, &libs, libN) != 0
        eprintln("Error: WindowsPE mix: CRT glue prelink failed")
        return 1
    end
    var one: [1]int
    one[0] = pass1
    if zMixLdR(combPath, &one, 1, &libs, libN) != 0
        eprintln("Error: WindowsPE mix: second CRT glue prelink pass failed")
        return 1
    end

    var olen: int = 0
    var obuf: int = zReadFile(combPath, &olen)
    # удалить per-source объекты и промежуточный (mix.cpp:416..417)
    var di: int = 0
    while di < zMixKeptN
        zRemove(zMixKeptObj[di])
        di = di + 1
    end
    zMixKeptN = 0
    zRemove(pass1)
    if obuf == 0
        eprintln("Error: could not parse prelinked CRT glue object")
        return 1
    end
    # полная перерегистрация состояния с одним схлопнутым объектом
    # (mix.cpp:421..438)
    var keepCpp: int = cgMixHasCpp
    cgMixReset()
    cgMixTarget = MIX_PE
    cgMixHasCpp = keepCpp
    var zp: int = azStr(combPath, zLen(combPath))
    if cgMixAddObjectBytes(obuf, olen, keepCpp, zp) != 0
        eprint("Error: ")
        eprintln(zMixPStr(cgMixErrStr()))
        return 1
    end
    zMixKeepObj(combPath)
    return 0
end

# ===================== main =====================

func main(argc: int, argv: int) -> int
    # Static bug check controls are accepted in every mode (build, new, ...).
    var bugOn: int = 1
    var bugStrict: int = 0
    # getenv запрещён директивой «только syscall»; zGetEnv (src/zio.z) читает
    # /proc/self/environ сырым сисколлом — та же семантика (0 = нет переменной).
    if zGetEnv("ZT_NO_BUGFIND") != 0
        bugOn = 0
    end
    var i: int = 1
    while i < argc
        var a: int = peek(argv + i * 8)
        if sEq(a, "--bugfind")
            bugOn = 1
            bugStrict = 1
        else
            if sEq(a, "--no-bugfind")
                bugOn = 0
            end
        end
        i = i + 1
    end

    if argc < 2
        printUsage()
        return 1
    end

    var arg1: int = peek(argv + 8)
    if sEq(arg1, "new")
        var newLib: int = 0
        var name: int = 0
        var j: int = 2
        while j < argc
            var a: int = peek(argv + j * 8)
            if sEq(a, "--lib")
                newLib = 1
            else
                if peek8(a) != 45
                    if name != 0
                        eprint("Warning: extra argument '")
                        eprint(a)
                        eprintln("' ignored")
                    else
                        name = a
                    end
                end
            end
            j = j + 1
        end
        if name == 0
            name = ""
        end
        return cmdNew(name, newLib)
    end
    if sEq(arg1, "build")
        var bLib: int = 0
        var b: int = 2
        while b < argc
            if sEq(peek(argv + b * 8), "--lib")
                bLib = 1
            end
            b = b + 1
        end
        return cmdBuild(bLib, bugOn, bugStrict)
    end
    if sEq(arg1, "disasm")
        # как в main.cpp:1218 — аргументы НАЧИНАЮТСЯ с argv[2] (argv[0] —
        # бинарник, argv[1] — само слово "disasm")
        return mDisasm(argc - 2, argv + 16)
    end

    # ---- single-file mode ----
    var inputFile: int = 0
    var inputs: [64]int
    var inputN: int = 0
    var outputArg: int = 0
    var libMode: int = 0
    var libsMode: int = 0
    var embedMode: int = 0
    var isoMode: int = 0
    var noOpt: int = 0
    var objMode: int = 0
    var debugInfo: int = 0
    var watchMode: int = 0
    var ccMode: int = 0
    var optR: int = -1
    var optS: int = 0
    var optD: int = 0
    var optMax: int = 1
    var archOpt: int = 0

    sSet(&gOut, "a.exe")

    i = 1
    while i < argc
        var a: int = peek(argv + i * 8)
        if sEq(a, "--version") || sEq(a, "-v")
            printVersion()
            return 0
        end
        if sEq(a, "--lib")
            libMode = 1
        else if sEq(a, "--libs")
            libsMode = 1
        else if sEq(a, "--embed")
            embedMode = 1
        else if sEq(a, "--iso")
            isoMode = 1
        else if sEq(a, "--ir")
            errLine("--ir is not available here: the IR pipeline is being rewritten")
            return 1
        else if sEq(a, "--no-opt")
            noOpt = 1
        else if sEq(a, "--obj")
            objMode = 1
        else if sEq(a, "-g") || sEq(a, "--debug")
            debugInfo = 1
        else if sEq(a, "-0r") || sEq(a, "--0r")
            optR = 0
        else if sEq(a, "-1r") || sEq(a, "--1r")
            optR = 1
        else if sEq(a, "-2r") || sEq(a, "--2r")
            optR = 2
        else if sEq(a, "-3r") || sEq(a, "--3r")
            optR = 3
        else if sEq(a, "--speed")
            optS = 3
        else if sEq(a, "-0s") || sEq(a, "--0s")
            optS = 0
        else if sEq(a, "-1s") || sEq(a, "--1s")
            optS = 1
        else if sEq(a, "-2s") || sEq(a, "--2s")
            optS = 2
        else if sEq(a, "-3s") || sEq(a, "--3s")
            optS = 3
        else if sEq(a, "-0d") || sEq(a, "--0d")
            optD = 0
        else if sEq(a, "-1d") || sEq(a, "--1d")
            optD = 1
        else if sEq(a, "-2d") || sEq(a, "--2d")
            optD = 2
        else if sEq(a, "-3d") || sEq(a, "--3d")
            optD = 3
        else if sEq(a, "--32bit")
            archOpt = 1
        else if sEq(a, "--64bit")
            archOpt = 2
        else if sEq(a, "--arm")
            archOpt = 3
        else if sEq(a, "--arm64")
            archOpt = 4
        else if sEq(a, "--watch")
            watchMode = 1
        else if sEq(a, "-o")
            if i + 1 < argc
                outputArg = peek(argv + (i + 1) * 8)
                i = i + 1
            else
                eprintln("Error: -o requires an output filename")
                return 1
            end
        else if sEq(a, "--cc") || sEq(a, "--cxx")
            if i + 1 < argc
                var mixFile: int = peek(argv + (i + 1) * 8)
                if sEq(a, "--cxx") == 1
                    if gCxxN >= 0 && gCxxN < 64
                        gCxxs[gCxxN] = mixFile
                        gCxxN = gCxxN + 1
                    end
                else
                    if gCcN >= 0 && gCcN < 64
                        gCcs[gCcN] = mixFile
                        gCcN = gCcN + 1
                    end
                end
                ccMode = 1
                i = i + 1
            else
                eprint("Error: ")
                eprint(a)
                eprintln(" requires a source file")
                return 1
            end
        else
            if peek8(a) != 45
                if inputN >= 64
                    eprintln("Error: too many input files")
                    return 1
                end
                var dup: int = 0
                var di: int = 0
                while di < inputN
                    if sEq(inputs[di], a) == 1
                        dup = 1
                    end
                    di = di + 1
                end
                if dup == 0
                    inputs[inputN] = a
                    inputN = inputN + 1
                end
                if inputFile == 0
                    inputFile = a
                end
            end
        end
        i = i + 1
    end

    if inputFile == 0
        eprintln("Error: no input file specified")
        printUsage()
        return 1
    end
    if outputArg != 0
        sSet(&gOut, outputArg)
    end

    var exeDir: int = zExeDirStr()

    # --libs: compile into <exe_dir>/libs/<basename>.so
    if libsMode == 1
        libMode = 1
        sSet(&gTmp, exeDir)
        sAdd(&gTmp, "/libs")
        zMkdir(&gTmp)
        sAdd(&gTmp, "/")
        var s: int = compStart(inputFile)
        var d: int = compDot(inputFile)
        var endOfStem: int = mSLen(inputFile)
        if d > s
            endOfStem = d
        end
        sAddRange(&gTmp, inputFile, s, endOfStem)
        sAdd(&gTmp, ".so")
        sSet(&gOut, &gTmp)
    end

    # ---- read the source ----
    var src: int = 0
    var srcLen: int = 0
    if mReadFiles(&inputs, inputN, &src, &srcLen) != 0
        errLine(zioErr())
        return 1
    end

    # ---- splice include "file.z" ----
    var incDir: int = mDirOf(inputFile)
    zgReset()
    zPreprocessIncludes(src, srcLen, incDir, 0)
    var spliced: int = zgFinish()
    if zpErrIs() != 0
        errLine(zioErr())
        return 1
    end
    src = zpCopy(spliced, zgLen)
    srcLen = mSLen(src)

    # ---- expand `use <module>` (the standard library) ----
    # Директива no_main в квадратных скобках — заголовочная директива
    # главного файла (см. stripHeaderDirectives): флаг берём ДО экспансии,
    # иначе любой `use`-модуль переводит программу в библиотеку одним
    # упоминанием маркера в комментарии (этот комментарий как раз того
    # и избегает — иначе компиляция самой main.z дала бы .so).
    var sourceIsLib: int = zHasNoMain(src, srcLen)
    var appType: [64]int
    if zScanAppType(src, srcLen, &appType, 64) == 0
        sSet(&appType, "")
    end
    var slash: int = compStart(inputFile)
    sSet(&gDir, "")
    if slash > 0
        sAddRange(&gDir, inputFile, 0, slash - 1)
    else
        sSet(&gDir, ".")
    end
    zgReset()
    zExpandUse(src, srcLen, &gDir, &appType)
    if zpErrIs() != 0
        errLine(zioErr())
        return 1
    end
    var expanded: int = src
    if zUseChanged() == 1
        expanded = zpCopy(zgFinish(), zgLen)
    end
    src = expanded
    srcLen = mSLen(src)

    # ---- front end ----
    var prc: int = parseRun(src, srcLen)
    var prog: int = parseOutPtr()
    gProgLen = parseOutLen()
    src = 0
    if prc == 1
        eprint("Lexer error: ")
        eprintln(parseErrMsg())
        return 1
    end
    if prc == 2
        eprint("Lexer error at line ")
        sSet(&gMsg, "")
        sAddInt(&gMsg, parseErrLine())
        eprint(&gMsg)
        eprint(": ")
        eprintln(parseErrMsg())
        return 1
    end
    if prc == 3
        eprint("Parser error: ")
        eprintln(parseErrMsg())
        return 1
    end

    # ---- configuration: arch / app validation / object mode ----
    var cfgFlags: int = 0
    if objMode == 1
        cfgFlags = cfgFlags + CFG_OBJ
    end
    if libMode == 1
        cfgFlags = cfgFlags + CFG_LIB
    end
    if sourceIsLib == 1
        cfgFlags = cfgFlags + CFG_NO_MAIN
    end
    var archStr: int = ""
    if archOpt == 1
        archStr = "32bit"
    end
    if archOpt == 2
        archStr = "64bit"
    end
    if archOpt == 3
        archStr = "arm"
    end
    if archOpt == 4
        archStr = "arm64"
    end
    if mConfigure(cfgFlags, archStr) != 0
        errLine(zioErr())
        return 1
    end

    if pHasFuncs() == 0
        eprintln("Error: no functions found in source")
        return 1
    end

    # ===== C/C++ mixing: compile --cc/--cxx sources, parse the objects =====
    # Порт main.cpp:1509..1589 на чистый .z: gcc/ld — через сисколлы
    # (zLaunchQuiet/zLaunchOut), разбор и раскладка — src/cg_mix.z.
    if gCcN > 0 || gCxxN > 0
        var mt: int = pAppType()
        if mt == APP_STM32 || mt == APP_WASM
            eprintln("Error: C/C++ mixing is not supported for this target")
            return 1
        end
        if mt == APP_ANDROID
            eprintln("Error: C/C++ mixing is not supported for 'app android' yet (the AArch64 objects would need Bionic, not the host glibc)")
            return 1
        end
        cgMixReset()
        var mtgt: int = MIX_FLAT
        if gProgKo == 1
            mtgt = MIX_KO
        else if mt == APP_ARM64
            mtgt = MIX_ARM64
        else if mt == APP_LINUX
            mtgt = MIX_LINUX
        else if gProgLib == 1 || mt == APP_EFI || mt == APP_CONSOLE || mt == APP_GUI
            mtgt = MIX_PE
        end
        cgMixTarget = mtgt
        # уровень -O для C/C++-микса = максимум по активным осям (r/s/d)
        var cOpt: int = 1
        var amax: int = optR
        if optS > amax
            amax = optS
        end
        if optD > amax
            amax = optD
        end
        if amax >= 0
            cOpt = amax
        end
        cgMixCOpt = cOpt
        var mi: int = 0
        while mi < gCcN
            if zMixAddSource(gCcs[mi], 0) != 0
                return 1
            end
            mi = mi + 1
        end
        mi = 0
        while mi < gCxxN
            if zMixAddSource(gCxxs[mi], 1) != 0
                return 1
            end
            mi = mi + 1
        end
        # PE: схлопывание CRT-клея mingw в один объект (mix.cpp:1548..1554)
        if cgMixTarget == MIX_PE
            if zMixPrelinkWindows() != 0
                return 1
            end
        end
        # предупреждения (main.cpp:1555..1557)
        mi = 0
        while mi < cgMixWarnCount()
            eprint("Warning: ")
            eprintln(zMixCStr(cgMixWarnAt(mi)))
            mi = mi + 1
        end
        # "Mixing N C/C++ source(s) (C/C++)" (main.cpp:1558..1562)
        if cgMixHasAny == 1
            sSet(&gMsg, "Mixing ")
            sAddInt(&gMsg, gCcN + gCxxN)
            sAdd(&gMsg, " C/C++ source(s) (")
            if cgMixHasCpp == 1
                sAdd(&gMsg, "C++")
            else
                sAdd(&gMsg, "C")
            end
            sAdd(&gMsg, ")")
            oLine(&gMsg)
        end
        # PE: инъекция IAT-импортов для неопределённых символов (main.cpp:
        # 1569..1588) стоит на PE-слое buildImportData — layer 2, как и
        # сам PE-контейнер; честная ошибка вместо тихой несостоятельности.
        if cgMixTarget == MIX_PE
            eprintln("Error: WindowsPE mixing needs the PE import layer (layer 2) of the .z backend")
            return 1
        end
        # Linux: пробы хост-библиотек ДО кодогена — resolve() читает таблицу
        if cgMixTarget == MIX_LINUX
            zMixFillProbes()
        end
    end

    # ---- --watch: live-reload loop (main.cpp does it here too) ----
    if watchMode == 1
        if prog == 0 || libMode == 1 || libsMode == 1 || embedMode == 1
            eprintln("Error: --watch cannot be combined with library/embed mode")
            return 1
        end
        var wt: int = pAppType()
        if wt != APP_CONSOLE && wt != APP_GUI && wt != APP_LINUX
            eprintln("Error: --watch (live reload) works only for 'app console', 'app gui', and 'app linux' targets")
            return 1
        end
        var watchRc: int = 0
        if collectSourceFiles(inputFile) != 0
            watchRc = 1
        else
            gProgPath = peek(argv)
            gOutPtr = &gOut
            var ca: int = 1
            while ca < argc
                var aa: int = peek(argv + ca * 8)
                if sEq(aa, "--watch") == 0
                    if gChildN >= 0 && gChildN < 31
                        gChildArgs[gChildN] = aa
                        gChildN = gChildN + 1
                    end
                end
                ca = ca + 1
            end
            var q: int = 0
            gArgv[q] = gProgPath
            q = 1
            while q - 1 < gChildN
                gArgv[q] = gChildArgs[q - 1]
                q = q + 1
            end
            gArgv[q] = 0
            gGameArgv[0] = gOutPtr
            gGameArgv[1] = 0
            watchRc = cmdWatch()
        end
        return watchRc
    end

    # ---- static bug check (before the optimizer, so it sees the source as
    #      written) ----
    if mBugFind(prog, inputFile, bugOn, bugStrict) != 0
        return 1
    end

    # ---- optimize (cliLevel default lives in zffi_optimize) ----
    if noOpt == 0
        var allowPow2: int = 0
        var t: int = pAppType()
        if t == APP_STM32 || t == APP_ARM64 || t == APP_ANDROID || t == APP_WASM
            allowPow2 = 1
        end
        mOptimize(prog, optR, optS, optD, allowPow2)
    end

    # ---- output file name ----
    var t: int = pAppType()
    if t == APP_EFI
        if sEq(&gOut, "a.exe")
            sSet(&gOut, "BOOTX64.EFI")
        else if sEndsWith(&gOut, ".efi") == 0 && sEndsWith(&gOut, ".EFI") == 0
            sSet(&gOut, mkSibling(&gOut, ".efi"))
        end
    end
    if t == APP_BARE || t == APP_STM32 || (t == APP_BIOS && isoMode == 1)
        if sEq(&gOut, "a.exe")
            sSet(&gOut, "a.bin")
        else
            sSet(&gOut, mkExt(&gOut, ".bin"))
        end
    end
    if pReal16() == 1
        if sEq(&gOut, "a.exe") || mSLen(&gOut) == 0
            sSet(&gOut, "a.bin")
        else
            sSet(&gOut, mkExt(&gOut, ".bin"))
        end
    end
    if t == APP_WASM
        if sEq(&gOut, "a.exe") || mSLen(&gOut) == 0
            sSet(&gOut, "a.wasm")
        else
            sSet(&gOut, mkExt(&gOut, ".wasm"))
        end
    end
    if t == APP_LINUX
        if gProgObj == 1
            if sEq(&gOut, "a.exe") || mSLen(&gOut) == 0
                sSet(&gOut, "a.o")
            else
                sSet(&gOut, mkExt(&gOut, ".o"))
            end
        else if gProgKo == 1
            if sEq(&gOut, "a.exe") || mSLen(&gOut) == 0
                sSet(&gOut, "a.ko")
            else
                sSet(&gOut, mkExt(&gOut, ".ko"))
            end
        else
            var ext: int = ".elf"
            if sourceIsLib == 1 || libMode == 1
                ext = ".so"
            end
            if sEq(&gOut, "a.exe") || mSLen(&gOut) == 0
                sSet(&gOut, "a")
                sAdd(&gOut, ext)
            else
                sSet(&gOut, mkExt(&gOut, ext))
            end
        end
    end

    # ---- ISO image path (same parent/stem rule as std::filesystem) ----
    var isoPath: int = 0
    if isoMode == 1
        isoPath = mkSibling(&gOut, ".iso")
    end

    # ---- codegen ----
    var cgFlags: int = 0
    if debugInfo == 1
        if t == APP_BIOS || t == APP_BARE || t == APP_ARM64 || t == APP_ANDROID || t == APP_WASM || pArch() != ARCH_X86_64 || pReal16() == 1
            eprintln("Warning: DWARF debug info is not supported for this target; ignoring -g/--debug")
        else
            cgFlags = cgFlags + CG_DEBUG
        end
    end
    if embedMode == 1
        cgFlags = cgFlags + CG_EMBED
    end
    if sourceIsLib == 1 || libMode == 1
        cgFlags = cgFlags + CG_LIB
    end
    if libMode == 1
        cgFlags = cgFlags + CG_LIBOUT
    end

    # mCodegen печатает ошибки сам (как zffi_codegen через gErr)
    if mCodegen(&gOut, exeDir, isoPath, cgFlags) != 0
        return 1
    end

    return 0
end
