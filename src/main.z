# ===================== buffers =====================
# Driver buffers are byte-granular (poke8/peek8) though declared as int
# arrays: an int element is just 8 bytes of storage here.

var gMsg: [8192]int
var gNum: [32]int
var gDir: [4096]int
var gTmp: [4096]int
var gOut: [4096]int
var gProj: [4096]int
