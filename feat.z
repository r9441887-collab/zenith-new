app console

func main() -> int
    js_reset()

    var ok: int = 0

    var e1: int = js_eval("if (1e308 > 9e307) { 1 } else { 0 }")
    ok = ok + e1
    var e2: int = js_eval("var x = 1e308; if (x < 2e308) { 1 } else { 0 }")
    ok = ok + e2
    var e3: int = js_eval("if (1e-3 > 0.0009) { 1 } else { 0 }")
    ok = ok + e3
    var f1: int = js_eval("if (Infinity > 1e308) { 1 } else { 0 }")
    ok = ok + f1
    var f2: int = js_eval("if (isFinite(1/0) == false && isFinite(42)) { 1 } else { 0 }")
    ok = ok + f2
    var f3: int = js_eval("if (NaN != NaN && isNaN(0/0)) { 1 } else { 0 }")
    ok = ok + f3
    var c1: int = js_eval("if (null == 0) { 0 } else { 1 }")
    ok = ok + c1
    var c2: int = js_eval("if (undefined == 0) { 0 } else { 1 }")
    ok = ok + c2
    var c3: int = js_eval("if (null == undefined) { 1 } else { 0 }")
    ok = ok + c3
    var p1: int = js_eval("if (isNaN(parseInt('xyz'))) { 1 } else { 0 }")
    ok = ok + p1
    var s1: int = js_eval("if ('  hi  '.trim() == 'hi') { 1 } else { 0 }")
    ok = ok + s1
    var s2: int = js_eval("if ('Hello World'.startsWith('Hello') && 'Hello World'.endsWith('World')) { 1 } else { 0 }")
    ok = ok + s2
    var s3: int = js_eval("if ('Hello World'.includes('lo Wo')) { 1 } else { 0 }")
    ok = ok + s3
    var s4: int = js_eval("if ('ab'.repeat(3) == 'ababab') { 1 } else { 0 }")
    ok = ok + s4
    var s5: int = js_eval("var c = 'A'.charCodeAt(0); if (c == 65) { 1 } else { 0 }")
    ok = ok + s5
    var s6: int = js_eval("if (String.fromCharCode(72,105) == 'Hi') { 1 } else { 0 }")
    ok = ok + s6
    var a1: int = js_eval("var a = [1,2,3]; a.reverse(); if (a.join(',') == '3,2,1') { 1 } else { 0 }")
    ok = ok + a1
    var a2: int = js_eval("if ([1,2].concat([3,4]).join(',') == '1,2,3,4') { 1 } else { 0 }")
    ok = ok + a2
    var a3: int = js_eval("if ([1,2,3,4].includes(3) && !4 == false) { 1 } else { 0 }")
    ok = ok + a3
    var a4: int = js_eval("var t = 0; [1,2,3,4].forEach(function(v){ t = t + v; }); if (t == 10) { 1 } else { 0 }")
    ok = ok + a4
    var a5: int = js_eval("var m = [1,2,3].map(function(v){ return v * v; }); if (m.join(',') == '1,4,9') { 1 } else { 0 }")
    ok = ok + a5
    var a6: int = js_eval("var f = [1,2,3,4,5,6].filter(function(v){ return v % 2 == 0; }); if (f.join(',') == '2,4,6') { 1 } else { 0 }")
    ok = ok + a6
    var o1: int = js_eval("var o = {a:1}; Object.assign(o,{b:2,c:3},{d:4}); if (o.a + o.b + o.c + o.d == 10) { 1 } else { 0 }")
    ok = ok + o1

    if ok != 23
        print("FEAT FAIL ok=")
        print(ok)
        print(" expected 23\n")
        return 1
    end
    print("FEAT OK ok=23\n")
    return 0
    end