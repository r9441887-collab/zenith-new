app gui tool

@import("kernel32.dll")

extern func GetModuleFileNameA(h: int, buf: int, n: int) -> int from "kernel32.dll"
extern func VirtualAlloc(addr: int, size: int, type: int, protect: int) -> int from "kernel32.dll"
extern func FindFirstFileA(name: int, data: int) -> int from "kernel32.dll"
extern func FindNextFileA(h: int, data: int) -> int from "kernel32.dll"
extern func GetFileAttributesA(name: int) -> int from "kernel32.dll"

var g_pBuf: int = 0

func valloc(size: int) -> int
    var p: int = VirtualAlloc(0, size, 0x3000, 0x40)
    return p
end

func sb_text(p: int)
    while peek8(p) != 0
        poke8(g_pBuf, peek8(p))
    end
end

func main() -> int
    g_pBuf = valloc(512)
    var n: int = GetModuleFileNameA(0, g_pBuf, 512)
    createWindow(640, 320, g_pBuf)
    loop
        if processMessages() == 0
            break
        end
        clear(0xFF101018)
        drawRect(10, 10, 20, 20, 0xFF50FF50)
        drawText(30, 12, g_pBuf, 0xFFFFFFFF)
        present()
        sleep(0.016)
        if getKey(0x1B) == 1
            break
        end
    end
    closeWindow()
    return 0
end
