app gui dx tool

# 3D rotating cube (DirectX 11) - flat per-face colors for clean depth perception
# 24 vertices (4 per face, each face solid color), 36 R16_UINT indices.
# Rotation computed on the HOST each frame (angle accumulates), ca/sa/cb/sb
# passed to the VS through a constant buffer. No sin/cos in the shader
# (wine's HLSL lacks them), so the shader itself is pure multiply/add.

var F1: int = 0x3F800000    # 1.0
var FN1: int = 0xBF800000   # -1.0
var F05: int = 0x3F000000   # 0.5
var F00: int = 0            # 0.0

func vert(pos: int, x: int, y: int, z: int, r: int, g: int, b: int, a: int)
    poke32(pos, x)
    poke32(pos + 4, y)
    poke32(pos + 8, z)
    poke32(pos + 12, r)
    poke32(pos + 16, g)
    poke32(pos + 20, b)
    poke32(pos + 24, a)
end

func main() -> int
    createWindow(800, 600, "DX11 3D Cube")

    # --- vertex buffer: 24 vertices, 28 bytes each = 672 bytes ---
    var vp: int = alloc(672)
    # face 0: z=-1 (back), RED
    vert(vp + 0  * 28, FN1, FN1, FN1, F1, F00, F00, F1)
    vert(vp + 1  * 28, F1,  FN1, FN1, F1, F00, F00, F1)
    vert(vp + 2  * 28, F1,  F1,  FN1, F1, F00, F00, F1)
    vert(vp + 3  * 28, FN1, F1,  FN1, F1, F00, F00, F1)
    # face 1: z=+1 (front), GREEN
    vert(vp + 4  * 28, FN1, FN1, F1, F00, F1, F00, F1)
    vert(vp + 5  * 28, F1,  FN1, F1, F00, F1, F00, F1)
    vert(vp + 6  * 28, F1,  F1,  F1, F00, F1, F00, F1)
    vert(vp + 7  * 28, FN1, F1,  F1, F00, F1, F00, F1)
    # face 2: x=-1 (left), BLUE
    vert(vp + 8  * 28, FN1, FN1, FN1, F00, F00, F1, F1)
    vert(vp + 9  * 28, FN1, F1,  FN1, F00, F00, F1, F1)
    vert(vp + 10 * 28, FN1, F1,  F1,  F00, F00, F1, F1)
    vert(vp + 11 * 28, FN1, FN1, F1,  F00, F00, F1, F1)
    # face 3: x=+1 (right), YELLOW
    vert(vp + 12 * 28, F1,  FN1, FN1, F1, F1, F00, F1)
    vert(vp + 13 * 28, F1,  FN1, F1,  F1, F1, F00, F1)
    vert(vp + 14 * 28, F1,  F1,  F1,  F1, F1, F00, F1)
    vert(vp + 15 * 28, F1,  F1,  FN1, F1, F1, F00, F1)
    # face 4: y=-1 (bottom), CYAN
    vert(vp + 16 * 28, FN1, FN1, FN1, F00, F1, F1, F1)
    vert(vp + 17 * 28, FN1, FN1, F1,  F00, F1, F1, F1)
    vert(vp + 18 * 28, F1,  FN1, F1,  F00, F1, F1, F1)
    vert(vp + 19 * 28, F1,  FN1, FN1, F00, F1, F1, F1)
    # face 5: y=+1 (top), MAGENTA
    vert(vp + 20 * 28, FN1, F1,  FN1, F1, F00, F1, F1)
    vert(vp + 21 * 28, FN1, F1,  F1,  F1, F00, F1, F1)
    vert(vp + 22 * 28, F1,  F1,  F1,  F1, F00, F1, F1)
    vert(vp + 23 * 28, F1,  F1,  FN1, F1, F00, F1, F1)

    # --- index buffer: 36 x uint16 = 72 bytes (18 packed dwords) ---
    var ip: int = alloc(72)
    # face0 (verts 0-3): 0,1,2 2,3,0
    poke32(ip + 0  * 4, (0) | (1 << 16))
    poke32(ip + 1  * 4, (2) | (2 << 16))
    poke32(ip + 2  * 4, (3) | (0 << 16))
    # face1 (verts 4-7): 5,4,7 7,6,5
    poke32(ip + 3  * 4, (5) | (4 << 16))
    poke32(ip + 4  * 4, (7) | (7 << 16))
    poke32(ip + 5  * 4, (6) | (5 << 16))
    # face2 (verts 8-11, x=-1): 8,9,10 10,11,8
    poke32(ip + 6  * 4, (8) | (9 << 16))
    poke32(ip + 7  * 4, (10) | (10 << 16))
    poke32(ip + 8  * 4, (11) | (8 << 16))
    # face3 (verts 12-15, x=+1): 12,13,14 14,15,12
    poke32(ip + 9  * 4, (12) | (13 << 16))
    poke32(ip + 10 * 4, (14) | (14 << 16))
    poke32(ip + 11 * 4, (15) | (12 << 16))
    # face4 (verts 16-19, y=-1): 16,17,18 18,19,16
    poke32(ip + 12 * 4, (16) | (17 << 16))
    poke32(ip + 13 * 4, (18) | (18 << 16))
    poke32(ip + 14 * 4, (19) | (16 << 16))
    # face5 (verts 20-23, y=+1): 20,23,22 22,21,20
    poke32(ip + 15 * 4, (20) | (23 << 16))
    poke32(ip + 16 * 4, (22) | (22 << 16))
    poke32(ip + 17 * 4, (21) | (20 << 16))

    # --- per-frame rotation params: cbuffer { float4 cs; float4 cs2; } = 32 bytes ---
    # layout: cs.x=ca, cs.y=sa, cs.z=0, cs.w=0 | cs2.x=cb2, cs2.y=sb, cs2.z=0, cs2.w=0
    var rot: int = alloc(32)
    poke32(rot + 0,  F1)
    poke32(rot + 4,  F00)
    poke32(rot + 8,  F00)
    poke32(rot + 12, F00)
    poke32(rot + 16, F1)
    poke32(rot + 20, F00)
    poke32(rot + 24, F00)
    poke32(rot + 28, F00)

    # --- shaders (HLSL must be passed as a single literal string) ---
    var vs: int = dxCreateVertexShader("cbuffer CB : register(b0) { float4 cs; float4 cs2; }; struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float ca = cs.x; float sa = cs.y; float x = ca*i.pos.x + sa*i.pos.z; float z = -sa*i.pos.x + ca*i.pos.z; float cb2 = cs2.x; float sb = cs2.y; float y = cb2*i.pos.y - sb*z; float z2 = sb*i.pos.y + cb2*z; float f = 2.0 / (z2 + 5.0); VOut o; o.pos = float4(x*f, y*f, (z2 + 1.0) * 0.5, 1); o.col = i.col; return o; }")
    var ps: int = dxCreatePixelShader("struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; float4 main(VOut i) : SV_Target { return i.col; }")

    # --- resources ---
    var layout: int = dxCreateInputLayout("cbuffer CB : register(b0) { float4 cs; float4 cs2; }; struct VIn { float3 pos : POSITION; float4 col : COLOR; }; struct VOut { float4 pos : SV_Position; float4 col : COLOR; }; VOut main(VIn i) { float ca = cs.x; float sa = cs.y; float x = ca*i.pos.x + sa*i.pos.z; float z = -sa*i.pos.x + ca*i.pos.z; float cb2 = cs2.x; float sb = cs2.y; float y = cb2*i.pos.y - sb*z; float z2 = sb*i.pos.y + cb2*z; float f = 2.0 / (z2 + 5.0); VOut o; o.pos = float4(x*f, y*f, (z2 + 1.0) * 0.5, 1); o.col = i.col; return o; }",
        "POSITION", 6, 0,
        "COLOR",    2, 12)
    var vbuf: int = dxCreateBuffer(672, vp)
    var ibuf: int = dxCreateBuffer(72, ip)
    var cb: int = dxCreateConstantBuffer(32, rot)

    print(vs) print(ps) print(layout) print(cb)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 28)
    dxSetIndexBuffer(ibuf)
    dxSetVertexConstants(cb)
    dxSetTopology(4)

    var ang: float = 0.0

    loop
        if processMessages() == 0
            break
        end
        ang = ang + 0.05
        var ca: float = cos(ang)
        var sa: float = sin(ang)
        var cb2: float = cos(ang * 0.8)
        var sb: float = sin(ang * 0.8)
        poke32(rot + 0, fbits(ca))
        poke32(rot + 4, fbits(sa))
        poke32(rot + 16, fbits(cb2))
        poke32(rot + 20, fbits(sb))
        dxUpdateBuffer(cb, rot)
        dxClearDepthStencil()
        dxDrawIndexed(36)
        dxProbeGPU()
        present()
        sleep(0.016)
        if getKey(0x1B) == 1
            break
        end
    end

    closeWindow()
    return 0
end