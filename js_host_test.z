app console

func main() -> int
    print("host fs test\n")

    js_reset()
    js_eval("__writeFile('jhost.txt','hello host'); 1;")
    var wl: int = js_eval("var n = __readFile('jhost.txt').length; n;")
    print("read len  = ")
    print(wl)
    print("\n")

    var cmp: int = js_eval("var c = __readFile('jhost.txt'); (c == 'hello host') ? 1 : 0;")
    print("read cmp  = ")
    print(cmp)
    print("\n")

    var ex: int = js_eval("__exists('jhost.txt') ? 1 : 0;")
    print("exists    = ")
    print(ex)
    print("\n")

    var cd: int = js_eval("var d = __getCwd(); d.length;")
    print("getcwd len= ")
    print(cd)
    print("\n")

    print("HOST FS TESTS DONE\n")
    return 0
end