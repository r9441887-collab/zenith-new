app gui dx tool

# Yellow triangle but INDEXED (uses the same index+draww path as the cube).
# Isolates whether dxSetIndexBuffer + dxDrawIndexed work at all.

func main() -> int
    createWindow(600, 400, "tridx")

    # 3 vertices, float2 POSITION = 8 bytes each = 24 bytes
    var p: int = alloc(48)
    poke32(p, 0x3F800000)      # ( 1.0,  1.0)
    poke32(p + 4, 0x3F800000)
    poke32(p + 8, 0xBF800000)  # (-1.0,  1.0)
    poke32(p + 12, 0x3F800000)
    poke32(p + 16, 0)          # ( 0.0, -1.0)
    poke32(p + 20, 0xBF800000)

    # index buffer: 3 x uint16. indexes 0,1,2 -> int32 packed = 0 | 1<<16 ... but
    # need 3 uint16 = 6 bytes. Use one poke32 (2 indices) + handle 3rd.
    var ip: int = alloc(8)
    poke32(ip, (0) | (1 << 16))  # indices 0,1
    poke32(ip + 4, 2)            # index 2 (only low 2 bytes used)

    var vs: int = dxCreateVertexShader("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var ps: int = dxCreatePixelShader("float4 main() : SV_Target { return float4(1, 1, 0, 1); }")
    var layout: int = dxCreateInputLayout("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var vbuf: int = dxCreateBuffer(24, p)
    var ibuf: int = dxCreateBuffer(8, ip)
    print(vs)
    print(ps)
    print(layout)
    print(vbuf)
    print(ibuf)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 8)
    dxSetIndexBuffer(ibuf)
    dxSetTopology(4)

    var running: int = 1
    while running == 1
        dxDrawIndexed(3)
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end
    closeWindow()
    return 0
end
