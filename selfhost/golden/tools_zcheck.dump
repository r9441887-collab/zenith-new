  if (bin == (id atEnd) (num 1) p=0) @1340
   if (bin > (id i) (id ls) p=0) @1341
    var e: int = (id ls) array=0 const=0 @1343
    while (bin && (bin && (bin < (id e) (id i) p=0) (bin != (call peek8 rec=- args=[(bin + (id text) (id e) p=0)] virt=0) (num 32) p=0) p=0) (bin != (call peek8 rec=- args=[(bin + (id text) (id e) p=0)] virt=0) (num 9) p=0) p=0) @1344
     assign e = (bin + (id e) (num 1) p=0) @1345
    end
    if (bin > (id e) (id ls) p=0) @1347
     var srcBuf: int = (call alloc rec=- args=[(bin + (bin - (id e) (id ls) p=0) (num 1) p=0)] virt=0) array=0 const=0 @1349
     var k: int = (num 0) array=0 const=0 @1350
     while (bin < (id k) (bin - (id e) (id ls) p=0) p=0) @1351
      expr (call poke8 rec=- args=[(bin + (id srcBuf) (id k) p=0),(call peek8 rec=- args=[(bin + (bin + (id text) (id ls) p=0) (id k) p=0)] virt=0)] virt=0) @1352
      assign k = (bin + (id k) (num 1) p=0) @1353
     end
     expr (call poke8 rec=- args=[(bin - (bin + (id srcBuf) (id e) p=0) (id ls) p=0),(num 0)] virt=0) @1355
     if (bin == (call checkOne rec=- args=[(id srcBuf)] virt=0) (num 0) p=0) @1356
      assign pass = (bin + (id pass) (num 1) p=0) @1357
     else
      assign fail = (bin + (id fail) (num 1) p=0) @1359
     end
    end
   end
   assign ls = (bin + (id i) (num 1) p=0) @1363
  end
  assign i = (bin + (id i) (num 1) p=0) @1365
 end
 expr (call print rec=- args=[(str "zcheck: ")] virt=0) @1367
 expr (call print rec=- args=[(id pass)] virt=0) @1368
 expr (call print rec=- args=[(str " OK, ")] virt=0) @1369
 expr (call print rec=- args=[(id fail)] virt=0) @1370
 expr (call print rec=- args=[(str " failed\n")] virt=0) @1371
 if (bin > (id fail) (num 0) p=0) @1372
  return (num 1) @1373
 end
 return (num 0) @1375
end
