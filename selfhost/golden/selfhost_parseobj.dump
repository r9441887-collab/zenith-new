   var ch: int = (num 0) array=0 const=0 @774
   if (bin == (id esc) (num 110) p=0) @775
    assign ch = (num 10) @776
   else
    if (bin == (id esc) (num 116) p=0) @778
     assign ch = (num 9) @779
    else
     if (bin == (id esc) (num 114) p=0) @781
      assign ch = (num 13) @782
