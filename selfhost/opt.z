# Порт src/optimizer.cpp (2308 строк) на ZAST — «часть 22».
#
# Как и lower.z, файл НЕ делает собственных `use`: он вставляется в сплайс
# через `use opt` в parser.z ПОСЛЕ `use ast`/`use lower`, поэтому здесь уже
# доступны az*/N_* (ast), numLo/numHi/gPErr/azStrLitEq (parser), strLen
# (lexer). Вызовы вперёд (numLo) работают — как в lower.z.
#
# Модель отличий от C++:
#   * unique_ptr<Expr>& -> возврат нового id; родитель пишет через azSet;
#   * std::unordered_set/map<строки> -> линейные таблицы записей stride 6,
#     ключ = strId, сравнение ВСЕГДА по содержимому (azStrEq): azStr не
#     дедуплицирует имена, поэтому strId != имя;
#   * блоки: (start,len)-окна в side; удаление/вставка stmt = пересборка
#     окна через azListBegin/Push/End (старое окно остаётся мусором, side
#     append-only); неизменившееся окно НЕ трогаем (иначе churn роняет
#     SIDE_CAP за 9 пассов × 5 итераций);
#   * N_FLOAT сравнивается ПО ЗНАЧЕНИЮ (как double == в C++): текст
#     парсится тем же decimal-конвертером, что cg_emit.z (копия — opt не
#     может зависеть от cg_*: parseobj.o собирается без кодогена);
#   * итерационный порядок unordered_* не влияет на результат (все обходы
#     детерминированы порядком prog.functions/блоков);
#   * residual-состояние localKinds_ воспроизведено: таблица чистится ровно
#     там, где чистит C++ (collectLocalKinds), поэтому propagateLocals и
#     cleanupIfShapes читают «хвост» от simplifyExprs как в эталоне.
#
# Включение: optScanDirectives(src,len) читает `# zt-opt=N` (первая строка)
# и маркер «нет main» — `# [` + `no_main]` (порт hasNoMain из main.cpp);
# optRun() зовёт parseRun перед azBuild(), только если gOptLevel > 0.
# Эталон (zenith -Nr) идёт своим путём: gOptLevel в parseobj.o C++-процесса
# всегда 0, дирекву там никто не читает — двойной оптимизации не бывает.
#
# Соответствие функций optimizer.cpp: см. имена o* построчно.

# ---------- константы ----------

# TypeKind (ast.h): Int=0 Float=1 Bool=2 Void=3 String=4 ... Struct=9
const TK_FLOAT: int = 1
const TK_VOID: int = 3
const TK_STRING: int = 4
const TK_STRUCT: int = 9

const I64_MIN: int = -9223372036854775807 - 1
const I64_MAX: int = 9223372036854775807

# ---------- состояние ----------

# уровень и режим библиотеки — из optScanDirectives
var gOptLevel: int = 0
var gOptIsLib: int = 0

# OptResult (optimizer.h)
var gORm: int = 0      # removedStatements
var gOSr: int = 0      # strengthReduced
var gOProp: int = 0    # propagated
var gORf: int = 0      # removedFunctions
var gORg: int = 0      # removedGlobals

# allowPow2Div_ (speed-пасс; false для classic-x86 целей, true для ARM64/
# WASM/STM32/Android — но speedReduce целиком зависит ещё и от prog.arch)
var gOAllowPow2: int = 1

# ============ ТРИ ОСИ ОПТИМИЗАЦИЙ (r=ram, s=speed, d=disk) ============
# Каждая ось несёт свой уровень 0..3 и ВЫБИРАЕТСЯ ОТДЕЛЬНО:
#   -0r..-3r  — оперативная память (стек/куча/временные)
#   -0s..-3s  — скорость исполнения
#   -0d..-3d  — размер на диске (бинарь)
# Проход помечен МАСКОЙ ОСЕЙ (1=R, 2=S, 4=D) и УРОВНЕМ (tier 1..3) и
# выполняется, если ХОТЯ БЫ ОДНА активная ось покрывает его tier.
#
# Комбинация осей считается «совместной»: каждая additional ось даёт
# накладные расходы на пересекающиеся проходы (см. oEffCompute):
#   1 ось  -> 100%   2 оси -> 90%   3 оси -> 98% (плюс конфликтные
# проходы отключаются целиком — см. oConflictSkip).
var gOAxisR: int = 0
var gOAxisS: int = 0
var gOAxisD: int = 0
var gOEff: int = 100        # оценка эффективности комбинации в %
var gOActiveN: int = 0      # сколько осей включено

# упаковка трёх осей в одно слово (обратная совместимость: старый level N
# == ось R уровня N, т.к. s=d=0 -> N % 8 == N)
func oPackAxes(r: int, s: int, d: int) -> int
    return r + s * 8 + d * 64
end

func oAxisR() -> int
    return gOAxisR
end

# маска осей: 1=R, 2=S, 4=D; tier — минимальный уровень прохода
func oAxisHas(mask: int, tier: int) -> int
    if (mask & 1) != 0 && gOAxisR >= tier
        return 1
    end
    if (mask & 2) != 0 && gOAxisS >= tier
        return 1
    end
    if (mask & 4) != 0 && gOAxisD >= tier
        return 1
    end
    return 0
end

# конфликт прохода с активной осью (passId произвольный ключ)
# 1=inline, 2=speedReduce, 3=pow2prod ... — задаётся при вызове
func oConflictSkip(passId: int, mask: int) -> int
    # inlineTiny растит бинарь -> против оси D (disk)
    if passId == 1 && (mask & 4) != 0 && gOAxisD > 0
        return 1
    end
    # speedReduce (деление->сдвиги) не даёт выигрыша памяти -> против R
    if passId == 2 && (mask & 1) != 0 && gOAxisR > 0 && gOAxisS == 0
        return 1
    end
    return 0
end

func oEffCompute()
    var n: int = 0
    if gOAxisR > 0
        n = n + 1
    end
    if gOAxisS > 0
        n = n + 1
    end
    if gOAxisD > 0
        n = n + 1
    end
    gOActiveN = n
    if n <= 1
        gOEff = 100
    else
        if n == 2
            gOEff = 90
        else
            gOEff = 98
        end
    end
end

# переполнение линейных таблиц — опт прерывать нельзя (пулы уже мутированы),
# поэтому флаг только информационный: паритет упадёт явно, а не молча
var gOFull: int = 0

# out-регистры helper'ов (в z нет out-параметров)
var gOI64: int = 0     # результат exprIsConstInt
var gOSh: int = 0      # результат oIsPow2
var gOK0: int = 0      # kindOfExpr .kind
var gOK1: int = 0      # kindOfExpr .structName (strId)

# ---------- линейные таблицы (stride 6: key,v0,v1,v2,v3,v4) ----------
# key == 0 — пустая запись (azStr никогда не возвращает 0).

const T8: int = 49152    # 8192 записей
const T4: int = 24576    # 4096 записей

var gTbReach: [49152]int    # reachable: имена достижимых user-функций
var gTbExtn: [24576]int     # usedExterns
var gTbGlUsed: [24576]int   # usedGlobals
var gTbFnUser: [49152]int   # isUserFunc: имена не-extern функций, v0 = funcId
var gTbGlSet: [24576]int    # isGlobal: имена глобалов
var gTbLocK: [49152]int     # localKinds_: v0 = kind, v1 = structName
var gTbGlK: [24576]int      # globalKinds_: v0 = kind, v1 = structName
var gTbFrK: [49152]int      # funcRetKinds_: v0 = kind, v1 = structName
var gTbFdK: [24576]int      # fieldKinds_: key = structStr, v0 = fieldStr, v1 = kind
var gTbKnown: [49152]int    # propagateLocals known: v0=isConst v1=lo v2=hi v3=isAlias v4=alias
var gTbAddr: [24576]int     # addrTaken
var gTbAsn: [24576]int      # assigned
var gTbLocals: [49152]int   # locals (DSE/propagate)
var gTbLocRd: [49152]int    # localReads
var gTbGlRd: [24576]int     # programGlobalsRead
var gTbTiny: [24576]int     # tiny-функции: v0 = funcId

var gNReach: int = 0
var gNExtn: int = 0
var gNGlUsed: int = 0
var gNFnUser: int = 0
var gNGlSet: int = 0
var gNLocK: int = 0
var gNGlK: int = 0
var gNFrK: int = 0
var gNFdK: int = 0
var gNKnown: int = 0
var gNAddr: int = 0
var gNAsn: int = 0
var gNLocals: int = 0
var gNLocRd: int = 0
var gNGlRd: int = 0
var gNTiny: int = 0

# ---------- таблицы: базовые операции ----------

# адрес слота поля f узла id: azGet читает nodeAddr + 8 + f*4 (первые
# 8 байт — tag+line), поэтому слоты-обходы обязаны добавлять те же 8
func azFldAddr(id: int, f: int) -> int
    var a: int = azNodeAddr(id)
    return a + 8 + f * 4
end

func oRecFind(t: int, n: int, cap: int, key: int) -> int
    var i: int = 0
    while i < n
        if azStrEq(peek32(t + i * 24), key) == 1
            return i
        end
        i = i + 1
    end
    return -1
end

func oRecAdd(t: int, n: int, cap: int, key: int) -> int
    var i: int = 0
    while i < n
        if azStrEq(peek32(t + i * 24), key) == 1
            return i
        end
        i = i + 1
    end
    if n >= cap
        gOFull = 1
        return -1
    end
    poke32(t + n * 24, key)
    return n
end

func oSetHas(t: int, n: int, key: int) -> int
    var i: int = 0
    while i < n
        if azStrEq(peek32(t + i * 24), key) == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

# fieldKinds: композитный ключ (structName, field) — парный поиск. C++
# склеивает "S.f" через operator+; пара (a,b) даёт ту же эквивалентность.
func oFdFind(n: int, a: int, b: int) -> int
    var i: int = 0
    while i < n
        if azStrEq(peek32(gPFdK + i * 24), a) == 1
            if azStrEq(peek32(gPFdK + i * 24 + 4), b) == 1
                return i
            end
        end
        i = i + 1
    end
    return -1
end

func oFdAdd(n: int, a: int, b: int) -> int
    var s: int = oFdFind(n, a, b)
    if s >= 0
        return s
    end
    if n >= 4096
        gOFull = 1
        return -1
    end
    poke32(gPFdK + n * 24, a)
    poke32(gPFdK + n * 24 + 4, b)
    return n
end

func oTabReset()
    oTbBind()
    gORm = 0
    gOSr = 0
    gOProp = 0
    gORf = 0
    gORg = 0
    gOFull = 0
    gNReach = 0
    gNExtn = 0
    gNGlUsed = 0
    gNFnUser = 0
    gNGlSet = 0
    gNLocK = 0
    gNGlK = 0
    gNFrK = 0
    gNFdK = 0
    gNKnown = 0
    gNAddr = 0
    gNAsn = 0
    gNLocals = 0
    gNLocRd = 0
    gNGlRd = 0
    gNTiny = 0
end

# ---------- утилиты по числам/строкам (зеркало optimizer.cpp) ----------

func oNumVal(e: int) -> int
    var a: int = azNodeAddr(e)
    var lo: int = peek32(a + 8)
    var hi: int = peek32(a + 12)
    return (hi << 32) | lo
end

func oMakeNum(v: int) -> int
    var n: int = azNew(N_NUMBER, 0)
    azSet(n, 0, numLo(v))
    azSet(n, 1, numHi(v))
    return n
end

func oMakeUnary(op: int, operand: int) -> int
    var u: int = azNew(N_UNARY, 0)
    azSet(u, 0, op)
    azSet(u, 1, operand)
    return u
end

func oMakeBinary(op: int, left: int, right: int) -> int
    var b: int = azNew(N_BINARY, 0)
    azSet(b, 0, left)
    azSet(b, 1, right)
    azSet(b, 2, op)
    azSet(b, 3, 0)
    return b
end

func oIsPow2(v: int) -> int
    # возвращает степень или -1 (isPow2Const); v > 0
    if v <= 0
        return -1
    end
    var s: int = 0
    while (v & 1) == 0
        v = v >> 1
        s = s + 1
    end
    if v == 1
        return s
    end
    return -1
end

func oOpIs(op: int, lit: int) -> int
    return azStrLitEq(op, lit)
end

# ---------- decimal -> float (копия cgParseFloatPtr из cg_emit.z) ----------
# opt.z входит в parseobj.o (без кодогена), поэтому своя копия.

func oParseF(p: int, n: int) -> float
    var i: int = 0
    var mant: int = 0
    var digits: int = 0
    var exp10: int = 0
    var c: int = 0
    while i < n
        c = peek8(p + i)
        if c < 48 || c > 57
            break
        end
        if digits < 18
            mant = mant * 10 + (c - 48)
            digits = digits + 1
        else
            exp10 = exp10 + 1
        end
        i = i + 1
    end
    if i < n && peek8(p + i) == 46
        i = i + 1
        while i < n
            c = peek8(p + i)
            if c < 48 || c > 57
                break
            end
            if digits < 18
                mant = mant * 10 + (c - 48)
                digits = digits + 1
                exp10 = exp10 - 1
            end
            i = i + 1
        end
    end
    if i < n && (peek8(p + i) == 101 || peek8(p + i) == 69)
        i = i + 1
        var neg: int = 0
        if i < n && peek8(p + i) == 43
            i = i + 1
        end
        if i < n && peek8(p + i) == 45
            i = i + 1
            neg = 1
        end
        var e: int = 0
        while i < n
            c = peek8(p + i)
            if c < 48 || c > 57
                break
            end
            e = e * 10 + (c - 48)
            i = i + 1
        end
        if neg == 1
            exp10 = exp10 - e
        else
            exp10 = exp10 + e
        end
    end
    if mant == 0
        return 0.0
    end
    var v: float = itof(mant)
    while exp10 > 0
        v = v * 10.0
        exp10 = exp10 - 1
    end
    while exp10 < 0
        v = v / 10.0
        exp10 = exp10 + 1
    end
    return v
end

func oFloatVal(e: int) -> float
    var sid: int = azGet(e, 0)
    var v: float = oParseF(azStrPtr(sid), azStrLen(sid))
    if azGet(e, 1) != 0
        v = 0.0 - v
    end
    return v
end

# ---------- exprIsConstInt (554-591) ----------

func oIsConstInt(e: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_NUMBER
        gOI64 = oNumVal(e)
        return 1
    end
    if t == N_UNARY
        if oIsConstInt(azGet(e, 1)) == 0
            return 0
        end
        var cv: int = gOI64
        if oOpIs(azGet(e, 0), "-") == 1
            gOI64 = 0 - cv
            return 1
        end
        if oOpIs(azGet(e, 0), "!") == 1
            if cv == 0
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(azGet(e, 0), "~") == 1
            gOI64 = ~cv
            return 1
        end
        return 0
    end
    if t == N_BINARY
        if oIsConstInt(azGet(e, 0)) == 0
            return 0
        end
        var l: int = gOI64
        if oIsConstInt(azGet(e, 1)) == 0
            return 0
        end
        var r: int = gOI64
        var op: int = azGet(e, 2)
        if oOpIs(op, "+") == 1
            gOI64 = l + r
            return 1
        end
        if oOpIs(op, "-") == 1
            gOI64 = l - r
            return 1
        end
        if oOpIs(op, "*") == 1
            gOI64 = l * r
            return 1
        end
        if oOpIs(op, "/") == 1
            if r == 0
                return 0
            end
            if l == I64_MIN && r == 0 - 1
                return 0
            end
            gOI64 = l / r
            return 1
        end
        if oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
            if r == 0
                return 0
            end
            if l == I64_MIN && r == 0 - 1
                return 0
            end
            gOI64 = l % r
            return 1
        end
        if oOpIs(op, "&") == 1
            gOI64 = l & r
            return 1
        end
        if oOpIs(op, "|") == 1
            gOI64 = l | r
            return 1
        end
        if oOpIs(op, "^") == 1
            gOI64 = l ^ r
            return 1
        end
        if oOpIs(op, "<<") == 1
            gOI64 = l << (r & 63)
            return 1
        end
        if oOpIs(op, ">>") == 1
            gOI64 = l >> (r & 63)
            return 1
        end
        if oOpIs(op, "==") == 1
            if l == r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, "!=") == 1
            if l != r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, "<") == 1
            if l < r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, "<=") == 1
            if l <= r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, ">") == 1
            if l > r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, ">=") == 1
            if l >= r
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, "&&") == 1
            if l != 0 && r != 0
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        if oOpIs(op, "||") == 1
            if l != 0 || r != 0
                gOI64 = 1
            else
                gOI64 = 0
            end
            return 1
        end
        return 0
    end
    return 0
end

# ---------- exprMayHaveSideEffects (791-810) ----------

func oMaySide(e: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_NUMBER || t == N_FLOAT || t == N_STRING || t == N_IDENT
        return 0
    end
    if t == N_UNARY
        return oMaySide(azGet(e, 1))
    end
    if t == N_BINARY
        if oMaySide(azGet(e, 0)) == 1
            return 1
        end
        return oMaySide(azGet(e, 1))
    end
    if t == N_MEMBER
        return oMaySide(azGet(e, 0))
    end
    if t == N_ARRAYACC
        if oMaySide(azGet(e, 0)) == 1
            return 1
        end
        return oMaySide(azGet(e, 1))
    end
    if t == N_DEREF
        return oMaySide(azGet(e, 0))
    end
    if t == N_ADDROF
        return 0
    end
    if t == N_CALL
        return 1
    end
    return 1
end

# ---------- sameExpr (1091-1122) ----------

func oSame(a: int, b: int) -> int
    if a == 0 || b == 0
        if a == b
            return 1
        end
        return 0
    end
    var ta: int = azTag(a)
    var tb: int = azTag(b)
    if ta == N_NUMBER
        if tb == N_NUMBER
            if oNumVal(a) == oNumVal(b)
                return 1
            end
            return 0
        end
    end
    if ta == N_FLOAT
        if tb == N_FLOAT
            if oFloatVal(a) == oFloatVal(b)
                return 1
            end
            return 0
        end
    end
    if ta == N_STRING
        if tb == N_STRING
            if azStrEq(azGet(a, 0), azGet(b, 0)) == 1
                return 1
            end
            return 0
        end
    end
    if ta == N_IDENT
        if tb == N_IDENT
            if azStrEq(azGet(a, 0), azGet(b, 0)) == 1
                return 1
            end
            return 0
        end
    end
    if ta == N_UNARY
        if tb == N_UNARY
            if azStrEq(azGet(a, 0), azGet(b, 0)) == 1
                return oSame(azGet(a, 1), azGet(b, 1))
            end
            return 0
        end
    end
    if ta == N_BINARY
        if tb == N_BINARY
            if azStrEq(azGet(a, 2), azGet(b, 2)) == 1
                if oSame(azGet(a, 0), azGet(b, 0)) == 1
                    return oSame(azGet(a, 1), azGet(b, 1))
                end
            end
            return 0
        end
    end
    if ta == N_MEMBER
        if tb == N_MEMBER
            if azStrEq(azGet(a, 1), azGet(b, 1)) == 1
                return oSame(azGet(a, 0), azGet(b, 0))
            end
            return 0
        end
    end
    if ta == N_DEREF
        if tb == N_DEREF
            return oSame(azGet(a, 0), azGet(b, 0))
        end
    end
    if ta == N_CALL
        if tb == N_CALL
            if azStrEq(azGet(a, 0), azGet(b, 0)) == 1
                if azGet(a, 3) == azGet(b, 3)
                    var as: int = azGet(a, 2)
                    var bs: int = azGet(b, 2)
                    var k: int = 0
                    while k < azGet(a, 3)
                        if oSame(peek32(gSideBase + (as + k) * 4), peek32(gSideBase + (bs + k) * 4)) == 0
                            return 0
                        end
                        k = k + 1
                    end
                    return 1
                end
                return 0
            end
            return 0
        end
    end
    return 0
end

# ---------- cloneExpr (11-51) ----------
# Зеркало C++ дословно: AddressOfExpr клонирует ТОЛЬКО name (target в C++
# не переносится) — сохраняем и это поведение.

func oClone(e: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_NUMBER || t == N_FLOAT || t == N_STRING || t == N_IDENT
        var c: int = azNew(t, 0)
        azSet(c, 0, azGet(e, 0))
        if t == N_NUMBER
            azSet(c, 1, azGet(e, 1))
        end
        if t == N_FLOAT
            azSet(c, 1, azGet(e, 1))
        end
        return c
    end
    if t == N_ADDROF
        var ca: int = azNew(N_ADDROF, 0)
        azSet(ca, 0, azGet(e, 0))
        return ca
    end
    if t == N_UNARY
        var cu: int = azNew(N_UNARY, 0)
        azSet(cu, 0, azGet(e, 0))
        azSet(cu, 1, oClone(azGet(e, 1)))
        return cu
    end
    if t == N_BINARY
        var cb: int = azNew(N_BINARY, 0)
        azSet(cb, 0, oClone(azGet(e, 0)))
        azSet(cb, 1, oClone(azGet(e, 1)))
        azSet(cb, 2, azGet(e, 2))
        azSet(cb, 3, azGet(e, 3))
        return cb
    end
    if t == N_MEMBER
        var cm: int = azNew(N_MEMBER, 0)
        azSet(cm, 0, oClone(azGet(e, 0)))
        azSet(cm, 1, azGet(e, 1))
        return cm
    end
    if t == N_ARRAYACC
        var car: int = azNew(N_ARRAYACC, 0)
        azSet(car, 0, oClone(azGet(e, 0)))
        azSet(car, 1, oClone(azGet(e, 1)))
        return car
    end
    if t == N_DEREF
        var cd: int = azNew(N_DEREF, 0)
        azSet(cd, 0, oClone(azGet(e, 0)))
        return cd
    end
    if t == N_CALL
        var cc: int = azNew(N_CALL, 0)
        azSet(cc, 0, azGet(e, 0))
        azSet(cc, 1, oClone(azGet(e, 1)))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        azListBegin()
        var k: int = 0
        while k < an
            azListPush(oClone(peek32(gSideBase + (as + k) * 4)))
            k = k + 1
        end
        azListEnd()
        azSet(cc, 2, gLStart)
        azSet(cc, 3, gLLen)
        return cc
    end
    return 0
end

# ---------- exprReferencesName (438-454) ----------

func oRefsName(e: int, name: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_IDENT
        if azStrEq(azGet(e, 0), name) == 1
            return 1
        end
        return 0
    end
    if t == N_ADDROF
        if azStrEq(azGet(e, 0), name) == 1
            return 1
        end
        return 0
    end
    if t == N_UNARY
        return oRefsName(azGet(e, 1), name)
    end
    if t == N_BINARY
        if oRefsName(azGet(e, 0), name) == 1
            return 1
        end
        return oRefsName(azGet(e, 1), name)
    end
    if t == N_MEMBER
        return oRefsName(azGet(e, 0), name)
    end
    if t == N_ARRAYACC
        if oRefsName(azGet(e, 0), name) == 1
            return 1
        end
        return oRefsName(azGet(e, 1), name)
    end
    if t == N_DEREF
        return oRefsName(azGet(e, 0), name)
    end
    if t == N_CALL
        if azGet(e, 1) != 0
            if oRefsName(azGet(e, 1), name) == 1
                return 1
            end
        end
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            if oRefsName(peek32(gSideBase + (as + k) * 4), name) == 1
                return 1
            end
            k = k + 1
        end
        return 0
    end
    return 0
end

# ---------- kindOfExpr (990-1044) + collectLocalKinds (1046-1085) ----------
# gTbLocK/gTbGlK/gTbFrK/gTbFdK — «остаточное» состояние как localKinds_/
# globalKinds_/funcRetKinds_/fieldKinds_ в C++.

func oKindOf(e: int)
    # VarKind по умолчанию {kind = Void(3), structName = ""}
    gOK0 = TK_VOID
    gOK1 = 0
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_NUMBER
        gOK0 = 0
        return
    end
    if t == N_FLOAT
        gOK0 = TK_FLOAT
        return
    end
    if t == N_IDENT
        var s: int = oRecFind(gPLocK, gNLocK, 8192, azGet(e, 0))
        if s >= 0
            gOK0 = peek32(gPLocK + s * 24 + 4)
            gOK1 = peek32(gPLocK + s * 24 + 8)
            return
        end
        s = oRecFind(gPGlK, gNGlK, 4096, azGet(e, 0))
        if s >= 0
            gOK0 = peek32(gPGlK + s * 24 + 4)
            gOK1 = peek32(gPGlK + s * 24 + 8)
            return
        end
        return
    end
    if t == N_UNARY
        if oOpIs(azGet(e, 0), "!") == 1
            gOK0 = 0
            return
        end
        oKindOf(azGet(e, 1))
        return
    end
    if t == N_BINARY
        var op: int = azGet(e, 2)
        if oOpIs(op, "==") == 1 || oOpIs(op, "!=") == 1 || oOpIs(op, "<") == 1 || oOpIs(op, ">") == 1 || oOpIs(op, "<=") == 1 || oOpIs(op, ">=") == 1 || oOpIs(op, "&&") == 1 || oOpIs(op, "||") == 1
            gOK0 = 0
            return
        end
        oKindOf(azGet(e, 0))
        var lk: int = gOK0
        oKindOf(azGet(e, 1))
        var rk: int = gOK0
        if oOpIs(op, "<<") == 1 || oOpIs(op, ">>") == 1
            if lk == 0 || rk == 0
                gOK0 = 0
                return
            end
            gOK0 = TK_VOID
            return
        end
        if oOpIs(op, "&") == 1 || oOpIs(op, "|") == 1 || oOpIs(op, "^") == 1 || oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
            if lk == 0 && rk == 0
                gOK0 = 0
                return
            end
            gOK0 = TK_VOID
            return
        end
        if oOpIs(op, "+") == 1 || oOpIs(op, "-") == 1 || oOpIs(op, "*") == 1 || oOpIs(op, "/") == 1
            if lk == TK_FLOAT || rk == TK_FLOAT
                gOK0 = TK_FLOAT
                return
            end
            if lk == 0 && rk == 0
                gOK0 = 0
                return
            end
            gOK0 = TK_VOID
            return
        end
        gOK0 = TK_VOID
        return
    end
    if t == N_MEMBER
        var obj: int = azGet(e, 0)
        if azTag(obj) == N_IDENT
            var nm: int = azGet(obj, 0)
            var s2: int = oRecFind(gPLocK, gNLocK, 8192, nm)
            if s2 < 0
                s2 = oRecFind(gPGlK, gNGlK, 4096, nm)
                if s2 >= 0
                    if peek32(gPGlK + s2 * 24 + 4) == TK_STRUCT
                        var f: int = oFdFind(gNFdK, peek32(gPGlK + s2 * 24 + 8), azGet(e, 1))
                        if f >= 0
                            gOK0 = peek32(gPFdK + f * 24 + 8)
                            gOK1 = 0
                        end
                        return
                    end
                end
                return
            end
            if peek32(gPLocK + s2 * 24 + 4) == TK_STRUCT
                var f2: int = oFdFind(gNFdK, peek32(gPLocK + s2 * 24 + 8), azGet(e, 1))
                if f2 >= 0
                    gOK0 = peek32(gPFdK + f2 * 24 + 8)
                    gOK1 = 0
                end
            end
            return
        end
        return
    end
    if t == N_CALL
        var s3: int = oRecFind(gPFrK, gNFrK, 8192, azGet(e, 0))
        if s3 >= 0
            gOK0 = peek32(gPFrK + s3 * 24 + 4)
            gOK1 = peek32(gPFrK + s3 * 24 + 8)
            return
        end
        return
    end
end

func oDefinitelyInt(e: int) -> int
    oKindOf(e)
    if gOK0 == 0
        return 1
    end
    return 0
end

# collectLocalKindsBlock (1046-1076): out — gTbLocK.
func oCollectLocKBlock(s: int, n: int)
    var i: int = 0
    while i < n
        var sid: int = peek32(gSideBase + (s + i) * 4)
        var t: int = azTag(sid)
        if t == N_VARDECL
            var vk0: int = 0
            var vk1: int = 0
            if azGet(sid, 1) != TK_VOID
                vk0 = azGet(sid, 1)
                vk1 = azGet(sid, 2)
            else
                var init: int = azGet(sid, 7)
                if init != 0
                    if azTag(init) == N_NUMBER
                        vk0 = 0
                    else
                        if azTag(init) == N_FLOAT
                            vk0 = TK_FLOAT
                        else
                            if azTag(init) == N_STRING
                                vk0 = TK_STRING
                            else
                                oKindOf(init)
                                vk0 = gOK0
                            end
                        end
                    end
                end
            end
            var li: int = oRecAdd(gPLocK, gNLocK, 8192, azGet(sid, 0))
            if li >= 0
                if li == gNLocK
                    gNLocK = gNLocK + 1
                end
                poke32(gPLocK + li * 24 + 4, vk0)
                poke32(gPLocK + li * 24 + 8, vk1)
            end
        end
        if t == N_IF
            oCollectLocKBlock(azGet(sid, 1), azGet(sid, 2))
            oCollectLocKBlock(azGet(sid, 3), azGet(sid, 4))
        else
            if t == N_WHILE
                oCollectLocKBlock(azGet(sid, 1), azGet(sid, 2))
            else
                if t == N_LOOP
                    oCollectLocKBlock(azGet(sid, 0), azGet(sid, 1))
                else
                    if t == N_FOR
                        oCollectLocKBlock(azGet(sid, 4), azGet(sid, 5))
                        if oSetHas(gPLocK, gNLocK, azGet(sid, 0)) == 0
                            var fi: int = oRecAdd(gPLocK, gNLocK, 8192, azGet(sid, 0))
                            if fi >= 0
                                if fi == gNLocK
                                    gNLocK = gNLocK + 1
                                end
                                poke32(gPLocK + fi * 24 + 4, 0)
                                poke32(gPLocK + fi * 24 + 8, 0)
                            end
                        end
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oCollectLocKBlock(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4))
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
end

# collectLocalKinds(fn) (1078-1085)
func oCollectLocalKinds(fn: int)
    gNLocK = 0
    var ps: int = azGet(fn, 1)
    var pl: int = azGet(fn, 2)
    var i: int = 0
    while i + 7 <= pl
        var key: int = peek32(gSideBase + (ps + i) * 4)
        var pi: int = oRecAdd(gPLocK, gNLocK, 8192, key)
        if pi >= 0
            if pi == gNLocK
                gNLocK = gNLocK + 1
            end
            poke32(gPLocK + pi * 24 + 4, peek32(gSideBase + (ps + i + 1) * 4))
            poke32(gPLocK + pi * 24 + 8, peek32(gSideBase + (ps + i + 2) * 4))
        end
        i = i + 7
    end
    oCollectLocKBlock(azGet(fn, 9), azGet(fn, 10))
end

# ---------- fold (593-790) ----------
# oFoldExpr/ oFoldBlock адресами СЛОТОВ (не id): замена выражения = poke32(sa,
# новый id), замена блока = poke32(sa, gLStart) + poke32(la, gLLen).

# scratch для конкатенации строковых литералов (STR_CAP_AST — предел azStr)
var gOBuf: int = 0

func oFoldExpr(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_BINARY
        var a: int = azNodeAddr(e)
        oFoldExpr(a + 8)
        oFoldExpr(a + 12)
        var l: int = azGet(e, 0)
        var r: int = azGet(e, 1)
        # константные строки: "ab" + "cd" -> "abcd", ==/!= -> 0/1
        if l != 0 && r != 0
            if azTag(l) == N_STRING
                if azTag(r) == N_STRING
                    var sop: int = azGet(e, 2)
                    if oOpIs(sop, "+") == 1
                        var n1: int = azStrLen(azGet(l, 0))
                        var n2: int = azStrLen(azGet(r, 0))
                        if gOBuf == 0
                            gOBuf = alloc(STR_CAP_AST)
                        end
                        if gOBuf != 0
                            if n1 + n2 < STR_CAP_AST
                                var p1: int = azStrPtr(azGet(l, 0))
                                var p2: int = azStrPtr(azGet(r, 0))
                                var j: int = 0
                                while j < n1
                                    poke8(gOBuf + j, peek8(p1 + j))
                                    j = j + 1
                                end
                                j = 0
                                while j < n2
                                    poke8(gOBuf + n1 + j, peek8(p2 + j))
                                    j = j + 1
                                end
                                var nsid: int = azStr(gOBuf, n1 + n2)
                                if nsid != 0
                                    var nid: int = azNew(N_STRING, 0)
                                    azSet(nid, 0, nsid)
                                    poke32(sa, nid)
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                    end
                    if oOpIs(sop, "==") == 1
                        if azStrEq(azGet(l, 0), azGet(r, 0)) == 1
                            poke32(sa, oMakeNum(1))
                        else
                            poke32(sa, oMakeNum(0))
                        end
                        gORm = gORm + 1
                        return
                    end
                    if oOpIs(sop, "!=") == 1
                        if azStrEq(azGet(l, 0), azGet(r, 0)) == 1
                            poke32(sa, oMakeNum(0))
                        else
                            poke32(sa, oMakeNum(1))
                        end
                        gORm = gORm + 1
                        return
                    end
                end
            end
        end
        # обе стороны — константные int
        if oIsConstInt(l) == 1
            var lv: int = gOI64
            if oIsConstInt(r) == 1
                var rv: int = gOI64
                var op: int = azGet(e, 2)
                # только чистая арифметика; exprIsConstInt уже ловит r==0
                if oOpIs(op, "/") == 1
                    if rv == 0
                        return
                    end
                end
                if oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
                    if rv == 0
                        return
                    end
                end
                if oOpIs(op, "/") == 1 || oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
                    if lv == I64_MIN && rv == 0 - 1
                        return
                    end
                end
                var nv: int = 0
                if oOpIs(op, "+") == 1
                    nv = lv + rv
                else
                    if oOpIs(op, "-") == 1
                        nv = lv - rv
                    else
                        if oOpIs(op, "*") == 1
                            nv = lv * rv
                        else
                            if oOpIs(op, "/") == 1
                                nv = lv / rv
                            else
                                if oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
                                    nv = lv % rv
                                else
                                    if oOpIs(op, "&") == 1
                                        nv = lv & rv
                                    else
                                        if oOpIs(op, "|") == 1
                                            nv = lv | rv
                                        else
                                            if oOpIs(op, "^") == 1
                                                nv = lv ^ rv
                                            else
                                                if oOpIs(op, "<<") == 1
                                                    nv = lv << (rv & 63)
                                                else
                                                    if oOpIs(op, ">>") == 1
                                                        nv = lv >> (rv & 63)
                                                    else
                                                        if oOpIs(op, "==") == 1
                                                            if lv == rv
                                                                nv = 1
                                                            else
                                                                nv = 0
                                                            end
                                                        else
                                                            if oOpIs(op, "!=") == 1
                                                                if lv != rv
                                                                    nv = 1
                                                                else
                                                                    nv = 0
                                                                end
                                                            else
                                                                if oOpIs(op, "<") == 1
                                                                    if lv < rv
                                                                        nv = 1
                                                                    else
                                                                        nv = 0
                                                                    end
                                                                else
                                                                    if oOpIs(op, "<=") == 1
                                                                        if lv <= rv
                                                                            nv = 1
                                                                        else
                                                                            nv = 0
                                                                        end
                                                                    else
                                                                        if oOpIs(op, ">") == 1
                                                                            if lv > rv
                                                                                nv = 1
                                                                            else
                                                                                nv = 0
                                                                            end
                                                                        else
                                                                            if oOpIs(op, ">=") == 1
                                                                                if lv >= rv
                                                                                    nv = 1
                                                                                else
                                                                                    nv = 0
                                                                                end
                                                                            else
                                                                                if oOpIs(op, "&&") == 1
                                                                                    if lv != 0 && rv != 0
                                                                                        nv = 1
                                                                                    else
                                                                                        nv = 0
                                                                                    end
                                                                                else
                                                                                    if oOpIs(op, "||") == 1
                                                                                        if lv != 0 || rv != 0
                                                                                            nv = 1
                                                                                        else
                                                                                            nv = 0
                                                                                        end
                                                                                    else
                                                                                        return
                                                                                    end
                                                                                end
                                                                            end
                                                                        end
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                poke32(sa, oMakeNum(nv))
                gORm = gORm + 1
                return
            end
        end
        # && / || с одной константной стороной
        var sop2: int = azGet(e, 2)
        if oOpIs(sop2, "&&") == 1 || oOpIs(sop2, "||") == 1
            var cv: int = 0
            if oIsConstInt(l) == 1
                cv = gOI64
                if oOpIs(sop2, "||") == 1
                    if cv != 0
                        poke32(sa, oMakeNum(1))
                        gORm = gORm + 1
                        return
                    end
                end
                if oOpIs(sop2, "&&") == 1
                    if cv == 0
                        poke32(sa, oMakeNum(0))
                        gORm = gORm + 1
                        return
                    end
                end
            end
            if oIsConstInt(r) == 1
                if oMaySide(l) == 0
                    cv = gOI64
                    if oOpIs(sop2, "||") == 1
                        if cv != 0
                            poke32(sa, oMakeNum(1))
                            gORm = gORm + 1
                            return
                        end
                    end
                    if oOpIs(sop2, "&&") == 1
                        if cv == 0
                            poke32(sa, oMakeNum(0))
                            gORm = gORm + 1
                            return
                        end
                    end
                end
            end
        end
        return
    end
    if t == N_UNARY
        oFoldExpr(azFldAddr(e, 1))
        if oIsConstInt(azGet(e, 1)) == 1
            var cv2: int = gOI64
            var uop: int = azGet(e, 0)
            if oOpIs(uop, "-") == 1
                poke32(sa, oMakeNum(0 - cv2))
                gORm = gORm + 1
                return
            end
            if oOpIs(uop, "!") == 1
                if cv2 == 0
                    poke32(sa, oMakeNum(1))
                else
                    poke32(sa, oMakeNum(0))
                end
                gORm = gORm + 1
                return
            end
            if oOpIs(uop, "~") == 1
                poke32(sa, oMakeNum(~cv2))
                gORm = gORm + 1
                return
            end
        end
        return
    end
    if t == N_CALL
        if azGet(e, 1) != 0
            oFoldExpr(azFldAddr(e, 1))
        end
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oFoldExpr(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
    if t == N_ARRAYACC
        oFoldExpr(azFldAddr(e, 0))
        oFoldExpr(azFldAddr(e, 1))
        return
    end
    if t == N_MEMBER
        oFoldExpr(azFldAddr(e, 0))
        return
    end
    if t == N_DEREF
        oFoldExpr(azFldAddr(e, 0))
        return
    end
end

func oFoldStmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        oFoldExpr(a + 36)
        return
    end
    if t == N_RETURN
        oFoldExpr(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oFoldExpr(a + 8)
        return
    end
    if t == N_ASSIGN
        oFoldExpr(a + 20)
        oFoldExpr(a + 24)
        return
    end
    if t == N_PTRASSIGN
        oFoldExpr(a + 8)
        oFoldExpr(a + 12)
        return
    end
    if t == N_IF
        oFoldExpr(a + 8)
        oFoldBlock(a + 12, a + 16)
        oFoldBlock(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oFoldExpr(a + 8)
        oFoldBlock(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oFoldBlock(a + 8, a + 12)
        return
    end
    if t == N_SWITCH
        oFoldExpr(a + 8)
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oFoldExpr(gSideBase + (cs + k) * 4)
            oFoldBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oFoldExpr(a + 12)
        oFoldExpr(a + 16)
        oFoldExpr(a + 20)
        oFoldBlock(a + 24, a + 28)
        return
    end
end

func oFoldBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oFoldStmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
    # схлопывание константного if / while(false) с фикс-пойнтом: сплайс
    # ветки может вывести на верхний уровень новый схлопаемый stmt (как
    # continue-пересмотр в C++).
    var changed: int = 1
    while changed == 1
        changed = 0
        s0 = peek32(sa)
        n0 = peek32(la)
        # есть ли что схлопывать?
        var can: int = 0
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            var t: int = azTag(sid)
            if t == N_IF
                if oIsConstInt(azGet(sid, 0)) == 1
                    can = 1
                end
            end
            if t == N_WHILE
                if oIsConstInt(azGet(sid, 0)) == 1
                    if gOI64 == 0
                        can = 1
                    end
                end
            end
            if can == 1
                break
            end
            i = i + 1
        end
        if can == 0
            return
        end
        azListBegin()
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            var t: int = azTag(sid)
            var skip: int = 0
            if t == N_IF
                if oIsConstInt(azGet(sid, 0)) == 1
                    var cv: int = gOI64
                    gORm = gORm + 1
                    changed = 1
                    var cs: int = 0
                    var cl: int = 0
                    if cv != 0
                        cs = azGet(sid, 1)
                        cl = azGet(sid, 2)
                    else
                        cs = azGet(sid, 3)
                        cl = azGet(sid, 4)
                    end
                    if cl == 0
                        skip = 1
                    else
                        var k: int = 0
                        while k < cl
                            azListPush(peek32(gSideBase + (cs + k) * 4))
                            k = k + 1
                        end
                        skip = 2
                    end
                end
            else
                if t == N_WHILE
                    if oIsConstInt(azGet(sid, 0)) == 1
                        if gOI64 == 0
                            gORm = gORm + 1
                            changed = 1
                            skip = 1
                        end
                    end
                end
            end
            if skip == 0
                azListPush(sid)
            end
            i = i + 1
        end
        azListEnd()
        if changed == 1
            poke32(sa, gLStart)
            poke32(la, gLLen)
        end
    end
end

func oFoldConstants()
    var i: int = 0
    while i < gGlobalN
        oFoldExpr(azFldAddr(gGlobalIds[i], 7))
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            var fa: int = azNodeAddr(fn)
            oFoldBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- simplifyExprs (1150-1391) + propagateLocals (1393-1619) ----------

# scratch-множество для kill-итераций (collectAssignedBlock в C++ создаёт
# временный set на каждый вызов while/loop/for)
var gTbTmp: [49152]int
var gNTmp: int = 0

# стек scopeUndo из walkS: 7 слов на запись
# [name, hasPrev, isConst, lo, hi, isAlias, alias]
const OSC_CAP: int = 65536
var gOSc: [458752]int
var gOSp: int = 0

func oKnownFind(name: int) -> int
    return oRecFind(gPKnown, gNKnown, 8192, name)
end

# known[name] = {...} (полная запись)
func oKnownSet(name: int, isC: int, lo: int, hi: int, isA: int, al: int)
    var k: int = oKnownFind(name)
    if k < 0
        k = oRecAdd(gPKnown, gNKnown, 8192, name)
        if k < 0
            return
        end
        if k == gNKnown
            gNKnown = gNKnown + 1
        end
    end
    poke32(gPKnown + k * 24 + 4, isC)
    poke32(gPKnown + k * 24 + 8, lo)
    poke32(gPKnown + k * 24 + 12, hi)
    poke32(gPKnown + k * 24 + 16, isA)
    poke32(gPKnown + k * 24 + 20, al)
end

# known.erase(name) — только запись с этим ключом (без алиасов)
func oKnownErase(name: int)
    var k: int = oKnownFind(name)
    if k >= 0
        poke32(gPKnown + k * 24, 0)
    end
end

# killName: erase(n) + удалить записи-алиасы, указывающие на n
func oKillName(name: int)
    var i: int = 0
    while i < gNKnown
        var key: int = peek32(gPKnown + i * 24)
        if key != 0
            if azStrEq(key, name) == 1
                poke32(gPKnown + i * 24, 0)
            else
                if peek32(gPKnown + i * 24 + 16) == 1
                    if azStrEq(peek32(gPKnown + i * 24 + 20), name) == 1
                        poke32(gPKnown + i * 24, 0)
                    end
                end
            end
        end
        i = i + 1
    end
end

func oSimplifyExpr(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_BINARY
        var a: int = azNodeAddr(e)
        oSimplifyExpr(a + 8)
        oSimplifyExpr(a + 12)
        var l: int = azGet(e, 0)
        var r: int = azGet(e, 1)
        var op: int = azGet(e, 2)
        var arith: int = 0
        if oOpIs(op, "+") == 1 || oOpIs(op, "-") == 1 || oOpIs(op, "*") == 1 || oOpIs(op, "/") == 1 || oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
            arith = 1
        end
        var bitw: int = 0
        if oOpIs(op, "&") == 1 || oOpIs(op, "|") == 1 || oOpIs(op, "^") == 1
            bitw = 1
        end
        var shift: int = 0
        if oOpIs(op, "<<") == 1 || oOpIs(op, ">>") == 1
            shift = 1
        end
        var cmp: int = 0
        if oOpIs(op, "==") == 1 || oOpIs(op, "!=") == 1 || oOpIs(op, "<") == 1 || oOpIs(op, ">") == 1 || oOpIs(op, "<=") == 1 || oOpIs(op, ">=") == 1
            cmp = 1
        end
        if arith == 0 && bitw == 0 && shift == 0 && cmp == 0
            return
        end
        var lv: int = 0
        var rv: int = 0
        var lC: int = 0
        var rC: int = 0
        if oIsConstInt(l) == 1
            lC = 1
            lv = gOI64
        end
        if oIsConstInt(r) == 1
            rC = 1
            rv = gOI64
        end
        var lSide: int = oMaySide(l)
        var rSide: int = oMaySide(r)
        var lInt: int = oDefinitelyInt(l)
        var rInt: int = oDefinitelyInt(r)
        # ---- одно и то же выражение по краям ----
        if oSame(l, r) == 1
            if lSide == 0
                if rSide == 0
                    if oOpIs(op, "-") == 1 || oOpIs(op, "^") == 1
                        if lInt == 1
                            if rInt == 1
                                poke32(sa, oMakeNum(0))
                                gORm = gORm + 1
                                return
                            end
                        end
                    else
                        if oOpIs(op, "&") == 1 || oOpIs(op, "|") == 1
                            if lInt == 1
                                if rInt == 1
                                    poke32(sa, l)
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        else
                            if oOpIs(op, "<") == 1 || oOpIs(op, ">") == 1
                                poke32(sa, oMakeNum(0))
                                gORm = gORm + 1
                                return
                            else
                                if oOpIs(op, "==") == 1 || oOpIs(op, "<=") == 1 || oOpIs(op, ">=") == 1
                                    if lInt == 1
                                        if rInt == 1
                                            poke32(sa, oMakeNum(1))
                                            gORm = gORm + 1
                                            return
                                        end
                                    end
                                else
                                    if oOpIs(op, "!=") == 1
                                        if lInt == 1
                                            if rInt == 1
                                                poke32(sa, oMakeNum(0))
                                                gORm = gORm + 1
                                                return
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        # ---- арифметические тождества (только целые) ----
        if arith == 1
            if lInt == 1
                if rInt == 1
                    if oOpIs(op, "+") == 1
                        if rC == 1
                            if rv == 0
                                poke32(sa, l)
                                gORm = gORm + 1
                                return
                            end
                        end
                        if lC == 1
                            if lv == 0
                                poke32(sa, r)
                                gORm = gORm + 1
                                return
                            end
                        end
                    else
                        if oOpIs(op, "-") == 1
                            if rC == 1
                                if rv == 0
                                    poke32(sa, l)
                                    gORm = gORm + 1
                                    return
                                end
                            end
                            if lC == 1
                                if lv == 0
                                    poke32(sa, oMakeUnary(azStrLit("-"), r))
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        else
                            if oOpIs(op, "*") == 1
                                if rC == 1
                                    if rv == 1
                                        poke32(sa, l)
                                        gORm = gORm + 1
                                        return
                                    end
                                end
                                if lC == 1
                                    if lv == 1
                                        poke32(sa, r)
                                        gORm = gORm + 1
                                        return
                                    end
                                end
                                if rC == 1
                                    if rv == 0
                                        if lSide == 0
                                            poke32(sa, oMakeNum(0))
                                            gORm = gORm + 1
                                            return
                                        end
                                    end
                                end
                                if lC == 1
                                    if lv == 0
                                        if rSide == 0
                                            poke32(sa, oMakeNum(0))
                                            gORm = gORm + 1
                                            return
                                        end
                                    end
                                end
                                if rC == 1
                                    if rv == 0 - 1
                                        poke32(sa, oMakeUnary(azStrLit("-"), l))
                                        gORm = gORm + 1
                                        return
                                    end
                                end
                                if lC == 1
                                    if lv == 0 - 1
                                        poke32(sa, oMakeUnary(azStrLit("-"), r))
                                        gORm = gORm + 1
                                        return
                                    end
                                end
                                var sh: int = -1
                                if rC == 1
                                    sh = oIsPow2(rv)
                                    if sh >= 0
                                        if sh > 0
                                            poke32(sa, oMakeBinary(azStrLit("<<"), l, oMakeNum(sh)))
                                            gOSr = gOSr + 1
                                            return
                                        end
                                    end
                                end
                                if lC == 1
                                    sh = oIsPow2(lv)
                                    if sh >= 0
                                        if sh > 0
                                            poke32(sa, oMakeBinary(azStrLit("<<"), r, oMakeNum(sh)))
                                            gOSr = gOSr + 1
                                            return
                                        end
                                    end
                                end
                                # отрицательная степень двойки: x * -4 -> -(x << 2)
                                if rC == 1
                                    if rv != I64_MIN
                                        if rv < 0
                                            sh = oIsPow2(0 - rv)
                                            if sh >= 0
                                                if sh > 0
                                                    poke32(sa, oMakeUnary(azStrLit("-"), oMakeBinary(azStrLit("<<"), l, oMakeNum(sh))))
                                                    gOSr = gOSr + 1
                                                    return
                                                end
                                            end
                                        end
                                    end
                                end
                                if lC == 1
                                    if lv != I64_MIN
                                        if lv < 0
                                            sh = oIsPow2(0 - lv)
                                            if sh >= 0
                                                if sh > 0
                                                    poke32(sa, oMakeUnary(azStrLit("-"), oMakeBinary(azStrLit("<<"), r, oMakeNum(sh))))
                                                    gOSr = gOSr + 1
                                                    return
                                                end
                                            end
                                        end
                                    end
                                end
                            else
                                if oOpIs(op, "/") == 1
                                    if rC == 1
                                        if rv == 1
                                            poke32(sa, l)
                                            gORm = gORm + 1
                                            return
                                        end
                                    end
                                else
                                    if oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1
                                        if rC == 1
                                            if rv == 1
                                                poke32(sa, oMakeNum(0))
                                                gORm = gORm + 1
                                                return
                                            end
                                            if rv == 0 - 1
                                                poke32(sa, oMakeNum(0))
                                                gORm = gORm + 1
                                                return
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        # ---- побитовые тождества ----
        if bitw == 1
            if oOpIs(op, "&") == 1
                if rC == 1
                    if rv == 0
                        if lSide == 0
                            poke32(sa, oMakeNum(0))
                            gORm = gORm + 1
                            return
                        end
                    end
                end
                if lC == 1
                    if lv == 0
                        if rSide == 0
                            poke32(sa, oMakeNum(0))
                            gORm = gORm + 1
                            return
                        end
                    end
                end
                if rC == 1
                    if rv == 0 - 1
                        if lInt == 1
                            poke32(sa, l)
                            gORm = gORm + 1
                            return
                        end
                    end
                end
                if lC == 1
                    if lv == 0 - 1
                        if rInt == 1
                            poke32(sa, r)
                            gORm = gORm + 1
                            return
                        end
                    end
                end
            else
                if oOpIs(op, "|") == 1
                    if rC == 1
                        if rv == 0
                            if lInt == 1
                                poke32(sa, l)
                                gORm = gORm + 1
                                return
                            end
                        end
                    end
                    if lC == 1
                        if lv == 0
                            if rInt == 1
                                poke32(sa, r)
                                gORm = gORm + 1
                                return
                            end
                        end
                    end
                    if rC == 1
                        if rv == 0 - 1
                            if lSide == 0
                                poke32(sa, oMakeNum(-1))
                                gORm = gORm + 1
                                return
                            end
                        end
                    end
                    if lC == 1
                        if lv == 0 - 1
                            if rSide == 0
                                poke32(sa, oMakeNum(-1))
                                gORm = gORm + 1
                                return
                            end
                        end
                    end
                else
                    if oOpIs(op, "^") == 1
                        if rC == 1
                            if rv == 0
                                if lInt == 1
                                    poke32(sa, l)
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                        if lC == 1
                            if lv == 0
                                if rInt == 1
                                    poke32(sa, r)
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                        if rC == 1
                            if rv == 0 - 1
                                if lInt == 1
                                    poke32(sa, oMakeUnary(azStrLit("~"), l))
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                        if lC == 1
                            if lv == 0 - 1
                                if rInt == 1
                                    poke32(sa, oMakeUnary(azStrLit("~"), r))
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
        # ---- сдвиг на 0 ----
        if shift == 1
            if lInt == 1
                if rInt == 1
                    if rC == 1
                        if rv == 0
                            poke32(sa, l)
                            gORm = gORm + 1
                            return
                        end
                    end
                end
            end
        end
        return
    end
    if t == N_UNARY
        var ua: int = azNodeAddr(e)
        oSimplifyExpr(ua + 12)
        var uop: int = azGet(e, 0)
        var oper: int = azGet(e, 1)
        if oOpIs(uop, "-") == 1 || oOpIs(uop, "~") == 1
            if oper != 0
                if azTag(oper) == N_UNARY
                    if azStrEq(azGet(oper, 0), uop) == 1
                        poke32(sa, azGet(oper, 1))
                        gORm = gORm + 1
                        return
                    end
                end
            end
        else
            if oOpIs(uop, "!") == 1
                if oper != 0
                    if azTag(oper) == N_BINARY
                        var bop2: int = azGet(oper, 2)
                        var isCmp: int = 0
                        if oOpIs(bop2, "==") == 1 || oOpIs(bop2, "!=") == 1 || oOpIs(bop2, "<") == 1 || oOpIs(bop2, ">") == 1 || oOpIs(bop2, "<=") == 1 || oOpIs(bop2, ">=") == 1
                            isCmp = 1
                        end
                        if isCmp == 1
                            if oDefinitelyInt(azGet(oper, 0)) == 1
                                if oDefinitelyInt(azGet(oper, 1)) == 1
                                    var inv: int = 0
                                    if oOpIs(bop2, "==") == 1
                                        inv = azStrLit("!=")
                                    else
                                        if oOpIs(bop2, "!=") == 1
                                            inv = azStrLit("==")
                                        else
                                            if oOpIs(bop2, "<") == 1
                                                inv = azStrLit(">=")
                                            else
                                                if oOpIs(bop2, ">") == 1
                                                    inv = azStrLit("<=")
                                                else
                                                    if oOpIs(bop2, "<=") == 1
                                                        inv = azStrLit(">")
                                                    else
                                                        inv = azStrLit("<")
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    poke32(sa, oMakeBinary(inv, azGet(oper, 0), azGet(oper, 1)))
                                    gORm = gORm + 1
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
        return
    end
    if t == N_CALL
        oSimplifyExpr(azFldAddr(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oSimplifyExpr(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
    if t == N_ARRAYACC
        oSimplifyExpr(azFldAddr(e, 0))
        oSimplifyExpr(azFldAddr(e, 1))
        return
    end
    if t == N_MEMBER
        oSimplifyExpr(azFldAddr(e, 0))
        return
    end
    if t == N_DEREF
        oSimplifyExpr(azFldAddr(e, 0))
        return
    end
end

func oSimplifyStmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        oSimplifyExpr(a + 36)
        return
    end
    if t == N_RETURN
        oSimplifyExpr(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oSimplifyExpr(a + 8)
        return
    end
    if t == N_ASSIGN
        oSimplifyExpr(a + 20)
        oSimplifyExpr(a + 24)
        return
    end
    if t == N_PTRASSIGN
        oSimplifyExpr(a + 8)
        oSimplifyExpr(a + 12)
        return
    end
    if t == N_IF
        oSimplifyExpr(a + 8)
        oSimplifyBlock(a + 12, a + 16)
        oSimplifyBlock(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oSimplifyExpr(a + 8)
        oSimplifyBlock(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oSimplifyBlock(a + 8, a + 12)
        return
    end
    if t == N_SWITCH
        oSimplifyExpr(a + 8)
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oSimplifyExpr(gSideBase + (cs + k) * 4)
            oSimplifyBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oSimplifyExpr(a + 12)
        oSimplifyExpr(a + 16)
        oSimplifyExpr(a + 20)
        oSimplifyBlock(a + 24, a + 28)
        return
    end
end

func oSimplifyBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oSimplifyStmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
    # удаление if с обеими пустыми ветками и чистым условием (только
    # удаления — один проход, без фикс-пойнта)
    s0 = peek32(sa)
    n0 = peek32(la)
    var removed: int = 0
    azListBegin()
    i = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var drop: int = 0
        if azTag(sid) == N_IF
            if azGet(sid, 2) == 0
                if azGet(sid, 4) == 0
                    if oMaySide(azGet(sid, 0)) == 0
                        drop = 1
                        gORm = gORm + 1
                        removed = 1
                    end
                end
            end
        end
        if drop == 0
            azListPush(sid)
        end
        i = i + 1
    end
    azListEnd()
    if removed == 1
        poke32(sa, gLStart)
        poke32(la, gLLen)
    end
end

func oSimplifyExprs()
    # перезаполнение globalKinds_/funcRetKinds_/fieldKinds_
    gNGlK = 0
    gNFrK = 0
    gNFdK = 0
    var i: int = 0
    while i < gGlobalN
        var g: int = gGlobalIds[i]
        var vk0: int = azGet(g, 1)
        var vk1: int = azGet(g, 2)
        if vk0 == TK_VOID
            var init: int = azGet(g, 7)
            if init != 0
                if azTag(init) == N_NUMBER
                    vk0 = 0
                else
                    if azTag(init) == N_FLOAT
                        vk0 = TK_FLOAT
                    else
                        if azTag(init) == N_STRING
                            vk0 = TK_STRING
                        end
                    end
                end
            end
        end
        var li: int = oRecAdd(gPGlK, gNGlK, 4096, azGet(g, 0))
        if li >= 0
            if li == gNGlK
                gNGlK = gNGlK + 1
            end
            poke32(gPGlK + li * 24 + 4, vk0)
            poke32(gPGlK + li * 24 + 8, vk1)
        end
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        var li2: int = oRecAdd(gPFrK, gNFrK, 8192, azGet(fn, 0))
        if li2 >= 0
            if li2 == gNFrK
                gNFrK = gNFrK + 1
            end
            poke32(gPFrK + li2 * 24 + 4, azGet(fn, 3))
            poke32(gPFrK + li2 * 24 + 8, azGet(fn, 4))
        end
        i = i + 1
    end
    i = 0
    while i < gStructN
        var st: int = gStructIds[i]
        var sname: int = azGet(st, 0)
        var fs: int = azGet(st, 1)
        var fl: int = azGet(st, 2)
        var j: int = 0
        while j + 7 <= fl
            var fi: int = oFdAdd(gNFdK, sname, peek32(gSideBase + (fs + j) * 4))
            if fi >= 0
                if fi == gNFdK
                    gNFdK = gNFdK + 1
                end
                poke32(gPFdK + fi * 24 + 8, peek32(gSideBase + (fs + j + 1) * 4))
            end
            j = j + 7
        end
        i = i + 1
    end
    i = 0
    while i < gGlobalN
        oSimplifyExpr(azFldAddr(gGlobalIds[i], 7))
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn2: int = gFuncIds[i]
        if azGet(fn2, 11) == 0
            oCollectLocalKinds(fn2)
            var fa: int = azNodeAddr(fn2)
            oSimplifyBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- collect-помощники propagateLocals ----------

# collectLocals: params + все VarDecl (для-переменная НЕ входит — как C++)
func oCollLoc(s: int, n: int)
    var i: int = 0
    while i < n
        var sid: int = peek32(gSideBase + (s + i) * 4)
        var t: int = azTag(sid)
        if t == N_VARDECL
            var li: int = oRecAdd(gPLocals, gNLocals, 8192, azGet(sid, 0))
            if li >= 0
                if li == gNLocals
                    gNLocals = gNLocals + 1
                end
            end
        end
        if t == N_IF
            oCollLoc(azGet(sid, 1), azGet(sid, 2))
            oCollLoc(azGet(sid, 3), azGet(sid, 4))
        else
            if t == N_WHILE
                oCollLoc(azGet(sid, 1), azGet(sid, 2))
            else
                if t == N_LOOP
                    oCollLoc(azGet(sid, 0), azGet(sid, 1))
                else
                    if t == N_FOR
                        oCollLoc(azGet(sid, 4), azGet(sid, 5))
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oCollLoc(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4))
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
end

# collectAssignedBlock: t==1 -> gTbAsn (assigned функции), t==2 -> gTbTmp
# (временный set для kill-итераций while/loop/for)
func oCollAsnInto(s: int, n: int, t: int)
    var i: int = 0
    while i < n
        var sid: int = peek32(gSideBase + (s + i) * 4)
        var tg: int = azTag(sid)
        if tg == N_ASSIGN
            if t == 1
                var li: int = oRecAdd(gPAsn, gNAsn, 4096, azGet(sid, 0))
                if li >= 0
                    if li == gNAsn
                        gNAsn = gNAsn + 1
                    end
                end
            else
                var li2: int = oRecAdd(gPTmp, gNTmp, 8192, azGet(sid, 0))
                if li2 >= 0
                    if li2 == gNTmp
                        gNTmp = gNTmp + 1
                    end
                end
            end
        end
        if tg == N_IF
            oCollAsnInto(azGet(sid, 1), azGet(sid, 2), t)
            oCollAsnInto(azGet(sid, 3), azGet(sid, 4), t)
        else
            if tg == N_WHILE
                oCollAsnInto(azGet(sid, 1), azGet(sid, 2), t)
            else
                if tg == N_LOOP
                    oCollAsnInto(azGet(sid, 0), azGet(sid, 1), t)
                else
                    if tg == N_FOR
                        oCollAsnInto(azGet(sid, 4), azGet(sid, 5), t)
                    else
                        if tg == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oCollAsnInto(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4), t)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
end

func oCollAddrE(e: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_ADDROF
        var li: int = oRecAdd(gPAddr, gNAddr, 4096, azGet(e, 0))
        if li >= 0
            if li == gNAddr
                gNAddr = gNAddr + 1
            end
        end
        return
    end
    if t == N_UNARY
        oCollAddrE(azGet(e, 1))
        return
    end
    if t == N_BINARY
        oCollAddrE(azGet(e, 0))
        oCollAddrE(azGet(e, 1))
        return
    end
    if t == N_MEMBER
        oCollAddrE(azGet(e, 0))
        return
    end
    if t == N_ARRAYACC
        oCollAddrE(azGet(e, 0))
        oCollAddrE(azGet(e, 1))
        return
    end
    if t == N_DEREF
        oCollAddrE(azGet(e, 0))
        return
    end
    if t == N_CALL
        oCollAddrE(azGet(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oCollAddrE(peek32(gSideBase + (as + k) * 4))
            k = k + 1
        end
        return
    end
end

func oCollAddrS(s: int, n: int)
    var i: int = 0
    while i < n
        var sid: int = peek32(gSideBase + (s + i) * 4)
        var t: int = azTag(sid)
        if t == N_VARDECL
            oCollAddrE(azGet(sid, 7))
        else
            if t == N_RETURN
                oCollAddrE(azGet(sid, 0))
            else
                if t == N_EXPRSTMT
                    oCollAddrE(azGet(sid, 0))
                else
                    if t == N_ASSIGN
                        oCollAddrE(azGet(sid, 3))
                        oCollAddrE(azGet(sid, 4))
                    else
                        if t == N_PTRASSIGN
                            oCollAddrE(azGet(sid, 0))
                            oCollAddrE(azGet(sid, 1))
                        else
                            if t == N_IF
                                oCollAddrE(azGet(sid, 0))
                                oCollAddrS(azGet(sid, 1), azGet(sid, 2))
                                oCollAddrS(azGet(sid, 3), azGet(sid, 4))
                            else
                                if t == N_WHILE
                                    oCollAddrE(azGet(sid, 0))
                                    oCollAddrS(azGet(sid, 1), azGet(sid, 2))
                                else
                                    if t == N_LOOP
                                        oCollAddrS(azGet(sid, 0), azGet(sid, 1))
                                    else
                                        if t == N_FOR
                                            oCollAddrE(azGet(sid, 1))
                                            oCollAddrE(azGet(sid, 2))
                                            oCollAddrE(azGet(sid, 3))
                                            oCollAddrS(azGet(sid, 4), azGet(sid, 5))
                                        else
                                            if t == N_SWITCH
                                                oCollAddrE(azGet(sid, 0))
                                                var cs: int = azGet(sid, 1)
                                                var cl: int = azGet(sid, 2)
                                                var k: int = 0
                                                while k + 2 < cl
                                                    oCollAddrE(peek32(gSideBase + (cs + k) * 4))
                                                    oCollAddrS(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4))
                                                    k = k + 3
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
end

# ---------- walkE / walkS propagateLocals ----------

func oPE(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    if azTag(e) == N_IDENT
        var k: int = oKnownFind(azGet(e, 0))
        if k >= 0
            if peek32(gPKnown + k * 24 + 4) == 1
                var lo: int = peek32(gPKnown + k * 24 + 8)
                var hi: int = peek32(gPKnown + k * 24 + 12)
                poke32(sa, oMakeNum((hi << 32) | lo))
                gORm = gORm + 1
                gOProp = gOProp + 1
                return
            end
            if peek32(gPKnown + k * 24 + 16) == 1
                var nid: int = azNew(N_IDENT, 0)
                azSet(nid, 0, peek32(gPKnown + k * 24 + 20))
                poke32(sa, nid)
                gORm = gORm + 1
                gOProp = gOProp + 1
                return
            end
        end
        return
    end
    var a: int = azNodeAddr(e)
    var t: int = azTag(e)
    if t == N_UNARY
        oPE(a + 12)
        return
    end
    if t == N_BINARY
        oPE(a + 8)
        oPE(a + 12)
        return
    end
    if t == N_MEMBER
        oPE(a + 8)
        return
    end
    if t == N_ARRAYACC
        oPE(a + 8)
        oPE(a + 12)
        return
    end
    if t == N_DEREF
        oPE(a + 8)
        return
    end
    if t == N_CALL
        oPE(a + 12)
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oPE(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
end

func oKillAsnBlock(s: int, n: int)
    gNTmp = 0
    oCollAsnInto(s, n, 2)
    var i: int = 0
    while i < gNTmp
        var key: int = peek32(gPTmp + i * 24)
        if key != 0
            oKillName(key)
        end
        i = i + 1
    end
end

func oPStmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        var name: int = azGet(sid, 0)
        var prev: int = oKnownFind(name)
        if gOSp < OSC_CAP
            var base: int = gOSp * 7
            poke32(gPOSc + base * 4, name)
            if prev >= 0
                poke32(gPOSc + base * 4 + 4, 1)
                poke32(gPOSc + base * 4 + 8, peek32(gPKnown + prev * 24 + 4))
                poke32(gPOSc + base * 4 + 12, peek32(gPKnown + prev * 24 + 8))
                poke32(gPOSc + base * 4 + 16, peek32(gPKnown + prev * 24 + 12))
                poke32(gPOSc + base * 4 + 20, peek32(gPKnown + prev * 24 + 16))
                poke32(gPOSc + base * 4 + 24, peek32(gPKnown + prev * 24 + 20))
            else
                poke32(gPOSc + base * 4 + 4, 0)
            end
            gOSp = gOSp + 1
        else
            gOFull = 1
        end
        oPE(a + 36)
        if oSetHas(gPAddr, gNAddr, name) == 1
            oKillName(name)
            return
        end
        var vk0: int = azGet(sid, 1)
        if vk0 == TK_VOID
            var init: int = azGet(sid, 7)
            if init != 0
                oKindOf(init)
                vk0 = gOK0
            end
        end
        if vk0 == TK_FLOAT
            oKillName(name)
            return
        end
        var init2: int = azGet(sid, 7)
        if oIsConstInt(init2) == 1
            oKnownSet(name, 1, numLo(gOI64), numHi(gOI64), 0, 0)
            return
        end
        if init2 != 0
            if azTag(init2) == N_IDENT
                var src: int = azGet(init2, 0)
                if oSetHas(gPLocals, gNLocals, src) == 1
                    if oSetHas(gPAsn, gNAsn, src) == 0
                        if oSetHas(gPAddr, gNAddr, src) == 0
                            var sk: int = oKnownFind(src)
                            if sk >= 0
                                oKnownSet(name, peek32(gPKnown + sk * 24 + 4), peek32(gPKnown + sk * 24 + 8), peek32(gPKnown + sk * 24 + 12), peek32(gPKnown + sk * 24 + 16), peek32(gPKnown + sk * 24 + 20))
                            else
                                oKnownSet(name, 0, 0, 0, 1, src)
                            end
                            return
                        end
                    end
                end
            end
        end
        oKillName(name)
        return
    end
    if t == N_RETURN
        oPE(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oPE(a + 8)
        return
    end
    if t == N_ASSIGN
        oPE(a + 20)
        oPE(a + 24)
        oKillName(azGet(sid, 0))
        return
    end
    if t == N_PTRASSIGN
        oPE(a + 8)
        oPE(a + 12)
        return
    end
    if t == N_IF
        oPE(a + 8)
        oPS(a + 12, a + 16)
        oPS(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oKillAsnBlock(azGet(sid, 1), azGet(sid, 2))
        oPE(a + 8)
        oPS(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oKillAsnBlock(azGet(sid, 0), azGet(sid, 1))
        oPS(a + 8, a + 12)
        return
    end
    if t == N_FOR
        oPE(a + 12)
        oPE(a + 16)
        oPE(a + 20)
        oKillName(azGet(sid, 0))
        oKillAsnBlock(azGet(sid, 4), azGet(sid, 5))
        oPS(a + 24, a + 28)
        return
    end
    if t == N_SWITCH
        oPE(a + 8)
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oPE(gSideBase + (cs + k) * 4)
            oPS(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
end

func oPS(sa: int, la: int)
    var mark: int = gOSp
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oPStmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
    # restore в ПОРЯДКЕ ПUSH (как C++: forward-обход scopeUndo)
    var j: int = mark
    while j < gOSp
        var base: int = j * 7
        var name: int = peek32(gPOSc + base * 4)
        if peek32(gPOSc + base * 4 + 4) == 1
            oKnownSet(name, peek32(gPOSc + base * 4 + 8), peek32(gPOSc + base * 4 + 12), peek32(gPOSc + base * 4 + 16), peek32(gPOSc + base * 4 + 20), peek32(gPOSc + base * 4 + 24))
        else
            oKnownErase(name)
        end
        j = j + 1
    end
    gOSp = mark
end

func oPropagateLocals()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            gNLocals = 0
            gNAsn = 0
            gNAddr = 0
            gNKnown = 0
            gOSp = 0
            # collectLocals: params + body
            var ps: int = azGet(fn, 1)
            var pl: int = azGet(fn, 2)
            var j: int = 0
            while j + 7 <= pl
                var li: int = oRecAdd(gPLocals, gNLocals, 8192, peek32(gSideBase + (ps + j) * 4))
                if li >= 0
                    if li == gNLocals
                        gNLocals = gNLocals + 1
                    end
                end
                j = j + 7
            end
            var fa: int = azNodeAddr(fn)
            oCollLoc(azGet(fn, 9), azGet(fn, 10))
            oCollAsnInto(azGet(fn, 9), azGet(fn, 10), 1)
            oCollAddrS(azGet(fn, 9), azGet(fn, 10))
            oPS(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- structuralClean (458-553) ----------

func oStructBlock(sa: int, la: int)
    # сначала вложенные блоки (innermost-first, как C++)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        if t == N_IF
            oStructBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            oStructBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
        else
            if t == N_WHILE
                oStructBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            else
                if t == N_LOOP
                    oStructBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                else
                    if t == N_FOR
                        oStructBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oStructBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    # линейные правила: только удаления/перенос init — один проход
    s0 = peek32(sa)
    n0 = peek32(la)
    var removed: int = 0
    azListBegin()
    i = 0
    var stop: int = 0
    var skipNext: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        if stop == 1
            gORm = gORm + 1
            removed = 1
        else
            if skipNext == 1
                skipNext = 0
            else
                var t: int = azTag(sid)
                var doPush: int = 1
                if t == N_RETURN || t == N_BREAK || t == N_CONTINUE
                    stop = 1
                else
                    if t == N_VARDECL
                        # 2) `var x; x = v;` -> `var x = v;`
                        if azGet(sid, 7) == 0
                            if azGet(sid, 8) == 0
                                if i + 1 < n0
                                    var nx: int = peek32(gSideBase + (s0 + i + 1) * 4)
                                    if azTag(nx) == N_ASSIGN
                                        if azGet(nx, 0) == azGet(sid, 0)
                                            if azGet(nx, 3) == 0
                                                if azGet(nx, 2) == 0
                                                    if oRefsName(azGet(nx, 4), azGet(sid, 0)) == 0
                                                        azSet(sid, 7, azGet(nx, 4))
                                                        gORm = gORm + 1
                                                        removed = 1
                                                        skipNext = 1
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    else
                        if t == N_ASSIGN
                            if azGet(sid, 3) == 0
                                if azGet(sid, 2) == 0
                                    var v0: int = azGet(sid, 4)
                                    var drop: int = 0
                                    if azTag(v0) == N_IDENT
                                        if azGet(v0, 0) == azGet(sid, 0)
                                            # 3) x = x;
                                            drop = 1
                                        end
                                    end
                                    if drop == 0
                                        # 4) x = v; x = v;
                                        if i + 1 < n0
                                            var nx3: int = peek32(gSideBase + (s0 + i + 1) * 4)
                                            if azTag(nx3) == N_ASSIGN
                                                if azGet(nx3, 0) == azGet(sid, 0)
                                                    if azGet(nx3, 3) == 0
                                                        if azGet(nx3, 2) == 0
                                                            if oMaySide(v0) == 0
                                                                if oRefsName(v0, azGet(sid, 0)) == 0
                                                                    if oSame(v0, azGet(nx3, 4)) == 1
                                                                        drop = 1
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    if drop == 1
                                        doPush = 0
                                        gORm = gORm + 1
                                        removed = 1
                                    end
                                end
                            end
                        end
                    end
                end
                if doPush == 1
                    azListPush(sid)
                end
            end
        end
        i = i + 1
    end
    azListEnd()
    if removed == 1
        poke32(sa, gLStart)
        poke32(la, gLLen)
    end
end

func oStructuralClean()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            var fa: int = azNodeAddr(fn)
            oStructBlock(fa + 44, fa + 48)
            # 6) trailing void `return;`
            var s0: int = peek32(fa + 36)
            var n0: int = peek32(fa + 40)
            if n0 > 0
                var last: int = peek32(gSideBase + (s0 + n0 - 1) * 4)
                if azTag(last) == N_RETURN
                    if azGet(last, 0) == 0
                        var removed: int = 0
                        azListBegin()
                        var k: int = 0
                        while k + 1 < n0
                            azListPush(peek32(gSideBase + (s0 + k) * 4))
                            k = k + 1
                        end
                        azListEnd()
                        poke32(fa + 36, gLStart)
                        poke32(fa + 40, gLLen)
                        gORm = gORm + 1
                    end
                end
            end
        end
        i = i + 1
    end
end

# ---------- pruneConstBranches (2033-2057): for с нулевой итерацией ----------

func oForEmptyTrip(fs: int) -> int
    var frm: int = 0
    var to: int = 0
    if oIsConstInt(azGet(fs, 1)) == 0
        return 0
    end
    frm = gOI64
    if oIsConstInt(azGet(fs, 2)) == 0
        return 0
    end
    to = gOI64
    if azGet(fs, 3) != 0
        if oIsConstInt(azGet(fs, 3)) == 0
            return 0
        end
        if gOI64 <= 0
            return 0
        end
    end
    if frm >= to
        return 1
    end
    return 0
end

func oPruneBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        if t == N_IF
            oPruneBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            oPruneBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
        else
            if t == N_WHILE
                oPruneBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            else
                if t == N_LOOP
                    oPruneBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                else
                    if t == N_FOR
                        oPruneBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oPruneBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    s0 = peek32(sa)
    n0 = peek32(la)
    var removed: int = 0
    azListBegin()
    i = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var drop: int = 0
        if azTag(sid) == N_FOR
            if oForEmptyTrip(sid) == 1
                drop = 1
                gORm = gORm + 1
                removed = 1
            end
        end
        if drop == 0
            azListPush(sid)
        end
        i = i + 1
    end
    azListEnd()
    if removed == 1
        poke32(sa, gLStart)
        poke32(la, gLLen)
    end
end

func oPruneConstBranches()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            var fa: int = azNodeAddr(fn)
            oPruneBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- cleanupIfShapes (2064-2126) ----------

func oEndsWithJump(sid: int) -> int
    if sid == 0
        return 0
    end
    var t: int = azTag(sid)
    if t == N_RETURN || t == N_BREAK || t == N_CONTINUE
        return 1
    end
    return 0
end

func oCleanupIfBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        if t == N_IF
            oCleanupIfBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            oCleanupIfBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
        else
            if t == N_WHILE
                oCleanupIfBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            else
                if t == N_LOOP
                    oCleanupIfBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                else
                    if t == N_FOR
                        oCleanupIfBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oCleanupIfBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    # линейный проход с фикс-пойнтом (сплайс ветки может породить новый if)
    var changed: int = 1
    while changed == 1
        changed = 0
        s0 = peek32(sa)
        n0 = peek32(la)
        var can: int = 0
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            if azTag(sid) == N_IF
                if azGet(sid, 0) != 0
                    if azGet(sid, 4) != 0
                        if azGet(sid, 2) == 0
                            if oDefinitelyInt(azGet(sid, 0)) == 1
                                can = 1
                            end
                        else
                            var tn: int = azGet(sid, 2)
                            var tl: int = peek32(gSideBase + (azGet(sid, 1) + tn - 1) * 4)
                            if oEndsWithJump(tl) == 1
                                can = 1
                            end
                        end
                    end
                end
            end
            if can == 1
                break
            end
            i = i + 1
        end
        if can == 0
            return
        end
        azListBegin()
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            var spliced: int = 0
            if azTag(sid) == N_IF
                if azGet(sid, 0) != 0
                    if azGet(sid, 4) != 0
                        var emptyThen: int = 0
                        if azGet(sid, 2) == 0
                            emptyThen = 1
                        end
                        if emptyThen == 1
                            if oDefinitelyInt(azGet(sid, 0)) == 1
                                # `if c {} else {B}` -> `if !c {B}`
                                azSet(sid, 0, oMakeUnary(azStrLit("!"), azGet(sid, 0)))
                                azSet(sid, 1, azGet(sid, 3))
                                azSet(sid, 2, azGet(sid, 4))
                                azSet(sid, 3, 0)
                                azSet(sid, 4, 0)
                                gORm = gORm + 1
                                changed = 1
                                azListPush(sid)
                                spliced = 1
                            end
                        else
                            var tn: int = azGet(sid, 2)
                            var last: int = peek32(gSideBase + (azGet(sid, 1) + tn - 1) * 4)
                            if oEndsWithJump(last) == 1
                                # `if c {J} else {B}` -> `if c {J}` + B
                                azListPush(sid)
                                var es: int = azGet(sid, 3)
                                var el: int = azGet(sid, 4)
                                var k: int = 0
                                while k < el
                                    azListPush(peek32(gSideBase + (es + k) * 4))
                                    k = k + 1
                                end
                                azSet(sid, 3, 0)
                                azSet(sid, 4, 0)
                                gORm = gORm + 1
                                changed = 1
                                spliced = 1
                            end
                        end
                    end
                end
            end
            if spliced == 0
                azListPush(sid)
            end
            i = i + 1
        end
        azListEnd()
        if changed == 1
            poke32(sa, gLStart)
            poke32(la, gLLen)
        end
    end
end

func oCleanupIfShapes()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            var fa: int = azNodeAddr(fn)
            oCleanupIfBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- canonicalCmp (2133-2179): a > b -> b < a ----------

func oCanonExpr(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_BINARY
        var a: int = azNodeAddr(e)
        oCanonExpr(a + 8)
        oCanonExpr(a + 12)
        if oOpIs(azGet(e, 2), ">") == 1
            if oDefinitelyInt(azGet(e, 0)) == 1
                if oDefinitelyInt(azGet(e, 1)) == 1
                    if oMaySide(azGet(e, 0)) == 0
                        if oMaySide(azGet(e, 1)) == 0
                            var l: int = azGet(e, 0)
                            var r: int = azGet(e, 1)
                            poke32(sa, oMakeBinary(azStrLit("<"), r, l))
                            gORm = gORm + 1
                            return
                        end
                    end
                end
            end
        end
        return
    end
    if t == N_UNARY
        oCanonExpr(azFldAddr(e, 1))
        return
    end
    if t == N_CALL
        oCanonExpr(azFldAddr(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oCanonExpr(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
    if t == N_ARRAYACC
        oCanonExpr(azFldAddr(e, 0))
        oCanonExpr(azFldAddr(e, 1))
        return
    end
    if t == N_MEMBER
        oCanonExpr(azFldAddr(e, 0))
        return
    end
    if t == N_DEREF
        oCanonExpr(azFldAddr(e, 0))
        return
    end
end

# как oSimplifyStmt, но БЕЗ рекурсии в условия if/while (C++ walker не
# заходит в condition) — только expr-слоты + forEachNestedBlock
func oCanonStmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        oCanonExpr(a + 36)
        return
    end
    if t == N_RETURN
        oCanonExpr(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oCanonExpr(a + 8)
        return
    end
    if t == N_ASSIGN
        oCanonExpr(a + 20)
        oCanonExpr(a + 24)
        return
    end
    if t == N_PTRASSIGN
        oCanonExpr(a + 8)
        oCanonExpr(a + 12)
        return
    end
    if t == N_IF
        oCanonBlock(a + 12, a + 16)
        oCanonBlock(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oCanonBlock(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oCanonBlock(a + 8, a + 12)
        return
    end
    if t == N_SWITCH
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oCanonBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oCanonBlock(a + 24, a + 28)
        return
    end
end

func oCanonBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oCanonStmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
end

func oCanonicalCmp()
    var i: int = 0
    while i < gGlobalN
        oCanonExpr(azFldAddr(gGlobalIds[i], 7))
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            var fa: int = azNodeAddr(fn)
            oCanonBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- pullPow2Products (2186-2244) ----------

# out-регистр oMatchPow2Factor: «остаток» (отдельно от счётчика gOSr!)
var gORest: int = 0

func oMatchPow2Factor(e: int) -> int
    # 1 => gOSh = shift, gORest = «остаток» rest
    gOSh = -1
    gORest = 0
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var op: int = azGet(e, 2)
    var c: int = 0
    if oOpIs(op, "<<") == 1
        if oIsConstInt(azGet(e, 1)) == 1
            c = gOI64
            if c > 0
                if c < 64
                    gOSh = c
                    gORest = azGet(e, 0)
                    return 1
                end
            end
        end
        return 0
    end
    if oOpIs(op, "*") != 1
        return 0
    end
    if oIsConstInt(azGet(e, 1)) == 1
        c = gOI64
        var sh: int = oIsPow2(c)
        if sh > 0
            gOSh = sh
            gORest = azGet(e, 0)
            return 1
        end
    end
    if oIsConstInt(azGet(e, 0)) == 1
        c = gOI64
        var sh2: int = oIsPow2(c)
        if sh2 > 0
            gOSh = sh2
            gORest = azGet(e, 1)
            return 1
        end
    end
    return 0
end

func oPullPow2Expr(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_BINARY
        var a: int = azNodeAddr(e)
        oPullPow2Expr(a + 8)
        oPullPow2Expr(a + 12)
        if oOpIs(azGet(e, 2), "*") != 1
            return
        end
        if oDefinitelyInt(azGet(e, 0)) == 0
            return
        end
        if oMatchPow2Factor(azGet(e, 1)) == 0
            return
        end
        var shift: int = gOSh
        var rest: int = gORest
        var product: int = oMakeBinary(azStrLit("*"), azGet(e, 0), rest)
        poke32(sa, oMakeBinary(azStrLit("<<"), product, oMakeNum(shift)))
        gOSr = gOSr + 1
        gORm = gORm + 1
        return
    end
    if t == N_UNARY
        oPullPow2Expr(azFldAddr(e, 1))
        return
    end
    if t == N_CALL
        oPullPow2Expr(azFldAddr(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oPullPow2Expr(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
    if t == N_ARRAYACC
        oPullPow2Expr(azFldAddr(e, 0))
        oPullPow2Expr(azFldAddr(e, 1))
        return
    end
    if t == N_MEMBER
        oPullPow2Expr(azFldAddr(e, 0))
        return
    end
    if t == N_DEREF
        oPullPow2Expr(azFldAddr(e, 0))
        return
    end
end

func oPullPow2Stmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        oPullPow2Expr(a + 36)
        return
    end
    if t == N_RETURN
        oPullPow2Expr(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oPullPow2Expr(a + 8)
        return
    end
    if t == N_ASSIGN
        oPullPow2Expr(a + 20)
        oPullPow2Expr(a + 24)
        return
    end
    if t == N_PTRASSIGN
        oPullPow2Expr(a + 8)
        oPullPow2Expr(a + 12)
        return
    end
    if t == N_IF
        oPullPow2Block(a + 12, a + 16)
        oPullPow2Block(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oPullPow2Block(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oPullPow2Block(a + 8, a + 12)
        return
    end
    if t == N_SWITCH
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oPullPow2Block(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oPullPow2Block(a + 24, a + 28)
        return
    end
end

func oPullPow2Block(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oPullPow2Stmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
end

func oPullPow2Products()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            var fa: int = azNodeAddr(fn)
            oPullPow2Block(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- mergeNestedIfs (2251-2308) ----------

func oMergeIfBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        if t == N_IF
            oMergeIfBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            oMergeIfBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
        else
            if t == N_WHILE
                oMergeIfBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
            else
                if t == N_LOOP
                    oMergeIfBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                else
                    if t == N_FOR
                        oMergeIfBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oMergeIfBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    # фикс-пойнт: слияние может вскрыть ещё один вложенный if
    var changed: int = 1
    while changed == 1
        changed = 0
        s0 = peek32(sa)
        n0 = peek32(la)
        var can: int = 0
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            if azTag(sid) == N_IF
                if azGet(sid, 4) == 0
                    if azGet(sid, 2) != 0
                        if azGet(sid, 0) != 0
                            var inner: int = 0
                            if azGet(sid, 2) == 1
                                inner = peek32(gSideBase + azGet(sid, 1) * 4)
                            end
                            if inner != 0
                                if azTag(inner) == N_IF
                                    if azGet(inner, 4) == 0
                                        if azGet(inner, 0) != 0
                                            if oDefinitelyInt(azGet(sid, 0)) == 1
                                                if oDefinitelyInt(azGet(inner, 0)) == 1
                                                    can = 1
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            if can == 1
                break
            end
            i = i + 1
        end
        if can == 0
            return
        end
        i = 0
        while i < n0
            var sid: int = peek32(gSideBase + (s0 + i) * 4)
            if azTag(sid) == N_IF
                if azGet(sid, 4) == 0
                    if azGet(sid, 2) != 0
                        if azGet(sid, 0) != 0
                            var inner: int = 0
                            if azGet(sid, 2) == 1
                                inner = peek32(gSideBase + azGet(sid, 1) * 4)
                            end
                            if inner != 0
                                if azTag(inner) == N_IF
                                    if azGet(inner, 4) == 0
                                        if azGet(inner, 0) != 0
                                            if oDefinitelyInt(azGet(sid, 0)) == 1
                                                if oDefinitelyInt(azGet(inner, 0)) == 1
                                                    azSet(sid, 0, oMakeBinary(azStrLit("&&"), azGet(sid, 0), azGet(inner, 0)))
                                                    azSet(sid, 1, azGet(inner, 1))
                                                    azSet(sid, 2, azGet(inner, 2))
                                                    gORm = gORm + 1
                                                    changed = 1
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
            i = i + 1
        end
    end
end

func oMergeNestedIfs()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            var fa: int = azNodeAddr(fn)
            oMergeIfBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# ---------- deadStoreElimination (812-989) ----------
# oReadsS/oReadsE: sel 0 -> gTbGlRd (programGlobalsRead), 1 -> gTbLocRd

func oReadAdd(name: int, sel: int)
    if sel == 0
        var li: int = oRecAdd(gPGlRd, gNGlRd, 4096, name)
        if li >= 0
            if li == gNGlRd
                gNGlRd = gNGlRd + 1
            end
        end
    else
        var li2: int = oRecAdd(gPLocRd, gNLocRd, 8192, name)
        if li2 >= 0
            if li2 == gNLocRd
                gNLocRd = gNLocRd + 1
            end
        end
    end
end

func oReadsE(e: int, ft: int, fn: int, sel: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_IDENT || t == N_ADDROF
        var name: int = azGet(e, 0)
        if oSetHas(ft, fn, name) == 1
            oReadAdd(name, sel)
        end
        return
    end
    if t == N_UNARY
        oReadsE(azGet(e, 1), ft, fn, sel)
        return
    end
    if t == N_BINARY
        oReadsE(azGet(e, 0), ft, fn, sel)
        oReadsE(azGet(e, 1), ft, fn, sel)
        return
    end
    if t == N_MEMBER
        oReadsE(azGet(e, 0), ft, fn, sel)
        return
    end
    if t == N_ARRAYACC
        oReadsE(azGet(e, 0), ft, fn, sel)
        oReadsE(azGet(e, 1), ft, fn, sel)
        return
    end
    if t == N_DEREF
        oReadsE(azGet(e, 0), ft, fn, sel)
        return
    end
    if t == N_CALL
        oReadsE(azGet(e, 1), ft, fn, sel)
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oReadsE(peek32(gSideBase + (as + k) * 4), ft, fn, sel)
            k = k + 1
        end
        return
    end
end

func oReadsS(s: int, n: int, ft: int, fn: int, sel: int)
    var i: int = 0
    while i < n
        var sid: int = peek32(gSideBase + (s + i) * 4)
        var t: int = azTag(sid)
        if t == N_VARDECL
            oReadsE(azGet(sid, 7), ft, fn, sel)
        else
            if t == N_RETURN
                oReadsE(azGet(sid, 0), ft, fn, sel)
            else
                if t == N_EXPRSTMT
                    oReadsE(azGet(sid, 0), ft, fn, sel)
                else
                    if t == N_ASSIGN
                        oReadsE(azGet(sid, 3), ft, fn, sel)
                        oReadsE(azGet(sid, 4), ft, fn, sel)
                    else
                        if t == N_PTRASSIGN
                            oReadsE(azGet(sid, 0), ft, fn, sel)
                            oReadsE(azGet(sid, 1), ft, fn, sel)
                        else
                            if t == N_IF
                                oReadsE(azGet(sid, 0), ft, fn, sel)
                                oReadsS(azGet(sid, 1), azGet(sid, 2), ft, fn, sel)
                                oReadsS(azGet(sid, 3), azGet(sid, 4), ft, fn, sel)
                            else
                                if t == N_WHILE
                                    oReadsE(azGet(sid, 0), ft, fn, sel)
                                    oReadsS(azGet(sid, 1), azGet(sid, 2), ft, fn, sel)
                                else
                                    if t == N_LOOP
                                        oReadsS(azGet(sid, 0), azGet(sid, 1), ft, fn, sel)
                                    else
                                        if t == N_FOR
                                            oReadsE(azGet(sid, 1), ft, fn, sel)
                                            oReadsE(azGet(sid, 2), ft, fn, sel)
                                            oReadsE(azGet(sid, 3), ft, fn, sel)
                                            oReadsS(azGet(sid, 4), azGet(sid, 5), ft, fn, sel)
                                        else
                                            if t == N_SWITCH
                                                oReadsE(azGet(sid, 0), ft, fn, sel)
                                                var cs: int = azGet(sid, 1)
                                                var cl: int = azGet(sid, 2)
                                                var k: int = 0
                                                while k + 2 < cl
                                                    oReadsE(peek32(gSideBase + (cs + k) * 4), ft, fn, sel)
                                                    oReadsS(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4), ft, fn, sel)
                                                    k = k + 3
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
end

func oRemoveDeadStores(sa: int, la: int, lT: int, lN: int, lrT: int, lrN: int, grT: int, grN: int, glT: int, glN: int)
    # pass0: вложенные блоки
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        if t == N_IF
            oRemoveDeadStores(azFldAddr(sid, 1), azFldAddr(sid, 2), lT, lN, lrT, lrN, grT, grN, glT, glN)
            oRemoveDeadStores(azFldAddr(sid, 3), azFldAddr(sid, 4), lT, lN, lrT, lrN, grT, grN, glT, glN)
        else
            if t == N_WHILE
                oRemoveDeadStores(azFldAddr(sid, 1), azFldAddr(sid, 2), lT, lN, lrT, lrN, grT, grN, glT, glN)
            else
                if t == N_LOOP
                    oRemoveDeadStores(azFldAddr(sid, 0), azFldAddr(sid, 1), lT, lN, lrT, lrN, grT, grN, glT, glN)
                else
                    if t == N_FOR
                        oRemoveDeadStores(azFldAddr(sid, 4), azFldAddr(sid, 5), lT, lN, lrT, lrN, grT, grN, glT, glN)
                    else
                        if t == N_SWITCH
                            var cs: int = azGet(sid, 1)
                            var cl: int = azGet(sid, 2)
                            var k: int = 0
                            while k + 2 < cl
                                oRemoveDeadStores(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4, lT, lN, lrT, lrN, grT, grN, glT, glN)
                                k = k + 3
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    # pass1: правила
    s0 = peek32(sa)
    n0 = peek32(la)
    var removed: int = 0
    azListBegin()
    i = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        var t: int = azTag(sid)
        var push: int = 1
        if t == N_VARDECL
            var name: int = azGet(sid, 0)
            if oSetHas(lT, lN, name) == 1
                if oSetHas(lrT, lrN, name) == 0
                    var init: int = azGet(sid, 7)
                    if init == 0
                        push = 0
                        gORm = gORm + 1
                        removed = 1
                    else
                        if oMaySide(init) == 0
                            push = 0
                            gORm = gORm + 1
                            removed = 1
                        else
                            # init со side-эффектами: оставляем вызов, переменную убираем
                            var es: int = azNew(N_EXPRSTMT, 0)
                            azSet(es, 0, init)
                            poke32(gSideBase + (s0 + i) * 4, es)
                            gORm = gORm + 1
                            removed = 1
                        end
                    end
                end
            end
        else
            if t == N_ASSIGN
                if azGet(sid, 3) == 0
                    if azGet(sid, 2) == 0
                        var name2: int = azGet(sid, 0)
                        var dead: int = 0
                        if oSetHas(lT, lN, name2) == 1
                            if oSetHas(lrT, lrN, name2) == 0
                                dead = 1
                            end
                        end
                        if dead == 0
                            if oSetHas(glT, glN, name2) == 1
                                if oSetHas(grT, grN, name2) == 0
                                    dead = 1
                                end
                            end
                        end
                        if dead == 1
                            if oMaySide(azGet(sid, 4)) == 0
                                push = 0
                                gORm = gORm + 1
                                removed = 1
                            end
                        end
                    end
                end
            end
        end
        if push == 1
            azListPush(sid)
        end
        i = i + 1
    end
    azListEnd()
    if removed == 1
        poke32(sa, gLStart)
        poke32(la, gLLen)
    end
end

func oDeadStoreElimination()
    # globals (имена)
    gNGlSet = 0
    var i: int = 0
    while i < gGlobalN
        var li: int = oRecAdd(gPGlSet, gNGlSet, 4096, azGet(gGlobalIds[i], 0))
        if li >= 0
            if li == gNGlSet
                gNGlSet = gNGlSet + 1
            end
        end
        i = i + 1
    end
    # programGlobalsRead — по ВСЕМ не-extern функциям
    gNGlRd = 0
    i = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oReadsS(azGet(fn, 9), azGet(fn, 10), gPGlSet, gNGlSet, 0)
        end
        i = i + 1
    end
    # per-функция
    i = 0
    while i < gFuncN
        var fn2: int = gFuncIds[i]
        if azGet(fn2, 11) == 0
            gNLocals = 0
            oCollLoc(azGet(fn2, 9), azGet(fn2, 10))
            gNLocRd = 0
            oReadsS(azGet(fn2, 9), azGet(fn2, 10), gPLocals, gNLocals, 1)
            var fa: int = azNodeAddr(fn2)
            oRemoveDeadStores(fa + 44, fa + 48, gPLocals, gNLocals, gPLocRd, gNLocRd, gPGlRd, gNGlRd, gPGlSet, gNGlSet)
        end
        i = i + 1
    end
end

# ---------- inlineTinyFunctions (1800-1980) ----------

# occ-накопитель для substituteTinyBody: слот (адрес i32) + индекс аргумента
var gTOcSa: [4096]int
var gTOcIx: [4096]int
var gNOc: int = 0
var gTOcCnt: [1024]int
var gOOcRoot: int = 0    # 1 = корень клона (слот call) — тоже occ
var gOCallSa: int = 0    # слот call'а текущей подстановки (oTinyWalk)

func oParamIdx(fn: int, name: int) -> int
    var ps: int = azGet(fn, 1)
    var pl: int = azGet(fn, 2)
    var i: int = 0
    while i + 7 <= pl
        if azStrEq(peek32(gSideBase + (ps + i) * 4), name) == 1
            return i / 7
        end
        i = i + 7
    end
    return -1
end

# walk клона: собирает occs/флаг bad (возврат: 1 = bad)
func oTinyWalk(n: int, sa: int, fn: int) -> int
    if n == 0
        return 0
    end
    var t: int = azTag(n)
    if t == N_IDENT
        var idx: int = oParamIdx(fn, azGet(n, 0))
        if idx >= 0
            if gNOc < 4096
                gTOcSa[gNOc] = sa
                gTOcIx[gNOc] = idx
                gNOc = gNOc + 1
                if sa == gOCallSa
                    gOOcRoot = 1
                end
            else
                return 1
            end
        end
        return 0
    end
    if t == N_ADDROF
        if oParamIdx(fn, azGet(n, 0)) >= 0
            return 1
        end
        return 0
    end
    if t == N_MEMBER
        var obj: int = azGet(n, 0)
        if azTag(obj) == N_IDENT
            if oParamIdx(fn, azGet(obj, 0)) >= 0
                return 1
            end
        end
        return oTinyWalk(obj, azFldAddr(n, 0), fn)
    end
    if t == N_ARRAYACC
        var arr: int = azGet(n, 0)
        if azTag(arr) == N_IDENT
            if oParamIdx(fn, azGet(arr, 0)) >= 0
                return 1
            end
        end
        if oTinyWalk(arr, azFldAddr(n, 0), fn) == 1
            return 1
        end
        return oTinyWalk(azGet(n, 1), azFldAddr(n, 1), fn)
    end
    if t == N_BINARY
        if oTinyWalk(azGet(n, 0), azFldAddr(n, 0), fn) == 1
            return 1
        end
        return oTinyWalk(azGet(n, 1), azFldAddr(n, 1), fn)
    end
    if t == N_UNARY
        return oTinyWalk(azGet(n, 1), azFldAddr(n, 1), fn)
    end
    if t == N_DEREF
        return oTinyWalk(azGet(n, 0), azFldAddr(n, 0), fn)
    end
    if t == N_CALL
        if oTinyWalk(azGet(n, 1), azFldAddr(n, 1), fn) == 1
            return 1
        end
        var as: int = azGet(n, 2)
        var an: int = azGet(n, 3)
        var k: int = 0
        while k < an
            if oTinyWalk(peek32(gSideBase + (as + k) * 4), gSideBase + (as + k) * 4, fn) == 1
                return 1
            end
            k = k + 1
        end
        return 0
    end
    return 0
end

func oSubstituteTiny(callSa: int, callId: int, fn: int) -> int
    if azGet(fn, 10) != 1
        return 0
    end
    var retSid: int = peek32(gSideBase + azGet(fn, 9) * 4)
    if azTag(retSid) != N_RETURN
        return 0
    end
    var val: int = azGet(retSid, 0)
    if val == 0
        return 0
    end
    if azGet(callId, 3) * 7 != azGet(fn, 2)
        return 0
    end
    var cloneId: int = oClone(val)
    if cloneId == 0
        return 0
    end
    gNOc = 0
    gOOcRoot = 0
    gOCallSa = callSa
    var i: int = 0
    while i < 1024
        gTOcCnt[i] = 0
        i = i + 1
    end
    if oTinyWalk(cloneId, callSa, fn) == 1
        return 0
    end
    # не больше одного вхождения на параметр
    i = 0
    while i < gNOc
        var ix: int = gTOcIx[i]
        if ix < 1024
            gTOcCnt[ix] = gTOcCnt[ix] + 1
            if gTOcCnt[ix] > 1
                return 0
            end
        else
            return 0
        end
        i = i + 1
    end
    # подстановка аргументов (move из call->args)
    var as: int = azGet(callId, 2)
    i = 0
    while i < gNOc
        var ix2: int = gTOcIx[i]
        if ix2 < azGet(callId, 3)
            var argId: int = peek32(gSideBase + (as + ix2) * 4)
            if argId != 0
                poke32(gTOcSa[i], argId)
            end
        end
        i = i + 1
    end
    if gOOcRoot == 0
        poke32(callSa, cloneId)
    end
    return 1
end

func oTryInline(sa: int) -> int
    var e: int = peek32(sa)
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_CALL
        var ti: int = oRecFind(gPTiny, gNTiny, 4096, azGet(e, 0))
        if ti >= 0
            # виртуальный вызов не инлайнится (f4 — всегда 0 на z-пути)
            if azGet(e, 4) == 0
                var safe: int = 1
                if oMaySide(azGet(e, 1)) == 1
                    safe = 0
                end
                if safe == 1
                    var as: int = azGet(e, 2)
                    var an: int = azGet(e, 3)
                    var k: int = 0
                    while k < an
                        if oMaySide(peek32(gSideBase + (as + k) * 4)) == 1
                            safe = 0
                        end
                        k = k + 1
                    end
                end
                if safe == 1
                    if oSubstituteTiny(sa, e, peek32(gPTiny + ti * 24 + 4)) == 1
                        gORm = gORm + 1
                        oTryInline(sa)
                    end
                end
            end
            return 1
        end
        var ch: int = 0
        if azGet(e, 1) != 0
            if oTryInline(azFldAddr(e, 1)) == 1
                ch = 1
            end
        end
        var as2: int = azGet(e, 2)
        var an2: int = azGet(e, 3)
        var k2: int = 0
        while k2 < an2
            if oTryInline(gSideBase + (as2 + k2) * 4) == 1
                ch = 1
            end
            k2 = k2 + 1
        end
        return ch
    end
    if t == N_BINARY
        var ch2: int = 0
        if oTryInline(azFldAddr(e, 0)) == 1
            ch2 = 1
        end
        if oTryInline(azFldAddr(e, 1)) == 1
            ch2 = 1
        end
        return ch2
    end
    if t == N_UNARY
        return oTryInline(azFldAddr(e, 1))
    end
    if t == N_MEMBER
        return oTryInline(azFldAddr(e, 0))
    end
    if t == N_ARRAYACC
        var ch3: int = 0
        if oTryInline(azFldAddr(e, 0)) == 1
            ch3 = 1
        end
        if oTryInline(azFldAddr(e, 1)) == 1
            ch3 = 1
        end
        return ch3
    end
    if t == N_DEREF
        return oTryInline(azFldAddr(e, 0))
    end
    return 0
end

# рекурсивный поиск собственного вызова (skip direct recursion)
func oScanSelf(e: int, fname: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_CALL
        if azStrEq(azGet(e, 0), fname) == 1
            return 1
        end
        if oScanSelf(azGet(e, 1), fname) == 1
            return 1
        end
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            if oScanSelf(peek32(gSideBase + (as + k) * 4), fname) == 1
                return 1
            end
            k = k + 1
        end
        return 0
    end
    if t == N_BINARY
        if oScanSelf(azGet(e, 0), fname) == 1
            return 1
        end
        return oScanSelf(azGet(e, 1), fname)
    end
    if t == N_UNARY
        return oScanSelf(azGet(e, 1), fname)
    end
    if t == N_MEMBER
        return oScanSelf(azGet(e, 0), fname)
    end
    if t == N_ARRAYACC
        if oScanSelf(azGet(e, 0), fname) == 1
            return 1
        end
        return oScanSelf(azGet(e, 1), fname)
    end
    if t == N_DEREF
        return oScanSelf(azGet(e, 0), fname)
    end
    return 0
end

func oInlineStmt(sid: int)
    var t: int = azTag(sid)
    var a: int = azNodeAddr(sid)
    if t == N_VARDECL
        oTryInline(a + 36)
        return
    end
    if t == N_RETURN
        oTryInline(a + 8)
        return
    end
    if t == N_EXPRSTMT
        oTryInline(a + 8)
        return
    end
    if t == N_ASSIGN
        oTryInline(a + 20)
        oTryInline(a + 24)
        return
    end
    if t == N_PTRASSIGN
        oTryInline(a + 8)
        oTryInline(a + 12)
        return
    end
    if t == N_IF
        oTryInline(a + 8)
        oInlineBlock(a + 12, a + 16)
        oInlineBlock(a + 20, a + 24)
        return
    end
    if t == N_WHILE
        oTryInline(a + 8)
        oInlineBlock(a + 12, a + 16)
        return
    end
    if t == N_LOOP
        oInlineBlock(a + 8, a + 12)
        return
    end
    if t == N_FOR
        oTryInline(a + 12)
        oTryInline(a + 16)
        oTryInline(a + 20)
        oInlineBlock(a + 24, a + 28)
        return
    end
    if t == N_SWITCH
        oTryInline(a + 8)
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 2 < cl
            oTryInline(gSideBase + (cs + k) * 4)
            oInlineBlock(gSideBase + (cs + k + 1) * 4, gSideBase + (cs + k + 2) * 4)
            k = k + 3
        end
        return
    end
end

func oInlineBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        oInlineStmt(peek32(gSideBase + (s0 + i) * 4))
        i = i + 1
    end
end

func oInlineTinyFunctions()
    # сбор tiny-таблицы
    gNTiny = 0
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            if azStrLitEq(azGet(fn, 0), "main") == 0
                if azGet(fn, 10) == 1
                    var retSid: int = peek32(gSideBase + azGet(fn, 9) * 4)
                    if azTag(retSid) == N_RETURN
                        if azGet(retSid, 0) != 0
                            if oScanSelf(azGet(retSid, 0), azGet(fn, 0)) == 0
                                var li: int = oRecAdd(gPTiny, gNTiny, 4096, azGet(fn, 0))
                                if li >= 0
                                    if li == gNTiny
                                        gNTiny = gNTiny + 1
                                    end
                                    poke32(gPTiny + li * 24 + 4, fn)
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    if gNTiny == 0
        return
    end
    i = 0
    while i < gGlobalN
        oTryInline(azFldAddr(gGlobalIds[i], 7))
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn2: int = gFuncIds[i]
        if azGet(fn2, 11) == 0
            var fa: int = azNodeAddr(fn2)
            oInlineBlock(fa + 44, fa + 48)
        end
        i = i + 1
    end
end

# =====================================================================
# chunk 6 — хвост optimize(): collectFuncRefs*/collectGlobalRefs*
# (optimizer.cpp:67-234), findReachable (236-253), DCE-половина
# optimize() (298-428), speedReduce* (1630-1798) и ТОЧКА ВХОДА oOptRun
# (аналог Optimizer::optimize, 255-429). Мостов на C++ нет: всё ходит
# по ZAST через az*, наборы — таблицы gTb* из шапки файла.
# =====================================================================

# запись в gTb*-таблицу: массив передаётся ПАРАМЕТРОМ (как в oSetHas) —
# побайтовая адресация гарантирована; сам oSetHas читает те же смещения
# (peek32(t + i*24)), поэтому формат записи обязан совпадать.
func oTbPut(t: int, i: int, v: int)
    poke32(t + i * 24, v)
end

func oTbPut2(t: int, i: int, v: int)
    poke32(t + i * 24 + 4, v)
end


# сырые адреса таблиц (&arr-идиом cg_zast.z): массив как аргумент или
# операнд падает в сегфолт — адреса связываются один раз в oTbBind
var gPAddr: int = 0
var gPAsn: int = 0
var gPExtn: int = 0
var gPFdK: int = 0
var gPFnUser: int = 0
var gPORef: int = 0
var gPOSc: int = 0
var gPFrK: int = 0
var gPGlK: int = 0
var gPGlRd: int = 0
var gPGlSet: int = 0
var gPGlUsed: int = 0
var gPKnown: int = 0
var gPLocals: int = 0
var gPLocK: int = 0
var gPLocRd: int = 0
var gPReach: int = 0
var gPTiny: int = 0
var gPTmp: int = 0

func oTbBind()
    gPAddr = &gTbAddr
    gPAsn = &gTbAsn
    gPORef = &gORef
    gPOSc = &gOSc
    gPExtn = &gTbExtn
    gPFdK = &gTbFdK
    gPFnUser = &gTbFnUser
    gPFrK = &gTbFrK
    gPGlK = &gTbGlK
    gPGlRd = &gTbGlRd
    gPGlSet = &gTbGlSet
    gPGlUsed = &gTbGlUsed
    gPKnown = &gTbKnown
    gPLocals = &gTbLocals
    gPLocK = &gTbLocK
    gPLocRd = &gTbLocRd
    gPReach = &gTbReach
    gPTiny = &gTbTiny
    gPTmp = &gTbTmp
end

# ---- локальный ref-сбор одного обхода (имена вызовов/идентов) ----
# stride как у gTb* (6 слов), чтобы пользоваться oSetHas
var gORef: [18432]int
var gORefN: int = 0

# Worklist для reachability (BFS). Раньше oFindReachable был рекурсивным и
# использовал ОБЩИЙ буфер gORef как список соседей: каждый рекурсивный вызов
# делал oRefReset() и перетирал gORef, по которому шёл внешний цикл — из-за
# этого соседи после первого (h2/hashLoop) терялись, и DCE ошибочно вырезал
# достижимые функции. Работаем через отдельный worklist: gORef читается в
# gORchWork целиком ДО дальнейших шагов, поэтому рекурсивного затирания нет.
var gORchWork: [16384]int
var gORchWorkN: int = 0

func oReachEnq(name: int)
    if gORchWorkN < 16384
        gORchWork[gORchWorkN] = name
        gORchWorkN = gORchWorkN + 1
    end
end

func oRefReset()
    gORefN = 0
end

func oRefAdd(name: int)
    if oSetHas(gPORef, gORefN, name) == 1
        return
    end
    if gORefN < 2048
        poke32(gPORef + gORefN * 24, name)
        gORefN = gORefN + 1
    end
end

# ---- isUserFunc / isGlobal (C++ строят их хеш-сетями; здесь линейные) ----

# заполнить gTbFnUser (v0 = funcId) из gFuncIds, кроме extern
func oFnUserBuild()
    oTbBind()
    gNFnUser = 0
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            if gNFnUser < 8192
                poke32(gPFnUser + gNFnUser * 24, azGet(fn, 0))
                poke32(gPFnUser + gNFnUser * 24 + 4, fn)
                gNFnUser = gNFnUser + 1
            end
        end
        i = i + 1
    end
end

# funcId не-extern функции или -1
func oIsUserFuncId(name: int) -> int
    var i: int = 0
    while i < gNFnUser
        if azStrEq(peek32(gPFnUser + i * 24), name) == 1
            return peek32(gPFnUser + i * 24 + 4)
        end
        i = i + 1
    end
    return -1
end

# есть ли функция с таким именем ВООБЩЕ (включая extern) — для N_ADDROF
func oFuncAny(name: int) -> int
    var i: int = 0
    while i < gFuncN
        if azStrEq(azGet(gFuncIds[i], 0), name) == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

# заполнить gTbGlSet (имена глобалов) из gGlobalIds
func oGlSetBuild()
    oTbBind()
    gNGlSet = 0
    var i: int = 0
    while i < gGlobalN
        if gNGlSet < 4096
            poke32(gPGlSet + gNGlSet * 24, azGet(gGlobalIds[i], 0))
            gNGlSet = gNGlSet + 1
        end
        i = i + 1
    end
end

func oIsGlobal(name: int) -> int
    if oSetHas(gPGlSet, gNGlSet, name) == 1
        return 1
    end
    return 0
end

# ---- collectFuncRefsIn* (optimizer.cpp:67-155) ----

func oCollectFuncRefsE(e: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_CALL
        oRefAdd(azGet(e, 0))
        oCollectFuncRefsE(azGet(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var i: int = 0
        while i < an
            oCollectFuncRefsE(peek32(gSideBase + (as + i) * 4))
            i = i + 1
        end
        return
    end
    if t == N_IDENT
        var nm: int = azGet(e, 0)
        if oIsUserFuncId(nm) >= 0
            oRefAdd(nm)
        end
        return
    end
    if t == N_BINARY
        oCollectFuncRefsE(azGet(e, 0))
        oCollectFuncRefsE(azGet(e, 1))
        return
    end
    if t == N_UNARY
        oCollectFuncRefsE(azGet(e, 1))
        return
    end
    if t == N_MEMBER
        oCollectFuncRefsE(azGet(e, 0))
        return
    end
    if t == N_ARRAYACC
        oCollectFuncRefsE(azGet(e, 0))
        oCollectFuncRefsE(azGet(e, 1))
        return
    end
    if t == N_DEREF
        oCollectFuncRefsE(azGet(e, 0))
        return
    end
    if t == N_ADDROF
        # &var / &func держит цель живой (адрес утекает)
        if oFuncAny(azGet(e, 0)) == 1
            oRefAdd(azGet(e, 0))
        end
        return
    end
end

func oCollectFuncRefsBlock(sa: int, la: int)
    var i: int = 0
    while i < la
        oCollectFuncRefsS(peek32(gSideBase + (sa + i) * 4))
        i = i + 1
    end
end

func oCollectFuncRefsS(sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_VARDECL
        oCollectFuncRefsE(azGet(sid, 7))
        return
    end
    if t == N_RETURN
        oCollectFuncRefsE(azGet(sid, 0))
        return
    end
    if t == N_EXPRSTMT
        oCollectFuncRefsE(azGet(sid, 0))
        return
    end
    if t == N_ASSIGN
        oCollectFuncRefsE(azGet(sid, 4))
        oCollectFuncRefsE(azGet(sid, 3))
        if oIsUserFuncId(azGet(sid, 0)) >= 0
            oRefAdd(azGet(sid, 0))
        end
        return
    end
    if t == N_PTRASSIGN
        oCollectFuncRefsE(azGet(sid, 0))
        oCollectFuncRefsE(azGet(sid, 1))
        return
    end
    if t == N_IF
        oCollectFuncRefsE(azGet(sid, 0))
        oCollectFuncRefsBlock(azGet(sid, 1), azGet(sid, 2))
        oCollectFuncRefsBlock(azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        oCollectFuncRefsE(azGet(sid, 0))
        oCollectFuncRefsBlock(azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_LOOP
        oCollectFuncRefsBlock(azGet(sid, 0), azGet(sid, 1))
        return
    end
    if t == N_SWITCH
        oCollectFuncRefsE(azGet(sid, 0))
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 3 <= cl
            oCollectFuncRefsE(peek32(gSideBase + (cs + k) * 4))
            oCollectFuncRefsBlock(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4))
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oCollectFuncRefsE(azGet(sid, 1))
        oCollectFuncRefsE(azGet(sid, 2))
        oCollectFuncRefsE(azGet(sid, 3))
        oCollectFuncRefsBlock(azGet(sid, 4), azGet(sid, 5))
        return
    end
end

# ---- collectGlobalRefsIn* (optimizer.cpp:157-234) ----
# отличие от func-версии: N_CALL имя НЕ добавляет (только receiver/args),
# N_IDENT/N_ADDROF проверяются по глобалам

func oCollectGlobalRefsE(e: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_IDENT
        if oIsGlobal(azGet(e, 0)) == 1
            oRefAdd(azGet(e, 0))
        end
        return
    end
    if t == N_CALL
        oCollectGlobalRefsE(azGet(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var i: int = 0
        while i < an
            oCollectGlobalRefsE(peek32(gSideBase + (as + i) * 4))
            i = i + 1
        end
        return
    end
    if t == N_BINARY
        oCollectGlobalRefsE(azGet(e, 0))
        oCollectGlobalRefsE(azGet(e, 1))
        return
    end
    if t == N_UNARY
        oCollectGlobalRefsE(azGet(e, 1))
        return
    end
    if t == N_MEMBER
        oCollectGlobalRefsE(azGet(e, 0))
        return
    end
    if t == N_ARRAYACC
        oCollectGlobalRefsE(azGet(e, 0))
        oCollectGlobalRefsE(azGet(e, 1))
        return
    end
    if t == N_DEREF
        oCollectGlobalRefsE(azGet(e, 0))
        return
    end
    if t == N_ADDROF
        if oIsGlobal(azGet(e, 0)) == 1
            oRefAdd(azGet(e, 0))
        end
        return
    end
end

func oCollectGlobalRefsBlock(sa: int, la: int)
    var i: int = 0
    while i < la
        oCollectGlobalRefsS(peek32(gSideBase + (sa + i) * 4))
        i = i + 1
    end
end

func oCollectGlobalRefsS(sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_VARDECL
        oCollectGlobalRefsE(azGet(sid, 7))
        return
    end
    if t == N_RETURN
        oCollectGlobalRefsE(azGet(sid, 0))
        return
    end
    if t == N_EXPRSTMT
        oCollectGlobalRefsE(azGet(sid, 0))
        return
    end
    if t == N_ASSIGN
        oCollectGlobalRefsE(azGet(sid, 4))
        oCollectGlobalRefsE(azGet(sid, 3))
        if oIsGlobal(azGet(sid, 0)) == 1
            oRefAdd(azGet(sid, 0))
        end
        return
    end
    if t == N_PTRASSIGN
        oCollectGlobalRefsE(azGet(sid, 0))
        oCollectGlobalRefsE(azGet(sid, 1))
        return
    end
    if t == N_IF
        oCollectGlobalRefsE(azGet(sid, 0))
        oCollectGlobalRefsBlock(azGet(sid, 1), azGet(sid, 2))
        oCollectGlobalRefsBlock(azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        oCollectGlobalRefsE(azGet(sid, 0))
        oCollectGlobalRefsBlock(azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_LOOP
        oCollectGlobalRefsBlock(azGet(sid, 0), azGet(sid, 1))
        return
    end
    if t == N_SWITCH
        oCollectGlobalRefsE(azGet(sid, 0))
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 3 <= cl
            oCollectGlobalRefsE(peek32(gSideBase + (cs + k) * 4))
            oCollectGlobalRefsBlock(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4))
            k = k + 3
        end
        return
    end
    if t == N_FOR
        oCollectGlobalRefsE(azGet(sid, 1))
        oCollectGlobalRefsE(azGet(sid, 2))
        oCollectGlobalRefsE(azGet(sid, 3))
        oCollectGlobalRefsBlock(azGet(sid, 4), azGet(sid, 5))
        return
    end
end

# ---- findReachable (optimizer.cpp:236-253) ----

func oFindReachable(name: int)
    # BFS-worklist транзитивного замыкания. gORchWork — отдельный стек имён,
    # gORef (общий буфер сбора) читается в worklist целиком на каждом шаге,
    # поэтому oRefReset() внутри следующего шага не затирает необработанных
    # соседей (это и был баг рекурсивной версии: h2/hashLoop терялись).
    gORchWorkN = 0
    oReachEnq(name)
    while gORchWorkN > 0
        gORchWorkN = gORchWorkN - 1
        var cur: int = gORchWork[gORchWorkN]
        if oSetHas(gPReach, gNReach, cur) == 0
            var fid: int = oIsUserFuncId(cur)
            if fid >= 0
                if gNReach < 8192
                    poke32(gPReach + gNReach * 24, cur)
                    gNReach = gNReach + 1
                end
                if azGet(fid, 11) == 0
                    oRefReset()
                    oCollectFuncRefsBlock(azGet(fid, 9), azGet(fid, 10))
                    var i: int = 0
                    while i < gORefN
                        oReachEnq(peek32(gPORef + i * 24))
                        i = i + 1
                    end
                end
            end
        end
    end
end

# ---- предупреждения DCE (драйвер печатает их сам, как main.cpp) ----
# kind: 0 = unused extern function, 1 = unused function, 2 = unused global
var gOWarnKind: [8192]int
var gOWarnName: [8192]int
var gOWarnN: int = 0

func oWarnAdd(kind: int, name: int)
    if gOWarnN < 8192
        gOWarnKind[gOWarnN] = kind
        gOWarnName[gOWarnN] = name
        gOWarnN = gOWarnN + 1
    end
end

func oWarnCount() -> int
    return gOWarnN
end

func oWarnKindAt(i: int) -> int
    return gOWarnKind[i]
end

func oWarnNameAt(i: int) -> int
    return gOWarnName[i]
end

# ---- DCE-половина optimize() (optimizer.cpp:298-428) ----

func oDce(koDriver: int)
    # точка входа: main, иначе первая не-extern функция (298-313)
    var entry: int = 0
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            if entry == 0
                entry = fn
            end
        end
        i = i + 1
    end
    i = 0
    while i < gFuncN
        var fn2: int = gFuncIds[i]
        if azGet(fn2, 11) == 0
            if azStrLitEq(azGet(fn2, 0), "main") == 1
                entry = fn2
                i = gFuncN
            end
        end
        i = i + 1
    end
    if entry == 0
        return
    end
    gNReach = 0
    oFindReachable(azGet(entry, 0))

    # функции из глобальных инициализаторов живы (324-333)
    i = 0
    while i < gGlobalN
        var gid: int = gGlobalIds[i]
        oRefReset()
        oCollectFuncRefsE(azGet(gid, 7))
        var k: int = 0
        while k < gORefN
            oFindReachable(peek32(gPORef + k * 24))
            k = k + 1
        end
        i = i + 1
    end

    # koDriver: cleanup-хук обязан жить со всеми своими вызовами (335-355)
    if koDriver == 1
        var cleanId: int = -1
        i = 0
        while i < gFuncN
            var fn3: int = gFuncIds[i]
            if azGet(fn3, 11) == 0
                if azStrLitEq(azGet(fn3, 0), "cleanup") == 1
                    cleanId = fn3
                end
            end
            i = i + 1
        end
        if cleanId >= 0
            oRefReset()
            oCollectFuncRefsBlock(azGet(cleanId, 9), azGet(cleanId, 10))
            var k2: int = 0
            while k2 < gORefN
                oFindReachable(peek32(gPORef + k2 * 24))
                k2 = k2 + 1
            end
            if oSetHas(gPReach, gNReach, azGet(cleanId, 0)) == 0
                if gNReach < 8192
                    poke32(gPReach + gNReach * 24, azGet(cleanId, 0))
                    gNReach = gNReach + 1
                end
            end
        end
    end

    # usedExterns: внешние имена, на которые ссылаются тела достижимых (357-368)
    gNExtn = 0
    i = 0
    while i < gFuncN
        var fn4: int = gFuncIds[i]
        if azGet(fn4, 11) == 0
            if oSetHas(gPReach, gNReach, azGet(fn4, 0)) == 1
                oRefReset()
                oCollectFuncRefsBlock(azGet(fn4, 9), azGet(fn4, 10))
                var k3: int = 0
                while k3 < gORefN
                    var rn: int = peek32(gPORef + k3 * 24)
                    if oIsUserFuncId(rn) < 0
                        if oSetHas(gPExtn, gNExtn, rn) == 0
                            if gNExtn < 4096
                                poke32(gPExtn + gNExtn * 24, rn)
                                gNExtn = gNExtn + 1
                            end
                        end
                    end
                    k3 = k3 + 1
                end
            end
        end
        i = i + 1
    end

    # удаление функций: пересборка окна H_FUNCS (370-389)
    azListBegin()
    i = 0
    while i < gFuncN
        var fn5: int = gFuncIds[i]
        var keep: int = 1
        if azGet(fn5, 11) != 0
            # extern: жив, только если на него ссылаются
            if oSetHas(gPExtn, gNExtn, azGet(fn5, 0)) == 0
                keep = 0
                oWarnAdd(0, azGet(fn5, 0))
                gORf = gORf + 1
            end
        else
            if oSetHas(gPReach, gNReach, azGet(fn5, 0)) == 0
                keep = 0
                oWarnAdd(1, azGet(fn5, 0))
                gORf = gORf + 1
            end
        end
        if keep == 1
            azListPush(fn5)
        end
        i = i + 1
    end
    azListEnd()
    gH[H_FUNCS] = gLStart
    gH[H_FUNCS + 1] = gLLen

    # usedGlobals: по телам достижимых, затем замыкание по init'ам (391-415)
    gNGlUsed = 0
    i = 0
    while i < gFuncN
        var fn6: int = gFuncIds[i]
        if azGet(fn6, 11) == 0
            if oSetHas(gPReach, gNReach, azGet(fn6, 0)) == 1
                oRefReset()
                oCollectGlobalRefsBlock(azGet(fn6, 9), azGet(fn6, 10))
                var k4: int = 0
                while k4 < gORefN
                    var gn: int = peek32(gPORef + k4 * 24)
                    if oSetHas(gPGlUsed, gNGlUsed, gn) == 0
                        if gNGlUsed < 4096
                            poke32(gPGlUsed + gNGlUsed * 24, gn)
                            gNGlUsed = gNGlUsed + 1
                        end
                    end
                    k4 = k4 + 1
                end
            end
        end
        i = i + 1
    end
    var changed: int = 1
    while changed == 1
        changed = 0
        i = 0
        while i < gGlobalN
            var g2: int = gGlobalIds[i]
            if oSetHas(gPGlUsed, gNGlUsed, azGet(g2, 0)) == 1
                oRefReset()
                oCollectGlobalRefsE(azGet(g2, 7))
                var k5: int = 0
                while k5 < gORefN
                    var gn2: int = peek32(gPORef + k5 * 24)
                    if oSetHas(gPGlUsed, gNGlUsed, gn2) == 0
                        if gNGlUsed < 4096
                            oTbPut(gPGlUsed, gNGlUsed, gn2)
                            gNGlUsed = gNGlUsed + 1
                        end
                        changed = 1
                    end
                    k5 = k5 + 1
                end
            end
            i = i + 1
        end
    end

    # удаление глобалов: пересборка окна H_GLOBALS (417-426)
    azListBegin()
    i = 0
    while i < gGlobalN
        var g3: int = gGlobalIds[i]
        if oSetHas(gPGlUsed, gNGlUsed, azGet(g3, 0)) == 1
            azListPush(g3)
        else
            oWarnAdd(2, azGet(g3, 0))
            gORg = gORg + 1
        end
        i = i + 1
    end
    azListEnd()
    gH[H_GLOBALS] = gLStart
    gH[H_GLOBALS + 1] = gLLen
end

# ---- speedReduce* (optimizer.cpp:1630-1798) ----
# Возвращает новый id узла (0 = без изменений) — тот же паттерн, что у
# oFoldExpr/oSimplifyExpr: родитель пишет через azGet/azSet по полю.

func oSpeedReduceE(e: int, w: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_BINARY
        var nl: int = oSpeedReduceE(azGet(e, 0), w)
        if nl != 0
            azSet(e, 0, nl)
        end
        var nr: int = oSpeedReduceE(azGet(e, 1), w)
        if nr != 0
            azSet(e, 1, nr)
        end
        if gOAllowPow2 == 0
            return 0
        end
        var op: int = azGet(e, 2)
        # x * k  ->  (x << a) +- (x << b)   (1639-1674)
        if oOpIs(op, "*") == 1
            if oDefinitelyInt(azGet(e, 0)) == 0
                return 0
            end
            if oDefinitelyInt(azGet(e, 1)) == 0
                return 0
            end
            if oMaySide(azGet(e, 0)) == 1
                return 0
            end
            if oMaySide(azGet(e, 1)) == 0
            else
                return 0
            end
            var kRight: int = 0
            var k: int = 0
            var xp: int = azGet(e, 0)
            if oIsConstInt(azGet(e, 1)) == 1
                kRight = 1
                k = gOI64
            else
                if oIsConstInt(azGet(e, 0)) == 0
                    return 0
                end
                k = gOI64
                xp = azGet(e, 1)
            end
            if k == 0 || k == 1 || k == -1
                return 0
            end
            var ak: int = k
            if k < 0
                ak = 0 - k
            end
            var foundA: int = -1
            var foundB: int = -1
            var usePlus: int = 0
            var a: int = 1
            while a <= 62 && foundA < 0
                var pa: int = 1
                var sh: int = 0
                while sh < a
                    pa = pa * 2
                    sh = sh + 1
                end
                if pa <= ak + ak + 1
                    var bb: int = 0
                    while bb <= a && foundA < 0
                        var pb: int = 1
                        var sh2: int = 0
                        while sh2 < bb
                            pb = pb * 2
                            sh2 = sh2 + 1
                        end
                        if pa + pb == ak
                            foundA = a
                            foundB = bb
                            usePlus = 1
                        end
                        if pa - pb == ak
                            if foundA < 0
                                foundA = a
                                foundB = bb
                                usePlus = 0
                            end
                        end
                        bb = bb + 1
                    end
                end
                a = a + 1
            end
            if foundA < 0
                return 0
            end
            var xa: int = oMakeBinary(azStrLit("<<"), oClone(xp), oMakeNum(foundA))
            var xb: int = oClone(xp)
            if foundB != 0
                xb = oMakeBinary(azStrLit("<<"), oClone(xp), oMakeNum(foundB))
            end
            var inner: int = 0
            if usePlus == 1
                inner = oMakeBinary(azStrLit("+"), xa, xb)
            else
                inner = oMakeBinary(azStrLit("-"), xa, xb)
            end
            gOSr = gOSr + 1
            if k < 0
                return oMakeUnary(azStrLit("-"), inner)
            end
            return inner
        end
        # x / k  или  x % k  при |k| = степень двойки (1675-1728)
        var isDiv: int = 0
        if oOpIs(op, "/") == 1
            isDiv = 1
        end
        var isMod: int = 0
        if oOpIs(op, "%") == 1
            isMod = 1
        end
        if oOpIs(op, "//") == 1
            isMod = 1
        end
        if isDiv == 0 && isMod == 0
            return 0
        end
        if oDefinitelyInt(azGet(e, 0)) == 0
            return 0
        end
        if oDefinitelyInt(azGet(e, 1)) == 0
            return 0
        end
        if oIsConstInt(azGet(e, 1)) == 0
            return 0
        end
        var rv: int = gOI64
        var n: int = 0
        var negDiv: int = 0
        if oIsPow2(rv) == 1
            negDiv = 0
            n = gOSh
        else
            if rv < 0
                if oIsPow2(0 - rv) == 1
                    negDiv = 1
                    n = gOSh
                else
                    return 0
                end
            else
                return 0
            end
        end
        if n < 1 || n >= w
            return 0
        end
        if oMaySide(azGet(e, 0)) == 1
            return 0
        end
        var x: int = azGet(e, 0)
        var xKeep: int = oClone(x)
        var sign: int = oMakeBinary(azStrLit(">>"), oClone(x), oMakeNum(w - 1))
        var mask: int = oMakeNum((1 << n) - 1)
        var corr: int = oMakeBinary(azStrLit("&"), oMakeBinary(azStrLit("-"), oMakeNum(0), oClone(sign)), mask)
        var tv: int = oMakeBinary(azStrLit("+"), oClone(x), corr)
        var tShift: int = oClone(tv)
        var tSign: int = tv
        var q: int = oMakeBinary(azStrLit("|"), oMakeBinary(azStrLit(">>"), tShift, oMakeNum(n)), oMakeBinary(azStrLit("<<"), oMakeBinary(azStrLit("-"), oMakeNum(0), oMakeBinary(azStrLit(">>"), tSign, oMakeNum(w - 1))), oMakeNum(w - n)))
        gOSr = gOSr + 1
        if isDiv == 1
            if negDiv == 1
                return oMakeUnary(azStrLit("-"), q)
            end
            return q
        end
        return oMakeBinary(azStrLit("-"), xKeep, oMakeBinary(azStrLit("<<"), q, oMakeNum(n)))
    end
    if t == N_UNARY
        var nu: int = oSpeedReduceE(azGet(e, 1), w)
        if nu != 0
            azSet(e, 1, nu)
        end
        return 0
    end
    if t == N_CALL
        var nc: int = oSpeedReduceE(azGet(e, 1), w)
        if nc != 0
            azSet(e, 1, nc)
        end
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var i: int = 0
        while i < an
            var slot: int = gSideBase + (as + i) * 4
            var na: int = oSpeedReduceE(peek32(slot), w)
            if na != 0
                poke32(slot, na)
            end
            i = i + 1
        end
        return 0
    end
    if t == N_ARRAYACC
        var na2: int = oSpeedReduceE(azGet(e, 0), w)
        if na2 != 0
            azSet(e, 0, na2)
        end
        var ni: int = oSpeedReduceE(azGet(e, 1), w)
        if ni != 0
            azSet(e, 1, ni)
        end
        return 0
    end
    if t == N_MEMBER
        var nm2: int = oSpeedReduceE(azGet(e, 0), w)
        if nm2 != 0
            azSet(e, 0, nm2)
        end
        return 0
    end
    if t == N_DEREF
        var nd: int = oSpeedReduceE(azGet(e, 0), w)
        if nd != 0
            azSet(e, 0, nd)
        end
        return 0
    end
    return 0
end

func oSpeedReduceStmt(sid: int, w: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_VARDECL
        var n1: int = oSpeedReduceE(azGet(sid, 7), w)
        if n1 != 0
            azSet(sid, 7, n1)
        end
        return
    end
    if t == N_RETURN
        var n2: int = oSpeedReduceE(azGet(sid, 0), w)
        if n2 != 0
            azSet(sid, 0, n2)
        end
        return
    end
    if t == N_EXPRSTMT
        var n3: int = oSpeedReduceE(azGet(sid, 0), w)
        if n3 != 0
            azSet(sid, 0, n3)
        end
        return
    end
    if t == N_ASSIGN
        var n4: int = oSpeedReduceE(azGet(sid, 3), w)
        if n4 != 0
            azSet(sid, 3, n4)
        end
        var n5: int = oSpeedReduceE(azGet(sid, 4), w)
        if n5 != 0
            azSet(sid, 4, n5)
        end
        return
    end
    if t == N_PTRASSIGN
        var n6: int = oSpeedReduceE(azGet(sid, 0), w)
        if n6 != 0
            azSet(sid, 0, n6)
        end
        var n7: int = oSpeedReduceE(azGet(sid, 1), w)
        if n7 != 0
            azSet(sid, 1, n7)
        end
        return
    end
    if t == N_IF
        var n8: int = oSpeedReduceE(azGet(sid, 0), w)
        if n8 != 0
            azSet(sid, 0, n8)
        end
        oSpeedReduceBlock(azGet(sid, 1), azGet(sid, 2), w)
        oSpeedReduceBlock(azGet(sid, 3), azGet(sid, 4), w)
        return
    end
    if t == N_WHILE
        var n9: int = oSpeedReduceE(azGet(sid, 0), w)
        if n9 != 0
            azSet(sid, 0, n9)
        end
        oSpeedReduceBlock(azGet(sid, 1), azGet(sid, 2), w)
        return
    end
    if t == N_LOOP
        oSpeedReduceBlock(azGet(sid, 0), azGet(sid, 1), w)
        return
    end
    if t == N_SWITCH
        var n10: int = oSpeedReduceE(azGet(sid, 0), w)
        if n10 != 0
            azSet(sid, 0, n10)
        end
        var cs: int = azGet(sid, 1)
        var cl: int = azGet(sid, 2)
        var k: int = 0
        while k + 3 <= cl
            var slot: int = gSideBase + (cs + k) * 4
            var n11: int = oSpeedReduceE(peek32(slot), w)
            if n11 != 0
                poke32(slot, n11)
            end
            oSpeedReduceBlock(peek32(gSideBase + (cs + k + 1) * 4), peek32(gSideBase + (cs + k + 2) * 4), w)
            k = k + 3
        end
        return
    end
    if t == N_FOR
        var n12: int = oSpeedReduceE(azGet(sid, 1), w)
        if n12 != 0
            azSet(sid, 1, n12)
        end
        var n13: int = oSpeedReduceE(azGet(sid, 2), w)
        if n13 != 0
            azSet(sid, 2, n13)
        end
        var n14: int = oSpeedReduceE(azGet(sid, 3), w)
        if n14 != 0
            azSet(sid, 3, n14)
        end
        oSpeedReduceBlock(azGet(sid, 4), azGet(sid, 5), w)
        return
    end
end

func oSpeedReduceBlock(sa: int, la: int, w: int)
    var i: int = 0
    while i < la
        oSpeedReduceStmt(peek32(gSideBase + (sa + i) * 4), w)
        i = i + 1
    end
end

# speedStrengthReduce (1785-1798): w из arch, пасс по функциям и глобалам
func oSpeedStrengthReduce(arch: int)
    var w: int = 0
    if arch == 2 || arch == 4
        w = 64
    end
    if arch == 1 || arch == 3
        w = 32
    end
    if w == 0
        return
    end
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            oSpeedReduceBlock(azGet(fn, 9), azGet(fn, 10), w)
        end
        i = i + 1
    end
    i = 0
    while i < gGlobalN
        var g: int = gGlobalIds[i]
        var n: int = oSpeedReduceE(azGet(g, 7), w)
        if n != 0
            azSet(g, 7, n)
        end
        i = i + 1
    end
end

# =====================================================================
# oOptRun — ТОЧКА ВХОДА (аналог Optimizer::optimize, optimizer.cpp:255-429)
#   level:    0=None(-0r) 1=Basic(-1r) 2=Max(-2r) 3=Speed(-3r)
#   allowPow2: 0 для classic-x86 (allowPow2Div), 1 для ARM/STM32/WASM
#   isLib:    prog.isLibrary — библиотека не оптимизируется (259)
#   koDriver: prog.koDriver — cleanup-хук (335-355)
#   arch:     prog.arch (0=Auto 1=X86_32 2=X86_64 3=ARM 4=ARM64)
# Возвращает 1, если были хоть какие-то изменения (для сообщений драйвера).
# =====================================================================

# ============ НОВЫЕ ПРОХОДЫ ТРЁХОСЕВОЙ МОДЕЛИ ============
# oBooleanSimplify (маска 7, tier2): логические тождества
#   x && 1 -> x ; x && 0 -> 0 ; x || 0 -> x ; x || 1 -> 1 ; константы -> 0/1
func oBoolSimpE(e: int) -> int
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var cl: int = oBoolSimpE(azGet(e, 0))
    if cl != 0
        azSet(e, 0, cl)
    end
    var cr: int = oBoolSimpE(azGet(e, 1))
    if cr != 0
        azSet(e, 1, cr)
    end
    var op: int = azGet(e, 2)
    var l: int = azGet(e, 0)
    var r: int = azGet(e, 1)
    var isAnd: int = 0
    if oOpIs(op, "&&") == 1
        isAnd = 1
    end
    var isOr: int = 0
    if oOpIs(op, "||") == 1
        isOr = 1
    end
    if isAnd == 0 && isOr == 0
        return 0
    end
    if oIsConstInt(l) == 1 && oIsConstInt(r) == 1
        var lv: int = oNumVal(l)
        var rv: int = oNumVal(r)
        if isAnd == 1
            if lv != 0 && rv != 0
                return oMakeNum(1)
            else
                return oMakeNum(0)
            end
        else
            if lv != 0 || rv != 0
                return oMakeNum(1)
            else
                return oMakeNum(0)
            end
        end
    end
    if isAnd == 1
        if oIsConstInt(r) == 1
            if oNumVal(r) != 0
                return l
            else
                return oMakeNum(0)
            end
        end
        if oIsConstInt(l) == 1
            if oNumVal(l) != 0
                return r
            else
                return oMakeNum(0)
            end
        end
    else
        if oIsConstInt(r) == 1
            if oNumVal(r) != 0
                return oMakeNum(1)
            else
                return l
            end
        end
        if oIsConstInt(l) == 1
            if oNumVal(l) != 0
                return oMakeNum(1)
            else
                return r
            end
        end
    end
    return 0
end

# oShiftCompose (маска 2, tier3): (x << a) << b -> x << (a+b) ; то же для >>
func oShiftComposeE(e: int) -> int
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var cl: int = oShiftComposeE(azGet(e, 0))
    if cl != 0
        azSet(e, 0, cl)
    end
    var cr: int = oShiftComposeE(azGet(e, 1))
    if cr != 0
        azSet(e, 1, cr)
    end
    var op: int = azGet(e, 2)
    var isShl: int = 0
    if oOpIs(op, "<<") == 1
        isShl = 1
    end
    var isShr: int = 0
    if oOpIs(op, ">>") == 1
        isShr = 1
    end
    if isShl == 0 && isShr == 0
        return 0
    end
    var inner: int = azGet(e, 0)
    var b: int = azGet(e, 1)
    if azTag(inner) != N_BINARY
        return 0
    end
    var iop: int = azGet(inner, 2)
    if isShl == 1
        if oOpIs(iop, "<<") == 0
            return 0
        end
    else
        if oOpIs(iop, ">>") == 0
            return 0
        end
    end
    var a: int = azGet(inner, 1)
    if oIsConstInt(a) == 0 || oIsConstInt(b) == 0
        return 0
    end
    if oDefinitelyInt(azGet(inner, 0)) == 0
        return 0
    end
    var av: int = oNumVal(a)
    var bv: int = oNumVal(b)
    if av < 0 || bv < 0 || av + bv >= 64
        return 0
    end
    gOSr = gOSr + 1
    return oMakeBinary(op, azGet(inner, 0), oMakeNum(av + bv))
end

# общий обходчик: mode 0 = boolsimp, 1 = shiftcompose
func oNewPassE(mode: int, e: int) -> int
    if mode == 0
        return oBoolSimpE(e)
    end
    return oShiftComposeE(e)
end

func oNewPassBlock(mode: int, sa: int, la: int)
    var i: int = 0
    while i < la
        var sid: int = peek32(gSideBase + (sa + i) * 4)
        oNewPassStmt(mode, sid)
        i = i + 1
    end
end

func oNewPassStmt(mode: int, sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_RETURN || t == N_EXPRSTMT
        var n: int = oNewPassE(mode, azGet(sid, 0))
        if n != 0
            azSet(sid, 0, n)
        end
        return
    end
    if t == N_ASSIGN
        var n2: int = oNewPassE(mode, azGet(sid, 3))
        if n2 != 0
            azSet(sid, 3, n2)
        end
        var n3: int = oNewPassE(mode, azGet(sid, 4))
        if n3 != 0
            azSet(sid, 4, n3)
        end
        return
    end
    if t == N_PTRASSIGN
        var n4: int = oNewPassE(mode, azGet(sid, 0))
        if n4 != 0
            azSet(sid, 0, n4)
        end
        var n5: int = oNewPassE(mode, azGet(sid, 1))
        if n5 != 0
            azSet(sid, 1, n5)
        end
        return
    end
    if t == N_IF
        var n6: int = oNewPassE(mode, azGet(sid, 0))
        if n6 != 0
            azSet(sid, 0, n6)
        end
        oNewPassBlock(mode, azGet(sid, 1), azGet(sid, 2))
        oNewPassBlock(mode, azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        var n7: int = oNewPassE(mode, azGet(sid, 0))
        if n7 != 0
            azSet(sid, 0, n7)
        end
        oNewPassBlock(mode, azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_LOOP
        oNewPassBlock(mode, azGet(sid, 0), azGet(sid, 1))
        return
    end
    if t == N_SWITCH
        var n8: int = oNewPassE(mode, azGet(sid, 0))
        if n8 != 0
            azSet(sid, 0, n8)
        end
        return
    end
end

func oNewPass(mode: int)
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            oNewPassBlock(mode, azGet(fn, 9), azGet(fn, 10))
        end
        i = i + 1
    end
    i = 0
    while i < gGlobalN
        var g: int = gGlobalIds[i]
        var n: int = oNewPassE(mode, azGet(g, 7))
        if n != 0
            azSet(g, 7, n)
        end
        i = i + 1
    end
end

func oBooleanSimplify()
    oNewPass(0)
end

func oShiftCompose()
    oNewPass(1)
end

# =====================================================================
# T1: ИНДЕКСНАЯ СИЛОВАЯ-РЕДУКЦИЯ (induction-variable strength reduction)
#
# Цель — inner-loop матричных умножений вида
#     while k < n
#         acc = acc + peek32(a + (r * n + k) * 4) * peek32(b + (k * n + cc) * 4)
#         k = k + 1
#     end
# где индексные выражения — аффинные по k: E(k) = C*k + D (C,D не зависят от k).
# Каждое такое E заменяется temp-переменной:
#     var __ixN = E            # перед while (со значением k на входе)
#     ... E -> __ixN ...       # в теле (включая вложенные конструкции)
#     __ixN = __ixN + C        # в конец тела (после k = k + 1)
# Тем inner-loop теряет по 2-3 imul на итерацию (пересчёт (r*n+k)*4,
# (k*n+cc)*4) — остаётся один add на temp.
#
# Условия безопасности (всё проверяется ДО мутаций):
#   - последний statement тела — канонический инкремент `k = k + 1`;
#   - кроме него никто не пишет в k (включая вложенные for с тем же именем);
#   - никто не пишет в имена, входящие в E/C (кроме k);
#   - ни одно имя E не взято через `&` в текущей функции (нет алиасинга);
#   - ни одно имя E не является глобалом (вызовы не могли бы его менять);
#   - в теле нет return/break/continue/switch/asm на уровне нашего цикла
#     (иначе добавленный инкремент мог бы не выполниться);
#   - только фикс-конструкции: выражения-кандидаты максимальны (замена
#     внешнего аффинного узла, без спуска внутрь), bare `k` не заменяется.
#
# Вставка в блоки — через azList* (как oRemoveDeadStores): окно списка
# пересобирается в хвосте side-секции, поля (start,len) перезаписываются.
# =====================================================================

var gOIvC: int = 0           # коэффициент, возвращаемый oIvCls (глобально: .z без out-параметров)
var gIXK: int = 0            # имя переменной цикла (strId)
var gIXLid: int = 0          # id канонического `k = k + 1`
var gIXN: int = 0            # число найденных аффинных выражений
var gIXSlot: [64]int         # адреса слотов под будущий ident(temp)
var gIXNode: [64]int         # сами E (переезжают в init нового N_VARDECL)
var gIXCoef: [64]int         # коэффициенты C = dE/dk
var gIXVd: [64]int           # созданные N_VARDECL (вставляются перед while)
var gIXInc: [64]int          # созданные инкременты (в конец тела)
var gIXNm: [128]int          # все имена, на которые ссылаются E (для проверок)
var gIXNmN: int = 0
var gIXAbort: int = 0        # встретили switch в теле -> отмена кандидата
var gIXEsc: [32]int          # имена, взятые через & в текущей функции
var gIXEscN: int = 0
var gIXNo: int = 0           # в функции есть switch/asm -> функция непригодна
var gIXCnt: int = 0          # счётчик имён __ixN

# temp-имя "__ix<n>" через общий строкостроитель парсера (sb*)
func oIvNewName() -> int
    sbInit()
    sbAddLit("__ix")
    var v: int = gIXCnt
    gIXCnt = gIXCnt + 1
    if v == 0
        sbAddChar(48)
    else
        var d: [4]int
        var dn: int = 0
        while v > 0 && dn < 4
            d[dn] = v % 10
            v = v / 10
            dn = dn + 1
        end
        var j: int = dn - 1
        while j >= 0
            sbAddChar(48 + d[j])
            j = j - 1
        end
    end
    return azStr(gSB, gSLen)
end

func oIvIdent(nm: int) -> int
    var idn: int = azNew(N_IDENT, 0)
    azSet(idn, 0, nm)
    return idn
end

# уже наш temp? (пропуск stmt, перестроенных трансформацией вложенного цикла)
func oIvTempQ(name: int) -> int
    var n: int = azStrLen(name)
    if n < 4
        return 0
    end
    var p: int = azStrPtr(name)
    if peek8(p) != 95 || peek8(p + 1) != 95 || peek8(p + 2) != 105 || peek8(p + 3) != 120
        return 0
    end
    return 1
end

# ---- свёртка коэффициентов (та же осторожность, что у oMakeBinary-правил) ----
func oSrMulN(a: int, b: int) -> int
    var na: int = oIsConstInt(a)
    var va: int = gOI64
    var nb: int = oIsConstInt(b)
    var vb: int = gOI64
    if na == 1 && nb == 1
        return oMakeNum(va * vb)
    end
    if na == 1 && va == 1
        return b
    end
    if nb == 1 && vb == 1
        return a
    end
    return oMakeBinary(azStrLit("*"), a, b)
end

func oSrAddN(a: int, b: int) -> int
    var na: int = oIsConstInt(a)
    var va: int = gOI64
    var nb: int = oIsConstInt(b)
    var vb: int = gOI64
    if na == 1 && nb == 1
        return oMakeNum(va + vb)
    end
    if na == 1 && va == 0
        return b
    end
    if nb == 1 && vb == 0
        return a
    end
    return oMakeBinary(azStrLit("+"), a, b)
end

func oSrSubN(a: int, b: int) -> int
    var na: int = oIsConstInt(a)
    var va: int = gOI64
    var nb: int = oIsConstInt(b)
    var vb: int = gOI64
    if na == 1 && nb == 1
        return oMakeNum(va - vb)
    end
    if nb == 1 && vb == 0
        return a
    end
    return oMakeBinary(azStrLit("-"), a, b)
end

func oSrNegN(a: int) -> int
    if oIsConstInt(a) == 1
        return oMakeNum(0 - gOI64)
    end
    return oMakeUnary(azStrLit("-"), a)
end

# oIvCls: класс выражения относительно gIXK:
#   0 = INV  (не зависит от k), 1 = AFFINE (C*k + D), 2 = NA (не аффинно).
# mk=1 — строит узел коэффициента в gOIvC (узлы E при этом переезжают в
# init VARDECL, поэтому в coef клонируются субдеревья E: oClone).
func oIvCls(e: int, mk: int) -> int
    if e == 0
        return 0
    end
    if oRefsName(e, gIXK) == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_IDENT
        if mk == 1
            gOIvC = oMakeNum(1)
        end
        return 1
    end
    if t == N_UNARY
        if oOpIs(azGet(e, 0), "-") == 1
            var cu: int = oIvCls(azGet(e, 1), mk)
            if cu == 1
                if mk == 1
                    gOIvC = oSrNegN(gOIvC)
                end
                return 1
            end
            return cu
        end
        if oIvCls(azGet(e, 1), mk) == 0
            return 0
        end
        return 2
    end
    if t == N_BINARY
        var l: int = azGet(e, 0)
        var r: int = azGet(e, 1)
        var op: int = azGet(e, 2)
        var cl: int = oIvCls(l, mk)
        var vl: int = gOIvC
        var cr: int = oIvCls(r, mk)
        var vr: int = gOIvC
        if cl == 2 || cr == 2
            return 2
        end
        if cl == 0 && cr == 0
            return 0
        end
        if oOpIs(op, "+") == 1
            if mk == 1
                if cl == 0
                    gOIvC = vr
                else
                    if cr == 0
                        gOIvC = vl
                    else
                        gOIvC = oSrAddN(vl, vr)
                    end
                end
            end
            return 1
        end
        if oOpIs(op, "-") == 1
            if mk == 1
                if cl == 0
                    gOIvC = oSrNegN(vr)
                else
                    if cr == 0
                        gOIvC = vl
                    else
                        gOIvC = oSrSubN(vl, vr)
                    end
                end
            end
            return 1
        end
        if oOpIs(op, "*") == 1
            if cl == 1 && cr == 1
                return 2
            end
            if mk == 1
                if cl == 1
                    gOIvC = oSrMulN(vl, oClone(r))
                else
                    gOIvC = oSrMulN(oClone(l), vr)
                end
            end
            return 1
        end
        return 2
    end
    return 2
end

# ---- сбор имён, на которые ссылается E (включая N_ADDROF) ----
func oIvRefN(e: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_IDENT || t == N_ADDROF
        var nm: int = azGet(e, 0)
        var i: int = 0
        while i < gIXNmN
            if azStrEq(gIXNm[i], nm) == 1
                return
            end
            i = i + 1
        end
        if gIXNmN < 128
            gIXNm[gIXNmN] = nm
            gIXNmN = gIXNmN + 1
        end
        return
    end
    if t == N_UNARY
        oIvRefN(azGet(e, 1))
        return
    end
    if t == N_BINARY
        oIvRefN(azGet(e, 0))
        oIvRefN(azGet(e, 1))
        return
    end
    if t == N_MEMBER || t == N_DEREF
        oIvRefN(azGet(e, 0))
        return
    end
    if t == N_ARRAYACC
        oIvRefN(azGet(e, 0))
        oIvRefN(azGet(e, 1))
        return
    end
    if t == N_CALL
        oIvRefN(azGet(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oIvRefN(peek32(gSideBase + (as + k) * 4))
            k = k + 1
        end
        return
    end
end

func oIvNmIn(nm: int) -> int
    var i: int = 0
    while i < gIXNmN
        if azStrEq(gIXNm[i], nm) == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

func oIvEscIn(nm: int) -> int
    var i: int = 0
    while i < gIXEscN
        if azStrEq(gIXEsc[i], nm) == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

func oIvIsGlobal(nm: int) -> int
    var i: int = 0
    while i < gGlobalN
        if azStrEq(gGlobalIds[i], nm) == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

# ---- обход выражений: сбор addrof-имён всей функции; switch/asm -> gIXNo ----
func oIvEscE(e: int)
    if e == 0
        return
    end
    var t: int = azTag(e)
    if t == N_ADDROF
        var nm: int = azGet(e, 0)
        var i: int = 0
        while i < gIXEscN
            if azStrEq(gIXEsc[i], nm) == 1
                return
            end
            i = i + 1
        end
        if gIXEscN < 32
            gIXEsc[gIXEscN] = nm
            gIXEscN = gIXEscN + 1
        end
        return
    end
    if t == N_UNARY
        oIvEscE(azGet(e, 1))
        return
    end
    if t == N_BINARY
        oIvEscE(azGet(e, 0))
        oIvEscE(azGet(e, 1))
        return
    end
    if t == N_MEMBER || t == N_DEREF
        oIvEscE(azGet(e, 0))
        return
    end
    if t == N_ARRAYACC
        oIvEscE(azGet(e, 0))
        oIvEscE(azGet(e, 1))
        return
    end
    if t == N_CALL
        oIvEscE(azGet(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oIvEscE(peek32(gSideBase + (as + k) * 4))
            k = k + 1
        end
        return
    end
end

func oIvEscB(s: int, n: int)
    var i: int = 0
    while i < n
        oIvEscS(peek32(gSideBase + (s + i) * 4))
        i = i + 1
    end
end

func oIvEscS(sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_SWITCH || t == N_ASM
        gIXNo = 1
        return
    end
    if t == N_RETURN || t == N_EXPRSTMT
        oIvEscE(azGet(sid, 0))
        return
    end
    if t == N_ASSIGN
        oIvEscE(azGet(sid, 3))
        oIvEscE(azGet(sid, 4))
        return
    end
    if t == N_PTRASSIGN
        oIvEscE(azGet(sid, 0))
        oIvEscE(azGet(sid, 1))
        return
    end
    if t == N_VARDECL
        oIvEscE(azGet(sid, 7))
        return
    end
    if t == N_IF
        oIvEscE(azGet(sid, 0))
        oIvEscB(azGet(sid, 1), azGet(sid, 2))
        oIvEscB(azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        oIvEscE(azGet(sid, 0))
        oIvEscB(azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_FOR
        oIvEscE(azGet(sid, 1))
        oIvEscE(azGet(sid, 2))
        oIvEscE(azGet(sid, 3))
        oIvEscB(azGet(sid, 4), azGet(sid, 5))
        return
    end
    if t == N_LOOP
        oIvEscB(azGet(sid, 0), azGet(sid, 1))
        return
    end
end

# ---- A1: поиск аффинных кандидатов в теле (без аллокаций, mk=0) ----
func oIvScanE(sa: int)
    var e: int = peek32(sa)
    if e == 0
        return
    end
    if oRefsName(e, gIXK) == 0
        return
    end
    var t: int = azTag(e)
    if t == N_IDENT || t == N_ADDROF
        return
    end
    if oIvCls(e, 0) == 1
        if gIXN < 64
            gIXSlot[gIXN] = sa
            gIXNode[gIXN] = e
            gIXN = gIXN + 1
            oIvRefN(e)
        end
        return
    end
    # не аффинно — спускаемся к детям (кандидаты никогда не вкладываются:
    # аффинный узел заменяется целиком и в него не спускаемся)
    if t == N_BINARY
        oIvScanE(azFldAddr(e, 0))
        oIvScanE(azFldAddr(e, 1))
        return
    end
    if t == N_UNARY
        oIvScanE(azFldAddr(e, 1))
        return
    end
    if t == N_ARRAYACC
        oIvScanE(azFldAddr(e, 0))
        oIvScanE(azFldAddr(e, 1))
        return
    end
    if t == N_MEMBER || t == N_DEREF
        oIvScanE(azFldAddr(e, 0))
        return
    end
    if t == N_CALL
        oIvScanE(azFldAddr(e, 1))
        var as: int = azGet(e, 2)
        var an: int = azGet(e, 3)
        var k: int = 0
        while k < an
            oIvScanE(gSideBase + (as + k) * 4)
            k = k + 1
        end
        return
    end
end

func oIvScanB(s: int, n: int)
    var i: int = 0
    while i < n
        oIvScanS(peek32(gSideBase + (s + i) * 4))
        i = i + 1
    end
end

func oIvScanS(sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_RETURN || t == N_EXPRSTMT
        oIvScanE(azFldAddr(sid, 0))
        return
    end
    if t == N_ASSIGN
        if oIvTempQ(azGet(sid, 0)) == 1
            return
        end
        oIvScanE(azFldAddr(sid, 3))
        oIvScanE(azFldAddr(sid, 4))
        return
    end
    if t == N_PTRASSIGN
        oIvScanE(azFldAddr(sid, 0))
        oIvScanE(azFldAddr(sid, 1))
        return
    end
    if t == N_VARDECL
        if oIvTempQ(azGet(sid, 0)) == 1
            return
        end
        oIvScanE(azFldAddr(sid, 7))
        return
    end
    if t == N_IF
        oIvScanE(azFldAddr(sid, 0))
        oIvScanB(azGet(sid, 1), azGet(sid, 2))
        oIvScanB(azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        oIvScanE(azFldAddr(sid, 0))
        oIvScanB(azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_FOR
        oIvScanE(azFldAddr(sid, 1))
        oIvScanE(azFldAddr(sid, 2))
        oIvScanE(azFldAddr(sid, 3))
        oIvScanB(azGet(sid, 4), azGet(sid, 5))
        return
    end
    if t == N_LOOP
        oIvScanB(azGet(sid, 0), azGet(sid, 1))
        return
    end
    if t == N_SWITCH
        gIXAbort = 1
        return
    end
end

# ---- проверка безопасности тела (lvl: 0 = наш цикл, 1+ = вложенные) ----
func oIvSafeB(s: int, n: int, lvl: int) -> int
    var i: int = 0
    while i < n
        if oIvSafeS(peek32(gSideBase + (s + i) * 4), lvl) == 0
            return 0
        end
        i = i + 1
    end
    return 1
end

func oIvSafeS(sid: int, lvl: int) -> int
    if sid == 0
        return 1
    end
    var t: int = azTag(sid)
    if t == N_RETURN || t == N_ASM || t == N_SWITCH
        return 0
    end
    if t == N_BREAK || t == N_CONTINUE
        if lvl == 0
            return 0
        end
        return 1
    end
    if t == N_ASSIGN
        var nm: int = azGet(sid, 0)
        if azStrEq(nm, gIXK) == 1
            if sid != gIXLid
                return 0
            end
            return 1
        end
        if oIvNmIn(nm) == 1
            return 0
        end
        return 1
    end
    if t == N_VARDECL
        var nm2: int = azGet(sid, 0)
        if azStrEq(nm2, gIXK) == 1
            return 0
        end
        if oIvNmIn(nm2) == 1
            return 0
        end
        return 1
    end
    if t == N_FOR
        var fn2: int = azGet(sid, 0)
        if azStrEq(fn2, gIXK) == 1
            return 0
        end
        if oIvNmIn(fn2) == 1
            return 0
        end
        return oIvSafeB(azGet(sid, 4), azGet(sid, 5), lvl + 1)
    end
    if t == N_IF
        if oIvSafeB(azGet(sid, 1), azGet(sid, 2), lvl) == 0
            return 0
        end
        return oIvSafeB(azGet(sid, 3), azGet(sid, 4), lvl)
    end
    if t == N_WHILE
        return oIvSafeB(azGet(sid, 1), azGet(sid, 2), lvl + 1)
    end
    if t == N_LOOP
        return oIvSafeB(azGet(sid, 0), azGet(sid, 1), lvl + 1)
    end
    return 1
end

# ---- попытка трансформации одного while; вернёт число temp (>0 = успех) ----
func oIvTryWhile(sid: int) -> int
    var s: int = azGet(sid, 1)
    var n: int = azGet(sid, 2)
    if n <= 0
        return 0
    end
    var lid: int = peek32(gSideBase + (s + n - 1) * 4)
    if lid == 0 || azTag(lid) != N_ASSIGN
        return 0
    end
    if azGet(lid, 1) != 0 || azGet(lid, 2) != 0 || azGet(lid, 3) != 0
        return 0
    end
    var val: int = azGet(lid, 4)
    if azTag(val) != N_BINARY || oOpIs(azGet(val, 2), "+") != 1
        return 0
    end
    var l0: int = azGet(val, 0)
    var r0: int = azGet(val, 1)
    var kname: int = azGet(lid, 0)
    var shape: int = 0
    if azTag(l0) == N_IDENT && azStrEq(azGet(l0, 0), kname) == 1
        if azTag(r0) == N_NUMBER && oNumVal(r0) == 1
            shape = 1
        end
    end
    if azTag(r0) == N_IDENT && azStrEq(azGet(r0, 0), kname) == 1
        if azTag(l0) == N_NUMBER && oNumVal(l0) == 1
            shape = 1
        end
    end
    if shape == 0
        return 0
    end

    gIXK = kname
    gIXLid = lid
    gIXN = 0
    gIXNmN = 0
    gIXAbort = 0

    # A1: аффинные кандидаты (без аллокаций) + их имена
    var i: int = 0
    while i < n - 1
        oIvScanS(peek32(gSideBase + (s + i) * 4))
        i = i + 1
    end
    if gIXAbort == 1 || gIXN == 0
        return 0
    end

    # имена E: не взяты через & в функции и не глобалы
    i = 0
    while i < gIXNmN
        if oIvEscIn(gIXNm[i]) == 1
            return 0
        end
        if oIvIsGlobal(gIXNm[i]) == 1
            return 0
        end
        i = i + 1
    end

    # тело безопасно (ранние выходы/чужие записи/канонический инкремент)
    if oIvSafeB(s, n, 0) == 0
        return 0
    end

    # типы (до мутаций)
    i = 0
    while i < gIXN
        if inferExprType(gIXNode[i]) == 3
            return 0
        end
        i = i + 1
    end

    # A2: коэффициенты — первые аллокации узлов (после всех проверок)
    i = 0
    while i < gIXN
        if oIvCls(gIXNode[i], 1) != 1
            return 0
        end
        gIXCoef[i] = gOIvC
        i = i + 1
    end

    # мутации: temp-имена, замена E на ident, VARDECL(init=E), инкременты
    i = 0
    while i < gIXN
        var tn: int = oIvNewName()
        poke32(gIXSlot[i], oIvIdent(tn))
        var vd: int = azNew(N_VARDECL, 0)
        azSet(vd, 0, tn)
        azSet(vd, 1, inferExprType(gIXNode[i]))
        azSet(vd, 7, gIXNode[i])
        gIXVd[i] = vd
        var inc: int = azNew(N_ASSIGN, 0)
        azSet(inc, 0, tn)
        azSet(inc, 3, 0)
        azSet(inc, 4, oMakeBinary(azStrLit("+"), oIvIdent(tn), gIXCoef[i]))
        gIXInc[i] = inc
        i = i + 1
    end

    # перестройка тела: исходные stmt (включая k = k + 1) + инкременты в конец
    azListBegin()
    i = 0
    while i < n
        azListPush(peek32(gSideBase + (s + i) * 4))
        i = i + 1
    end
    i = 0
    while i < gIXN
        azListPush(gIXInc[i])
        i = i + 1
    end
    azListEnd()
    poke32(azFldAddr(sid, 1), gLStart)
    poke32(azFldAddr(sid, 2), gLLen)
    gOSr = gOSr + gIXN
    return gIXN
end

# ---- обход блоков: вложенные циклы -> попытка трансформации -> вставка ----
func oIxBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        if sid != 0
            var t: int = azTag(sid)
            if t == N_WHILE
                oIxBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                var got: int = oIvTryWhile(sid)
                if got > 0
                    # вставить VARDECL-ы temp'ов перед этим while в ТЕКУЩЕМ окне
                    azListBegin()
                    var j: int = 0
                    while j < i
                        azListPush(peek32(gSideBase + (s0 + j) * 4))
                        j = j + 1
                    end
                    j = 0
                    while j < got
                        azListPush(gIXVd[j])
                        j = j + 1
                    end
                    azListPush(sid)
                    j = i + 1
                    while j < n0
                        azListPush(peek32(gSideBase + (s0 + j) * 4))
                        j = j + 1
                    end
                    azListEnd()
                    poke32(sa, gLStart)
                    poke32(la, gLLen)
                    s0 = peek32(sa)
                    n0 = peek32(la)
                    i = i + got + 1
                else
                    i = i + 1
                end
            else
                if t == N_IF
                    oIxBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    oIxBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
                end
                if t == N_FOR
                    oIxBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                end
                if t == N_LOOP
                    oIxBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                end
                i = i + 1
            end
        else
            i = i + 1
        end
    end
end

func oIxRun()
    gIXCnt = 0
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            gIXEscN = 0
            gIXNo = 0
            oIvEscB(azGet(fn, 9), azGet(fn, 10))
            if gIXNo == 0
                oIxBlock(azNodeAddr(fn) + 44, azNodeAddr(fn) + 48)
            end
        end
        i = i + 1
    end
end

# =====================================================================
# T2: ТРАНСПОН B ОДИН РАЗ ПЕРЕД ТРОЙНЫМ ЦИКЛОМ (PLAN_AUTOVEC.md)
#
# Распознаётся канонический matmul-костяк (форма tools/_bench.z):
#   while r < n                       # O: тело ровно [ccDecl, ccWhile, rInc]
#       var cc: int = 0
#       while cc < n                  # тело ровно [accDecl, kDecl, kWhile, poke, ccInc]
#           var acc: int = 0
#           var k: int = 0
#           while k < n               # тело ровно [acc-assign, k=k+1]
#               acc = acc + peek32(argA) * peek32(BASE + (k * n + cc) * 4)
#               k = k + 1
#           end
#           poke32(caddr, acc)
#           cc = cc + 1
#       end
#       r = r + 1
#   end
#
# ПЕРЕД O вставляется:  var bt = alloc(n*n*4) + двойной цикл
#   bt[cc*n + k] = b[k*n + k -> tk/tcc: bt[tcc*n + tk] = BASE[tk*n + tcc]
# ПОСЛЕ O:              free(bt)
# В k-цикле argB `BASE + (k*n+cc)*4` заменяется на `bt + (cc*n+k)*4`.
#
# Тело matmul НЕ перестраивается: регистровый acc, c-store, порядок
# сложений — всё на месте (поэтому здесь лучше, чем interchange,
# который проиграл −23% на n=128 из-за c-RMW в inner-loop: см. A/B
# в коммите). B по k становится СПЛОШНЫМ — подготовка к T3 (SIMD
# dot-product). Стоимость: n² копий против n³ умножений (~0.8%).
#
# Строгие проверки ДО мутаций (только чтение): точная stmt-структура
# (3/5/2), канонические `v = v + 1`, argB в точности
# `BASE + ((k * n) + cc) * 4` с oSame(n) из условия O; BASE — локальный
# N_IDENT, не перезаписываемый в гнезде (имена гнезда: r/cc/k/acc);
# poke/cc-тела пинят запись только в c. N и BASE не ссылаются на
# переменные гнезда. Гейт (3,3), гоняется ДО основных пассов (паттерн
# первоначален); T1 в tier3 навешивает указатели-инкременты на k-цикл.
# =====================================================================

var gTpPreN: int = 0            # stmt'ы для вставки ПЕРЕД O
var gTpPre: [8]int
var gTpPostN: int = 0           # stmt'ы для вставки ПОСЛЕ O
var gTpPost: [4]int
var gTpCnt: int = 0             # счётчик имён __tpN

# выражение — только арифметика (idents/литералы/unary/binary), без вызовов:
# нет ни side-эффектов, ни косвенных чтений/записей
func oTpArithQ(e: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_IDENT || t == N_NUMBER || t == N_FLOAT || t == N_STRING
        return 1
    end
    if t == N_UNARY
        return oTpArithQ(azGet(e, 1))
    end
    if t == N_BINARY
        if oTpArithQ(azGet(e, 0)) == 0
            return 0
        end
        return oTpArithQ(azGet(e, 1))
    end
    return 0
end

# plain assign `name = ...` (без path/index)
func oTpPlainQ(sid: int, name: int) -> int
    if sid == 0 || azTag(sid) != N_ASSIGN
        return 0
    end
    if azGet(sid, 1) != 0 || azGet(sid, 2) != 0 || azGet(sid, 3) != 0
        return 0
    end
    if azStrEq(azGet(sid, 0), name) == 0
        return 0
    end
    return 1
end

# канонический инкремент `name = name + 1`
func oTpIncQ(sid: int, name: int) -> int
    if oTpPlainQ(sid, name) == 0
        return 0
    end
    var v: int = azGet(sid, 4)
    if azTag(v) != N_BINARY || oOpIs(azGet(v, 2), "+") != 1
        return 0
    end
    var l: int = azGet(v, 0)
    var r: int = azGet(v, 1)
    if azTag(l) == N_IDENT && azStrEq(azGet(l, 0), name) == 1
        if azTag(r) == N_NUMBER && oNumVal(r) == 1
            return 1
        end
    end
    if azTag(r) == N_IDENT && azStrEq(azGet(r, 0), name) == 1
        if azTag(l) == N_NUMBER && oNumVal(l) == 1
            return 1
        end
    end
    return 0
end

# вызов: field0 == lit, field1 == 0 (без квалификатора), точное число аргументов
func oTpCallQ(e: int, lit: int, nargs: int) -> int
    if e == 0 || azTag(e) != N_CALL
        return 0
    end
    if azGet(e, 1) != 0
        return 0
    end
    if azGet(e, 3) != nargs
        return 0
    end
    return azStrLitEq(azGet(e, 0), lit)
end

func oTpArgs(e: int, i: int) -> int
    return peek32(gSideBase + (azGet(e, 2) + i) * 4)
end

func oTpDistinct(a: int, b: int) -> int
    if azStrEq(a, b) == 1
        return 0
    end
    return 1
end

# свежее temp-имя "__tpN" (общий с T1 стиль; свой счётчик — префикс другой)
func oTpNewName() -> int
    sbInit()
    sbAddLit("__tp")
    var v: int = gTpCnt
    gTpCnt = gTpCnt + 1
    if v == 0
        sbAddChar(48)
    else
        var d: [4]int
        var dn: int = 0
        while v > 0 && dn < 4
            d[dn] = v % 10
            v = v / 10
            dn = dn + 1
        end
        var j: int = dn - 1
        while j >= 0
            sbAddChar(48 + d[j])
            j = j - 1
        end
    end
    return azStr(gSB, gSLen)
end

# BASE + (i1 * n + i2) * 4 — адрес элемента; baseE переезжает (не клон),
# nE клонируется на каждый узел
func oTpIdxE(baseE: int, i1: int, i2: int, nE: int) -> int
    var a1: int = oMakeBinary(azStrLit("*"), oIvIdent(i1), oClone(nE))
    var s1: int = oMakeBinary(azStrLit("+"), a1, oIvIdent(i2))
    var m1: int = oMakeBinary(azStrLit("*"), s1, oMakeNum(4))
    return oMakeBinary(azStrLit("+"), baseE, m1)
end

# вызов с 1/2 аргументами (окно args — через azList, как у парсера)
func oTpMkCall(nm: int, a1: int) -> int
    var c: int = azNew(N_CALL, 0)
    azSet(c, 0, azStrLit(nm))
    azSet(c, 1, 0)
    azListBegin()
    azListPush(a1)
    azListEnd()
    azSet(c, 2, gLStart)
    azSet(c, 3, 1)
    return c
end

func oTpMkCall2(nm: int, a1: int, a2: int) -> int
    var c: int = azNew(N_CALL, 0)
    azSet(c, 0, azStrLit(nm))
    azSet(c, 1, 0)
    azListBegin()
    azListPush(a1)
    azListPush(a2)
    azListEnd()
    azSet(c, 2, gLStart)
    azSet(c, 3, 2)
    return c
end

# ---- попытка трансформации одного while (matmul-костяк) ----
func oTpTry(sid: int) -> int
    gTpPreN = 0
    gTpPostN = 0

    # --- O: тело ровно [ccDecl, ccWhile, rInc] ---
    var os: int = azGet(sid, 1)
    var on: int = azGet(sid, 2)
    if on != 3
        return 0
    end
    var ccDecl: int = peek32(gSideBase + os * 4)
    var ccWhile: int = peek32(gSideBase + (os + 1) * 4)
    var rInc: int = peek32(gSideBase + (os + 2) * 4)
    if ccDecl == 0 || azTag(ccDecl) != N_VARDECL
        return 0
    end
    if ccWhile == 0 || azTag(ccWhile) != N_WHILE
        return 0
    end
    if rInc == 0 || azTag(rInc) != N_ASSIGN
        return 0
    end
    var rName: int = azGet(rInc, 0)
    if oTpIncQ(rInc, rName) == 0
        return 0
    end
    var oc: int = azGet(sid, 0)
    if azTag(oc) != N_BINARY
        return 0
    end
    var nE: int = azGet(oc, 1)
    if oTpArithQ(nE) == 0
        return 0
    end
    var ccName: int = azGet(ccDecl, 0)
    if oTpDistinct(ccName, rName) == 0
        return 0
    end

    # --- T2.1: ccWhile: тело [d0, d1, kWhile, pokeS, (extra), ccInc] ---
    # Принимаем ОБЕ формы: 5 stmt'ов (tools/_bench.z: [accDecl, kDecl, ...])
    # и 6 (tools/_speedbench.z: [kDecl, sumDecl, ..., acc += sum&mask, ...]):
    # порядок decl'ов НЕ фиксирован — имена опознаём через канонический kInc.
    var cs: int = azGet(ccWhile, 1)
    var cn: int = azGet(ccWhile, 2)
    if cn != 5 && cn != 6
        return 0
    end
    var d0: int = peek32(gSideBase + cs * 4)
    var d1: int = peek32(gSideBase + (cs + 1) * 4)
    var kWhile: int = peek32(gSideBase + (cs + 2) * 4)
    var pokeS: int = peek32(gSideBase + (cs + 3) * 4)
    var extra: int = 0
    var ccInc: int = 0
    if cn == 5
        ccInc = peek32(gSideBase + (cs + 4) * 4)
    else
        extra = peek32(gSideBase + (cs + 4) * 4)
        ccInc = peek32(gSideBase + (cs + 5) * 4)
    end
    if d0 == 0 || azTag(d0) != N_VARDECL
        return 0
    end
    if d1 == 0 || azTag(d1) != N_VARDECL
        return 0
    end
    if kWhile == 0 || azTag(kWhile) != N_WHILE
        return 0
    end
    if pokeS == 0 || azTag(pokeS) != N_EXPRSTMT
        return 0
    end
    if ccInc == 0 || azTag(ccInc) != N_ASSIGN
        return 0
    end
    if extra != 0 && azTag(extra) != N_ASSIGN
        return 0
    end

    # --- kWhile: тело ровно [acc-assign, k=k+1]; имя k — из kInc ---
    var ks: int = azGet(kWhile, 1)
    var kn: int = azGet(kWhile, 2)
    if kn != 2
        return 0
    end
    var accAsg: int = peek32(gSideBase + ks * 4)
    var kInc: int = peek32(gSideBase + (ks + 1) * 4)
    if kInc == 0 || azTag(kInc) != N_ASSIGN
        return 0
    end
    var kName: int = azGet(kInc, 0)
    if oTpIncQ(kInc, kName) == 0
        return 0
    end

    # второй decl — аккумулятор k-цикла (k-decl сам — нет)
    var accName: int = 0
    if azStrEq(azGet(d0, 0), kName) == 1
        accName = azGet(d1, 0)
    else
        if azStrEq(azGet(d1, 0), kName) == 1
            accName = azGet(d0, 0)
        end
    end
    if accName == 0
        return 0
    end
    if oTpIncQ(ccInc, ccName) == 0
        return 0
    end
    if oTpDistinct(ccName, kName) == 0 || oTpDistinct(ccName, accName) == 0
        return 0
    end
    if oTpDistinct(kName, accName) == 0
        return 0
    end
    if oTpDistinct(kName, rName) == 0 || oTpDistinct(accName, rName) == 0
        return 0
    end
    if oTpPlainQ(accAsg, accName) == 0
        return 0
    end

    # --- acc = acc + peek32(argA) * peek32(argB) ---
    var plus: int = azGet(accAsg, 4)
    if azTag(plus) != N_BINARY || oOpIs(azGet(plus, 2), "+") != 1
        return 0
    end
    var accL: int = azGet(plus, 0)
    if azTag(accL) != N_IDENT || azStrEq(azGet(accL, 0), accName) == 0
        return 0
    end
    var star: int = azGet(plus, 1)
    if azTag(star) != N_BINARY || oOpIs(azGet(star, 2), "*") != 1
        return 0
    end
    var callA: int = azGet(star, 0)
    var callB: int = azGet(star, 1)
    if oTpCallQ(callA, "peek32", 1) == 0 || oTpCallQ(callB, "peek32", 1) == 0
        return 0
    end

    # --- argB в точности: BASE + ((k * n) + cc) * 4, oSame(n) с условием O ---
    var argB: int = oTpArgs(callB, 0)
    if azTag(argB) != N_BINARY || oOpIs(azGet(argB, 2), "+") != 1
        return 0
    end
    var baseE: int = azGet(argB, 0)
    if azTag(baseE) != N_IDENT
        return 0
    end
    var baseName: int = azGet(baseE, 0)
    if oTpDistinct(baseName, rName) == 0 || oTpDistinct(baseName, ccName) == 0
        return 0
    end
    if oTpDistinct(baseName, kName) == 0 || oTpDistinct(baseName, accName) == 0
        return 0
    end
    var mul1: int = azGet(argB, 1)
    if azTag(mul1) != N_BINARY || oOpIs(azGet(mul1, 2), "*") != 1
        return 0
    end
    var num4: int = azGet(mul1, 1)
    if azTag(num4) != N_NUMBER || oNumVal(num4) != 4
        return 0
    end
    var plus1: int = azGet(mul1, 0)
    if azTag(plus1) != N_BINARY || oOpIs(azGet(plus1, 2), "+") != 1
        return 0
    end
    var ccId: int = azGet(plus1, 1)
    if azTag(ccId) != N_IDENT || azStrEq(azGet(ccId, 0), ccName) == 0
        return 0
    end
    var mul2: int = azGet(plus1, 0)
    if azTag(mul2) != N_BINARY || oOpIs(azGet(mul2, 2), "*") != 1
        return 0
    end
    var kId: int = azGet(mul2, 0)
    if azTag(kId) != N_IDENT || azStrEq(azGet(kId, 0), kName) == 0
        return 0
    end
    var n2: int = azGet(mul2, 1)
    if oSame(n2, nE) == 0
        return 0
    end
    # N не зависит от переменных гнезда (иначе транспон/размер считается не тем)
    if oRefsName(nE, rName) == 1 || oRefsName(nE, ccName) == 1 || oRefsName(nE, kName) == 1 || oRefsName(nE, accName) == 1
        return 0
    end

    # --- pokeS: poke32(caddr, acc); в гнезде пишется только c ---
    var pokeC: int = azGet(pokeS, 0)
    if oTpCallQ(pokeC, "poke32", 2) == 0
        return 0
    end
    var caddr: int = oTpArgs(pokeC, 0)
    var parg1: int = oTpArgs(pokeC, 1)
    if oTpArithQ(caddr) == 0
        return 0
    end
    if oRefsName(caddr, kName) == 1 || oRefsName(caddr, accName) == 1 || oRefsName(caddr, baseName) == 1
        return 0
    end
    if azTag(parg1) != N_IDENT || azStrEq(azGet(parg1, 0), accName) == 0
        return 0
    end

    # --- T2.1: extra-stmt (6-форма): внешний acc += f(внутр. sum) ---
    # Читает финальный sum (сохраняется при T3: sum = __vdot(...) стоит до
    # poke и extra — порядок stmt'ов не меняется), пишет внешнее имя.
    # Запреты: писать {k, acc(внутр.), cc, r, BASE} и переменные условия N;
    # читать k (после T3 k-инкремент исчезает вместе с циклом — значение k
    # после __vdot не определено!); вызовы в значении (чистая арифметика).
    if extra != 0
        if azGet(extra, 1) != 0 || azGet(extra, 2) != 0 || azGet(extra, 3) != 0
            return 0
        end
        var exName: int = azGet(extra, 0)
        if oTpDistinct(exName, kName) == 0 || oTpDistinct(exName, accName) == 0
            return 0
        end
        if oTpDistinct(exName, ccName) == 0 || oTpDistinct(exName, rName) == 0
            return 0
        end
        if oTpDistinct(exName, baseName) == 0
            return 0
        end
        var exVal: int = azGet(extra, 4)
        if oTpArithQ(exVal) == 0
            return 0
        end
        if oRefsName(exVal, kName) == 1
            return 0
        end
        if oRefsName(nE, exName) == 1
            return 0
        end
    end

    # ================= все проверки пройдены: сборка =================
    var btN: int = oTpNewName()
    var tkN: int = oTpNewName()
    var tccN: int = oTpNewName()

    # 1) argB -> bt + (cc * n + k) * 4 (слот argB в аргументе callB)
    var argBp: int = oTpIdxE(oIvIdent(btN), ccName, kName, nE)
    poke32(gSideBase + azGet(callB, 2) * 4, argBp)

    # 2) var bt = alloc(n * n * 4)
    var szE: int = oMakeBinary(azStrLit("*"), oMakeBinary(azStrLit("*"), oClone(nE), oClone(nE)), oMakeNum(4))
    var btDecl: int = azNew(N_VARDECL, 0)
    azSet(btDecl, 0, btN)
    azSet(btDecl, 7, oTpMkCall("alloc", szE))

    # 3) var tk = 0
    var tkDecl: int = azNew(N_VARDECL, 0)
    azSet(tkDecl, 0, tkN)
    azSet(tkDecl, 7, oMakeNum(0))

    # 4) внутренний цикл по tcc: poke32(bt + (tcc*n+tk)*4, peek32(BASE + (tk*n+tcc)*4))
    var srcE: int = oTpIdxE(baseE, tkN, tccN, nE)          # BASE переезжает сюда
    var pokeTS: int = azNew(N_EXPRSTMT, 0)
    azSet(pokeTS, 0, oTpMkCall2("poke32", oTpIdxE(oIvIdent(btN), tccN, tkN, nE), oTpMkCall("peek32", srcE)))
    var tccInc: int = azNew(N_ASSIGN, 0)
    azSet(tccInc, 0, tccN)
    azSet(tccInc, 3, 0)
    azSet(tccInc, 4, oMakeBinary(azStrLit("+"), oIvIdent(tccN), oMakeNum(1)))
    var tccDecl: int = azNew(N_VARDECL, 0)
    azSet(tccDecl, 0, tccN)
    azSet(tccDecl, 7, oMakeNum(0))
    var tccW: int = azNew(N_WHILE, 0)
    azSet(tccW, 0, oMakeBinary(azStrLit("<"), oIvIdent(tccN), oClone(nE)))
    azListBegin()
    azListPush(pokeTS)
    azListPush(tccInc)
    azListEnd()
    poke32(azFldAddr(tccW, 1), gLStart)
    poke32(azFldAddr(tccW, 2), gLLen)

    # 5) внешний цикл по tk: [tccDecl, tccW, tk=0 -> tkInc]
    var tkInc: int = azNew(N_ASSIGN, 0)
    azSet(tkInc, 0, tkN)
    azSet(tkInc, 3, 0)
    azSet(tkInc, 4, oMakeBinary(azStrLit("+"), oIvIdent(tkN), oMakeNum(1)))
    var tkW: int = azNew(N_WHILE, 0)
    azSet(tkW, 0, oMakeBinary(azStrLit("<"), oIvIdent(tkN), oClone(nE)))
    azListBegin()
    azListPush(tccDecl)
    azListPush(tccW)
    azListPush(tkInc)
    azListEnd()
    poke32(azFldAddr(tkW, 1), gLStart)
    poke32(azFldAddr(tkW, 2), gLLen)

    # 6) free(bt)
    var freeS: int = azNew(N_EXPRSTMT, 0)
    azSet(freeS, 0, oTpMkCall("free", oIvIdent(btN)))

    # 7) вставка вокруг O (заполняет gTpPre/gTpPost, вставляет oTpBlock)
    gTpPre[0] = btDecl
    gTpPre[1] = tkDecl
    gTpPre[2] = tkW
    gTpPreN = 3
    gTpPost[0] = freeS
    gTpPostN = 1

    gOSr = gOSr + 3
    return 1
end

# (sa, la) — АДРЕСА полей (start,len), как у oIxBlock/oRemoveDeadStores
func oTpBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        if sid != 0
            var t: int = azTag(sid)
            if t == N_WHILE
                var ok: int = oTpTry(sid)
                if ok == 1
                    # вставить [pre..., sid, post...] в текущее окно
                    azListBegin()
                    var j: int = 0
                    while j < i
                        azListPush(peek32(gSideBase + (s0 + j) * 4))
                        j = j + 1
                    end
                    j = 0
                    while j < gTpPreN
                        azListPush(gTpPre[j])
                        j = j + 1
                    end
                    azListPush(sid)
                    j = 0
                    while j < gTpPostN
                        azListPush(gTpPost[j])
                        j = j + 1
                    end
                    j = i + 1
                    while j < n0
                        azListPush(peek32(gSideBase + (s0 + j) * 4))
                        j = j + 1
                    end
                    azListEnd()
                    poke32(sa, gLStart)
                    poke32(la, gLLen)
                    s0 = peek32(sa)
                    n0 = peek32(la)
                    # тело sid не тронуто (поля узла)
                    oTpBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    i = i + 1 + gTpPreN + gTpPostN
                else
                    oTpBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    i = i + 1
                end
            else
                if t == N_IF
                    oTpBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    oTpBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
                end
                if t == N_FOR
                    oTpBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                end
                if t == N_LOOP
                    oTpBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                end
                i = i + 1
            end
        else
            i = i + 1
        end
    end
end

func oTpRun()
    gTpCnt = 0
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oTpBlock(azNodeAddr(fn) + 44, azNodeAddr(fn) + 48)
        end
        i = i + 1
    end
end

# =====================================================================
# T3: SIMD DOT-PRODUCT — замена k-цикла matmul на вызов __vdot
#
# Распознаёт k-цикл (после T2, ДО T1) вида:
#     while k < N
#         acc = acc + peek32(argA) * peek32(argB)
#         k = k + 1
#     end
# где argA и argB — СПЛОШНЫЕ int32-потоки по k: BASE + ((INV) + k) * 4
# (INV/BASE чистая арифметика, не зависят от k/acc — ровно то, что
# даёт T2: a+(r*n+k)*4 и bt+(cc*n+k)*4) и заменяет ВЕСЬ цикл на
#     acc = __vdot(argA, argB, N - k, acc)
# (argA/argB переезжают из умирающих peek32-обёрток, N — правая часть
# условия, знаковое: cnt<=0 корректно даёт 0 итераций -> acc0).
# Эмиссия SIMD — cg_expr.z cgTryVdotCall (pmuldq+paddq, хвост,
# reduce). Слагаемое/условия чистые -> порядок вычислений безопасен.
#
# Порядок в tier3: oVdRun() ДО oIxRun() — vdot потребляет сырой
# (до-T1) вид цикла; T1 на этот цикл больше не срабатывает (не нужен).
# При --speed (ось S) oPullPow2 может превратить *4 в <<2 и форма
# перестанет матчиться — v1 рассчитан на -3r (бенчмарки).
# =====================================================================

# argX = BASE + ((INV) + k) * 4 — сплошной поток; INV/BASE без k/acc
func oVdStreamQ(e: int, kName: int, accName: int) -> int
    if azTag(e) != N_BINARY || oOpIs(azGet(e, 2), "+") != 1
        return 0
    end
    var baseE: int = azGet(e, 0)
    if oTpArithQ(baseE) == 0
        return 0
    end
    if oRefsName(baseE, kName) == 1 || oRefsName(baseE, accName) == 1
        return 0
    end
    var mul1: int = azGet(e, 1)
    # промежуточные пассы конвертируют x*4 -> x<<2 (а T2 до пассов видит *4):
    # принимаем обе формы шага 4 байта
    var okStep: int = 0
    if azTag(mul1) == N_BINARY
        var mop: int = azGet(mul1, 2)
        var mr: int = azGet(mul1, 1)
        if azTag(mr) == N_NUMBER
            if oOpIs(mop, "*") == 1 && oNumVal(mr) == 4
                okStep = 1
            end
            if oOpIs(mop, "<<") == 1 && oNumVal(mr) == 2
                okStep = 1
            end
        end
    end
    if okStep == 0
        return 0
    end
    var pl: int = azGet(mul1, 0)
    if azTag(pl) != N_BINARY || oOpIs(azGet(pl, 2), "+") != 1
        return 0
    end
    var inv: int = azGet(pl, 0)
    if oTpArithQ(inv) == 0
        return 0
    end
    if oRefsName(inv, kName) == 1 || oRefsName(inv, accName) == 1
        return 0
    end
    var kid: int = azGet(pl, 1)
    if azTag(kid) != N_IDENT || azStrEq(azGet(kid, 0), kName) == 0
        return 0
    end
    return 1
end

# slot — адрес слота while в родительском окне (для замены на assign)
func oVdTry(sid: int, slot: int) -> int
    # тело ровно [acc-assign, k=k+1]
    var bs: int = azGet(sid, 1)
    var bn: int = azGet(sid, 2)
    if bn != 2
        return 0
    end
    var accAsg: int = peek32(gSideBase + bs * 4)
    var kInc: int = peek32(gSideBase + (bs + 1) * 4)

    # условие `k < N`
    var cond: int = azGet(sid, 0)
    if azTag(cond) != N_BINARY || oOpIs(azGet(cond, 2), "<") != 1
        return 0
    end
    if kInc == 0 || azTag(kInc) != N_ASSIGN
        return 0
    end
    var kName: int = azGet(kInc, 0)
    if oTpIncQ(kInc, kName) == 0
        return 0
    end
    var cl: int = azGet(cond, 0)
    if azTag(cl) != N_IDENT || azStrEq(azGet(cl, 0), kName) == 0
        return 0
    end
    var nC: int = azGet(cond, 1)
    if oTpArithQ(nC) == 0 || oRefsName(nC, kName) == 1
        return 0
    end

    # acc = acc + peek32(A) * peek32(B)
    if accAsg == 0 || azTag(accAsg) != N_ASSIGN
        return 0
    end
    if azGet(accAsg, 1) != 0 || azGet(accAsg, 2) != 0 || azGet(accAsg, 3) != 0
        return 0
    end
    var accName: int = azGet(accAsg, 0)
    var plus: int = azGet(accAsg, 4)
    if azTag(plus) != N_BINARY || oOpIs(azGet(plus, 2), "+") != 1
        return 0
    end
    var accL: int = azGet(plus, 0)
    if azTag(accL) != N_IDENT || azStrEq(azGet(accL, 0), accName) == 0
        return 0
    end
    var star: int = azGet(plus, 1)
    if azTag(star) != N_BINARY || oOpIs(azGet(star, 2), "*") != 1
        return 0
    end
    var callA: int = azGet(star, 0)
    var callB: int = azGet(star, 1)
    if oTpCallQ(callA, "peek32", 1) == 0 || oTpCallQ(callB, "peek32", 1) == 0
        return 0
    end
    var argA: int = oTpArgs(callA, 0)
    var argB: int = oTpArgs(callB, 0)
    if oVdStreamQ(argA, kName, accName) == 0
        return 0
    end
    if oVdStreamQ(argB, kName, accName) == 0
        return 0
    end

    # ==== мутация: while -> acc = __vdot(argA, argB, N - k, acc) ====
    var cnt: int = oMakeBinary(azStrLit("-"), oClone(nC), oIvIdent(kName))
    var call: int = azNew(N_CALL, 0)
    azSet(call, 0, azStrLit("__vdot"))
    azSet(call, 1, 0)
    azListBegin()
    azListPush(argA)
    azListPush(argB)
    azListPush(cnt)
    azListPush(accL)
    azListEnd()
    azSet(call, 2, gLStart)
    azSet(call, 3, 4)
    var na: int = azNew(N_ASSIGN, 0)
    azSet(na, 0, accName)
    azSet(na, 3, 0)
    azSet(na, 4, call)
    poke32(slot, na)
    gOSr = gOSr + 3
    return 1
end

# (sa, la) — АДРЕСА полей (как oTpBlock/oIxBlock)
func oVdBlock(sa: int, la: int)
    var s0: int = peek32(sa)
    var n0: int = peek32(la)
    var i: int = 0
    while i < n0
        var sid: int = peek32(gSideBase + (s0 + i) * 4)
        if sid != 0
            var t: int = azTag(sid)
            if t == N_WHILE
                var slot: int = gSideBase + (s0 + i) * 4
                if oVdTry(sid, slot) == 1
                    i = i + 1
                else
                    oVdBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    i = i + 1
                end
            else
                if t == N_IF
                    oVdBlock(azFldAddr(sid, 1), azFldAddr(sid, 2))
                    oVdBlock(azFldAddr(sid, 3), azFldAddr(sid, 4))
                end
                if t == N_FOR
                    oVdBlock(azFldAddr(sid, 4), azFldAddr(sid, 5))
                end
                if t == N_LOOP
                    oVdBlock(azFldAddr(sid, 0), azFldAddr(sid, 1))
                end
                i = i + 1
            end
        else
            i = i + 1
        end
    end
end

func oVdRun()
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oVdBlock(azNodeAddr(fn) + 44, azNodeAddr(fn) + 48)
        end
        i = i + 1
    end
end

func oOptRun(level: int, allowPow2: int, isLib: int, koDriver: int, arch: int) -> int
    oTabReset()
    gOAllowPow2 = allowPow2
    gOWarnN = 0
    # level — упакованное слово осей: r + s*8 + d*64 (обратная совместимость:
    # старый level N == ось R уровня N, т.к. s=d=0)
    gOAxisR = level % 8
    gOAxisS = (level / 8) % 8
    gOAxisD = (level / 64) % 8
    oEffCompute()
    gOptLevel = gOAxisR
    if gOAxisS > gOptLevel
        gOptLevel = gOAxisS
    end
    if gOAxisD > gOptLevel
        gOptLevel = gOAxisD
    end
    gOptIsLib = isLib
    if isLib == 1
        return 0
    end
    if gOActiveN == 0
        return 0
    end
    oFnUserBuild()
    oGlSetBuild()

    # T2: транспон B (alloc bt + копия n*n, argB -> bt) — ДО основных пассов,
    # пока матmul-костяк первоначален; T1 в tier3 доберёт k-цикл.
    if oAxisHas(3, 3) == 1
        oTpRun()
    end

    # tier2 (R|S): tiny-inlining — растит стек/кадр, но убирает вызовы
    if oAxisHas(3, 2) == 1 && oConflictSkip(1, 3) == 0
        oInlineTinyFunctions()
    end
    var maxIter: int = 4
    if gOptLevel >= 2
        maxIter = 5
    end
    if gOptLevel >= 3
        maxIter = 6
    end
    var iter: int = 0
    while iter < maxIter
        var before: int = gORm
        if oAxisHas(7, 1) == 1
            oFoldConstants()
        end
        if oAxisHas(7, 1) == 1
            oStructuralClean()
        end
        if oAxisHas(7, 2) == 1
            oSimplifyExprs()
        end
        if oAxisHas(7, 2) == 1
            oPropagateLocals()
        end
        if oAxisHas(7, 2) == 1
            oPruneConstBranches()
        end
        if oAxisHas(7, 2) == 1
            oCleanupIfShapes()
        end
        if oAxisHas(7, 2) == 1
            oDeadStoreElimination()
        end
        if oAxisHas(7, 2) == 1
            oBooleanSimplify()
        end
        if oAxisHas(7, 1) == 1
            oIdentityArith()
        end
        if oAxisHas(7, 1) == 1
            oDoubleUnary()
        end
        if oAxisHas(4, 2) == 1
            oSelfLogical()
        end
        if oAxisHas(2, 2) == 1
            oNormConstArith()
        end
        if oAxisHas(2, 1) == 1
            oCanonicalCmp()
        end
        if oAxisHas(2, 2) == 1
            oPullPow2Products()
        end
        if oAxisHas(6, 2) == 1
            oMergeNestedIfs()
        end
        if gORm == before
            iter = maxIter
        else
            iter = iter + 1
        end
    end
    # tier3 (speed): strength-reduce + композиция сдвигов
    if oAxisHas(2, 3) == 1 && oConflictSkip(2, 2) == 0
        oSpeedStrengthReduce(arch)
    end
    if oAxisHas(2, 3) == 1
        oShiftCompose()
    end
    # T1: индексная силовая-редукция аффинных индексов в while-циклах
    if oAxisHas(3, 3) == 1
        oVdRun()
        oIxRun()
    end
    oDce(koDriver)
    if gORm + gOSr + gOProp + gORf + gORg > 0
        return 1
    end
    return 0
end


# ====================================================================
# МЕЛКИЕ ОПТИМИЗАЦИИ (2 на ось) — план PLAN_OPT3.md
#   oIdentityArith  (маска 7, t1) — нейтральные элементы:  x+0->x, x*1->x,
#                                    x|0->x, x<<0->x, x&-1->x, x/1->x ...
#   oDoubleUnary    (маска 7, t1) — двойные унарные:        !!x->x, -(-x)->x, ~~x->x
#   oMulShiftAdd    (маска 2, t2) — умножение на 3/5/9 -> сдвиг+сложение
#   oSelfLogical    (маска 4, t2) — самосвязки:             x&&x->x, x|x->x, x^x->0
# Все — чистые переписывания выражений (семантически нейтральные для int;
# для float не применяются), без удаления statements -> безопасно для паритета.
# ====================================================================

func oIdentityArithE(e: int) -> int
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var cl: int = oIdentityArithE(azGet(e, 0))
    if cl != 0
        azSet(e, 0, cl)
    end
    var cr: int = oIdentityArithE(azGet(e, 1))
    if cr != 0
        azSet(e, 1, cr)
    end
    var l: int = azGet(e, 0)
    var r: int = azGet(e, 1)
    var op: int = azGet(e, 2)
    if oDefinitelyInt(l) == 0
        return 0
    end
    if oDefinitelyInt(r) == 0
        return 0
    end
    # правый нейтральный элемент
    if oIsConstInt(r) == 1
        var rv: int = gOI64
        if (oOpIs(op, "+") == 1 || oOpIs(op, "-") == 1 || oOpIs(op, "|") == 1 || oOpIs(op, "^") == 1 || oOpIs(op, "<<") == 1 || oOpIs(op, ">>") == 1) && rv == 0
            return l
        end
        if oOpIs(op, "*") == 1 && rv == 1
            return l
        end
        if oOpIs(op, "/") == 1 && rv == 1
            return l
        end
        if oOpIs(op, "&") == 1 && rv == -1
            return l
        end
        # нулевые поглотители — левый ОПЕРАНД отбрасывается, нужен чистый
        if (oOpIs(op, "*") == 1 || oOpIs(op, "&") == 1 || oOpIs(op, "<<") == 1 || oOpIs(op, ">>") == 1) && rv == 0
            if oMaySide(l) == 0
                return oMakeNum(0)
            end
            return 0
        end
        if oOpIs(op, "|") == 1 && rv == -1
            if oMaySide(l) == 0
                return oMakeNum(-1)
            end
            return 0
        end
        # x % 1 -> 0
        if (oOpIs(op, "%") == 1 || oOpIs(op, "//") == 1) && rv == 1
            if oMaySide(l) == 0
                return oMakeNum(0)
            end
            return 0
        end
    end
    # левый нейтральный элемент (только для коммутативных)
    if oIsConstInt(l) == 1
        var lv: int = gOI64
        if (oOpIs(op, "+") == 1 || oOpIs(op, "|") == 1 || oOpIs(op, "^") == 1) && lv == 0
            return r
        end
        if oOpIs(op, "*") == 1 && lv == 1
            return r
        end
        if oOpIs(op, "&") == 1 && lv == -1
            return r
        end
        if (oOpIs(op, "*") == 1 || oOpIs(op, "&") == 1) && lv == 0
            if oMaySide(r) == 0
                return oMakeNum(0)
            end
            return 0
        end
        if oOpIs(op, "|") == 1 && lv == -1
            if oMaySide(r) == 0
                return oMakeNum(-1)
            end
            return 0
        end
    end
    return 0
end

func oDoubleUnaryE(e: int) -> int
    if e == 0
        return 0
    end
    var t: int = azTag(e)
    if t == N_UNARY
        var ci: int = oDoubleUnaryE(azGet(e, 1))
        if ci != 0
            azSet(e, 1, ci)
        end
        var inner: int = azGet(e, 1)
        if azTag(inner) != N_UNARY
            return 0
        end
        var opO: int = azGet(e, 0)
        var opI: int = azGet(inner, 0)
        # !!x -> x, -(-x)->x, ~~x->x (только одинаковые пары)
        if oOpIs(opO, "!") == 1 && oOpIs(opI, "!") == 1
            return azGet(inner, 1)
        end
        if oOpIs(opO, "-") == 1 && oOpIs(opI, "-") == 1
            if oMaySide(azGet(inner, 1)) == 0
                return azGet(inner, 1)
            end
        end
        if oOpIs(opO, "~") == 1 && oOpIs(opI, "~") == 1
            return azGet(inner, 1)
        end
        return 0
    end
    if t == N_BINARY
        var cl: int = oDoubleUnaryE(azGet(e, 0))
        if cl != 0
            azSet(e, 0, cl)
        end
        var cr: int = oDoubleUnaryE(azGet(e, 1))
        if cr != 0
            azSet(e, 1, cr)
        end
        return 0
    end
    return 0
end

# oNormConstArith (маска 2, t2): нормализация отрицательных констант
#   x * -1  ->  -x ;  x - (-k) -> x + k ;  x + (-k) -> x - k (k>0)
# без клонирования узла (узлы в .z — id, переиспользование безопасно)
func oNormConstArithE(e: int) -> int
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var cl: int = oNormConstArithE(azGet(e, 0))
    if cl != 0
        azSet(e, 0, cl)
    end
    var cr: int = oNormConstArithE(azGet(e, 1))
    if cr != 0
        azSet(e, 1, cr)
    end
    var l: int = azGet(e, 0)
    var r: int = azGet(e, 1)
    var op: int = azGet(e, 2)
    if oDefinitelyInt(l) == 0
        return 0
    end
    if oDefinitelyInt(r) == 0
        return 0
    end
    # x * -1 -> -x
    if oOpIs(op, "*") == 1 && oIsConstInt(r) == 1 && gOI64 == -1 && oMaySide(l) == 0
        gOSr = gOSr + 1
        return oMakeUnary(azStrLit("-"), l)
    end
    if oOpIs(op, "*") == 1 && oIsConstInt(l) == 1 && gOI64 == -1 && oMaySide(r) == 0
        gOSr = gOSr + 1
        return oMakeUnary(azStrLit("-"), r)
    end
    # x - (-k) -> x + k
    if oOpIs(op, "-") == 1 && oIsConstInt(r) == 1 && gOI64 < 0
        gOSr = gOSr + 1
        return oMakeBinary(azStrLit("+"), l, oMakeNum(0 - gOI64))
    end
    # x + (-k) -> x - k   (k > 0, иначе свернётся раньше)
    if oOpIs(op, "+") == 1 && oIsConstInt(r) == 1 && gOI64 < 0
        gOSr = gOSr + 1
        return oMakeBinary(azStrLit("-"), l, oMakeNum(0 - gOI64))
    end
    # x - k -> x + (-k) не делаем (прямая форма предпочтительнее)
    return 0
end

func oSelfLogicalE(e: int) -> int
    if e == 0
        return 0
    end
    if azTag(e) != N_BINARY
        return 0
    end
    var cl: int = oSelfLogicalE(azGet(e, 0))
    if cl != 0
        azSet(e, 0, cl)
    end
    var cr: int = oSelfLogicalE(azGet(e, 1))
    if cr != 0
        azSet(e, 1, cr)
    end
    var l: int = azGet(e, 0)
    var r: int = azGet(e, 1)
    if oSame(l, r) == 0
        return 0
    end
    if oMaySide(l) == 1
        return 0
    end
    var op: int = azGet(e, 2)
    # x&&x->x, x||x->x, x&x->x, x|x->x, x^x->0, x==x->1, x!=x->0
    if oOpIs(op, "&&") == 1 || oOpIs(op, "||") == 1 || oOpIs(op, "&") == 1 || oOpIs(op, "|") == 1
        return l
    end
    if oOpIs(op, "^") == 1
        return oMakeNum(0)
    end
    if oOpIs(op, "==") == 1 && oDefinitelyInt(l) == 1
        return oMakeNum(1)
    end
    if oOpIs(op, "!=") == 1 && oDefinitelyInt(l) == 1
        return oMakeNum(0)
    end
    return 0
end

# обходчики — по образцу oNewPass (mode: 0=identity,1=doubleUnary,
# 2=mulShiftAdd, 3=selfLogical)
func oMicroE(mode: int, e: int) -> int
    if mode == 0
        return oIdentityArithE(e)
    end
    if mode == 1
        return oDoubleUnaryE(e)
    end
    if mode == 2
        return oNormConstArithE(e)
    end
    return oSelfLogicalE(e)
end

func oMicroBlock(mode: int, sa: int, la: int)
    var i: int = 0
    while i < la
        var sid: int = peek32(gSideBase + (sa + i) * 4)
        oMicroStmt(mode, sid)
        i = i + 1
    end
end

func oMicroStmt(mode: int, sid: int)
    if sid == 0
        return
    end
    var t: int = azTag(sid)
    if t == N_RETURN || t == N_EXPRSTMT
        var n: int = oMicroE(mode, azGet(sid, 0))
        if n != 0
            azSet(sid, 0, n)
        end
        return
    end
    if t == N_ASSIGN
        var n2: int = oMicroE(mode, azGet(sid, 3))
        if n2 != 0
            azSet(sid, 3, n2)
        end
        var n3: int = oMicroE(mode, azGet(sid, 4))
        if n3 != 0
            azSet(sid, 4, n3)
        end
        return
    end
    if t == N_PTRASSIGN
        var n4: int = oMicroE(mode, azGet(sid, 0))
        if n4 != 0
            azSet(sid, 0, n4)
        end
        var n5: int = oMicroE(mode, azGet(sid, 1))
        if n5 != 0
            azSet(sid, 1, n5)
        end
        return
    end
    if t == N_VARDECL
        var n6: int = oMicroE(mode, azGet(sid, 3))
        if n6 != 0
            azSet(sid, 3, n6)
        end
        return
    end
    if t == N_IF
        var n7: int = oMicroE(mode, azGet(sid, 0))
        if n7 != 0
            azSet(sid, 0, n7)
        end
        oMicroBlock(mode, azGet(sid, 1), azGet(sid, 2))
        oMicroBlock(mode, azGet(sid, 3), azGet(sid, 4))
        return
    end
    if t == N_WHILE
        var n8: int = oMicroE(mode, azGet(sid, 0))
        if n8 != 0
            azSet(sid, 0, n8)
        end
        oMicroBlock(mode, azGet(sid, 1), azGet(sid, 2))
        return
    end
    if t == N_LOOP
        oMicroBlock(mode, azGet(sid, 0), azGet(sid, 1))
        return
    end
    if t == N_SWITCH
        var n9: int = oMicroE(mode, azGet(sid, 0))
        if n9 != 0
            azSet(sid, 0, n9)
        end
        return
    end
end

func oMicroRun(mode: int)
    var i: int = 0
    while i < gFuncN
        var fn: int = gFuncIds[i]
        if azGet(fn, 11) == 0
            oCollectLocalKinds(fn)
            oMicroBlock(mode, azGet(fn, 9), azGet(fn, 10))
        end
        i = i + 1
    end
    i = 0
    while i < gGlobalN
        var g: int = gGlobalIds[i]
        var n: int = oMicroE(mode, azGet(g, 7))
        if n != 0
            azSet(g, 7, n)
        end
        i = i + 1
    end
end

func oIdentityArith()
    oMicroRun(0)
end

func oDoubleUnary()
    oMicroRun(1)
end

func oNormConstArith()
    oMicroRun(2)
end

func oSelfLogical()
    oMicroRun(3)
end
