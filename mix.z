app gui dx tool

# Mix CPU draw (green rect, visible ONLY via CPU staging present path)
# with GPU dxDraw (red triangle, visible via GPU back-buffer present path).
# - If green visible + no red -> present goes CPU path (gpuFrame==0), GPU triangle gets erased
# - If black only (no green, no red) -> gpuFrame==1 but Draw doesn't render
# - If red visible  -> Draw renders & gpuFrame==1 (goal)

func main() -> int
    createWindow(800, 600, "DX11")

    var p: int = alloc(64)
    poke32(p, 0x3F800000)
    poke32(p + 4, 0x3F800000)
    poke32(p + 8, 0xBF800000)
    poke32(p + 12, 0x3F800000)
    poke32(p + 16, 0)
    poke32(p + 20, 0xBF800000)

    var vs: int = dxCreateVertexShader("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var ps: int = dxCreatePixelShader("float4 main() : SV_Target { return float4(1, 0, 0, 1); }")
    var layout: int = dxCreateInputLayout("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }", "POSITION", 16, 0)
    var vbuf: int = dxCreateBuffer(24, p)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 8)
    dxSetTopology(4)

    var running: int = 1
    while running == 1
        drawRect(0, 0, 400, 300, 0xFF00FF00)
        dxDraw(3)
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end
    closeWindow()
    return 0
end
