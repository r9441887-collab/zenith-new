app linux driver
module_description: "zenith hex-string + CMOS clock driver"
module_author: "zenith"
module_version: "1.1.0"

# Converts a kernel-heap buffer to uppercase hex and reads the BIOS
# CMOS/RTC time-of-day registers (BCD) through inb/outb — the ring-0
# port-I/O path. Uses kzalloc + arithmetic on port I/O results.
var g_hex: int = 0
var g_len: int = 8

func to_hex(b: int) -> int
    # returns ASCII code for low nibble of b
    var n: int = b % 16
    if n < 10
        return 48 + n        # '0'..'9'
    end
    return 55 + n            # 'A'..'F'
end

func bcd8(v: int) -> int
    # unpack a BCD byte: (v/16)*10 + (v%16)
    return (v / 16) * 10 + (v % 16)
end

func main() -> int
    var buf: int = kzalloc(g_len)
    var i: int
    var sec: int
    var min: int
    var hr: int
    if buf == 0
        print("hex kzalloc FAILED")
        return 1
    end
    # fill buffer with a known pattern, then print its hex representation
    i = 0
    while i < g_len
        poke8(buf + i, 0x10 + i)
        i = i + 1
    end
    print("buffer hex: ")
    i = 0
    while i < g_len
        var b: int = peek8(buf + i)
        print(to_hex(b / 16))
        print(to_hex(b))
        i = i + 1
    end
    print("")
    print("CMOS seconds (BCD)=")
    outb(0x70, 0)
    io_delay()
    sec = bcd8(inb(0x71))
    print(sec)
    print("CMOS minutes (BCD)=")
    outb(0x70, 2)
    io_delay()
    min = bcd8(inb(0x71))
    print(min)
    print("CMOS hours (BCD)=")
    outb(0x70, 4)
    io_delay()
    hr = bcd8(inb(0x71))
    print(hr)
    print("time is ")
    print(hr)
    print(":")
    print(min)
    print(":")
    print(sec)
    print("")
    kfree(buf)
    return 0
end

func cleanup()
    print("hex/cmos cleanup")
end