app console

use lexer

extern func refLoadFile(path: int) -> int
extern func refFileLen() -> int
extern func refTokenize(s: int, n: int) -> int
extern func refCount() -> int
extern func refKind(i: int) -> int
extern func refLine(i: int) -> int
extern func refCol(i: int) -> int
extern func refInt(i: int) -> int
extern func refFloat(i: int) -> float
extern func refTextPtr(i: int) -> int
extern func refTextLen(i: int) -> int
extern func refErrOut() -> int
extern func refErrOutLen() -> int
extern func refNextInit(s: int, n: int) -> int
extern func refNextScan() -> int

var failed: int = 0
var cases: int = 0
var tokensSeen: int = 0

func bytesEq(a: int, b: int, n: int) -> int
    var i: int = 0
    while i < n
        if peek8(a + i) != peek8(b + i)
            return 0
        end
        i = i + 1
    end
    return 1
end

func closeF(a: float, b: float) -> int
    var d: float = a - b
    if d < 0.0
        d = 0.0 - d
    end
    var m: float = b
    if m < 0.0
        m = 0.0 - m
    end
    if m < 1.0
        m = 1.0
    end
    if d <= 0.00001 * m
        return 1
    end
    return 0
end

func bad(name: string, i: int, what: string, z: int, r: int)
    print(name)
    print(" #")
    println(i)
    println(what)
    print("z=")
    println(z)
    print("ref=")
    println(r)
    failed = failed + 1
end

func cmpRun(name: string, src: int, len: int) -> int
    lexInit(src, len)
    var nz: int = lexAll()
    refTokenize(src, len)
    var nr: int = refCount()
    if nz != nr
        bad(name, 0, "count", nz, nr)
        return 0
    end

    var i: int = 0
    while i < nz
        var k: int = gToks[i].kind
        if k != refKind(i)
            bad(name, i, "kind", k, refKind(i))
            return 0
        end
        if gToks[i].line != refLine(i)
            bad(name, i, "line", gToks[i].line, refLine(i))
            return 0
        end
        if gToks[i].col != refCol(i)
            bad(name, i, "col", gToks[i].col, refCol(i))
            return 0
        end

        if k == TFloatLit
            if closeF(gToks[i].floatVal, refFloat(i)) == 0
                println("float mismatch")
                print(name)
                println(i)
                failed = failed + 1
                return 0
            end
        else
            if gToks[i].intVal != refInt(i)
                bad(name, i, "intVal", gToks[i].intVal, refInt(i))
                return 0
            end
        end

        var zp: int = 0
        var zn: int = 0
        if k == TStringLit
            zp = gToks[i].strVal
            zn = gToks[i].slen
        else
            zp = src + gToks[i].start
            zn = gToks[i].len
        end
        var rn: int = refTextLen(i)
        if zn != rn
            bad(name, i, "textlen", zn, rn)
            return 0
        end
        if bytesEq(zp, refTextPtr(i), zn) == 0
            println("text mismatch")
            print(name)
            println(i)
            failed = failed + 1
            return 0
        end
        i = i + 1
    end

    if lexErrOutLen() != refErrOutLen()
        println("errout len mismatch")
        print(name)
        println(lexErrOutLen())
        println(refErrOutLen())
        failed = failed + 1
        return 0
    end
    if bytesEq(lexErrOut(), refErrOut(), lexErrOutLen()) == 0
        println("errout text mismatch")
        println(name)
        failed = failed + 1
        return 0
    end

    cases = cases + 1
    tokensSeen = tokensSeen + nz
    return 1
end

func cmpCase(name: string, src: int) -> int
    return cmpRun(name, src, strLen(src))
end

func cmpCaseN(name: string, src: int, len: int) -> int
    return cmpRun(name, src, len)
end

func cmpNext(name: string, src: int, len: int) -> int
    lexInit(src, len)
    refNextInit(src, len)
    var guard: int = 0
    while guard < 100000
        guard = guard + 1
        var zi: int = lexNext()
        if zi < 0
            println("next z fail")
            println(name)
            failed = failed + 1
            return 0
        end
        var ri: int = refNextScan()
        if ri != zi
            println("next idx mismatch")
            println(name)
            failed = failed + 1
            return 0
        end
        var k: int = gToks[zi].kind
        if k != refKind(ri)
            println("next kind mismatch")
            print(name)
            println(ri)
            failed = failed + 1
            return 0
        end
        if gToks[zi].line != refLine(ri) || gToks[zi].col != refCol(ri)
            println("next line/col mismatch")
            print(name)
            println(ri)
            failed = failed + 1
            return 0
        end
        if k == TFloatLit
            if closeF(gToks[zi].floatVal, refFloat(ri)) == 0
                println("next float mismatch")
                failed = failed + 1
                return 0
            end
        else
            if gToks[zi].intVal != refInt(ri)
                println("next int mismatch")
                print(name)
                println(ri)
                failed = failed + 1
                return 0
            end
        end
        var zp: int = 0
        var zn: int = 0
        if k == TStringLit || k == TError
            zp = gToks[zi].strVal
            zn = gToks[zi].slen
        else
            zp = src + gToks[zi].start
            zn = gToks[zi].len
        end
        if zn != refTextLen(ri)
            println("next textlen mismatch")
            print(name)
            println(ri)
            failed = failed + 1
            return 0
        end
        if zn > 0 && bytesEq(zp, refTextPtr(ri), zn) == 0
            println("next text mismatch")
            print(name)
            println(ri)
            failed = failed + 1
            return 0
        end
        if k == TEof
            cases = cases + 1
            return 1
        end
    end
    println("next guard hit")
    println(name)
    failed = failed + 1
    return 0
end

func cmpFile(path: string) -> int
    var pp: int = path
    var p: int = refLoadFile(pp)
    if p == 0
        println("cannot open")
        println(path)
        failed = failed + 1
        return 0
    end
    return cmpRun(path, p, refFileLen())
end

func main() -> int
    cmpCase("numbers", "123 0x1F 0xab 1.5 .5 1e3 2.5E-2 1f 50% 12.foo 0\n")
    cmpCase("strings", "x = \"abc\\n\\t\\\"q\\\" \\\\ z\\0\" y\n")
    cmpCase("ops", "+ - * / // % . , : @ = == ! != < > <= >= << >> && || & | ^ ~ ( ) { } [ ] ->\n")
    cmpCase("keywords", "func var let const if else while for return end true false import use struct class extends extern interface implements abstract app from switch case break continue loop interrupt int float bool string void vec2 vec3 color entity virt phys ptr asm _x x1 foo_bar\n")
    cmpCase("comments", "# comment\n  a\n\\ block \\ tail\nkeep # x\n")
    cmpCase("junk", "$ ` ? ;\n")
    cmpCase("cols", "  a\n b\n\tc\n")
    cmpCase("edges", "0x 1e 12..34 a.b 1.foo ->\n")
    cmpCaseN("nul", "a\0b", 3)
    cmpCase("errEof", "$")
    cmpCase("errEof2", "0x")
    cmpCase("esc", "x = \"a\\tb\" c = \"a\\nb\"")
    cmpCase("unterm", "a = \"abc")
    cmpCase("badesc", "a = \"q\\xy\" b")
    cmpCase("pct", "12% 0x1F% 1.5%")
    cmpCase("numedge", "1.foo 12..34 1e 2E+5 0Xff 1_2")
    # z float = f32: selfhost floatVal is rounded vs the reference f64, so
    # closeF() tolerates it here. Exact f64 precision is checked
    # integration-wise by test-bugfind case 013 (float-precision-cmp).
    cmpCase("floats", "0.1 0.2 0.3 1.5 0.30000001\n")

    cmpNext("n_numbers", "123 0x1F 1.5 50% 1f\n", 21)
    cmpNext("n_strings", "x = \"abc\\n\" y\n", 13)
    cmpNext("n_junk", "$ ` ? ;\n", 7)
    cmpNext("n_errEof", "$", 1)
    cmpNext("n_esc", "a = \"q\\xy\" \"z\n", 14)
    cmpNext("n_unterm", "a = \"abc", 8)
    cmpNext("n_ops", "+ -> == << && ( ) { } [ ] , : @\n", 30)
    cmpNext("n_keywords", "func var const if else while return end phys asm\n", 48)

    lexInit("$", 1)
    lexAll()
    if lexErrorCount() != 1
        println("error count")
        println(lexErrorCount())
        failed = failed + 1
    end

    cmpFile("selfhost/lexer.z")
    cmpFile("selfhost/lexdiff.z")
    cmpFile("tools/android_smoke.z")
    cmpFile("tools/oop_smoke.z")
    cmpFile("tools/opt_peephole.z")
    cmpFile("tools/smoke_mix.z")

    if lexOverflow() == 1
        println("token buffer overflow")
        failed = failed + 1
    end

    print("cases=")
    println(cases)
    print("tokens=")
    println(tokensSeen)

    if failed == 0
        println("SELFHOST LEXER: ALL OK")
        exit(0)
    end
    print("SELFHOST LEXER FAILURES: ")
    println(failed)
    exit(1)
    return 0
end
