app android
    api_level: 33

# Regression for the small peephole passes in src/optimizer.cpp:
#   1) pruneConstBranches  2) cleanupIfShapes   3) canonicalCmp
#   4) pullPow2Products    5) mergeNestedIfs
#
# Every pass must preserve behaviour, so this file only asserts results.
# That each pass actually fires is covered by tools/opt_peephole_count.sh,
# which diffs the optimiser counters and code size against -0r.

var failed: int = 0

func check(got: int, want: int)
    if got != want
        println("FAIL want=")
        println(want)
        println("got=")
        println(got)
        failed = failed + 1
    end
end

# `return` in the then-arm plus an else-arm: the else-arm is exactly what runs
# when the condition is false, so it can be spliced in after the if.
func earlyReturn(a: int) -> int
    if a > 0
        return 1
    else
        return 2
    end
    return 3
end

func main() -> int
    var t: int = 0
    var a: int = 5
    var b: int = 3

    # ---- 1) constant conditions ----
    if 2 > 1
        t = 7
    else
        t = 99
    end
    check(t, 7)

    t = 0
    while 0
        t = 5
    end
    check(t, 0)

    t = 0
    for i = 5, 5
        t = 5
    end
    check(t, 0)

    # A non-empty trip count must survive untouched.
    t = 0
    for i = 0, 4
        t = t + i
    end
    check(t, 6)

    # ---- 2) if shapes ----
    # `if c {} else {B}` becomes `if !c {B}`, so B still runs only when c is
    # false. Both directions are checked because dropping the `if` outright
    # (instead of negating) would pass only the first one.
    t = 0
    if 1 > 2
    else
        t = 3
    end
    check(t, 3)

    t = 0
    if 2 > 1
    else
        t = 3
    end
    check(t, 0)

    check(earlyReturn(5), 1)
    check(earlyReturn(0 - 5), 2)

    # ---- 3) comparison canonicalisation (a > b -> b < a) ----
    t = 0
    if 5 > 3
        t = 1
    end
    check(t, 1)
    t = 0
    if 3 > 5
        t = 1
    end
    check(t, 0)
    check(earlyReturn(5), 1)

    # ---- 4) power-of-two pulled out of a product ----
    # x * (y * 8) -> (x * y) << 3
    check(3 * (5 * 8), 120)
    check(0 - 3 * (5 * 8), 0 - 120)
    check(1 * (7 * 1), 7)

    # ---- 5) nested if merged with && ----
    t = 0
    if 5 > 3
        if 7 > 6
            t = 42
        end
    end
    check(t, 42)

    t = 0
    if 5 > 9
        if 7 > 6
            t = 1
        end
    end
    check(t, 0)

    # The merged form must still short-circuit: a false left side must not
    # make the right side observable.
    t = 0
    if 3 > 9
        t = 1
    else
        t = t + 100
    end
    check(t, 100)

    # Plain arithmetic must be untouched by all of the above.
    check(a + b, 8)
    check(a - b, 2)
    check(a * b, 15)
    check(b * 4, 12)

    if failed == 0
        println("OPT PEEPHOLE ALL PASS")
        return 0
    end
    println("OPT PEEPHOLE FAILURES")
    return 1
end
