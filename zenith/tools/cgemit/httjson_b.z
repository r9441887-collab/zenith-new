app gui dx11 tool

# Одна функция с http_json на то, чтобы тело хелпера (cg_httpjson.z)
# врезалось именно здесь. Хелпер вшивается один раз на весь переводный
# блок (codegen.h:521), а харнесс эмитит функции по одной в буфер с
# обнулением cgCodeLen — вызов из второй функции указал бы на метку
# первой и rel32 не совпал бы с эталоном. Полноценная проверка второго
# сайта придётся на emitFunction (один буфер на весь блок).
func j1() -> int
  return http_json("https://example.com/index.html")
end
