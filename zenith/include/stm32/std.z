# std: STM32 input and output
#
# Same public surface as the other targets. An STM32 has no console: output
# goes out of a bit-banged UART on a chosen pin, and that pin has to be
# named once, which is why every call here takes it. A program sets it at
# startup and then only passes it around:
#
#   stdSetPin("PA2", 9600)
#   stdOutStr0("ready")
#
# Input is the mirror image: stdSetRxPin names the receive pin, and the
# reader waits for a byte on it.

var stdTxPin: int = 0
var stdRxPin: int = 0
var stdTxReady: int = 0
var stdRxReady: int = 0

# Configure the transmit pin. baud is a compile-time constant for the
# bit-bang timer, so it has to be a literal at the call site.
func stdSetPin(pin: int, baud: int) -> int
    uart_init(pin, baud)
    stdTxPin = pin
    stdTxReady = 1
    return 0
end

func stdSetRxPin(pin: int, baud: int) -> int
    uart_init(pin, baud)
    stdRxPin = pin
    stdRxReady = 1
    return 0
end

# ---- output -------------------------------------------------------------

func stdOutStr0(s: int) -> int
    return uart_print(stdTxPin, s)
end

func stdOutStr(s: int, len: int) -> int
    return uart_print(stdTxPin, s)
end

func stdOutCh(c: int) -> int
    return uart_write(stdTxPin, c)
end

func stdOutLn() -> int
    return uart_println(stdTxPin, "")
end

# The UART backend already formats integers, so this is a pass-through.
func stdOutInt(v: int) -> int
    return uart_print_int(stdTxPin, v)
end

func stdOutUint(v: int) -> int
    if v < 0
        return stdOutInt(v)
    end
    return uart_print_int(stdTxPin, v)
end

# Two decimals, same as the gui target.
func stdOutFloat(f: float) -> int
    var neg: int = 0
    if f < 0.0
        neg = 1
        f = 0.0 - f
    end
    var scaled: int = f * 100.0 + 0.5
    var whole: int = scaled / 100
    var frac: int = scaled % 100
    if neg != 0
        stdOutCh(45)
    end
    stdOutInt(whole)
    stdOutCh(46)
    stdOutCh(48 + (frac / 10))
    stdOutCh(48 + (frac % 10))
    return 0
end

# ---- input --------------------------------------------------------------

# Waits for a byte on the receive pin and returns it.
func stdInByte() -> int
    return uart_read(stdRxPin)
end

func stdInLine(buf: int, maxn: int) -> int
    var i: int = 0
    while i < maxn - 1
        var c: int = stdInByte()
        if c == 13 || c == 10
            memByteW(buf, i, 0)
            return i
        end
        if c == 8
            if i > 0
                i = i - 1
            end
            continue
        end
        if c == 0
            continue
        end
        memByteW(buf, i, c)
        i = i + 1
    end
    memByteW(buf, i, 0)
    return i
end

func stdInInt() -> int
    var c: int = stdInByte()
    while c == 32 || c == 9 || c == 13 || c == 10
        c = stdInByte()
    end
    var neg: int = 0
    if c == 45
        neg = 1
        c = stdInByte()
    end
    var v: int = 0
    while c >= 48 && c <= 57
        v = v * 10 + (c - 48)
        c = stdInByte()
    end
    if neg != 0
        return 0 - v
    end
    return v
end
