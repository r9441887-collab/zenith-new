# std: console / linux input and output
#
# The whole public surface of the Zenith standard library for console
# targets. Programs say `use std` and call these functions; which file
# behind that name gets spliced in is decided by the app type, so the same
# call sites work for a console, a windowed app, EFI or bare metal.
#
# Layering:
#   stdOutInt / stdOutFloat  - number formatting, written in Zenith
#   stdOutStr / stdInByte    - the target-specific syscalls
#
# Byte level only: Zenith strings are pointers, so stdOutStr takes a
# pointer and a length, matching how the language already represents text.

# ---- target layer -------------------------------------------------------

# write(len) bytes at s to stdout. Returns bytes written.
func stdOutStr(s: int, len: int) -> int
    asm {
        mov rdi, 1
        mov rsi, [rbp+24]
        mov rdx, [rbp+32]
        mov rax, 1
        syscall
    }
    return len
end

# read up to len bytes from stdin into s. Returns bytes read.
func stdInStr(s: int, len: int) -> int
    asm {
        mov rdi, 0
        mov rsi, [rbp+24]
        mov rdx, [rbp+32]
        mov rax, 0
        syscall
    }
    return len
end

# ---- output -------------------------------------------------------------

func stdOutCh(c: int) -> int
    var b: int = c
    return stdOutStr(&b, 1)
end

# Print a NUL-terminated string.
func stdOutStr0(s: int) -> int
    var n: int = 0
    while peek8(s + n) != 0
        n = n + 1
    end
    return stdOutStr(s, n)
end

func stdOutInt(v: int) -> int
    var buf: [24]int
    var p: int = &buf
    var i: int = 24
    var x: int = v
    if x < 0
        stdOutCh(45)
        x = 0 - x
    end
    if x == 0
        return stdOutCh(48)
    end
    while x != 0
        i = i - 1
        memByteW(p, i, 48 + (x % 10))
        x = x / 10
    end
    return stdOutStr(p + i, 24 - i)
end

# Print a newline.
func stdOutLn() -> int
    return stdOutCh(10)
end

# Print a float. AArch64 has no float support yet in the backend, so the
# bits are formatted here to keep the console backend usable on both.
func stdOutFloat(f: float) -> int
    var ib: int = f
    var bits: int = memQ(&ib, 0)
    var sign: int = (bits >> 31) & 1
    var expf: int = (bits >> 23) & 0xFF
    var mant: int = bits & 0x7FFFFF
    if sign != 0
        stdOutCh(45)
    end
    if expf == 0 && mant == 0
        return stdOutCh(48)
    end
    var M: int = 0x800000 + mant
    if expf == 0
        M = mant
        expf = 1
    end
    var exp2: int = expf - 150
    if exp2 >= 0
        return stdOutInt(M << exp2)
    end
    var sh: int = 0 - exp2
    if sh >= 60
        return stdOutCh(48)
    end
    stdOutInt(M >> sh)
    var mask: int = (1 << sh) - 1
    var rem: int = M & mask
    stdOutCh(46)
    var n: int = 0
    while n < 6
        rem = rem * 10
        var dig: int = rem >> sh
        stdOutCh(48 + dig)
        rem = rem - (dig << sh)
        n = n + 1
    end
    return 0
end

# ---- input --------------------------------------------------------------

func stdInByte() -> int
    var b: int = 0
    stdInStr(&b, 1)
    return memByte(&b, 0)
end

# Read one line into buf, NUL-terminated and newline stripped.
# Returns the length, or -1 at end of input.
func stdInLine(buf: int, maxn: int) -> int
    var i: int = 0
    var any: int = 0
    while i < maxn - 1
        var c: int = stdInByte()
        if c == 0
            memByteW(buf, i, 0)
            if any == 0
                return 0 - 1
            end
            return i
        end
        if c == 10
            memByteW(buf, i, 0)
            return i
        end
        memByteW(buf, i, c)
        i = i + 1
        any = 1
    end
    memByteW(buf, i, 0)
    return i
end

# Read a decimal integer. Skips leading whitespace; returns 0 at end of input.
func stdInInt() -> int
    var c: int = stdInByte()
    while c == 32 || c == 10 || c == 9 || c == 13
        c = stdInByte()
    end
    var neg: int = 0
    if c == 45
        neg = 1
        c = stdInByte()
    end
    var v: int = 0
    while c >= 48 && c <= 57
        v = v * 10 + (c - 48)
        c = stdInByte()
    end
    if neg != 0
        return 0 - v
    end
    return v
end
