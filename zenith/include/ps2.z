# PS/2 keyboard translation, shared by the bare and bios targets.
#
# kb_get() delivers a raw scancode from set 1 (PC/AT make codes), not a
# character, so turning a key press into text is the program's job. That
# mapping lives here, in Zenith, which also means the layout is not locked
# down: only the scancode->ASCII table is provided, and a program that wants
# Dvorak or a Cyrillic layout is free to supply its own table.
#
# Break codes have bit 7 set and are dropped, so holding a key down
# auto-repeats like a real keyboard.

var ps2Map: [21]int
var ps2Ready: int = 0

# Scancodes 0x1E..0x32 cover the letter block. The gaps in that range are the
# keys that are not letters in that physical position.
func ps2Init() -> int
    if ps2Ready != 0
        return 0
    end
    ps2Ready = 1
    var base: int = &ps2Map
    memByteW(base + 0, 0, 65)    # 1E A
    memByteW(base + 1, 0, 83)    # 1F S
    memByteW(base + 2, 0, 68)    # 20 D
    memByteW(base + 3, 0, 70)    # 21 F
    memByteW(base + 4, 0, 71)    # 22 G
    memByteW(base + 5, 0, 72)    # 23 H
    memByteW(base + 6, 0, 74)    # 24 J
    memByteW(base + 7, 0, 75)    # 25 K
    memByteW(base + 8, 0, 76)    # 26 L
    memByteW(base + 9, 0, 59)    # 27 ;
    memByteW(base + 10, 0, 39)   # 28 '
    memByteW(base + 11, 0, 96)   # 29 `
    memByteW(base + 12, 0, 0)    # 2A LShift
    memByteW(base + 13, 0, 92)   # 2B backslash
    memByteW(base + 14, 0, 90)   # 2C Z
    memByteW(base + 15, 0, 88)   # 2D X
    memByteW(base + 16, 0, 67)   # 2E C
    memByteW(base + 17, 0, 86)   # 2F V
    memByteW(base + 18, 0, 66)   # 30 B
    memByteW(base + 19, 0, 78)   # 31 N
    memByteW(base + 20, 0, 77)   # 32 M
    return 0
end

# Translate one set 1 make code to ASCII. Returns 0 for keys that produce no
# text (shift, ctrl, arrows, function keys, ...).
func ps2Key(sc: int) -> int
    ps2Init()
    if (sc & 128) != 0
        return 0
    end
    # Number row: 0x02..0x0A are '1'..'9', then '0' '-', '=', backspace, tab.
    if sc >= 0x02 && sc <= 0x0A
        return sc + 47
    end
    if sc == 0x0B
        return 48
    end
    if sc == 0x0C
        return 45
    end
    if sc == 0x0D
        return 61
    end
    if sc == 0x0E
        return 8
    end
    if sc == 0x0F
        return 9
    end
    if sc == 0x1C
        return 10
    end
    if sc == 0x33
        return 44
    end
    if sc == 0x34
        return 46
    end
    if sc == 0x35
        return 47
    end
    if sc == 0x39
        return 32
    end
    # Letter block 0x1E..0x32, including the non-letter keys in its gaps.
    if sc >= 0x1E && sc <= 0x32
        return memByte(&ps2Map, sc - 0x1E)
    end
    return 0
end

# Blocking: wait for a key press and return it as ASCII, 0 for a non-text key.
func stdKbGet() -> int
    while kb_hit() == 0
        hlt()
    end
    return ps2Key(kb_get())
end
