app linux

var ztioFlt: float = 0.0
var ztioBits: int = 0

func zOutCh(c: int) -> int
    var b: int = c
    return zOutStr(&b, 1)
end

func zOutStr(s: int, len: int) -> int
    asm {
        mov rdi, 1
        mov rsi, [rbp+24]
        mov rdx, [rbp+32]
        mov rax, 1
        syscall
    }
    return 0
end

func zOutInt(v: int) -> int
    var buf: [24]int
    var p: int = &buf
    var i: int = 24
    var x: int = v
    if x < 0
        zOutCh(45)
        x = 0 - x
    end
    if x == 0
        zOutCh(48)
        return 0
    end
    while x != 0
        i = i - 1
        memByteW(p, i, 48 + (x % 10))
        x = x / 10
    end
    return zOutStr(p + i, 24 - i)
end

func zOutLn() -> int
    return zOutCh(10)
end

func zOutFloatBits(bits: int) -> int
    var sign: int = (bits >> 31) & 1
    var expf: int = (bits >> 23) & 0xFF
    var mant: int = bits & 0x7FFFFF
    if sign != 0
        zOutCh(45)
    end
    if expf == 0 && mant == 0
        zOutCh(48)
        return 0
    end
    var M: int = 0x800000 + mant
    if expf == 0
        M = mant
        expf = 1
    end
    var exp2: int = expf - 150
    if exp2 >= 0
        zOutInt(M << exp2)
    else
        var sh: int = 0 - exp2
        if sh >= 60
            zOutCh(48)
        else
            zOutInt(M >> sh)
            var mask: int = (1 << sh) - 1
            var rem: int = M & mask
            zOutCh(46)
            var n: int = 0
            while n < 6
                rem = rem * 10
                var dig: int = rem >> sh
                zOutCh(48 + dig)
                rem = rem - (dig << sh)
                n = n + 1
            end
        end
    end
    return 0
end

func zOutFloat(f: float) -> int
    var ib: int = f
    var bits: int = memQ(&ib, 0)
    return zOutFloatBits(bits)
end

func _ztR(addr: int, len: int) -> int
    asm {
        mov rdi, 0
        mov rsi, [rbp+24]
        mov rdx, [rbp+32]
        mov rax, 0
        syscall
    }
    return 0
end

func zInByte() -> int
    var b: int = 0
    _ztR(&b, 1)
    return memByte(&b, 0)
end

func zInLine(buf: int, maxn: int) -> int
    var i: int = 0
    while i < maxn
        var c: int = zInByte()
        if c == 10 || c == 0
            memByteW(buf, i, 0)
            return i
        end
        memByteW(buf, i, c)
        i = i + 1
    end
    memByteW(buf, i - 1, 0)
    return i
end

func zInWord(buf: int, maxn: int) -> int
    var i: int = 0
    var c: int = zInByte()
    while c == 32 || c == 9 || c == 10 || c == 13 || c == 0
        c = zInByte()
    end
    while c >= 33 && c <= 126 && i < maxn
        memByteW(buf, i, c)
        i = i + 1
        c = zInByte()
    end
    memByteW(buf, i, 0)
    return i
end

func zInInt() -> int
    var acc: int = 0
    var neg: int = 0
    var c: int = zInByte()
    while c == 32 || c == 9 || c == 10 || c == 13 || c == 0
        c = zInByte()
    end
    if c == 45
        neg = 1
        c = zInByte()
    end
    var got: int = 0
    while c >= 48 && c <= 57
        acc = acc * 10 + (c - 48)
        got = 1
        c = zInByte()
    end
    if got != 0 && neg != 0
        acc = 0 - acc
    end
    if got == 0
        acc = 0
    end
    return acc
end

func zBuildFlt(v: int, p: int, neg: int) -> int
    var dv: float = 0.0 + v
    var dp: float = 0.0 + p
    var res: float = 0.0
    res = dv / dp
    if neg != 0
        var z: float = 0.0
        res = z - res
    end
    var ib: int = res
    var bits: int = memQ(&ib, 0)
    ztioFlt = res
    ztioBits = bits
    return 0
end

func zInFloat() -> int
    var acc: int = 0
    var neg: int = 0
    var frac: int = 0
    var c: int = zInByte()
    while c == 32 || c == 9 || c == 10 || c == 13 || c == 0
        c = zInByte()
    end
    if c == 45
        neg = 1
        c = zInByte()
    end
    var got: int = 0
    while c >= 48 && c <= 57
        acc = acc * 10 + (c - 48)
        got = 1
        c = zInByte()
    end
    if c == 46
        c = zInByte()
        while c >= 48 && c <= 57
            acc = acc * 10 + (c - 48)
            frac = frac + 1
            c = zInByte()
        end
    end
    var p: int = 1
    var k: int = 0
    while k < frac
        p = p * 10
        k = k + 1
    end
    if got != 0
        zBuildFlt(acc, p, neg)
    else
        ztioFlt = 0.0
        ztioBits = 0
    end
    return 0
end

func zInFloatBits() -> int
    return ztioBits
end

