# std: EFI input and output
#
# Same public surface as the other targets. Under EFI the console is the UEFI
# Graphics Output Protocol, so output is drawn into the framebuffer with
# gop_print rather than written to a byte stream, and input comes from the
# UEFI keyboard via efi_check_key / efi_get_char.
#
# The cursor advances across the screen and wraps to the next line, which is
# what makes a sequence of stdOutStr0 calls look like ordinary output.

var stdX: int = 8
var stdY: int = 8
var stdColH: int = 16
var stdReady: int = 0

func stdInit() -> int
    if stdReady == 0
        stdReady = 1
        gop_init()
    end
    return 0
end

# Move to the next line, scrolling by restarting at the top once the bottom
# is reached: the framebuffer is not scrolled by the protocol.
func stdNewline() -> int
    stdX = 8
    stdY = stdY + stdColH
    if stdY > 560
        stdY = 8
    end
    return 0
end

# ---- output -------------------------------------------------------------

func stdOutStr0(s: int) -> int
    return stdOutStr(s, 0)
end

# len == 0 means NUL-terminated, matching the console target.
func stdOutStr(s: int, len: int) -> int
    stdInit()
    gop_print(stdX, stdY, s, 0x00FFFFFF, 0x00000000)
    if len == 0
        len = 0
        while peek8(s + len) != 0
            len = len + 1
        end
    end
    stdX = stdX + (len * 8)
    if stdX > 1000
        stdNewline()
    end
    return len
end

func stdOutCh(c: int) -> int
    stdInit()
    if c == 10
        return stdNewline()
    end
    return stdOutChAt(stdX, stdY, c)
end

func stdOutChAt(x: int, y: int, c: int) -> int
    gop_char(x, y, c, 0x00FFFFFF, 0x00000000)
    stdX = stdX + 8
    if stdX > 1000
        stdNewline()
    end
    return 0
end

func stdOutUint(v: int) -> int
    var buf: [24]int
    var p: int = &buf
    var i: int = 24
    var x: int = v
    if x == 0
        return stdOutCh(48)
    end
    while x != 0
        i = i - 1
        memByteW(p, i, 48 + (x % 10))
        x = x / 10
    end
    return stdOutStr(p + i, 24 - i)
end

func stdOutInt(v: int) -> int
    if v < 0
        stdOutCh(45)
        return stdOutUint(0 - v)
    end
    return stdOutUint(v)
end

# Two decimals, same as the gui target.
func stdOutFloat(f: float) -> int
    var neg: int = 0
    if f < 0.0
        neg = 1
        f = 0.0 - f
    end
    var scaled: int = f * 100.0 + 0.5
    var whole: int = scaled / 100
    var frac: int = scaled % 100
    if neg != 0
        stdOutCh(45)
    end
    stdOutInt(whole)
    stdOutCh(46)
    stdOutCh(48 + (frac / 10))
    stdOutCh(48 + (frac % 10))
    return 0
end

func stdOutLn() -> int
    return stdOutCh(10)
end

# ---- input --------------------------------------------------------------

# Blocks until a key is available and returns its ASCII code.
func stdInByte() -> int
    while efi_check_key() == 0
        hlt()
    end
    return efi_get_char()
end

func stdInLine(buf: int, maxn: int) -> int
    var i: int = 0
    while i < maxn - 1
        var c: int = stdInByte()
        if c == 13 || c == 10
            memByteW(buf, i, 0)
            return i
        end
        memByteW(buf, i, c)
        i = i + 1
    end
    memByteW(buf, i, 0)
    return i
end

func stdInInt() -> int
    var c: int = stdInByte()
    while c == 32 || c == 10 || c == 9 || c == 13
        c = stdInByte()
    end
    var neg: int = 0
    if c == 45
        neg = 1
        c = stdInByte()
    end
    var v: int = 0
    while c >= 48 && c <= 57
        v = v * 10 + (c - 48)
        c = stdInByte()
    end
    if neg != 0
        return 0 - v
    end
    return v
end
