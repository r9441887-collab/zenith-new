# src/cg_type.z — типы ZAST: раскладки, таблица переменных, кадр, exprType.
# Семантика программного кода: типы (кольцо scratch-слотов), раскладки
# структур, таблица переменных (локальные/глобальные/поля), свёртка кадра
# (`cgTypeSetupFrame` пишет `cgSpillBase` эмиттера), а также те
# предикаты, по которым выражения спрашивают про типы: `cgExprType`,
# cgIsFloatExpr, callee kind, structValueQwords.
#
# Слой стоит выше эмиттера, потому что именно он решает, какая операция
# и с какой шириной будет закодирована; ниже выражений, потому что
# обход AST спрашивает о типах, но типы не ходят по AST.
#
# Use-chain (strictly linear — parseRun does not dedup spliced modules, so a
# diamond `use` prints "Duplicate function" and the layering would rot):
#
#   codegen.z -> cg_elf.z -> cg_expr.z -> cg_type.z -> cg_httpjson.z -> cg_emit.z -> cg_zast.z
#
# every arrow is a real dependency of the upper layer on the lower one;
# each module is `use`d exactly once in the whole tree.

use cg_httpjson

# ===================== type system =====================
#
# A ZAST Type is exactly TYPEW=6 consecutive words:
#   [kind, structName strId, isPtr, addrSpace, arraySize, fnSigId]
# (selfhost/ast.z azTypePush). Values already live contiguously in the side
# section for struct fields / var decls / func returns, so `.z` passes them
# around as a pointer to those 6 words instead of copying a struct around.

# enum class TypeKind in src/ast.h (declaration order)
const TK_INT: int = 0
const TK_FLOAT: int = 1
const TK_BOOL: int = 2
const TK_VOID: int = 3
const TK_STRING: int = 4
const TK_VEC2: int = 5
const TK_VEC3: int = 6
const TK_COLOR: int = 7
const TK_ENTITY: int = 8
const TK_STRUCT: int = 9
const TK_FUNCPTR: int = 10

const CG_TYPEW: int = 6

func cgTk(t: int) -> int
    return peek32(t)
end

func cgTStruct(t: int) -> int
    return peek32(t + 4)
end

func cgTIsPtr(t: int) -> int
    return peek32(t + 8)
end

func cgTArr(t: int) -> int
    return peek32(t + 16)
end

# make a scratch type (returns a pointer to 6 writable words)
var cgTyScratch: [48]int

func cgTySet(kind: int, name: int, isPtr: int)
    poke32(&cgTyScratch, kind)
    poke32(&cgTyScratch + 4, name)
    poke32(&cgTyScratch + 8, isPtr)
    poke32(&cgTyScratch + 12, 0)
    poke32(&cgTyScratch + 16, 0)
    poke32(&cgTyScratch + 20, 0)
end

# ===================== struct layouts =====================
#
# structLayouts in codegen.h is a map<name, {totalSize, fieldOffsets,
# fieldTypes}>. Here it is three flat tables: one row per struct and one row
# per field. fieldTypes point straight at the 6 type words in the ZAST side
# section, so no type is ever copied.

const CG_SL_MAX: int = 512
const CG_SLF_MAX: int = 8192

var cgSlN: int = 0
var cgSlName: [512]int
var cgSlSize: [512]int
var cgSlFStart: [512]int
var cgSlFN: [512]int
var cgSlFStruct: [8192]int
var cgSlFName: [8192]int
var cgSlFOff: [8192]int
var cgSlFKind: [8192]int
var cgSlFPtr: [8192]int
var cgSlFType: [8192]int

# index of the struct named `name`, or -1
func cgSlFind(name: int) -> int
    var s: int = 0
    while s < cgSlN
        if cgStrIdsEq(cgSlName[s], name) == 1
            return s
        end
        s = s + 1
    end
    return -1
end

# field row index for struct `s` + field name, or -1
func cgSlField(s: int, name: int) -> int
    if s < 0 || s >= cgSlN
        return -1
    end
    var i: int = 0
    var f0: int = cgSlFStart[s]
    while i < cgSlFN[s]
        var f: int = f0 + i
        if f >= 0 && f < CG_SLF_MAX && cgStrIdsEq(cgSlFName[f], name) == 1
            return f
        end
        i = i + 1
    end
    return -1
end

# Program::classIDs (codegen.cpp:1849): имя структуры -> runtime class id.
# ZAST хранит их плоскими парами (strId, id) в H_CLASSIDS. -1 = класс id не
# получил, и тогда инициализатор локального пропускает запись в __classid.
func cgClassIdFind(name: int) -> int
    var cs: int = cgH(H_CLASSIDS)
    var cl: int = cgH(H_CLASSIDS + 1)
    var i: int = 0
    while i + 1 < cl
        if cgStrIdsEq(cgSide(cs + i), name) == 1
            return cgSide(cs + i + 1)
        end
        i = i + 2
    end
    return -1
end

func cgComputeStructLayouts()
    cgSlN = 0
    var fs: int = cgH(H_STRUCTS)
    var fl: int = cgH(H_STRUCTS + 1)
    var nextField: int = 0
    var i: int = 0
    while i < fl
        var sid: int = cgSide(fs + i)
        if cgTag(sid) == N_STRUCT && cgSlN < CG_SL_MAX
            var si: int = cgSlN
            cgSlN = cgSlN + 1
            cgSlName[si] = cgF(sid, 0)
            cgSlSize[si] = 0
            cgSlFStart[si] = nextField
            cgSlFN[si] = 0
            var start: int = cgF(sid, 1)
            var len: int = cgF(sid, 2)
            var j: int = 0
            while j < len && nextField < CG_SLF_MAX
                var w: int = start + j
                cgSlFStruct[nextField] = si
                cgSlFName[nextField] = cgSide(w)
                cgSlFType[nextField] = cgSideBase + (w + 1) * 4
                cgSlFKind[nextField] = cgSide(w + 1)
                cgSlFPtr[nextField] = cgSide(w + 3)
                cgSlFOff[nextField] = 0
                nextField = nextField + 1
                cgSlFN[si] = cgSlFN[si] + 1
                j = j + CG_TYPEW + 1
            end
        end
        i = i + 1
    end

    # Tentative layouts, resolved iteratively so struct-typed fields can use
    # the final totalSize of nested structs (8 passes, as in codegen.cpp).
    var word: int = 8
    if cgWordSize == 32
        word = 4
    end
    var pass: int = 0
    while pass < 8
        var changed: int = 0
        var s: int = 0
        while s < cgSlN
            var offset: int = 0
            var fi: int = 0
            while fi < cgSlFN[s]
                var f: int = cgSlFStart[s] + fi
                var isPtr: int = 0
                var kind: int = 0
                if f >= 0 && f < CG_SLF_MAX
                    isPtr = cgSlFPtr[f]
                    kind = cgSlFKind[f]
                end
                var fieldSize: int = 0
                if isPtr != 0
                    # ptr<T> is always a word
                    fieldSize = word
                else if kind == TK_INT
                    fieldSize = word
                else if kind == TK_FLOAT
                    fieldSize = 4
                else if kind == TK_BOOL
                    fieldSize = 4
                else if kind == TK_VEC2
                    fieldSize = 8
                else if kind == TK_VEC3
                    fieldSize = 12
                else if kind == TK_COLOR
                    fieldSize = 16
                else if kind == TK_STRUCT
                    fieldSize = word
                    var ns: int = cgSlFind(cgTStruct(cgSlFType[f]))
                    if ns >= 0
                        fieldSize = cgSlSize[ns]
                    end
                else
                    fieldSize = word
                end
                if fieldSize > 0 && offset % fieldSize != 0
                    offset = offset + fieldSize - (offset % fieldSize)
                end
                if f >= 0 && f < CG_SLF_MAX && cgSlFOff[f] != offset
                    cgSlFOff[f] = offset
                    changed = 1
                end
                offset = offset + fieldSize
                fi = fi + 1
            end
            if s >= 0 && s < CG_SL_MAX && cgSlSize[s] != offset
                cgSlSize[s] = offset
                changed = 1
            end
            s = s + 1
        end
        if changed == 0
            pass = 8
        end
        pass = pass + 1
    end
end

func cgStructTypeSize(t: int) -> int
    if cgTIsPtr(t) != 0
        return 8
    end
    var kind: int = cgTk(t)
    if kind == TK_VEC2
        return 8
    end
    if kind == TK_VEC3
        return 12
    end
    if kind == TK_COLOR
        return 16
    end
    if kind == TK_STRUCT
        var nm: int = cgTStruct(t)
        if nm == 0
            return 0
        end
        var it: int = cgSlFind(nm)
        if it >= 0
            return cgSlSize[it]
        end
        return 0
    end
    return 0
end

func cgArrayElemStride(t: int) -> int
    if cgWordSize == 32
        # 32-bit: pointers/scalars are one word, structs round to 4 bytes
        if cgTk(t) == TK_STRUCT
            var nm: int = cgTStruct(t)
            if nm != 0
                var sz: int = 0
                var it: int = cgSlFind(nm)
                if it >= 0
                    sz = cgSlSize[it]
                end
                if sz <= 0
                    return 4
                end
                if sz % 4 != 0
                    sz = sz + 4 - (sz % 4)
                end
                return sz
            end
        end
        if cgTk(t) == TK_VEC2
            return 8
        end
        if cgTk(t) == TK_VEC3
            return 12
        end
        if cgTk(t) == TK_COLOR
            return 16
        end
        return 4
    end
    if cgTIsPtr(t) != 0
        return 8
    end
    if cgTk(t) == TK_FLOAT
        return 4
    end
    if cgTk(t) == TK_STRUCT
        var nm2: int = cgTStruct(t)
        if nm2 != 0
            var sz2: int = 0
            var it2: int = cgSlFind(nm2)
            if it2 >= 0
                sz2 = cgSlSize[it2]
            end
            if sz2 <= 0
                return 8
            end
            if sz2 % 8 != 0
                sz2 = sz2 + 8 - (sz2 % 8)
            end
            return sz2
        end
    end
    return 8
end

# ===================== variable table =====================
#
# varInfos in codegen.h is a map<string, VarInfo{offset,type,isGlobal,isConst,
# arraySize}>; one flat row per variable, type stored as a pointer to 6 ZAST
# words.

const CG_VI_MAX: int = 8192

var cgViN: int = 0
var cgViName: [8192]int
var cgViOff: [8192]int
var cgViType: [8192]int
var cgViGlobal: [8192]int
var cgViConst: [8192]int
var cgViArr: [8192]int

func cgVarClear()
    cgViN = 0
end

func cgVarFind(name: int) -> int
    var i: int = 0
    while i < cgViN
        if i < CG_VI_MAX && cgStrIdsEq(cgViName[i], name) == 1
            return i
        end
        i = i + 1
    end
    return -1
end

# returns the row index (replacing an existing row of the same name)
func cgVarPut(name: int, off: int, t: int, isGlobal: int, isConst: int, arr: int) -> int
    var i: int = cgVarFind(name)
    if i < 0
        if cgViN >= CG_VI_MAX
            return -1
        end
        i = cgViN
        cgViN = cgViN + 1
    end
    if i < 0 || i >= CG_VI_MAX
        return -1
    end
    cgViName[i] = name
    cgViOff[i] = off
    cgViType[i] = t
    cgViGlobal[i] = isGlobal
    cgViConst[i] = isConst
    cgViArr[i] = arr
    return i
end

# field address of node id (for fields that hold a whole Type, e.g. a
# VarDecl's f1..f6) — the 6 words are contiguous there, so a Type can be
# passed around as this pointer
func cgFAddr(id: int, f: int) -> int
    return cgNodeBase + id * CG_NODE_BYTES + (2 + f) * 4
end

# Port of Codegen::populateGlobalVarInfos (codegen.cpp:1788). The backend
# lays the user globals out in .data first (for ELF:
# cgBuildLinuxImportData -> cgGoName/cgGoOff/cgGoN, which IS
# globalOffsets), and this re-registers them in the per-function var table
# from the H_GLOBALS list. Globals whose name the backend did not lay out
# (impossible once buildImportData ran, but reachable from a smoke test that
# never called it) are simply skipped, exactly like C++ `find == end`.
func cgPopulateGlobalVarInfos()
    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    var i: int = 0
    while i < gl
        var gid: int = cgSide(gs + i)
        if gid != 0
            var gi: int = cgGoFind(cgF(gid, 0))
            if gi >= 0
                cgVarPut(cgF(gid, 0), cgGoOff[gi], cgFAddr(gid, 1), 1, cgF(gid, 9), cgF(gid, 8))
            end
        end
        i = i + 1
    end
end

# scratch type that always reads as TypeKind::Int (all-zero words)
var cgTyIntT: [6]int

# per-function frame bookkeeping (codegen.cpp `locals`)
var cgLocals: int = 0
var cgParamBytes: int = 0
var cgSpillArea: int = 0
var cgFrameSize: int = 0

# Port of Codegen::allocateBlockVars: reserve one frame slot per local
# declaration, in declaration order, recursing into nested blocks. `start`/`len`
# is a side list of statement node ids (there is no Block node in ZAST — a
# block IS its side list).
func cgAllocStmts(start: int, len: int)
    var i: int = 0
    while i < len
        var sid: int = cgSide(start + i)
        if sid != 0
            var t: int = cgTag(sid)
            if t == N_VARDECL
                var fsz: int = 8
                var tp: int = cgFAddr(sid, 1)
                var arr: int = cgF(sid, 8)
                if arr > 0
                    fsz = cgArrayElemStride(tp) * arr
                else
                    if cgTk(tp) == TK_STRUCT && cgTIsPtr(tp) == 0
                        var it: int = cgSlFind(cgTStruct(tp))
                        if it >= 0
                            fsz = cgSlSize[it]
                            if fsz % 8 != 0
                                fsz = fsz + 8 - (fsz % 8)
                            end
                        end
                    else
                        if cgTk(tp) == TK_BOOL && cgTIsPtr(tp) == 0
                            fsz = 4
                        else
                            if cgTk(tp) == TK_FLOAT && cgTIsPtr(tp) == 0
                                fsz = 4
                            else
                                if cgTk(tp) == TK_VEC2
                                    fsz = 8
                                else
                                    if cgTk(tp) == TK_VEC3
                                        fsz = 12
                                        if fsz % 8 != 0
                                            fsz = fsz + 8 - (fsz % 8)
                                        end
                                    else
                                        if cgTk(tp) == TK_COLOR
                                            fsz = 16
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                cgLocals = cgLocals + fsz
                cgVarPut(cgF(sid, 0), -cgLocals, tp, 0, cgF(sid, 9), arr)
            else if t == N_FOR
                if cgVarFind(cgF(sid, 0)) < 0
                    cgLocals = cgLocals + 8
                    cgVarPut(cgF(sid, 0), -cgLocals, &cgTyIntT, 0, 0, 0)
                end
                cgAllocStmts(cgF(sid, 4), cgF(sid, 5))
            else if t == N_IF
                cgAllocStmts(cgF(sid, 1), cgF(sid, 2))
                cgAllocStmts(cgF(sid, 3), cgF(sid, 4))
            else if t == N_WHILE
                cgAllocStmts(cgF(sid, 1), cgF(sid, 2))
            else if t == N_LOOP
                cgAllocStmts(cgF(sid, 0), cgF(sid, 1))
            else if t == N_SWITCH
                var cs: int = cgF(sid, 1)
                var cl: int = cgF(sid, 2)
                var j: int = 0
                while j < cl
                    cgAllocStmts(cgSide(cs + j + 1), cgSide(cs + j + 2))
                    j = j + 3
                end
            end
        end
        i = i + 1
    end
end

const CG_PARAM_MAX: int = 4096
var cgPSSlots: [4096]int

# Codegen::curFuncRetType / funcEndLabel, both owned by emitFunction. The
# driver sets cgFuncEndLabel to the label of the function epilogue (-1 = no
# jump, e.g. when emitting a body in isolation); cgSetupFunc fills in the
# return type from the N_FUNC node.
var cgCurFuncRetType: int = 0
var cgFuncEndLabel: int = -1

# Port of the frame setup at the top of Codegen::emitFunction (the part that
# only touches varInfos/locals, not the code buffer): clear the var table,
# lay out the parameters in the caller-provided slots below rbp, allocate the
# body's locals, then reserve the spill area. Returns 0 on ok.
func cgSetupFunc(fid: int) -> int
    cgVarClear()
    # emitFunction (codegen.cpp:7657) re-registers the globals right after
    # clearing varInfos and BEFORE laying out the params — keep that order.
    cgPopulateGlobalVarInfos()
    cgLabelStacksReset()
    cgLocals = 0
    cgParamBytes = 0
    cgCurFuncRetType = cgFAddr(fid, 3)
    var ps: int = cgF(fid, 1)
    var pl: int = cgF(fid, 2)
    var n: int = pl / 7
    if n > CG_PARAM_MAX
        n = CG_PARAM_MAX
    end
    var k: int = 0
    var paramBytes: int = 0
    while k < n
        var w: int = ps + k * 7
        var sl: int = 1
        var tp: int = cgSideBase + (w + 1) * 4
        if cgTk(tp) == TK_STRUCT && cgTIsPtr(tp) == 0
            var it: int = cgSlFind(cgTStruct(tp))
            if it >= 0
                sl = (cgSlSize[it] + 7) / 8
                if sl < 1
                    sl = 1
                end
            end
        end
        cgPSSlots[k] = sl
        paramBytes = paramBytes + sl * 8
        k = k + 1
    end
    cgParamBytes = paramBytes
    cgLocals = paramBytes
    var paramSlot: int = 0
    k = 0
    while k < n
        var w2: int = ps + k * 7
        var off: int = -(paramBytes - paramSlot * 8)
        cgVarPut(cgSide(w2), off, cgSideBase + (w2 + 1) * 4, 0, 0, 0)
        paramSlot = paramSlot + cgPSSlots[k]
        k = k + 1
    end
    cgAllocStmts(cgF(fid, 9), cgF(fid, 10))
    cgSpillBase = cgLocals + 8
    cgLocals = cgLocals + 48
    cgFrameSize = ((cgLocals + 15) / 16) * 16 + 8
    return 0
end

# ===================== transient Type scratch =====================
#
# C++ `Type exprType(Expr*)` returns by value; `.z` cannot, so Types live in a
# rotating ring of scratch slots. A slot is only valid until 256 further
# cgTyMake/cgExprType calls, which is far beyond what any expression's
# immediate consumers use.

const CG_TYRING: int = 256
var cgTyRing: [1536]int
var cgTyRingI: int = 0

func cgTyNew() -> int
    var k: int = cgTyRingI % CG_TYRING
    cgTyRingI = cgTyRingI + 1
    return &cgTyRing + k * 6
end

func cgTyMake(kind: int, name: int, isPtr: int, arr: int) -> int
    var t: int = cgTyNew()
    poke32(t, kind)
    poke32(t + 4, name)
    poke32(t + 8, isPtr)
    poke32(t + 12, 0)
    poke32(t + 16, arr)
    poke32(t + 20, 0)
    return t
end

func cgTyCopy(src: int) -> int
    var t: int = cgTyNew()
    if src == 0
        poke32(t, 3)
        poke32(t + 4, 0)
        poke32(t + 8, 0)
        poke32(t + 12, 0)
        poke32(t + 16, 0)
        poke32(t + 20, 0)
        return t
    end
    poke32(t, peek32(src))
    poke32(t + 4, peek32(src + 4))
    poke32(t + 8, peek32(src + 8))
    poke32(t + 12, peek32(src + 12))
    poke32(t + 16, peek32(src + 16))
    poke32(t + 20, peek32(src + 20))
    return t
end

# Type::isFuncPtr() == (kind == FuncPtr && isPtr)
func cgIsFuncPtr(t: int) -> int
    if t == 0
        return 0
    end
    if cgTk(t) == TK_FUNCPTR && cgTIsPtr(t) != 0
        return 1
    end
    return 0
end

# FuncPtrSig layout: [nparams, params…(TYPEW each), ret…(TYPEW each)]
# -> pointer to the return type's 6 words
func cgSigRet(sigId: int) -> int
    var n: int = peek32(cgSigBase + sigId)
    return cgSigBase + sigId + 4 + n * CG_TYPEW * 4
end

# return type (pointer to 6 words) of the function named `name`, or 0
func cgFuncRetType(name: int) -> int
    var fs: int = cgH(H_FUNCS)
    var fl: int = cgH(H_FUNCS + 1)
    var i: int = 0
    while i < fl
        var fid: int = cgSide(fs + i)
        if cgTag(fid) == N_FUNC && cgStrIdsEq(cgF(fid, 0), name) == 1
            return cgTyCopy(cgFAddr(fid, 3))
        end
        i = i + 1
    end
    return 0
end

# ===================== exprType =====================

# Port of Codegen::exprType (codegen.cpp:1306). Returns a Type scratch slot.
func cgExprType(e: int) -> int
    if e == 0
        return cgTyMake(TK_VOID, 0, 0, 0)
    end
    var tg: int = cgTag(e)
    if tg == N_NUMBER
        return cgTyMake(TK_INT, 0, 0, 0)
    end
    if tg == N_FLOAT
        return cgTyMake(TK_FLOAT, 0, 0, 0)
    end
    if tg == N_STRING
        return cgTyMake(TK_STRING, 0, 0, 0)
    end
    if tg == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi >= 0
            return cgViType[vi]
        end
        return cgTyMake(TK_VOID, 0, 0, 0)
    end
    if tg == N_MEMBER
        var rev: [256]int
        var rn: int = 0
        var cur: int = e
        while cgTag(cur) == N_MEMBER
            if rn < 256
                rev[rn] = cgF(cur, 1)
            end
            rn = rn + 1
            cur = cgF(cur, 0)
        end
        var t: int = cgExprType(cur)
        if cgTk(t) != TK_STRUCT || cgTStruct(t) == 0
            return cgTyMake(TK_VOID, 0, 0, 0)
        end
        var curName: int = cgTStruct(t)
        var ft: int = 0
        var k: int = rn - 1
        while k >= 0
            var si: int = cgSlFind(curName)
            if si < 0
                return cgTyMake(TK_VOID, 0, 0, 0)
            end
            var fr: int = cgSlField(si, rev[k])
            if fr < 0
                return cgTyMake(TK_VOID, 0, 0, 0)
            end
            ft = cgSlFType[fr]
            curName = cgTStruct(ft)
            k = k - 1
        end
        if ft == 0
            return cgTyMake(TK_VOID, 0, 0, 0)
        end
        return cgTyCopy(ft)
    end
    if tg == N_ARRAYACC
        var arr0: int = cgF(e, 0)
        if cgTag(arr0) == N_IDENT
            var vi2: int = cgVarFind(cgF(arr0, 0))
            if vi2 >= 0 && cgViArr[vi2] > 0
                return cgViType[vi2]
            end
        end
        var t2: int = cgExprType(arr0)
        var r: int = cgTyCopy(t2)
        poke32(r + 8, 0)
        return r
    end
    if tg == N_DEREF
        var t3: int = cgExprType(cgF(e, 0))
        var r2: int = cgTyCopy(t3)
        poke32(r2 + 8, 0)
        return r2
    end
    if tg == N_CALL
        var fr2: int = cgFuncRetType(cgF(e, 0))
        if fr2 != 0
            return fr2
        end
        return cgTyMake(TK_VOID, 0, 0, 0)
    end
    if tg == N_ADDROF
        var t4: int = 0
        if cgF(e, 1) != 0
            t4 = cgExprType(cgF(e, 1))
        else
            var vi3: int = cgVarFind(cgF(e, 0))
            if vi3 >= 0
                t4 = cgViType[vi3]
            end
        end
        var r3: int = cgTyCopy(t4)
        poke32(r3 + 8, 1)
        return r3
    end
    if tg == N_BINARY
        var op: int = cgF(e, 2)
        if cgStrIs(op, "==") == 1 || cgStrIs(op, "!=") == 1 || cgStrIs(op, "<") == 1 || cgStrIs(op, ">") == 1 || cgStrIs(op, "<=") == 1 || cgStrIs(op, ">=") == 1
            return cgTyMake(TK_BOOL, 0, 0, 0)
        end
        if cgIsFloatExpr(e) == 1
            return cgTyMake(TK_FLOAT, 0, 0, 0)
        end
        return cgTyMake(TK_INT, 0, 0, 0)
    end
    if tg == N_UNARY
        if cgIsFloatExpr(e) == 1
            return cgTyMake(TK_FLOAT, 0, 0, 0)
        end
        return cgTyMake(TK_INT, 0, 0, 0)
    end
    return cgTyMake(TK_VOID, 0, 0, 0)
end

# ===================== callee kind =====================
#
# Codegen::callCalleeKind: 0 = direct call by name, 1 = call through a
# function-pointer variable (name returned in cgCalleeVar), 2 = indirect call
# through a receiver expression.

var cgCalleeVar: int = 0

func cgCallCalleeKind(c: int) -> int
    cgCalleeVar = 0
    if c == 0
        return 0
    end
    if cgF(c, 1) != 0
        var memb: int = cgF(c, 1)
        if cgTag(memb) != N_MEMBER
            return 0
        end
        var ft: int = cgExprType(memb)
        if cgIsFuncPtr(ft) == 1
            return 2
        end
        return 0
    end
    var vi: int = cgVarFind(cgF(c, 0))
    if vi >= 0
        if cgIsFuncPtr(cgViType[vi]) == 1
            cgCalleeVar = cgF(c, 0)
            return 1
        end
    end
    return 0
end

# ===================== isFloatExpr =====================

# math intrinsics that always produce a float (codegen.cpp:1138)
func cgIsMathFloatCall(name: int) -> int
    if cgStrIs(name, "sqrt") == 1 || cgStrIs(name, "abs") == 1 || cgStrIs(name, "floor") == 1 || cgStrIs(name, "ceil") == 1 || cgStrIs(name, "trunc") == 1 || cgStrIs(name, "neg") == 1 || cgStrIs(name, "sin") == 1 || cgStrIs(name, "cos") == 1 || cgStrIs(name, "tan") == 1 || cgStrIs(name, "atan2") == 1 || cgStrIs(name, "min") == 1 || cgStrIs(name, "max") == 1 || cgStrIs(name, "fmod") == 1 || cgStrIs(name, "pow") == 1 || cgStrIs(name, "itof") == 1
        return 1
    end
    return 0
end

# Port of Codegen::isFloatExpr (codegen.cpp:1080).
func cgIsFloatExpr(e: int) -> int
    if e == 0
        return 0
    end
    var tg: int = cgTag(e)
    if tg == N_FLOAT
        return 1
    end
    if tg == N_NUMBER
        return 0
    end
    if tg == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi >= 0
            if cgTk(cgViType[vi]) == TK_FLOAT && cgTIsPtr(cgViType[vi]) == 0
                return 1
            end
        end
        return 0
    end
    if tg == N_MEMBER
        var rev: [256]int
        var rn: int = 0
        var cur: int = e
        while cgTag(cur) == N_MEMBER
            if rn < 256
                rev[rn] = cgF(cur, 1)
            end
            rn = rn + 1
            cur = cgF(cur, 0)
        end
        if cgTag(cur) == N_IDENT
            var vi2: int = cgVarFind(cgF(cur, 0))
            if vi2 >= 0 && cgTk(cgViType[vi2]) == TK_STRUCT
                var curName: int = cgTStruct(cgViType[vi2])
                var ok: int = 1
                var ft: int = 0
                var k: int = rn - 1
                while ok == 1 && k >= 0
                    var si: int = cgSlFind(curName)
                    if si < 0
                        ok = 0
                    else
                        var fr: int = cgSlField(si, rev[k])
                        if fr < 0
                            ok = 0
                        else
                            ft = cgSlFType[fr]
                            curName = cgTStruct(ft)
                        end
                    end
                    k = k - 1
                end
                if ok == 1
                    if ft != 0 && cgTk(ft) == TK_FLOAT && cgTIsPtr(ft) == 0
                        return 1
                    end
                    return 0
                end
            end
        end
        var t2: int = cgExprType(e)
        if cgTk(t2) == TK_FLOAT && cgTIsPtr(t2) == 0
            return 1
        end
        return 0
    end
    if tg == N_BINARY
        var op: int = cgF(e, 2)
        if cgStrIs(op, "==") == 1 || cgStrIs(op, "!=") == 1 || cgStrIs(op, "<") == 1 || cgStrIs(op, ">") == 1 || cgStrIs(op, "<=") == 1 || cgStrIs(op, ">=") == 1
            return 0
        end
        if cgIsFloatExpr(cgF(e, 0)) == 1 || cgIsFloatExpr(cgF(e, 1)) == 1
            return 1
        end
        return 0
    end
    if tg == N_ARRAYACC
        var t3: int = cgExprType(e)
        if cgTk(t3) == TK_FLOAT && cgTIsPtr(t3) == 0
            return 1
        end
        return 0
    end
    if tg == N_DEREF
        var pt: int = cgExprType(cgF(e, 0))
        if cgTk(pt) == TK_FLOAT && cgTIsPtr(pt) != 0
            return 1
        end
        return 0
    end
    if tg == N_CALL
        var nm: int = cgF(e, 0)
        if cgIsMathFloatCall(nm) == 1
            return 1
        end
        var ck: int = cgCallCalleeKind(e)
        if ck != 0
            var ft2: int = 0
            if ck == 1
                var vi3: int = cgVarFind(cgCalleeVar)
                if vi3 >= 0
                    ft2 = cgViType[vi3]
                end
            else
                ft2 = cgExprType(cgF(e, 1))
            end
            if ft2 != 0 && cgIsFuncPtr(ft2) == 1 && peek32(ft2 + 20) != 0
                if cgTk(cgSigRet(peek32(ft2 + 20))) == TK_FLOAT
                    return 1
                end
                return 0
            end
        end
        var fr: int = cgFuncRetType(nm)
        if fr != 0
            if cgTk(fr) == TK_FLOAT
                return 1
            end
            return 0
        end
        return 0
    end
    if tg == N_UNARY
        if cgStrIs(cgF(e, 0), "-") == 1
            if cgIsFloatExpr(cgF(e, 1)) == 1
                return 1
            end
        end
        return 0
    end
    return 0
end

# ===================== struct value qwords =====================
#
# Codegen::structValueQwords (codegen.cpp:1199): ceil(totalSize/8) (>=2) for a
# non-pointer struct value bigger than 8 bytes, 0 otherwise.

func cgStructValueQwords(e: int) -> int
    if e == 0
        return 0
    end
    var tg: int = cgTag(e)
    var t: int = 0
    if tg == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi < 0
            return 0
        end
        t = cgViType[vi]
    else if tg == N_CALL
        t = cgFuncRetType(cgF(e, 0))
        if t == 0
            return 0
        end
        if cgTk(t) == TK_VOID
            return 0
        end
    else if tg == N_MEMBER
        var rev: [256]int
        var rn: int = 0
        var cur: int = e
        while cgTag(cur) == N_MEMBER
            if rn < 256
                rev[rn] = cgF(cur, 1)
            end
            rn = rn + 1
            cur = cgF(cur, 0)
        end
        if cgTag(cur) != N_IDENT
            return 0
        end
        var vi2: int = cgVarFind(cgF(cur, 0))
        if vi2 < 0
            return 0
        end
        var vt: int = cgViType[vi2]
        if cgTk(vt) != TK_STRUCT && cgTk(vt) != TK_VEC2 && cgTk(vt) != TK_VEC3 && cgTk(vt) != TK_COLOR
            return 0
        end
        var curName: int = cgTStruct(vt)
        var ft: int = vt
        var k: int = 0
        while k < rn
            var si: int = cgSlFind(curName)
            if si < 0
                return 0
            end
            var fr: int = cgSlField(si, rev[rn - 1 - k])
            if fr < 0
                return 0
            end
            ft = cgSlFType[fr]
            curName = cgTStruct(ft)
            k = k + 1
        end
        t = ft
    else
        return 0
    end
    if t == 0 || cgTIsPtr(t) != 0
        return 0
    end
    var size: int = cgStructTypeSize(t)
    if size <= 8
        return 0
    end
    return (size + 7) / 8
end
