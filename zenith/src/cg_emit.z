end

func emitFloatLoadFromAddrR10(xmmDst: int, offset: int)
    emit8(0xF3)
    emit8(0x41)
    emit8(0x0F)
    emit8(0x10)
    if offset >= -128 && offset <= 127
        emit8(0x40 | ((xmmDst & 7) << 3) | 0x02)
        emit8(offset & 255)
    else
        emit8(0x80 | ((xmmDst & 7) << 3) | 0x02)
