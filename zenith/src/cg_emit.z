# ---- RIP-relative user globals (.data) ----

func emitGlobalLoadReg(r: int, offset: int)
    var modrm: int = 0x05 | ((r & 7) << 3)
    emit8(0x48)
    emit8(0x8B)
    emit8(modrm)
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalLoadReg32(r: int, offset: int)
    var modrm: int = 0x05 | ((r & 7) << 3)
    emit8(0x8B)
    emit8(modrm)
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalStoreReg64(offset: int)
    emit8(0x48)
    emit8(0x89)
    emit8(0x05)
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalStoreReg32(offset: int)
    emit8(0x89)
    emit8(0x05)
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

# 32-bit targets: absolute disp32 addressing (no RIP-relative, no REX)
func emitGlobalLoadReg32Abs(r: int, offset: int)
    if r == 0
        emit8(0xA1)
    else
        emit8(0x8B)
        emit8(0x05 | ((r & 7) << 3))
    end
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalStoreReg32Abs(r: int, offset: int)
    emit8(0x89)
    emit8(0x05 | ((r & 7) << 3))
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalLeaR10(offset: int)
    emit8(0x4C)
    emit8(0x8D)
    emit8(0x15)
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalFloatLoad(xmm: int, offset: int)
    emit8(0xF3)
    emit8(0x0F)
    emit8(0x10)
    emit8(0x05 | ((xmm & 7) << 3))
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

func emitGlobalFloatStore(xmm: int, offset: int)
    emit8(0xF3)
    emit8(0x0F)
    emit8(0x11)
    emit8(0x05 | ((xmm & 7) << 3))
    cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + offset)
    emit32(0)
end

# ---- smoke: address / float / global access primitives ----
func cgSmokeAddr() -> int
    cgReset()
    cgWordSize = 64
    cgFixReset()
    cgGlobalsRVA = 0x3000

    emitFloatStoreToBP(1, -8)
    emitFloatLoadFromBP(6, -300)
    emitLeaR10FromBP(-16)
    emitLeaRegFromBP(2, -200)
    emitStoreToAddr(3, 5, 0)
    emitStoreToAddr(3, 5, -400)
    emitLoad32FromAddr(2, 4, 16)
    emitStore32ToAddr(2, 4, -16)
    emitFloatLoadFromAddr(0, 6, 8)
    emitFloatStoreToAddr(7, 6, 300)
    emitLoadR10FromBP64(-64)
    emitGlobalLoadR10(48)
    emitLoad32FromAddrR10(1, -200)
    emitStoreToAddrR10(-8)
    emitStore32ToAddrR10(200)
    emitFloatLoadFromAddrR10(3, -12)
    emitFloatStoreToR10(5, 400)
    emitLoadFromAddr(1, 5, 0)
    emitLoadFromAddr(1, 5, -200)
    emitLoadFromAddr(1, 4, 200)
    emitLoadFromAddrR10(2, -9)
    emitGlobalLoadReg(0, 16)
    emitGlobalLoadReg32(7, 20)
    emitGlobalStoreReg64(24)
    emitGlobalStoreReg32(28)
    emitGlobalLoadReg32Abs(3, 32)
    emitGlobalStoreReg32Abs(1, 36)
    emitGlobalLeaR10(40)
    emitGlobalFloatLoad(2, 44)
    emitGlobalFloatStore(3, 48)

    var h: int = 0x4BF29CE484222325
    var i: int = 0
    while i < cgCodeLen
        h = h ^ peek8(cgCode + i)
        h = h * 0x100000001B3
        i = i + 1
    end
    return h
end
