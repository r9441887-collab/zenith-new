# ---------------- образы .rdata / .data ----------------
# C++: std::vector<uint8_t> rdata / data (codegen.h:461,462)
var cgRData: int = 0
var cgRDataCap: int = 0
var cgRDataLen: int = 0
var cgData: int = 0
var cgDataCap: int = 0
var cgDataLen: int = 0

# растут так же, как cgCode (std::vector::push_back в C++). Не чистятся в
# cgInit(): очистка .rdata/.data — забота buildLinuxImportData/PE-аналога.
func cgRDataEnsure(n: int)
    if cgRDataLen + n <= cgRDataCap
        return
    end
    var nc: int = cgRDataCap * 2
    if nc < 65536
        nc = 65536
    end
    while nc < cgRDataLen + n
        nc = nc * 2
    end
    var nb: int = realloc(cgRData, nc)
    if nb == 0
        cgErrSet("out of memory while growing the .rdata buffer")
        return
    end
    cgRData = nb
    cgRDataCap = nc
end

func cgRDataPush(v: int)
    cgRDataEnsure(1)
    if cgRDataLen + 1 > cgRDataCap
        return
    end
    poke8(cgRData + cgRDataLen, v & 0xFF)
    cgRDataLen = cgRDataLen + 1
end

func cgRDataFill(v: int, n: int)
    cgRDataEnsure(n)
    if cgRDataLen + n > cgRDataCap
        return
    end
    var i: int = 0
    while i < n
        poke8(cgRData + cgRDataLen + i, v & 0xFF)
        i = i + 1
    end
    cgRDataLen = cgRDataLen + n
end

# nul-terminated строка из байтового литерала (адрес в .z-строке)
func cgRDataStr(s: int)
    var p: int = s
    while peek8(p) != 0
        cgRDataPush(peek8(p))
        p = p + 1
    end
    cgRDataPush(0)
end

func cgDataEnsure(n: int)
    if cgDataLen + n <= cgDataCap
        return
    end
    var nc: int = cgDataCap * 2
    if nc < 65536
        nc = 65536
    end
    while nc < cgDataLen + n
        nc = nc * 2
    end
    var nb: int = realloc(cgData, nc)
    if nb == 0
        cgErrSet("out of memory while growing the .data buffer")
        return
    end
    cgData = nb
    cgDataCap = nc
end

func cgDataPush(v: int)
    cgDataEnsure(1)
    if cgDataLen + 1 > cgDataCap
        return
    end
    poke8(cgData + cgDataLen, v & 0xFF)
    cgDataLen = cgDataLen + 1
end

func cgDataFill(v: int, n: int)
    cgDataEnsure(n)
    if cgDataLen + n > cgDataCap
        return
    end
    var i: int = 0
    while i < n
        poke8(cgData + cgDataLen + i, v & 0xFF)
        i = i + 1
    end
    cgDataLen = cgDataLen + n
end

# строки внутри .rdata: смещения от начала string-pool (codegen.h:476
# stringOffsets, строится в buildLinuxImportData) + её RVA.
# std::vector<uint32_t> stringOffsets -> фиксированный массив как у фикстур.
var cgStringOffsets: [4096]int
var cgStringOffsetsN: int = 0

# размеры/адреса, которые заполняет buildLinuxImportData (codegen.h:465,815)
var cgEntryPointCodeOffset: int = 0
var cgGlobalsSize: int = 0

# globalOffsets: std::unordered_map<std::string,int> (codegen.h). Ключ в C++
# — имя глобала; здесь — ZAST strId (как в cgViName), значение — смещение
# внутри блока глобалов .data. Заполняет cgBuildLinuxImportData по списку
# H_GLOBALS.
var cgGoName: [65536]int
var cgGoOff: [65536]int
var cgGoN: int = 0

# analog of globalOffsets.find(name) — index into cgGoName/cgGoOff or -1
func cgGoFind(name: int) -> int
    var i: int = 0
    while i < cgGoN
        if i < 65536 && cgStrIdsEq(cgGoName[i], name) == 1
            return i
        end
        i = i + 1
    end
    return -1
end

