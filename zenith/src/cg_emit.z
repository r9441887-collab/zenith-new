func emitLoad32FromAddrR10(gpDst: int, offset: int)
    emit8(0x41)
    emit8(0x8B)
    if offset >= -128 && offset <= 127
        emit8(0x40 | ((gpDst & 7) << 3) | 0x02)
        emit8(offset & 255)
    else
        emit8(0x80 | ((gpDst & 7) << 3) | 0x02)
        emit32(offset)
    end
end

func emitStoreToAddrR10(offset: int)
    emit8(0x49)
    emit8(0x89)
    if offset >= -128 && offset <= 127
        emit8(0x42)
        emit8(offset & 255)
    else
        emit8(0x82)
        emit32(offset)
