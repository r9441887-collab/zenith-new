var cgSoundUsed: int = 0
var cgTlsUsed: int = 0
var cgJsUsed: int = 0
var cgVkUsed: int = 0
var cgWlUsed: int = 0
var cgVkSurfaceUsed: int = 0
var cgDisasmUsed: int = 0
var cgHttpDlUsed: int = 0

# Ещё скалярные RVA, которые двигает fixupSectionRVAs (codegen.h:485,523..529,
# 835..836, 878..881). Дефолты все 0; на Linux-пути net*/font*/embedded*/
# не заполняются (их заполняет только PE/EFI-код), но `+= dData` в
# fixupSectionRVAs идёт безусловно — чтобы поведение совпадало, поля есть.
var cgWin32GlobalsRVA: int = 0
var cgNetStatusRVA: int = 0
var cgNetStatusLenRVA: int = 0
var cgNetBytesReadRVA: int = 0
