# src/cg_emit.z — байтовый эмиттер: буфер, регистры, x86/SSE, метки, фикстуры.
# Здесь только машинные байты: буфер растущего кода, аллокация GP/XMM
# регистров, энкодеры инструкций, метки/фикстуры, адресные примитивы
# кадра и таблицы фикстур бэкенда. Слой не знает ни о типах ZAST, ни о
# ходе по AST — он умеет только писать байты и сообщать об ошибках в
# слот ошибок нижнего слоя.
#
# `cgSpillBase` живёт здесь (его читает `cgTypeSetupFrame` выше) — это
# единственная связь типа с эмиттером.
#
# Use-chain (strictly linear — parseRun does not dedup spliced modules, so a
# diamond `use` prints "Duplicate function" and the layering would rot):
#
#   codegen.z -> cg_elf.z -> cg_expr.z -> cg_type.z -> cg_httpjson.z -> cg_emit.z -> cg_zast.z
#
# every arrow is a real dependency of the upper layer on the lower one;
# each module is `use`d exactly once in the whole tree.

use cg_zast

# ЁМКОСТЬ ФИКСТУРНЫХ ТАБЛИЦ (C++ — std::vector, растут сами; здесь
# фиксированные массивы с громкой ошибкой/тихим пропуском на переполнении).
# Замер на крупнейшей программе дерева (selfhost/_parsdrv.z, сплайс
# parser+ast+lower+opt+lexer): jfix=8724, labels=7797, call=4088,
# global=3379, go=384 — потолок 8192 был превышен, отсюда и ошибка
# "too many jump fixups" на test-cgfront. 65536 даёт ~7x запаса.
const CG_JFIX_MAX: int = 65536

# Внутренняя куча Zenith (bump-хип в .bss, 64 MiB) — слишком мало для
# 17.6-мегабайтового js-блоба: рост cgCode/cgImg упирался в её потолок,
# а сумма шагов удвоения (64K+...+33.5M) съедала кучу целиком. Буферы
# кодогена существуют только внутри драйвера — их содержимое это то, что
# кладётся в контейнеры srcA..srcN, поэтому перевод на libc heap не
# меняет ни одного байта паритета. realloc(0, n) == malloc(n), а
# realloc(p, n) сохраняет содержимое и освобождает старый блок сам.
# `malloc`/`free` здесь недоступны как имена: free — builtin codegen
# (codegen.cpp:3076), поэтому освобождение отдаём realloc'у.
extern func realloc(p: int, n: int) -> int

# emitted machine code (grows, owned by cgEnsure)
var cgCode: int = 0
var cgCodeCap: int = 0
var cgCodeLen: int = 0

# Codegen members that carry over one-for-one
var cgRegsUsed: int = 0
var cgXmmUsed: int = 0
var cgLabelNext: int = 0
var cgIsLinux: int = 0
var cgSysvAbi: int = 0
var cgLibOutput: int = 0
var cgIsLibrary: int = 0
var cgEmitDebug: int = 0
var cgFlatOutput: int = 0
var cgEmbedDlLs: int = 0

# ---------------- секционные RVA-слоты (src/codegen.h) ----------------
#
# C++: uint32_t ...RVA (codegen.h:547..614, 840..843), все читаются и
# пишутся слоем buildLinuxImportData()/buildELF() (src/codegen_elf.cpp) и
# resolveFixups(). Имена — те же, с префиксом `cg`, как у остального
# состояния (см. cgGlobalsRVA). Значения — дефолты codegen.h: отправные
# сентинелы heapOffset/heapFreeHead/heapArea ещё ДО сборки .data заменяются
# на реальные RVA (см. cgBuildLinuxImportData).
#
# Отдельно от буферов: RVA живут между функциями (fixup-патчинг идёт после
# того, как эмит закончил), а буферы .text/.rdata/.data — это образ.
