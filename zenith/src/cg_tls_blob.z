# codegen_tls.cpp:99..118 â€” append the blob to .text and bind the label
# the `call rel32` sites in cgTryTlsCall/cgEmitTlsIoInit jump through.
# Runs after function codegen but before fixupSectionRVAs/resolveJmpFixups
# (codegen.cpp:8714). Ð’Ñ‹Ð·Ñ‹Ð²Ð°ÐµÑ‚ÑÑ Ð¿Ñ€Ð¸ (tlsUsed || jsUsed) && !libOutput.
func cgEmitTlsBlob()
    if cgTlsBlobEmitted != 0
        return
    end
    cgTlsBlobEmitted = 1
    if cgTlsEntryLabel < 0
        cgTlsEntryLabel = newLabel()
    end

    # C++: while (code.size() % 16) emit8(0x90); â€” NOP, Ð½Ðµ Ð½ÑƒÐ»Ð¸: ÐºÑ€Ð¸Ð¿Ñ‚Ð¾-ÐºÐ¾Ð´
    # blob'Ð° Ð³Ñ€ÑƒÐ·Ð¸Ñ‚ SIMD-ÐºÐ¾Ð½ÑÑ‚Ð°Ð½Ñ‚Ñ‹ movdqa ÑÐ¾ ÑÐ¼ÐµÑ‰ÐµÐ½Ð¸Ð¹ Ð²Ð½ÑƒÑ‚Ñ€Ð¸ .text, Ð¸ ÑÑ‚Ð¸
    # ÑÐ¼ÐµÑ‰ÐµÐ½Ð¸Ñ Ð¾Ð±ÑÐ·Ð°Ð½Ñ‹ Ð¾ÑÑ‚Ð°Ñ‚ÑŒÑÑ Ð²Ð°Ð»Ð¸Ð´Ð½Ñ‹Ð¼Ð¸, ÐºÑƒÐ´Ð° Ð±Ñ‹ Ð±Ð»Ð¾Ð± Ð½Ð¸ ÑÐµÐ».
    while cgCodeLen % 16 != 0
        emit8(0x90)
    end
    var blobStart: int = cgCodeLen
    cgTlsEmitBlobBytes()
    if cgTlsEntryLabel >= 0 && cgTlsEntryLabel < 8192
        cgLabelPos[cgTlsEntryLabel] = blobStart + CG_TLS_BLOB_ENTRY
    end
end
