# --- END cgSoundLutAppend ---

func cgBuildLinuxImportData()
    cgRDataLen = 0
    cgDataLen = 0
    cgStringOffsetsN = 0

    # ---- String pool — pool-relative offsets (:132..140) ----
    var poolStart: int = cgRDataLen
    cgStringRVA = cgRdataRVA + poolStart
    var i: int = 0
    while i < cgStrPoolN
        cgStringOffsets[cgStringOffsetsN] = cgRDataLen - poolStart
        cgStringOffsetsN = cgStringOffsetsN + 1
        var q: int = cgPoolPtr(i)
        var n: int = cgPoolLen(i)
        var k: int = 0
        while k < n
            cgRDataPush(peek8(q + k))
            k = k + 1
        end
        cgRDataPush(0)
        i = i + 1
    end
    while cgRDataLen % 16 != 0
        cgRDataPush(0)
    end

    # ---- GUI class name (:142..148) ----
    if cgH(H_APPTYPE) == 1
        cgClassNameRVA = cgRdataRVA + cgRDataLen
        cgAddRdataStr("ZenithWnd")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end
    end

    # ---- Re-space .data from the real .rdata size (:150..160) ----
    # computeSectionRVAs() кладёт .data ровно на страницу выше .rdata; пул
    # строк больше страницы заставил бы окна fixupSectionRVAs() накладываться,
    # и фикстапы первых глобалов уезжали бы на страницу ниже — в RX-сегмент.
    var spacedDataRVA: int = cgAlignUp(cgRdataRVA + cgRDataLen, 4096)
    if cgDataRVA < spacedDataRVA
        cgDataRVA = spacedDataRVA
    end

    # ---- Heap offset + free-list head + rand seed (:162..168) ----
    cgHeapOffsetRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)
    cgHeapFreeHeadRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)
    cgRandSeedRVA = cgDataRVA + cgDataLen
    cgDataFill(0, 8)

    # ---- Socket / sound / tls / js slot state (:170..217) ----
    if cgNetSocksUsed != 0
        cgSockWsaStartedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSockWsadataRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 416)
        cgSockPeerRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16)
        cgSockPeerLenRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        # Linux net: last-error slot + peer IP buffer (PE пользуется wininet/wsa;
        # эти два слота есть только в codegen_net_linux.cpp).
        cgLinNetErrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgLinNetIpBufRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16)
    end
    if cgSoundUsed != 0
        cgSoundOpenedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundHwoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundFmtRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 24)
        cgSoundBpfRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundHdrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 56)
        cgSoundSeedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgSoundLutRVA = cgDataRVA + cgDataLen
        cgSoundLutAppend()
    end
    if cgTlsUsed != 0
        cgTlsIoDoneRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
    end
    if cgJsUsed != 0
        cgJsResultRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
        cgJsErrorRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
    end

    # ---- Linux Vulkan (:219..252) ----
    if cgVkUsed != 0
        cgVkZenithStrRVA = cgAddRdataStr("Zenith")
        cgVkDestroyStrRVA = cgAddRdataStr("vkDestroyInstance")
        cgVkEnumPhyStrRVA = cgAddRdataStr("vkEnumeratePhysicalDevices")
        cgVkPhyPropsStrRVA = cgAddRdataStr("vkGetPhysicalDeviceProperties")
        cgVkDevProcStrRVA = cgAddRdataStr("vkGetDeviceProcAddr")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end
        cgVkInstRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkAppInfoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 48)
        cgVkInstInfoRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 64)
        cgVkFnTableRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 48)
        cgVkCountRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkPhyBufRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 512)
        cgVkPropsRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 2048)
        # syscall-загрузчик (часть 21): строки путей к библиотекам, имена
        # трёх символов, сообщение об ошибке; три import-слота .data
        # (каждый сдвигает .data на 8 — .bss-адреса ещё не фиксированы,
        # финальные RVA им даст fixupSectionRVAs); stat-буфер и таблица
        # библиотек (4 × 96 байт) — тоже в .data, как и прежние нулевые
        # буферы vulkan (cgVkInstRVA и т.п.).
        cgVkLoaderPathRVA[0] = cgAddRdataStr("/usr/lib/x86_64-linux-gnu/libvulkan.so.1")
        cgVkLoaderPathRVA[1] = cgAddRdataStr("/usr/lib64/libvulkan.so.1")
        cgVkLoaderPathRVA[2] = cgAddRdataStr("/usr/lib/libvulkan.so.1")
        cgVkISymRVA[0] = cgAddRdataStr("vkEnumerateInstanceVersion")
        cgVkISymRVA[1] = cgAddRdataStr("vkCreateInstance")
        cgVkISymRVA[2] = cgAddRdataStr("vkGetInstanceProcAddr")
        cgVkLibMsgRVA = cgAddRdataStr("zenith: vulkan loader cannot open libvulkan.so.1\n")
        cgVkLibMsgLen = 46
        cgVkStubNameRVA[0] = cgAddRdataStr("secure_getenv")
        cgVkStubNameRVA[1] = cgAddRdataStr("getenv")
        cgVkStubNameRVA[2] = cgAddRdataStr("malloc")
        cgVkStubNameRVA[3] = cgAddRdataStr("calloc")
        cgVkStubNameRVA[4] = cgAddRdataStr("realloc")
        cgVkStubNameRVA[5] = cgAddRdataStr("free")
        cgVkStubNameRVA[6] = cgAddRdataStr("memcpy")
        cgVkStubNameRVA[7] = cgAddRdataStr("memmove")
        cgVkStubNameRVA[8] = cgAddRdataStr("memset")
        cgVkStubNameRVA[9] = cgAddRdataStr("memcmp")
        cgVkStubNameRVA[10] = cgAddRdataStr("strlen")
        cgVkStubNameRVA[11] = cgAddRdataStr("strcmp")
        cgVkStubNameRVA[12] = cgAddRdataStr("strncmp")
        cgVkStubNameRVA[13] = cgAddRdataStr("strcpy")
        cgVkStubNameRVA[14] = cgAddRdataStr("strchr")
        cgVkStubNameRVA[15] = cgAddRdataStr("pthread_mutex_init")
        cgVkStubNameRVA[16] = cgAddRdataStr("pthread_mutex_lock")
        cgVkStubNameRVA[17] = cgAddRdataStr("pthread_mutex_unlock")
        cgVkStubNameRVA[18] = cgAddRdataStr("pthread_mutex_destroy")
        cgVkStubNameRVA[19] = cgAddRdataStr("abort")
        cgVkStubNameRVA[20] = cgAddRdataStr("__stack_chk_fail")
        cgVkStubNameRVA[21] = cgAddRdataStr("strcspn")
        cgVkStubNameRVA[22] = cgAddRdataStr("strncpy")
        cgVkStubNameRVA[23] = cgAddRdataStr("strspn")
        cgVkStubNameRVA[24] = cgAddRdataStr("strpbrk")
        cgVkStubNameRVA[25] = cgAddRdataStr("strrchr")
        cgVkStubNameRVA[26] = cgAddRdataStr("strstr")
        cgVkStubNameRVA[27] = cgAddRdataStr("__vsnprintf_chk")
        cgVkStubNameRVA[28] = cgAddRdataStr("__snprintf_chk")
        cgVkStubNameRVA[29] = cgAddRdataStr("snprintf")
        cgVkStubNameRVA[30] = cgAddRdataStr("access")
        cgVkStubNameRVA[31] = cgAddRdataStr("closedir")
        cgVkStubNameRVA[32] = cgAddRdataStr("dirname")
        cgVkStubNameRVA[33] = cgAddRdataStr("fclose")
        cgVkStubNameRVA[34] = cgAddRdataStr("feof")
        cgVkStubNameRVA[35] = cgAddRdataStr("fopen")
        cgVkStubNameRVA[36] = cgAddRdataStr("fputc")
        cgVkStubNameRVA[37] = cgAddRdataStr("fputs")
        cgVkStubNameRVA[38] = cgAddRdataStr("fread")
        cgVkStubNameRVA[39] = cgAddRdataStr("fseek")
        cgVkStubNameRVA[40] = cgAddRdataStr("ftell")
        cgVkStubNameRVA[41] = cgAddRdataStr("opendir")
        cgVkStubNameRVA[42] = cgAddRdataStr("readdir")
        cgVkStubNameRVA[43] = cgAddRdataStr("readlink")
        cgVkStubNameRVA[44] = cgAddRdataStr("geteuid")
        cgVkStubNameRVA[45] = cgAddRdataStr("getuid")
        cgVkStubNameRVA[46] = cgAddRdataStr("getegid")
        cgVkStubNameRVA[47] = cgAddRdataStr("getgid")
        cgVkStubNameRVA[48] = cgAddRdataStr("__ctype_tolower_loc")
        cgVkStubNameRVA[49] = cgAddRdataStr("__cxa_finalize")
        cgVkStubNameRVA[50] = cgAddRdataStr("dlclose")
        cgVkStubNameRVA[51] = cgAddRdataStr("dlerror")
        cgVkStubNameRVA[52] = cgAddRdataStr("dlopen")
        cgVkStubNameRVA[53] = cgAddRdataStr("dlsym")
        cgVkStubNameRVA[54] = cgAddRdataStr("__isoc99_sscanf")
        cgVkStubNameRVA[55] = cgAddRdataStr("pow")
        cgVkStubNameRVA[56] = cgAddRdataStr("qsort")
        cgVkStubNameRVA[57] = cgAddRdataStr("strtok")
        cgVkStubNameRVA[58] = cgAddRdataStr("strtol")
        cgVkStubNameRVA[59] = cgAddRdataStr("__strcat_chk")
        cgVkStubNameRVA[60] = cgAddRdataStr("strcat")
        cgVkStubNameRVA[61] = cgAddRdataStr("__strcpy_chk")
        cgVkStubNameRVA[62] = cgAddRdataStr("__strncat_chk")
        cgVkStubNameRVA[63] = cgAddRdataStr("__strncpy_chk")
        cgVkStubNameRVA[64] = cgAddRdataStr("stderr")
        while cgRDataLen % 8 != 0
            cgRDataPush(0)
        end
        var vks: int = 0
        while vks < 3
            cgVkImpSlotRVA[vks] = cgDataRVA + cgDataLen
            cgDataFill(0, 8)
            vks = vks + 1
        end
        cgVkStatRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 144)
        cgVkHeapCurRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkLTabRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 384)
    end

    # ---- Linux Wayland (:254..334) ----
    # Сырые syscall'ы (codegen_wl_linux.cpp) — путь display-сокета приходит из
    # envp; emitLinuxEntryPoint кладёт envp в cgWlEnvRVA сразу на старте.
    if cgWlUsed != 0
        cgWlXdgRVA = cgAddRdataStr("XDG_RUNTIME_DIR=")
        cgWlSfxRVA = cgAddRdataStr("/wayland-0")
        cgWlColonRVA = cgAddRdataStr(":")
        cgWlNlRVA = cgAddRdataStr("\n")
        # Window builtins (codegen_wl_window.cpp): interface-строки сверяются
        # с анонсами registry.global и уходят как есть в bind/app_id.
        cgWlCompositorStrRVA = cgAddRdataStr("wl_compositor")
        cgWlXdgWmBaseStrRVA = cgAddRdataStr("xdg_wm_base")
        cgWlShmStrRVA = cgAddRdataStr("wl_shm")
        cgWlMemfdNameRVA = cgAddRdataStr("z-wl-fb")
        cgWlAppIdRVA = cgAddRdataStr("zenith-app")

        # Two-way init handshake — статичный блоб на 24 байта. Проводной
        # заголовок 8 байт: u32 object id | u16 opcode | u16 size (с заголовком),
        # у запроса с одним new_id размер запроса = 12:
        #   wl_display.get_registry(new_id=2): id=1 opcode=1 size=12 + uint(2)
        #   wl_display.sync(new_id=3):         id=1 opcode=0 size=12 + uint(3)
        cgWlInitReqRVA = cgRdataRVA + cgRDataLen
        var initReq: [24]int
        initReq[0] = 0x01
        initReq[1] = 0x00
        initReq[2] = 0x00
        initReq[3] = 0x00
        initReq[4] = 0x01
        initReq[5] = 0x00
        initReq[6] = 0x0c
        initReq[7] = 0x00
        initReq[8] = 0x02
        initReq[9] = 0x00
        initReq[10] = 0x00
        initReq[11] = 0x00
        initReq[12] = 0x01
        initReq[13] = 0x00
        initReq[14] = 0x00
        initReq[15] = 0x00
        initReq[16] = 0x00
        initReq[17] = 0x00
        initReq[18] = 0x0c
        initReq[19] = 0x00
        initReq[20] = 0x03
        initReq[21] = 0x00
        initReq[22] = 0x00
        initReq[23] = 0x00
        var ik: int = 0
        while ik < 24
            cgRDataPush(initReq[ik])
            ik = ik + 1
        end

        cgWlEnvRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlFdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlPathRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 128)
        cgWlInRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4096)
        cgWlTmpRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 32)

        # Window / shm-framebuffer state (codegen_wl_window.cpp).
        cgWlWNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlXdgNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlShmNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlSurfIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlXdgIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlTopIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlShmIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlPoolIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlBufIdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlFbPtrRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlBufFdRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlWinWRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlWinHRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlConfiguredRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlClosedRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgWlOutRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 256)
    end

    # ---- Linux Vulkan WSI surface (:336..465) ----
    # Wayland client + surface/swapchain state, собран на libwayland-client.so.0
    # (импорты) + libvulkan (слоты vk_*).
    if cgVkSurfaceUsed != 0
        cgVkSurfaceKHRStrRVA = cgAddRdataStr("VK_KHR_surface")
        cgVkWaylandSurfaceStrRVA = cgAddRdataStr("VK_KHR_wayland_surface")
        cgVkSwapchainStrRVA = cgAddRdataStr("VK_KHR_swapchain")
        cgVkCreateSurfaceStrRVA = cgAddRdataStr("vkCreateWaylandSurfaceKHR")
        cgVkDestroySurfStrRVA = cgAddRdataStr("vkDestroySurfaceKHR")
        cgVkDestroyDeviceStrRVA = cgAddRdataStr("vkDestroyDevice")
        cgVkSurfaceProcsStrRVA[0] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceCapabilitiesKHR")
        cgVkSurfaceProcsStrRVA[1] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceFormatsKHR")
        cgVkSurfaceProcsStrRVA[2] = cgAddRdataStr("vkGetPhysicalDeviceSurfacePresentModesKHR")
        cgVkSurfaceProcsStrRVA[3] = cgAddRdataStr("vkGetPhysicalDeviceSurfaceSupportKHR")
        cgVkSurfaceProcsStrRVA[4] = cgAddRdataStr("vkCreateSwapchainKHR")
        cgVkSurfaceProcsStrRVA[5] = cgAddRdataStr("vkGetSwapchainImagesKHR")
        cgVkSurfaceProcsStrRVA[6] = cgAddRdataStr("vkDestroySwapchainKHR")
        cgVkSurfaceProcsStrRVA[7] = cgAddRdataStr("vkCreateImageView")
        cgVkSurfaceProcsStrRVA[8] = cgAddRdataStr("vkCreateFramebuffer")
        cgVkSurfaceProcsStrRVA[9] = cgAddRdataStr("vkCreateRenderPass")
        cgVkSurfaceProcsStrRVA[10] = cgAddRdataStr("vkCreateGraphicsPipelines")
        cgVkSurfaceProcsStrRVA[11] = cgAddRdataStr("vkCreatePipelineLayout")
        cgVkSurfaceProcsStrRVA[12] = cgAddRdataStr("vkCreateCommandPool")
        cgVkSurfaceProcsStrRVA[13] = cgAddRdataStr("vkAllocateCommandBuffers")
        cgVkSurfaceProcsStrRVA[14] = cgAddRdataStr("vkBeginCommandBuffer")
        cgVkSurfaceProcsStrRVA[15] = cgAddRdataStr("vkCmdBeginRenderPass")
        cgVkSurfaceProcsStrRVA[16] = cgAddRdataStr("vkCmdBindPipeline")
        cgVkSurfaceProcsStrRVA[17] = cgAddRdataStr("vkCmdDraw")
        cgVkSurfaceProcsStrRVA[18] = cgAddRdataStr("vkCmdEndRenderPass")
        cgVkSurfaceProcsStrRVA[19] = cgAddRdataStr("vkEndCommandBuffer")
        cgVkSurfaceProcsStrRVA[20] = cgAddRdataStr("vkAcquireNextImageKHR")
        cgVkSurfaceProcsStrRVA[21] = cgAddRdataStr("vkWaitForFences")
        cgVkSurfaceProcsStrRVA[22] = cgAddRdataStr("vkResetFences")
        cgVkSurfaceProcsStrRVA[23] = cgAddRdataStr("vkQueueSubmit")
        cgVkSurfaceProcsStrRVA[24] = cgAddRdataStr("vkQueuePresentKHR")
        cgVkSurfaceProcsStrRVA[25] = cgAddRdataStr("vkQueueWaitIdle")
        cgVkSurfaceProcsStrRVA[26] = cgAddRdataStr("vkDeviceWaitIdle")
        cgVkSurfaceProcsStrRVA[27] = cgAddRdataStr("vkCreateSemaphore")
        cgVkSurfaceProcsStrRVA[28] = cgAddRdataStr("vkGetDeviceQueue")
        cgVkSurfaceProcsStrRVA[29] = cgAddRdataStr("vkCreateBuffer")
        cgVkSurfaceProcsStrRVA[30] = cgAddRdataStr("vkGetBufferMemoryRequirements")
        cgVkSurfaceProcsStrRVA[31] = cgAddRdataStr("vkAllocateMemory")
        cgVkSurfaceProcsStrRVA[32] = cgAddRdataStr("vkBindBufferMemory")
        cgVkSurfaceProcsStrRVA[33] = cgAddRdataStr("vkMapMemory")
        cgVkSurfaceProcsStrRVA[34] = cgAddRdataStr("vkUnmapMemory")
        cgVkSurfaceProcsStrRVA[35] = cgAddRdataStr("vkGetPhysicalDeviceMemoryProperties")
        cgVkSurfaceProcsStrRVA[36] = cgAddRdataStr("vkCmdSetViewport")
        cgVkSurfaceProcsStrRVA[37] = cgAddRdataStr("vkCmdSetScissor")
        cgVkSurfaceProcsStrRVA[38] = cgAddRdataStr("vkCmdBindVertexBuffers")
        cgVkSurfaceProcsStrRVA[39] = cgAddRdataStr("vkCreateShaderModule")
        while cgRDataLen % 16 != 0
            cgRDataPush(0)
        end

        # Массив extension-указателей: два абсолютных указателя внутрь .rdata —
        # vk_instance_create включает surface + wayland surface, давая
        # ppEnabledExtensionNames на эту 2*8B ячейку.
        var vkSfcExtArrayPos: int = cgDataLen
        cgDataFill(0, 16)
        cgVkExtArrayRVA = cgDataRVA + vkSfcExtArrayPos
        # Абсолютные VA запекаются сразу (ET_EXEC грузится на LOAD_BASE, RVA
        # строк на момент buildLinuxImportData уже финальны).
        cgPutAbsPtr(vkSfcExtArrayPos, 0, cgVkSurfaceKHRStrRVA)
        cgPutAbsPtr(vkSfcExtArrayPos, 8, cgVkWaylandSurfaceStrRVA)

        # Wayland client state.
        cgWlSfcDisplayRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcRegistryRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcCompositorRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcSurfaceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgWlSfcNameRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        # Vulkan surface/device state.
        cgVkSfcSurfaceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcGpuRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcQueueFamilyRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcDeviceRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcQueueRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcSwapchainRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcFormatRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcExtentRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcImageCountRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcRenderPassRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcPipeRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        cgVkSfcFrameImageRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4)
        cgVkSfcFrameCBRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 8)
        # Device-level fn table (16 слотов), держатели image view/framebuffer и
        # scratch arena.
        cgVkSfcDevTableRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 16 * 8)
        cgVkSfcScratchRVA = cgDataRVA + cgDataLen
        cgDataFill(0, 4096)
    end

    # ---- Heap area -> .bss (:467..468) ----
    # zero-init; buildELF расширяет RW-сегмент.
    cgHeapAreaRVA = cgDataRVA + cgDataLen

    # ---- User global variables (:470..498) ----
    # C++ ходит по prog.globals (имя/тип/arraySize) и строит globalOffsets;
    # здесь список глобалов — side-список H_GLOBALS, ключ — ZAST strId.
    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    if gl > 0
        cgGoN = 0
        var total: int = 0
        var gi: int = 0
        while gi < gl
            var gid: int = cgSide(gs + gi)
            var fsz: int = 8
            var tp: int = cgFAddr(gid, 1)
            var arr: int = cgF(gid, 8)
            if arr > 0
                fsz = cgArrayElemStride(tp) * arr
            else
                if cgTk(tp) == TK_STRUCT
                    var it: int = cgSlFind(cgTStruct(tp))
                    if it >= 0
                        fsz = cgSlSize[it]
                    end
                else
                    if cgTk(tp) == TK_BOOL || cgTk(tp) == TK_FLOAT
                        fsz = 4
                    else
                        if cgTk(tp) == TK_VEC2
                            fsz = 8
                        else
                            if cgTk(tp) == TK_VEC3
                                fsz = 12
                            else
                                if cgTk(tp) == TK_COLOR
                                    fsz = 16
                                end
                            end
                        end
                    end
                end
            end
            if fsz % 8 != 0
                fsz = fsz + 8 - (fsz % 8)
            end
            # C++: globalOffsets[g->name] = totalSize — map, дубликат имени
            # перезаписывает (last-wins); здесь так же, иначе ссылки на
            # дублирующийся глобал (lexer.z+ast.z gStrUsed) попадают в
            # первый слот вместо последнего.
            var gof: int = cgGoFind(cgF(gid, 0))
            if gof >= 0
                cgGoOff[gof] = total
            else
                if cgGoN < 8192
                    cgGoName[cgGoN] = cgF(gid, 0)
                    cgGoOff[cgGoN] = total
                    cgGoN = cgGoN + 1
                end
            end
            total = total + fsz
            gi = gi + 1
        end
        cgGlobalsSize = total
        cgGlobalsRVA = cgDataRVA + cgDataLen
        cgDataFill(0, cgGlobalsSize)
    end

    # ---- Resolve heap-slot fixups (:500..505) ----
    var hi: int = 0
    while hi < cgHeapFixN
        if cgHeapFixTarget[hi] == CG_HEAP_AREA_RVA
            cgHeapFixTarget[hi] = cgHeapAreaRVA
        else
            if cgHeapFixTarget[hi] == CG_HEAP_FREE_HEAD_RVA
                cgHeapFixTarget[hi] = cgHeapFreeHeadRVA
            else
                if cgHeapFixTarget[hi] == CG_HEAP_OFFSET_RVA
                    cgHeapFixTarget[hi] = cgHeapOffsetRVA
                end
            end
        end
        hi = hi + 1
    end

    # ---- SPIR-V shader records -> .rdata (:507..508) ----
    # codegen_shader.cpp:160..180 — ассемблирует каждый собранный шейдер в
    # бинарь SPIR-V и дописывает в .rdata запись [u32 codeSize][u32 words...],
    # запоминая её RVA в shaderRecs (её потом lea-ит tryShaderCall).
    # Портирована в src/cg_shader.z; вызов — как в codegen_elf.cpp:507,
    # последним в cgBuildLinuxImportData (до cgFixupSectionRVAs).
    cgEmitShaderModules()
end

# ===================== emitLinux* (codegen_elf.cpp:518..630) =====================

# emitMixCrt0Call (mix.cpp:1453). mixCtx is a `--cxx` driver construct with no
# selfhost equivalent, so `hasAny` never turns on here — kept as a hook so the
# four call sites (entry/libInit/PE entry) stay byte-for-byte transcribable.
var cgMixHasAny: int = 0

func cgEmitMixCrt0Call()
    if cgMixHasAny == 0
        return
    end
    if cgKoDriverFlag != 0
        return
    end
    emit8(0xE8)
    cgPushCallFix(cgCodeLen, cgStrSynth("$mixcrt0"))
    emit32(0)
end

# emitStartupRelocator (codegen_elf.cpp:625). On Linux the GOT slots for OS
# imports are resolved eagerly by the dynamic linker before _start runs
# (buildELF's PT_INTERP/PT_DYNAMIC/.rela), so there is nothing to do — kept as
# a hook for uniformity across targets, exactly as in C++.
func cgEmitStartupRelocator()
    if cgElfImpN == 0
        return
    end
end

func cgEmitLinuxExitSyscall()
    emit8(0xB8)
    emit32(231)
    emit8(0x31)
    emit8(0xFF)
    emit8(0x0F)
    emit8(0x05)
end

# emitLinuxExitViaLibc (codegen_elf.cpp:593) — returns 1 when it emitted the
# libc path. The raw exit_group above discards whatever libc has buffered, so
# a dynamically linked image routes the exit through libc's atexit/stdio
# flushing instead; a statically linked one (no imports) keeps the raw syscall
# and would otherwise pay a DT_NEEDED just to exit. rdi already holds the code.
func cgEmitLinuxExitViaLibc() -> int
    if cgElfImpN == 0
        return 0
    end
    emit8(0xFF)
    emit8(0x15)
    var ex: int = cgStrSynth("exit")
    cgPushElfImport(cgCodeLen, ex, cgLinuxSonameFor(ex))
    emit32(0)
    emit8(0xEB)
    emit8(0xFE)
    return 1
end

# emitLinuxLibInit (codegen_elf.cpp:610) — the DT_INIT target of an ET_DYN
# shared library: the global initializers + $mixcrt0, then straight back to
# the caller (dlopen's init loop). Minus _exit, which is _start's job.
func cgEmitLinuxLibInit()
    cgEntryPointCodeOffset = cgCodeLen
    cgEmitGlobalInit()
    cgEmitMixCrt0Call()
    emit8(0xC3)
end

# emitLinuxEntryPoint (codegen_elf.cpp:518) — the ELF `_start`. Emitted at the
# end of .text after every function, so it only forward-calls into
# already-emitted code. rsp is 16-aligned at process entry, which is exactly
# what SysV wants immediately before `call`, so nothing is padded.
func cgEmitLinuxEntryPoint()
    cgEntryPointCodeOffset = cgCodeLen

    # syscall-only loader (часть 21): первый шаг _start — дозаполнить три
    # .data-слота vk-импортов из libvulkan.so, загруженной через
    # openat/mmap. Харнесс сюда не заходит (флаг ставит только generateWide).
    if cgVkLoaderWanted != 0
        emit8(0xE8)
        cgVkLoaderCallPos = cgCodeLen
        cgFixPush(cgCodeLen, cgVkLoaderLabel)
        emit32(0)
    end

    # stash envp (envp = rsp + 8*(argc+2); argc at [rsp]) for the Wayland
    # backend, which resolves $XDG_RUNTIME_DIR itself, with no libc getenv.
    if cgWlUsed != 0
        emit8(0x48)
        emit8(0x8B)
        emit8(0x04)
        emit8(0x24)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x8C)
        emit8(0xC4)
        emit8(0x10)
        emit8(0x00)
        emit8(0x00)
        emit8(0x00)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x15)
        cgPushGlobalFix(cgCodeLen, cgWlEnvRVA)
        emit32(0)
        emit8(0x48)
        emit8(0x89)
        emit8(0x0A)
    end

    cgEmitStartupRelocator()

    # prefer 'main', else the first non-extern function (codegen.cpp:546)
    var entry: int = 0
    var i: int = 0
    while i < cgFoN
        if cgStrEqId(cgFoName[i], "main") == 1
            entry = cgFoName[i]
        end
        i = i + 1
    end
    if entry == 0
        var fs: int = cgH(H_FUNCS)
        var fl: int = cgH(H_FUNCS + 1)
        var j: int = 0
        var done: int = 0
        while j < fl && done == 0
            var fid: int = cgSide(fs + j)
            if fid != 0
                if cgTag(fid) == N_FUNC
                    if cgF(fid, 11) == 0
                        entry = cgF(fid, 0)
                        done = 1
                    end
                end
            end
            j = j + 1
        end
    end

    cgEmitGlobalInit()

    if entry != 0
        cgEmitMixCrt0Call()
        # argc/argv. Ядро держит argc в [rsp] и argv в [rsp+8] на протяжении
        # всего _start (релокатор здесь no-op, cgEmitGlobalInit стек-нейтрален,
        # mixcrt0 возвращает), а SysV-пролог Zenith читает параметры из
        # rdi/rsi (слоты 0/1 в cgEmitFunction). Без этого main(argc, argv)
        # получало мусор. codegen_elf.cpp:560..567.
        emit8(0x48)
        emit8(0x8B)
        emit8(0x3C)
        emit8(0x24)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x74)
        emit8(0x24)
        emit8(0x08)
        emit8(0xE8)
        cgPushCallFix(cgCodeLen, entry)
        emit32(0)
    end

    # exit status is always 0 here; set rdi before either path, since
    # cgEmitLinuxExitViaLibc() reads it.
    emit8(0x31)
    emit8(0xFF)
    if cgEmitLinuxExitViaLibc() == 0
        emit8(0xB8)
        emit32(231)
        emit8(0x0F)
        emit8(0x05)
    end
    emit8(0xF4)
    emit8(0xEB)
    emit8(0xFE)
end

# ===================== syscall-only vulkan loader (часть 21) =====================
#
# cgEmitVkLoader эмитит мини-dlopen на сырых syscall'ах. Директива
# «только syscall» запрещает PT_INTERP/PT_DYNAMIC/DT_NEEDED в образе, но
# vulkan-билтины обязаны дёргать реальные vk*-функции: загрузчик сам
# ищет libvulkan.so.1 (только её саму: DT_NEEDED-либы не грузим),
# мапит через openat/fstat/mmap/close, применяет RELATIVE-релоки и
# резолвит GLOB_DAT/JUMP_SLOT: сначала по своему экспорту, потом
# через emit8-стабы libc-функций, и кладёт три адреса в cgVkImpSlotRVA[0..2],
# откуда их читают call-сайты (cgVkCallRipImport → cgVkCallRipSlot).
#
# Вызывается одним rel32 из пролога _start (hook в
# cgEmitLinuxEntryPoint, ставится только generateWide); при ошибке пишет
# сообщение в fd 2 и уходит в exit_group(127). Внутри — только
# rel32/rip-relative адресация, выравнивание не нужно.
#
# Раскладка записи таблицы библиотек (96 байт, cgVkLTabRVA + idx*96):
#   +0  base     — результат mmap (runtime VA)
#   +8  phoff    — e_phoff
#   +16 phnum    — e_phnum (нулевое расширение)
#   +24 dyn      — VA PT_DYNAMIC (0 — сегмента нет)
#   +32 strtab   — DT_STRTAB (vaddr)
#   +40 symtab   — DT_SYMTAB (vaddr)
#   +48 nsyms    — (strtab - symtab) / 24
#   +56 rela     — DT_RELA (vaddr)
#   +64 relasz   — DT_RELASZ (байты)
#   +72 jmprel   — DT_JMPREL (vaddr)
#   +80 pltrelsz — DT_PLTRELSZ (байты)
#
# Грузится ровно одна библиотека: 0 libvulkan (остальные слоты таблицы
# остаются нулевыми и скипаются). Mapping не unmapp'ится (живёт весь срок
# процесса — так же, как у настоящего dlopen).
#
# ABI подпрограмм: сохраняют rbx/rbp/r12-r15; каллят только друг друга;
# syscall калерит rax/rcx/r11. r12/rsp как база памяти не используются
# (кроме [r12+d8] со своим SIB — эмитится явно в applyPass).

# ---- emit-хелперы syscall-загрузчика ----

# syscall: mov eax, nr; syscall (rax/rdi/rsi/rdx/r10/r8/r9 — аргументы Linux x86-64)
func cgVkSys(nr: int)
    emit8(0xB8)
    emit32(nr)
    emit8(0x0F)
    emit8(0x05)
end

# mov r64, imm32 (знаковое расширение) — только значения int32
func cgVkEmovRi(r: int, v: int)
    if r >= 8
        emit8(0x49)
    else
        emit8(0x48)
    end
    emit8(0xC7)
    emit8(0xC0 + (r & 7))
    emit32(v)
end

# mov rDst64, [rBase + disp8]; base r12/rsp получает обязательный SIB 0x24
func cgVkEloadRm(rDst: int, rBase: int, disp: int)
    var rex: int = 0x48
    if rDst >= 8
        rex = rex + 4
    end
    if rBase >= 8
        rex = rex + 1
    end
    emit8(rex)
    emit8(0x8B)
    emit8(0x40 | ((rDst & 7) << 3) | (rBase & 7))
    if (rBase & 7) == 4
        emit8(0x24)
    end
    emit8(disp & 0xFF)
end

# mov [rBase + disp8], rSrc64
func cgVkEstoreRm(rSrc: int, rBase: int, disp: int)
    var rex: int = 0x48
    if rSrc >= 8
        rex = rex + 4
    end
    if rBase >= 8
        rex = rex + 1
    end
    emit8(rex)
    emit8(0x89)
    emit8(0x40 | ((rSrc & 7) << 3) | (rBase & 7))
    if (rBase & 7) == 4
        emit8(0x24)
    end
    emit8(disp & 0xFF)
end

# mov r64, [rip + rva] (globalFix; rva может быть +смещение, например
# cgVkStatRVA + 48 для st_size)
func cgVkEloadRip(r: int, rva: int)
    var rex: int = 0x48
    if r >= 8
        rex = rex + 4
    end
    emit8(rex)
    emit8(0x8B)
    emit8(0x05 | ((r & 7) << 3))
    cgPushGlobalFix(cgCodeLen, rva)
    emit32(0)
end

# mov [rip + rva], r64 (globalFix)
func cgVkEstoreRip(r: int, rva: int)
    var rex: int = 0x48
    if r >= 8
        rex = rex + 4
    end
    emit8(rex)
    emit8(0x89)
    emit8(0x05 | ((r & 7) << 3))
    cgPushGlobalFix(cgCodeLen, rva)
    emit32(0)
end

# call rel32 к метке (та же rel32-таблица, что у jmp)
func cgVkEcallL(label: int)
    emit8(0xE8)
    cgFixPush(cgCodeLen, label)
    emit32(0)
end

# lea reg, [rip + label] -- disp32 фиксап метки (как у emitJmp):
# cgApplyFixups пишет rel = labelPos - at - 4,
# а это ровно тому, что нужно lea
# (base и load base сокрашиваются).
# cgVkLeaRip здесь нельзя: ожидает готовый RVA.
func cgVkLeaRipL(r: int, lab: int)
    if r >= 8
        emit8(0x4C)
    else
        emit8(0x48)
    end
    emit8(0x8D)
    emit8(0x05 | ((r & 7) << 3))
    cgFixPush(cgCodeLen, lab)
    emit32(0)
end

# test r64, r64
func cgVkEtestRR(r: int)
    var rex: int = 0x48
    if r >= 8
        rex = rex + 5
    end
    emit8(rex)
    emit8(0x85)
    emit8(0xC0 + (r & 7) * 8 + (r & 7))
end

# js/jns/je/jne/jae/jb rel32
func cgVkEjs(l: int)
    emitJccRaw(0x88, l)
end

func cgVkEjns(l: int)
    emitJccRaw(0x89, l)
end

func cgVkEje(l: int)
    emitJccRaw(0x84, l)
end

func cgVkEjne(l: int)
    emitJccRaw(0x85, l)
end

func cgVkEjae(l: int)
    emitJccRaw(0x83, l)
end

func cgVkEjb(l: int)
    emitJccRaw(0x82, l)
end

# imul rDst64, rSrc64, imm8
func cgVkEimulRRI(rDst: int, rSrc: int, imm: int)
    var rex: int = 0x48
    if rDst >= 8
        rex = rex + 4
    end
    if rSrc >= 8
        rex = rex + 1
    end
    emit8(rex)
    if imm > 127 or imm < -128
        emit8(0x69)
        emit8(0xC0 | ((rDst & 7) << 3) | (rSrc & 7))
        emit32(imm)
    else
        emit8(0x6B)
        emit8(0xC0 | ((rDst & 7) << 3) | (rSrc & 7))
        emit8(imm)
    end
end

func cgEmitVkLoader()
    emitLabel(cgVkLoaderLabel)

    # проход — с трамплина: цель вызова лезат на метку до него (jmp +2 по остатке трамплина).
    emit8(0xEB)
    emit8(0x02)

    # трамплин для ненайденных символов релок (SIGILL вместо нуля)
    var ud2: int = cgCodeLen
    emit8(0x0F)
    emit8(0x0B)

    var failL: int = newLabel()
    var parseL: int = newLabel()
    var v2fL: int = newLabel()
    var strcmpL: int = newLabel()
    var lookupL: int = newLabel()
    var applyL: int = newLabel()
    var stubL: int = newLabel()
    var stubOut: int = newLabel()
    var stubRet0: int = newLabel()
    var stubRetZero: int = newLabel()
    var stubDie: int = newLabel()
    var stubMalloc: int = newLabel()
    var stubCalloc: int = newLabel()
    var stubRealloc: int = newLabel()
    var stubMemcpy: int = newLabel()
    var stubMemmove: int = newLabel()
    var stubMemset: int = newLabel()
    var stubMemcmp: int = newLabel()
    var stubStrlen: int = newLabel()
    var stubStrcmp: int = newLabel()
    var stubStrncmp: int = newLabel()
    var stubStrcpy: int = newLabel()
    var stubStrchr: int = newLabel()
    var stubStrcspn: int = newLabel()
    var stubStrncpy: int = newLabel()
    var stubStrspn: int = newLabel()
    var stubStrpbrk: int = newLabel()
    var stubStrrchr: int = newLabel()
    var stubStrstr: int = newLabel()
    var stubVsnprintf: int = newLabel()
    var stubRetM1: int = newLabel()
    var stubDirname: int = newLabel()
    var stubGetuid: int = newLabel()
