            if r < 0
                r = 0
            end
            var setOp: int = 0x93
            if cgStrIs(op, "==") == 1
                setOp = 0x94
            else if cgStrIs(op, "!=") == 1
                setOp = 0x95
            else if cgStrIs(op, "<") == 1
                setOp = 0x92
            else if cgStrIs(op, ">") == 1
                setOp = 0x97
            else if cgStrIs(op, "<=") == 1
                setOp = 0x96
