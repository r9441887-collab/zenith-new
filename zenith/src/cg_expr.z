            emit8(0x99)
        else
            emit8(0x48)
            emit8(0x99)
        end
        emitMovRegImm(1, 100)
        if cgWordSize == 32
            emit8(0xF7)
        else
            emit8(0x48)
            emit8(0xF7)
        end
        emit8(0xF9)
        if saveRdx == 1
            emit8(0x5A)
        end
        if saveRcx == 1
            emit8(0x59)
        end
        freeReg(rightReg)
        if saveRax == 1
            var dst: int = findFreeRegOtherThan(cgRegsUsed, 0)
