    # ---- Create:File(name, content[, path]) (codegen.cpp:4415..4505) ----
    # Win32 CreateFileA/WriteFile/CloseHandle, no platform gate. Both strings
    # must be literals; with a non-empty path the target name is synthesized
    # (dir + '\\' + name), which is why the pool entry is taken through the
    # raw-string path with a stable heap copy.
