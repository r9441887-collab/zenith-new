        if res2 < 0
            res2 = 0
        end
        emitMovssXmmFromMem(res2, 4, 0)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x10)
        freeXmmReg(ax2)
        freeXmmReg(ay2)
        return res2
    end

