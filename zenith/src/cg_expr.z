# rdi(7)/rsi(6)/rdx(2)/rcx(1) — из аллокатора; пин после staging, чтобы
# выражение следующего аргумента не затёрло уже поставленный регистр.
func cgHttpDlGuard(wantReg: int)
    if wantReg == 6 || wantReg == 7 || wantReg == 1 || wantReg == 2
        cgRegsUsed = cgRegsUsed | (1 << wantReg)
    end
end

# mov r8/r9, r64: REX.W(+B) 0x48/0x49, opcode 89 /r; modrm.reg = src,
# modrm.rm = dst&7 (REX.B даёт третий бит). Аллокатор никогда не выдаёт r8/r9.
func cgHttpDlEmitRx(dst: int, src: int)
    var rex: int = 0x48
    if dst >= 8
        rex = 0x49
    end
    emit8(rex)
    emit8(0x89)
    emit8(0xC0 | ((src & 7) << 3) | (dst & 7))
end

# kBlobRegs[5] = { 6, 2, 1, 8, 9 } (codegen_httpdl.cpp:214)
func cgHttpDlBlobReg(i: int) -> int
    if i == 0
        return 6
    end
    if i == 1
        return 2
    end
    if i == 2
        return 1
    end
    if i == 3
        return 8
    end
    return 9
end

# codegen_httpdl.cpp:125..277
func cgTryHttpDlCall(c: int) -> int
    var name: int = cgF(c, 0)
    var op: int = 0
    var winPe: int = 0
    if cgStrIs(name, "http_download") == 1
        op = 1
    else if cgStrIs(name, "http_download_ask") == 1
        op = 2
    else if cgStrIs(name, "http_download_speed") == 1
        op = 3
    else if cgStrIs(name, "http_server") == 1
        op = 4
    else if cgStrIs(name, "http_download_ghreleases") == 1
        op = 5
    else if cgStrIs(name, "http_download_ask_gh") == 1
        op = 6
    else if cgStrIs(name, "http_download_msiso") == 1
        op = 7
    else if cgStrIs(name, "http_download_winpe") == 1
        op = 8
        winPe = 1
    else if cgStrIs(name, "http_download_winpe_media") == 1
        op = 9
    else if cgStrIs(name, "iso_extract") == 1 || cgStrIs(name, "http_download_iso") == 1
        op = 8
    else
        return 0
    end

    var argc: int = cgCallArgc(c)
    if op == 4
        if argc < 1 || argc > 3
            return 0
        end
    else if op == 5
        if argc != 4
            return 0
        end
    else if op == 6
        if argc != 5
            return 0
        end
    else if op == 7 || (op == 8 && winPe == 1) || op == 9
        if argc < 1 || argc > 2
            return 0
        end
    else if op == 8
        if argc < 2 || argc > 3
            return 0
        end
    else if argc != 2
        return 0
    end

    if cgHttpDlEntryLabel < 0
        cgHttpDlEntryLabel = newLabel()
    end
    cgHttpDlUsed = 1

    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    var done: int = newLabel()
    var exitLabel: int = newLabel()

    if op == 4
        # http_server(port[, cert, key]): port->rsi, cert->rdx, key->rcx.
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgHttpDlGuard(6)

        if argc >= 2
            var a1: int = cgEmitExpr(cgCallArg(c, 1))
            if a1 != 2
                emitMovReg(2, a1)
            end
            freeReg(a1)
            cgHttpDlGuard(2)
        else
            emit8(0x31)
            emit8(0xD2)
            cgHttpDlGuard(2)
        end
        if argc >= 3
            var a2: int = cgEmitExpr(cgCallArg(c, 2))
            if a2 != 1
                emitMovReg(1, a2)
            end
            freeReg(a2)
            cgHttpDlGuard(1)
        else
            emit8(0x31)
            emit8(0xC9)
            cgHttpDlGuard(1)
        end
    else if op >= 5 && op <= 9
        # SysV: a1=rsi a2=rdx a3=rcx a4=r8 a5=r9 (rdi = op). Порядок слева
        # направо сохраняет порядок вычисления аргументов; r8/r9 выживают,
        # потому что физические и аллокатор их не трогает.
        var i: int = 0
        while i < argc
            var t: int = cgEmitExpr(cgCallArg(c, i))
            var br: int = cgHttpDlBlobReg(i)
            if br >= 8
                cgHttpDlEmitRx(br, t)
                freeReg(t)
            else
                if t != br
                    emitMovReg(br, t)
                end
                freeReg(t)
                cgHttpDlGuard(br)
            end
            i = i + 1
        end
        if argc < 2
            emit8(0x31)
            emit8(0xD2)
            cgHttpDlGuard(2)
        end
        if op == 8
            if argc < 3
                emit8(0x31)
                emit8(0xC9)
                cgHttpDlGuard(1)
            end
            emit8(0x41)
            emit8(0xC7)
            emit8(0xC0)
            emit32(winPe)
        else if op == 9
            emit8(0x45)
            emit8(0x31)
            emit8(0xC0)
        end
    else
        # url -> rsi (a1)
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgHttpDlGuard(6)

        # file -> rdx (a2)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        if a1 != 2
            emitMovReg(2, a1)
        end
        freeReg(a1)
        cgHttpDlGuard(2)
    end

    # op -> rdi
    emit8(0x48)
    emit8(0xC7)
    emit8(0xC7)
    emit32(op)
    cgHttpDlGuard(7)

    emit8(0xE8)
    cgFixPush(cgCodeLen, cgHttpDlEntryLabel)
    emit32(0)
    emitJmp(done)

    emitLabel(done)
    emitJmp(exitLabel)

    emitLabel(exitLabel)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# codegen_disasm.cpp — disasm()/disasm_one() поверх embedded x86-64
# дизассемблера (tools/disasm_blob.cpp -> src/disasm_blob.h).
#
# Блоб в .text кладёт cgEmitDisasmBlob() (src/cg_disasm_blob.z); здесь —
# только `call rel32` в его точку входа. ABI SysV-внутренний:
#     long long disasm_entry(op=rdi, dst=rsi, cap=rdx, src=rcx,
#                            srcLen=r8, base=r9, syntax=[rsp+8],
#                            flags=[rsp+16])
#   op 1 (mass): весь src -> dst; 0, если влезло, иначе точная длина.
#   op 2 (one):  одна инструкция по src; возвращает её длину.
#   disasm(dst, cap, src, srclen, base[, syntax[, flags]])
#   disasm_one(src, srclen, base)
#
# Порядок регистрации — codegen.cpp:5610 (после tryJsCall). Разворачиваем
# лямбды C++ в cgDs*-функции: в .z их нет (см. cgWw* в «части 15»).
# ============================================================================

# SysV ABI-номера регистров в этом аллокаторе: rdi=7, rsi=6, rdx=2, rcx=1.
# r8/r9 — не регистры аллокатора, им отданы REX-prefixed mov.
const CG_DS_ABI_OP: int = 7
const CG_DS_ABI_DST: int = 6
const CG_DS_ABI_CAP: int = 2
const CG_DS_ABI_SRC: int = 1

# codegen_disasm.cpp:150..153 — «закрепить» уже сложенные ABI-регистры.
func cgDsGuard(wantReg: int)
    if wantReg == 7 || wantReg == 6 || wantReg == 2 || wantReg == 1
        cgRegsUsed = cgRegsUsed | (1 << wantReg)
    end
end

# codegen_disasm.cpp:154..161 — mov r8/r9, <reg аллокатора>.
func cgDsMovR8(src: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC0 + src * 8)
end

func cgDsMovR9(src: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC1 + src * 8)
end

# codegen_disasm.cpp:165..171 — выложить аргумент в ABI-регистр. r8/r9 не
# регистры аллокатора (cgEmitExpr их не трогает), поэтому кормятся последними
# и освобождаются сразу.
func cgDsStageAbi(e: int, abiReg: int)
    var r: int = cgEmitExpr(e)
    if abiReg == 8
        cgDsMovR8(r)
        freeReg(r)
        return
    end
    if abiReg == 9
        cgDsMovR9(r)
        freeReg(r)
        return
    end
    if r != abiReg
        emitMovReg(abiReg, r)
        freeReg(r)
    end
    cgDsGuard(abiReg)
end

# codegen_disasm.cpp:185..195 — 7-й и 8-й аргументы лежат в [rsp]/[rsp+8]
# от rsp ПЕРЕД call (Syntax/flags читает сама точка входа блоба).
func cgDsStoreStackSlot(e: int, slot: int)
    if e == 0
        return
    end
    var r: int = cgEmitExpr(e)
    if r == 0
        freeReg(0)
    else
        emitMovReg(0, r)
        freeReg(r)
    end
    if slot == 7
        emit8(0x48)
        emit8(0x89)
        emit8(0x04)
        emit8(0x24)
    else
        emit8(0x48)
        emit8(0x89)
        emit8(0x44)
        emit8(0x24)
        emit8(0x08)
    end
end

# codegen_disasm.cpp:124..128 — `call rel32` в точку входа блоба.
func cgDsEntryCall()
    emit8(0xE8)
    cgFixPush(cgCodeLen, cgDisasmEntryLabel)
    emit32(0)
end

func cgTryDisasmCall(c: int) -> int
    var name: int = cgF(c, 0)
    var isMass: int = 0
    var isOne: int = 0
    if cgStrIs(name, "disasm") == 1
        isMass = 1
    end
    if cgStrIs(name, "disasm_one") == 1
        isOne = 1
    end
    if isOne == 0 && isMass == 0
        return 0
    end

    var argc: int = cgCallArgc(c)
    var needArgs: int = 5
    var maxArgs: int = 7
    if isMass == 0
        needArgs = 3
        maxArgs = 3
    end
    if argc < needArgs || argc > maxArgs
        return 0
    end

    if cgDisasmEntryLabel < 0
        cgDisasmEntryLabel = newLabel()
    end
    cgDisasmUsed = 1

    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    if isMass == 1
        emitMovRegImm(CG_DS_ABI_OP, 1)
        cgDsStageAbi(cgCallArg(c, 0), CG_DS_ABI_DST)
        cgDsStageAbi(cgCallArg(c, 1), CG_DS_ABI_CAP)
        cgDsStageAbi(cgCallArg(c, 2), CG_DS_ABI_SRC)
        cgDsStageAbi(cgCallArg(c, 3), 8)
        cgDsStageAbi(cgCallArg(c, 4), 9)

        # arg7 -> [rsp], arg8 -> [rsp+8]; при argc < 6/7 слоты НЕ трогаем —
        # ровно как в C++ (nullptr-ветка storeStackSlot).
        if argc >= 6
            cgDsStoreStackSlot(cgCallArg(c, 5), 7)
        end
        if argc >= 7
            cgDsStoreStackSlot(cgCallArg(c, 6), 8)
        end

        cgDsEntryCall()
    else
        # disasm_one(src, srclen, base): op=2, syntax=0, flags=0, cap=1,
        # dst — scratch-слот на своём [rsp].
        var tmp: int = allocReg()
        emitMovRegImm(tmp, 0)
        emit8(0x48)
        emit8(0x89)
        emit8(0x04 + tmp * 8)
        emit8(0x24)
        emit8(0x48)
        emit8(0x89)
        emit8(0x44 + tmp * 8)
        emit8(0x24)
        emit8(0x08)
        freeReg(tmp)

        emitMovRegImm(CG_DS_ABI_OP, 2)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x74)
        emit8(0x24)
        emit8(0x00)
        emitMovRegImm(CG_DS_ABI_CAP, 1)
        cgDsStageAbi(cgCallArg(c, 0), CG_DS_ABI_SRC)
        cgDsStageAbi(cgCallArg(c, 1), 8)
        cgDsStageAbi(cgCallArg(c, 2), 9)

        cgDsEntryCall()
    end

    # Пересадить результат (rax -> регистр аллокатора) — так же, как TLS/JS.
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# codegen_tls.cpp — tls_* поверх embedded TLS 1.2 blob (src/tls_blob.h)
#
# Реальный TLS 1.2 (ECDHE-RSA-AES128-GCM-SHA256) на сыром сокете, без libc.
# Всё внутри position-independent freestanding-блоба, который в .text кладёт
# cgEmitTlsBlob() (src/cg_tls_blob.z); здесь — только staged SysV-вызов
# `call rel32` в его точку входа (tlsrt_entry): rdi=op, rsi=a1, rdx=a2,
# rcx=a3, r8=a4, r9=a5, результат в rax.
#
#   tls_connect(sock, host) -> session handle | -1   (host = NUL-terminated)
#   tls_send(handle, buf, len) -> bytes sent | -1
#   tls_recv(handle, buf, len) -> bytes read | 0 (closed) | -1 (err)
#   tls_close(handle) -> 0 | -1
#   tls_last_error()  -> int TLS error code
#
# Порядок регистрации — codegen.cpp:5593 (после trySoundCall, до tryJsCall).
#
# ЗАМЕЧАНИЕ ПО ФИКСТУРАМ: tlsFixups (io-флаг TLS_IO_DONE) и importCallFixups
# (send/recv/closesocket из PE IAT) на Linux НЕ резолвятся — их патчит только
# buildPE (codegen_pe.cpp:1841) и PE-ветка resolveFixups, а buildELF работает
# с elfImportFixups. Поэтому disp32 у них остаётся нулём и в эталоне, и здесь;
# cgPushImportCall вызываем только ради checkFixupOverlaps.
# ============================================================================

# SysV ABI-номера регистров в этом аллокаторе: rdi=7, rsi=6, rdx=2, rcx=1.
const CG_TLS_ABI_SOCK: int = 6
const CG_TLS_ABI_HOST: int = 2
const CG_TLS_ABI_LEN: int = 1

# codegen_tls.cpp:187..190 — «закрепить» уже сложенные ABI-регистры, чтобы
# выражения следующих аргументов их не вытеснили.
func cgTlsGuard(wantReg: int)
    if wantReg == 6 || wantReg == 7 || wantReg == 1 || wantReg == 2
        cgRegsUsed = cgRegsUsed | (1 << wantReg)
    end
end

# codegen_tls.cpp:159..163 — `call rel32` в точку входа блоба. rdi..r9
# обязаны быть выложены заранее; результат придёт в rax.
func cgTlsEntryCall()
    emit8(0xE8)
    cgFixPush(cgCodeLen, cgTlsEntryLabel)
    emit32(0)
end

# codegen_tls.cpp:123..155 — однократная заливка io-слотов блоба
# (send/recv/closesocket), под защитой .data-флага TLS_IO_DONE. Указатели
# берутся из PE IAT RIP-ссылками (на Linux их disp32 остаётся нулём —
# см. комментарий сверху), потому что .text для tls-приложений записываем.
func cgEmitTlsIoInit()
    var skip: int = newLabel()

    # mov rax,[rip+&tlsIoDone]; cmp qword [rax],0; jnz skip
    emit8(0x48)
    emit8(0x8D)
    emit8(0x05)
    emit32(0)
    emit8(0x48)
    emit8(0x83)
    emit8(0x38)
    emit8(0x00)
    emitJccLit("!=", skip)

    # send -> rsi (a1)
    emit8(0x48)
    emit8(0x8B)
    emit8(0x05)
    cgPushImportCall(cgCodeLen, "send", "ws2_32.dll")
    emit32(0)
    emit8(0x48)
    emit8(0x89)
    emit8(0xC6)

    # recv -> rdx (a2)
    emit8(0x48)
    emit8(0x8B)
    emit8(0x05)
    cgPushImportCall(cgCodeLen, "recv", "ws2_32.dll")
    emit32(0)
    emit8(0x48)
    emit8(0x89)
    emit8(0xC2)

    # closesocket -> rcx (a3)
    emit8(0x48)
    emit8(0x8B)
    emit8(0x05)
    cgPushImportCall(cgCodeLen, "closesocket", "ws2_32.dll")
    emit32(0)
    emit8(0x48)
    emit8(0x89)
    emit8(0xC1)

    # op = TLS_OP_IO_INIT (1) -> rdi
    emit8(0x48)
    emit8(0xC7)
    emit8(0xC7)
    emit32(1)

    cgTlsEntryCall()

    # mark done: lea rax,[&tlsIoDone]; mov qword [rax],1
    emit8(0x48)
    emit8(0x8D)
    emit8(0x05)
    emit32(0)
    emit8(0x48)
    emit8(0xC7)
    emit8(0x00)
    emit32(1)

    emitLabel(skip)
end

func cgTryTlsCall(c: int) -> int
    var name: int = cgF(c, 0)
    var isConn: int = 0
    var isXfer: int = 0
    var isClose: int = 0
    var isErr: int = 0
    if cgStrIs(name, "tls_connect") == 1
        isConn = 1
    end
    if cgStrIs(name, "tls_send") == 1 || cgStrIs(name, "tls_recv") == 1
        isXfer = 1
    end
    if cgStrIs(name, "tls_close") == 1
        isClose = 1
    end
    if cgStrIs(name, "tls_last_error") == 1
        isErr = 1
    end
    if isConn == 0 && isXfer == 0 && isClose == 0 && isErr == 0
        return 0
    end

    var argc: int = cgCallArgc(c)
    if isConn == 1
        if argc != 2
            return 0
        end
    end
    if isXfer == 1
        if argc != 3
            return 0
        end
    end
    if isClose == 1
        if argc != 1
            return 0
        end
    end
    if isErr == 1
        if argc != 0
            return 0
        end
    end

    if cgTlsEntryLabel < 0
        cgTlsEntryLabel = newLabel()
    end
    cgTlsUsed = 1

    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    var tlsExit: int = newLabel()
    var done: int = newLabel()

    # ======= tls_connect(sock, host) -> session handle | -1 =======
    if isConn == 1
        cgEmitTlsIoInit()

        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgTlsGuard(6)

        var host: int = cgCallArg(c, 1)
        var lit: int = 0
        if cgTag(host) == N_STRING
            lit = 1
        end

        var a1: int = cgEmitExpr(host)
        if a1 != 2
            emitMovReg(2, a1)
        end
        freeReg(a1)
        cgTlsGuard(2)

        if lit == 1
            # mov rcx, literalLen  -> rcx = a3 (host_len)
            emit8(0x48)
            emit8(0xC7)
            emit8(0xC1)
            emit32(cgStrLen(cgF(host, 0)))
        else
            # strlen(rdx) -> rcx   (host — NUL-терминированный буфер)
            emit8(0x31)
            emit8(0xC9)
            var strLoop: int = newLabel()
            var strEnd: int = newLabel()
            emitLabel(strLoop)
            emit8(0x0F)
            emit8(0xB6)
            emit8(0x04)
            emit8(0x0E)
            emit8(0x84)
            emit8(0xC0)
            emitJccLit("==", strEnd)
            emit8(0x48)
            emit8(0xFF)
            emit8(0xC1)
            emit8(0xE9)
            cgFixPush(cgCodeLen, strLoop)
            emit32(0)
            emitLabel(strEnd)
        end
        cgTlsGuard(1)

        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(20)
        cgTlsEntryCall()
        emitJmp(done)
    end

    # ======= tls_send/tls_recv(handle, buf, len) =======
    if isXfer == 1
        cgEmitTlsIoInit()

        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgTlsGuard(6)

        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        if a1 != 2
            emitMovReg(2, a1)
        end
        freeReg(a1)
        cgTlsGuard(2)

        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        if a2 != 1
            emitMovReg(1, a2)
        end
        freeReg(a2)
        cgTlsGuard(1)

        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        if cgStrIs(name, "tls_send") == 1
            emit32(21)
        else
            emit32(22)
        end
        cgTlsEntryCall()
        emitJmp(done)
    end

    # ======= tls_close(handle) =======
    if isClose == 1
        cgEmitTlsIoInit()

        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgTlsGuard(6)

        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(23)
        cgTlsEntryCall()
        emitJmp(done)
    end

    # ======= tls_last_error() =======
    if isErr == 1
        cgEmitTlsIoInit()
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(24)
        cgTlsEntryCall()
        emitJmp(done)
    end

    emitLabel(done)
    emitJmp(tlsExit)

    # ============== Common exit: reseat result in an allocator register ====
    emitLabel(tlsExit)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# codegen_js.cpp — JS builtins (`js_*` над встроенным JS-движком)
#
# Freestanding position-independent x86-64 JS engine (src/js_blob.h,
# генератор tools/gen_js_blob_z.py) дописывается в .text один раз
# (cgEmitJsBlob) и вызывается через `call rel32` в точку входа (jsrt_entry).
# ABI внутри SysV-internal: op в rdi, a1 в rsi, a2 в rdx, a3 в rcx, результат
# в rax. Блоб не зовёт внешних функций и держит своё состояние (4 MiB arena
# + globals) в собственном .bss, который кодоген дописывает нулями сразу за
# кодом; .text становится RWX при cgJsUsed (p_flags уже считает его).
#
#   js_reset()  -> int   чистит arena + глобальное окружение
#   js_eval(code) -> int исполняет JS-программу; число последнего выражения
#   js_result()  -> str  строка последнего вычисленного выражения
#   js_error()   -> str  текст последней ошибки
#
# host-колбэки (fs/net/tls/print): каждый слот g_host_fn[] на Linux — это
# просто blobStart + смещение реализации внутри самого блоба
# (tools/js_host_linux.c; codegen_js.cpp:85..100 и :210..222), поэтому ни
# заглушек, ни патчинга не нужно: installHost() пишет в слот адрес внутри
# .text, а однократность защищает RWX-байт-флаг рядом с блобом.
# ============================================================================

# codegen_js.cpp:257..260 — guard(wantReg): аргументы, выложенные в
# rdi/rsi/rdx/rcx, нельзя отдать реаллокатору, пока не сгенерированы
# оставшиеся arg-выражения. Набор {7,6,2,1} — те же, что у cgTlsGuard.
func cgJsGuard(wantReg: int)
    if wantReg == 7 || wantReg == 6 || wantReg == 2 || wantReg == 1
        cgRegsUsed = cgRegsUsed | (1 << wantReg)
    end
end

# codegen_js.cpp:231..235 — `call rel32` в точку входа блоба (jsrt_entry).
# rdi/rsi/rdx/rcx должны быть выложены заранее; результат придёт в rax.
func cgJsEntryCall()
    emit8(0xE8)
    cgFixPush(cgCodeLen, cgJsEntryLabel)
    emit32(0)
end

func cgTryJsCall(c: int) -> int
    var name: int = cgF(c, 0)
    var isReset: int = 0
    var isEval: int = 0
    var isResult: int = 0
    var isError: int = 0
    if cgStrIs(name, "js_reset") == 1
        isReset = 1
    end
    if cgStrIs(name, "js_eval") == 1
        isEval = 1
    end
    if cgStrIs(name, "js_result") == 1
        isResult = 1
    end
    if cgStrIs(name, "js_error") == 1
        isError = 1
    end
    if isReset == 0 && isEval == 0 && isResult == 0 && isError == 0
        return 0
    end

    # arity: js_eval ровно 1 аргумент, остальные — ровно 0
    var argc: int = cgCallArgc(c)
    if isEval == 1
        if argc != 1
            return 0
        end
    end
    if isEval == 0
        if argc != 0
            return 0
        end
    end

    if cgJsEntryLabel < 0
        cgJsEntryLabel = newLabel()
    end
    cgJsUsed = 1

    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    # ======= js_reset() =======
    if isReset == 1
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(0)
        cgJsEntryCall()
    end

    # ======= js_eval(code) =======
    if isEval == 1
        # Однократная установка host-таблицы под защитой RWX-байта-флага
        # в .text: на неё ссылаются require()/httpGet()/print() движка.
        if cgJsHostFlagLabel < 0
            cgJsHostFlagLabel = newLabel()
            var s0: int = 0
            while s0 < 24
                cgJsHostStubLabel[s0] = newLabel()
                s0 = s0 + 1
            end
        end
        var hostSkip: int = newLabel()

        # lea rax,[rip+&flag]; cmp byte [rax], 0; jne hostSkip
        emit8(0x48)
        emit8(0x8D)
        emit8(0x05)
        cgFixPush(cgCodeLen, cgJsHostFlagLabel)
        emit32(0)
        emit8(0x80)
        emit8(0x38)
        emit8(0x00)
        emitJccLit("!=", hostSkip)

        # installHost(slot): rdi = JS_OP_SET_HOST(6), rsi = slot,
        # rdx = lea &jsHostStubLabel[slot], затем call jsrt_entry.
        # Порядок строк kJsHostLinux (codegen_js.cpp:85..100) задаёт
        # cgJsHostSlotAt(): 0,1,2,3,12,13,14,15,16,17,18,20,21,22.
        var hi: int = 0
        var hslot: int = cgJsHostSlotAt(0)
        while hslot >= 0
            emit8(0x48)
            emit8(0xC7)
            emit8(0xC7)
            emit32(6)
            emit8(0x48)
            emit8(0xC7)
            emit8(0xC6)
            emit32(hslot)
            emit8(0x48)
            emit8(0x8D)
            emit8(0x15)
            cgFixPush(cgCodeLen, cgJsHostStubLabel[hslot])
            emit32(0)
            cgJsEntryCall()
            hi = hi + 1
            hslot = cgJsHostSlotAt(hi)
        end

        # lea rax,[rip+&flag]; mov byte [rax], 1
        emit8(0x48)
        emit8(0x8D)
        emit8(0x05)
        cgFixPush(cgCodeLen, cgJsHostFlagLabel)
        emit32(0)
        emit8(0xC6)
        emit8(0x00)
        emit8(0x01)
        emitLabel(hostSkip)

        var codeArg: int = cgCallArg(c, 0)
        var lit: int = 0
        if cgTag(codeArg) == N_STRING
            lit = 1
        end

        var a: int = cgEmitExpr(codeArg)
        if a != 6
            emitMovReg(6, a)
        end
        freeReg(a)
        cgJsGuard(6)

        if lit == 1
            # mov rdx, literal length (codegen_js.cpp:307..310)
            emit8(0x48)
            emit8(0xC7)
            emit8(0xC2)
            emit32(cgStrLen(cgF(codeArg, 0)))
        else
            # strlen(rsi) -> rdx (не-литерал: цикл по байтам)
            emit8(0x31)
            emit8(0xD2)
            var strLoop: int = newLabel()
            var strEnd: int = newLabel()
            emitLabel(strLoop)
            emit8(0x0F)
            emit8(0xB6)
            emit8(0x04)
            emit8(0x16)
            emit8(0x84)
            emit8(0xC0)
            emitJccLit("==", strEnd)
            emit8(0x48)
            emit8(0xFF)
            emit8(0xC2)
            emit8(0xE9)
            cgFixPush(cgCodeLen, strLoop)
            emit32(0)
            emitLabel(strEnd)
        end
        cgJsGuard(2)

        # JS_OP_EXEC, затем JS_OP_NUM — вернуть число последнего результата
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(1)
        cgJsEntryCall()
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        emit32(5)
        cgJsEntryCall()
    end

    # ======= js_result() / js_error() =======
    if isResult == 1 || isError == 1
        var slot: int = CG_JS_SLOT_RESULT
        if isError == 1
            slot = CG_JS_SLOT_ERROR
        end

        # lea rsi,[rip+&slot]  (a1 = out buffer)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x35)
        cgPushJsFix(cgCodeLen, slot)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(512)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC7)
        if isError == 1
            emit32(4)
        else
            emit32(3)
        end
        cgJsEntryCall()

        # lea rax,[rip+&slot] — вернуть адрес буфера, а не длину из rax
        emit8(0x48)
        emit8(0x8D)
        emit8(0x05)
        cgPushJsFix(cgCodeLen, slot)
        emit32(0)
    end

    # ============== Common exit: reseat result in an allocator register ====
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# codegen_wl_linux.cpp — Wayland display-сокет (`app linux`), raw syscall
#
# Никакого libwayland: каждый байт протокола пишется в эмитируемый код.
#   wl_open()         -> fd подключённого display-сокета | -1
#   wl_list_globals() -> roundtrip: печатает "interface:name:version", версёт счётчик
#   wl_close(fd)      -> 0 | -1
#
# Состояние живёт в r12/r13/r14 (callee-saved, пушатся здесь) плюс rbx/r8
# (сохраняются syscall'ом); SysV: nr в rax, аргументы в
# rdi,rsi,rdx,r10,r8,r9.
#
# Билтины окна/shm-framebuffer (`wl_create_window`, `wl_present`,
# `wl_process`, `wl_close_window`, `wl_fb`, `wl_pixel`) в C++ уходят в
# tryLinuxWLWindowCall (codegen_wl_window.cpp, портирован в cg_expr.z ниже)
# — там свой wire-протокол поверх того же cgWlOutRVA/cgWlInRVA. Порядок в
# C++: сначала окно, потом isWLBuiltin.
# ============================================================================

func cgDetectWLExpr(e: int)
    if e == 0
        return
    end
    var t: int = cgTag(e)
    if t == N_CALL
        if cgStrHasPrefix(cgF(e, 0), "wl_") == 1
            cgWlUsed = 1
        end
        var na: int = cgCallArgc(e)
        var ai: int = 0
        while ai < na
            cgDetectWLExpr(cgCallArg(e, ai))
            ai = ai + 1
        end
        return
    end
    if t == N_BINARY
        cgDetectWLExpr(cgF(e, 0))
        cgDetectWLExpr(cgF(e, 1))
    else if t == N_MEMBER
        cgDetectWLExpr(cgF(e, 0))
    else if t == N_ARRAYACC
        cgDetectWLExpr(cgF(e, 0))
        cgDetectWLExpr(cgF(e, 1))
    else if t == N_UNARY
        # f0 = оператор (strId), операнд — f1 (см. cgEmitUnaryExpr)
        cgDetectWLExpr(cgF(e, 1))
    end
end

func cgDetectWLBlock(start: int, len: int)
    if start == 0 || len <= 0
        return
    end
    var i: int = 0
    while i < len
        cgDetectWLStmt(cgSide(start + i))
        i = i + 1
    end
end

# В отличие от detectNetSock*/detectHttpDl* тут НЕТ Assign и Switch —
# дословно по detectWLStmt (codegen_wl_linux.cpp:72..96).
func cgDetectWLStmt(s: int)
    if s == 0
        return
    end
    var t: int = cgTag(s)
    if t == N_RETURN
        cgDetectWLExpr(cgF(s, 0))
    else if t == N_EXPRSTMT
        cgDetectWLExpr(cgF(s, 0))
    else if t == N_VARDECL
        cgDetectWLExpr(cgF(s, 7))
    else if t == N_IF
        cgDetectWLExpr(cgF(s, 0))
        cgDetectWLBlock(cgF(s, 1), cgF(s, 2))
        cgDetectWLBlock(cgF(s, 3), cgF(s, 4))
    else if t == N_WHILE
        cgDetectWLExpr(cgF(s, 0))
        cgDetectWLBlock(cgF(s, 1), cgF(s, 2))
    else if t == N_LOOP
        cgDetectWLBlock(cgF(s, 0), cgF(s, 1))
    else if t == N_FOR
        cgDetectWLExpr(cgF(s, 1))
        cgDetectWLExpr(cgF(s, 2))
        cgDetectWLExpr(cgF(s, 3))
        cgDetectWLBlock(cgF(s, 4), cgF(s, 5))
    end
end

func cgDetectWLUsage()
    if cgWlUsed != 0
        return
    end
    var fs: int = cgH(H_FUNCS)
    var fl: int = cgH(H_FUNCS + 1)
    var i: int = 0
    while i < fl
        var fid: int = cgSide(fs + i)
        if fid != 0
            if cgTag(fid) == N_FUNC
                if cgF(fid, 11) == 0
                    cgDetectWLBlock(cgF(fid, 9), cgF(fid, 10))
                end
            end
        end
        if cgWlUsed != 0
            return
        end
        i = i + 1
    end
    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    var g: int = 0
    while g < gl
        var gid: int = cgSide(gs + g)
        if gid != 0
            cgDetectWLExpr(cgF(gid, 7))
        end
        if cgWlUsed != 0
            return
        end
        g = g + 1
    end
end

# pop r14/r13/r12/rsi/rdi + add rsp,8 и прыжок на общий выход (codegen_wl_linux.cpp:150..158)
func cgWlLeave(label: int)
    emit8(0x41)
    emit8(0x5E)
    emit8(0x41)
    emit8(0x5D)
    emit8(0x41)
    emit8(0x5C)
    emit8(0x5E)
    emit8(0x5F)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
    emitJmp(label)
end

# Дecimal-принтер в stdout: u32 в eax, div по 10 в обратный scratch-буфер.
# Ломает rax,rcx,rdx,rsi,rdi,r9; сохраняет rbx, r8, r12, r13, r14.
func cgWlDecWrite()
    cgVkLeaRip(7, cgWlTmpRVA)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC7)
    emit8(0x1F)
    emit8(0x51)
    emit8(0x31)
    emit8(0xC9)
    emit8(0x41)
    emit8(0xB9)
    emit32(10)
    var decTop: int = newLabel()
    emitLabel(decTop)
    emit8(0x31)
    emit8(0xD2)
    emit8(0x41)
    emit8(0xF7)
    emit8(0xF1)
    emit8(0x80)
    emit8(0xC2)
    emit8(0x30)
    emit8(0x48)
    emit8(0xFF)
    emit8(0xCF)
    emit8(0x88)
    emit8(0x17)
    emit8(0xFF)
    emit8(0xC1)
    emit8(0x85)
    emit8(0xC0)
    emitJccLit("!=", decTop)
    emit8(0x48)
    emit8(0x89)
    emit8(0xFE)
    emit8(0x48)
    emit8(0x89)
    emit8(0xCA)
    emit8(0xBF)
    emit32(1)
    cgNetSvc(1)
    emit8(0x59)
end

# codegen_wl_linux.cpp:104..444
func cgTryLinuxWLCall(c: int) -> int
    var name: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    # Окно/shm-framebuffer уходят в tryLinuxWLWindowCall (codegen_wl_window.cpp) —
    # в C++ эта проверка стоит ДО isWLBuiltin (codegen_wl_linux.cpp:110..113).
    if cgStrIs(name, "wl_create_window") == 1 || cgStrIs(name, "wl_present") == 1 || cgStrIs(name, "wl_process") == 1 || cgStrIs(name, "wl_close_window") == 1 || cgStrIs(name, "wl_fb") == 1 || cgStrIs(name, "wl_pixel") == 1
        return cgTryLinuxWLWindowCall(c)
    end

    var isWLBuiltin: int = 0
    if cgStrIs(name, "wl_open") == 1 || cgStrIs(name, "wl_list_globals") == 1 || cgStrIs(name, "wl_close") == 1
        isWLBuiltin = 1
    end
    if isWLBuiltin == 0
        return 0
    end
    if (cgStrIs(name, "wl_open") == 1 || cgStrIs(name, "wl_list_globals") == 1) && argc != 0
        return 0
    end
    if cgStrIs(name, "wl_close") == 1 && argc != 1
        return 0
    end

    cgWlUsed = 1

    # Staging как в net/vulkan: spill, пауза аллокатора, push callee-saved
    # rdi (7) / rsi (6) и r12/r13/r14 (вне пула).
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    emit8(0x57)
    emit8(0x56)
    emit8(0x41)
    emit8(0x54)
    emit8(0x41)
    emit8(0x55)
    emit8(0x41)
    emit8(0x56)

    var wlExit: int = newLabel()

    # ---- wl_open() -> connected display socket fd | -1 ----
    if cgStrIs(name, "wl_open") == 1
        var done: int = newLabel()
        var sockFail: int = newLabel()
        var envFail: int = newLabel()
        var connFail: int = newLabel()

        # fd = socket(AF_UNIX=1, SOCK_STREAM|SOCK_CLOEXEC=0x80001, 0)
        emit8(0xBF)
        emit32(1)
        emit8(0xBE)
        emit32(0x80001)
        emit8(0xBA)
        emit32(0)
        cgNetSvc(41)
        emitJccLit("<", sockFail)
        emit8(0x49)
        emit8(0x89)
        emit8(0xC4)

        # Build sun.sun_path = "$XDG_RUNTIME_DIR/wayland-0" at [cgWlPathRVA+2].
        cgVkLeaRip(2, cgWlPathRVA)
        emit8(0x66)
        emit8(0xC7)
        emit8(0x02)
        emit16(1)
        cgVkLeaRip(7, cgWlPathRVA)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC7)
        emit8(0x02)
        emit8(0x49)
        emit8(0x89)
        emit8(0xF9)

        # Scan envp (rab slot cgWlEnvRVA) for the "XDG_RUNTIME_DIR=" prefix.
        cgVkLeaRip(8, cgWlEnvRVA)
        emit8(0x4D)
        emit8(0x8B)
        emit8(0x00)
        cgVkLeaRip(7, cgWlXdgRVA)
        var envNext: int = newLabel()
        var preCmp: int = newLabel()
        var envInc: int = newLabel()
        emitLabel(envNext)
        emit8(0x49)
        emit8(0x8B)
        emit8(0x30)
        emit8(0x48)
        emit8(0x85)
        emit8(0xF6)
        emitJccLit("==", envFail)
        emit8(0x31)
        emit8(0xC9)
        emitLabel(preCmp)
        emit8(0x8A)
        emit8(0x04)
        emit8(0x0E)
        emit8(0x3A)
        emit8(0x04)
        emit8(0x0F)
        emitJccLit("!=", envInc)
        emit8(0xFF)
        emit8(0xC1)
        emit8(0x83)
        emit8(0xF9)
        emit8(0x10)
        emit8(0x0F)
        emit8(0x82)
        cgFixPush(cgCodeLen, preCmp)
        emit32(0)
        # Matched: rsi -> value, rdi -> sun.sun_path (rebase from r9).
        emit8(0x48)
        emit8(0x8D)
        emit8(0x76)
        emit8(0x10)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xCF)
        var copyLoop: int = newLabel()
        var copyDone2: int = newLabel()
        emitLabel(copyLoop)
        emit8(0x8A)
        emit8(0x06)
        emit8(0x88)
        emit8(0x07)
        emit8(0x48)
        emit8(0xFF)
        emit8(0xC6)
        emit8(0x84)
        emit8(0xC0)
        emitJccLit("==", copyDone2)
        emit8(0x48)
        emit8(0xFF)
        emit8(0xC7)
        emitJmp(copyLoop)
        emitLabel(copyDone2)

        # Append the fixed "/wayland-0" suffix from .rdata.
        cgVkLeaRip(10, cgWlSfxRVA)
        emit8(0x31)
        emit8(0xC9)
        var sfxLoop: int = newLabel()
        var sfxDone: int = newLabel()
        emitLabel(sfxLoop)
        emit8(0x41)
        emit8(0x8A)
        emit8(0x04)
        emit8(0x0A)
        emit8(0x84)
        emit8(0xC0)
        emitJccLit("==", sfxDone)
        emit8(0x88)
        emit8(0x07)
        emit8(0x48)
        emit8(0xFF)
        emit8(0xC7)
        emit8(0xFF)
        emit8(0xC1)
        emitJmp(sfxLoop)
        emitLabel(sfxDone)
        emit8(0x31)
        emit8(0xC0)
        emit8(0x88)
        emit8(0x07)
        emit8(0x48)
        emit8(0xFF)
        emit8(0xC7)

        # addrlen = (rdi - sun.sun_path_base) + 1
        emit8(0x48)
        emit8(0x89)
        emit8(0xF8)
        emit8(0x4C)
        emit8(0x29)
        emit8(0xC8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x01)

        # connect(fd, &sun, addrlen)
        cgVkLeaRip(6, cgWlPathRVA)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC2)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xE7)
        emit8(0x45)
        emit8(0x31)
        emit8(0xD2)
        cgNetSvc(42)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", connFail)
        # Success: remember the fd and return it.
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x4C)
        emit8(0x89)
        emit8(0x22)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xE0)
        cgWlLeave(done)

        emitLabel(envInc)
        emit8(0x49)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x08)
        emitJmp(envNext)

        emitLabel(connFail)
        emitJmp(envFail)
        emitLabel(envFail)
        cgNetSvc(3)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(0xFFFFFFFF)
        cgWlLeave(done)

        emitLabel(sockFail)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(0xFFFFFFFF)
        cgWlLeave(done)

        emitLabel(done)
        emitJmp(wlExit)
    end

    # ---- wl_close(fd) -> 0 | -1 ----
    if cgStrIs(name, "wl_close") == 1
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgNetSvc(3)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", done)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(0xFFFFFFFF)
        emitLabel(done)
        cgWlLeave(wlExit)
    end

    # ---- wl_list_globals() -> count of advertised registry globals | -1 ----
    if cgStrIs(name, "wl_list_globals") == 1
        var done: int = newLabel()
        var noFd: int = newLabel()
        var cbDone: int = newLabel()

        # Must have connected first (wl_open).
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        emit8(0x85)
        emit8(0xFF)
        emitJccLit("<=", noFd)

        # Send the get_registry + sync handshake blob in one write().
        cgVkLeaRip(6, cgWlInitReqRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(24)
        cgNetSvc(1)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", noFd)

        # Read loop: batches of events until the sync callback's "done".
        # rbx = bytes read this batch ; r12 = parse offset ; r14 = count.
        var rdTop: int = newLabel()
        var rdEnd: int = newLabel()
        var pxLoop: int = newLabel()
        var rdNext: int = newLabel()
        var skipEvent: int = newLabel()
        emit8(0x45)
        emit8(0x31)
        emit8(0xF6)
        emitLabel(rdTop)
        cgVkLeaRip(6, cgWlInRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(4096)
        cgNetSvc(0)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<=", rdEnd)
        emit8(0x89)
        emit8(0xC3)
        cgVkLeaRip(8, cgWlInRVA)
        emit8(0x45)
        emit8(0x31)
        emit8(0xE4)

        emitLabel(pxLoop)
        emit8(0x49)
        emit8(0x39)
        emit8(0xDC)
        emitJccLit(">=", rdNext)
        emit8(0x4B)
        emit8(0x8D)
        emit8(0x0C)
        emit8(0x04)
        emit8(0x8B)
        emit8(0x39)
        emit8(0x85)
        emit8(0xFF)
        emitJccLit("<=", skipEvent)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x03)
        emitJccLit("==", cbDone)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x01)
        emitJccLit("==", skipEvent)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x02)
        emitJccLit("!=", skipEvent)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", skipEvent)

        # ---- print this global as "interface:name:version" ----
        emit8(0x8B)
        emit8(0x41)
        emit8(0x0C)
        emit8(0x83)
        emit8(0xE8)
        emit8(0x01)
        var ifaceSkip: int = newLabel()
        emit8(0x85)
        emit8(0xC0)
        emit8(0x0F)
        emit8(0x8E)
        cgFixPush(cgCodeLen, ifaceSkip)
        emit32(0)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC2)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x71)
        emit8(0x10)
        emit8(0xBF)
        emit32(1)
        cgNetSvc(1)
        emitLabel(ifaceSkip)

        # ':' then the numeric global name.
        cgVkLeaRip(6, cgWlColonRVA)
        emit8(0xBA)
        emit32(1)
        emit8(0xBF)
        emit32(1)
        cgNetSvc(1)
        # syscall clobbers rcx/r11 — reload the event pointer before the payload.
        emit8(0x4B)
        emit8(0x8D)
        emit8(0x0C)
        emit8(0x04)
        emit8(0x8B)
        emit8(0x41)
        emit8(0x08)
        cgWlDecWrite()

        cgVkLeaRip(6, cgWlColonRVA)
        emit8(0xBA)
        emit32(1)
        emit8(0xBF)
        emit32(1)
        cgNetSvc(1)

        # ':' then the version: payload offset 16 + align4(slen) -> u32.
        emit8(0x4B)
        emit8(0x8D)
        emit8(0x0C)
        emit8(0x04)
        emit8(0x8B)
        emit8(0x41)
        emit8(0x0C)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x03)
        emit8(0x83)
        emit8(0xE0)
        emit8(0xFC)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x10)
        emit8(0x8B)
        emit8(0x04)
        emit8(0x01)
        cgWlDecWrite()

        cgVkLeaRip(6, cgWlNlRVA)
        emit8(0xBA)
        emit32(1)
        emit8(0xBF)
        emit32(1)
        cgNetSvc(1)
        emit8(0x41)
        emit8(0xFF)
        emit8(0xC6)

        emitLabel(skipEvent)
        emit8(0x4B)
        emit8(0x8D)
        emit8(0x0C)
        emit8(0x04)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x06)
        emit8(0x49)
        emit8(0x01)
        emit8(0xC4)
        emitJmp(pxLoop)

        emitLabel(rdNext)
        emitJmp(rdTop)

        emitLabel(cbDone)
        emitLabel(rdEnd)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xF0)
        cgWlLeave(done)

        emitLabel(noFd)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(0xFFFFFFFF)
        emitLabel(done)
        emitJmp(wlExit)
    end

    # ================= Common exit: restore the allocator view ================
    emitLabel(wlExit)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# Wayland window / shm-framebuffer билтины для Linux-таргета (app linux) —
# сырой сокет + рукописный wire-протокол поверх wl_* из cgTryLinuxWLCall.
# Без libwayland, без libc: каждый байт рукописного хендшейка эмитится здесь.
#
#   wl_create_window(w, h, title) -> 0 (configured) | -1
#   wl_present()                  -> 0 | -1
#   wl_process()                  -> 0 (close requested) | 1 (keep going)
#   wl_close_window()             -> 0
#   wl_fb()                       -> shm framebuffer (ARGB8888, stride = w*4) | 0
#   wl_pixel(x, y, color)         -> store u32 at fb[(y*w+x)*4]
#
# Object ids: display=1, registry=2, sync-callback=3, wl_compositor=4,
# xdg_wm_base=5, wl_shm=6, wl_surface=7, xdg_surface=8, xdg_toplevel=9,
# wl_shm_pool=10, wl_buffer=11. Клиентские (new_id) объекты обязаны
# выделяться плотно в порядке создания с 2, поэтому путь окна переиспользует
# пару registry(2)/callback(3) — wl_list_globals() и оконный API мешать нельзя.
#
# Wire (LE): u32 object id | u16 opcode | u16 size (size = байт с заголовком).
# Payload: u(u32), s(u32 len c NUL + байты, pad до 4), o(u32), n(u32).
#
# Дисциплина регистров (сохраняются через leaf-синтетики):
#   r12 = w    r13 = title   r14 = h   (из аргументов вызова)
#   r10 = cgWlOutRVA base   r8 = cgWlInRVA base   r9d/rax = parse offset
#   rbx = bytes read / message size / buffer length
# SysV: syscall калечит rax, rcx (RIP), r11.
#
# codegen_wl_window.cpp:61..774
# ============================================================================

# ---- u32 request field builders against [r10 + off] ----
func cgWwOut32(off: int, v: int)
    emit8(0x41)
    emit8(0xC7)
    emit8(0x42)
    emit8(off)
    emit32(v)
end

func cgWwOutReg32(off: int, reg: int)
    if reg >= 8
        emit8(0x45)
    else
        emit8(0x41)
    end
    emit8(0x89)
    emit8(0x42 | ((reg & 7) << 3))
    emit8(off)
end

func cgWwOutHeader(off: int, id: int, op: int, sz: int)
    cgWwOut32(off, id)
    cgWwOut32(off + 4, op | (sz << 16))
end

# ---- write(n) to the display fd from cgWlOutRVA (rax = result) ----
func cgWwWriteOut(n: int)
    cgVkLeaRip(2, cgWlFdRVA)
    emit8(0x8B)
    emit8(0x3A)
    cgVkLeaRip(6, cgWlOutRVA)
    emit8(0x48)
    emit8(0xC7)
    emit8(0xC2)
    emit32(n)
    cgNetSvc(1)
end

func cgWwWriteLen()
    cgVkLeaRip(2, cgWlFdRVA)
    emit8(0x8B)
    emit8(0x3A)
    cgVkLeaRip(6, cgWlOutRVA)
    emit8(0x48)
    emit8(0x89)
    emit8(0xDA)
    cgNetSvc(1)
end

func cgWwWriteOutCheck(n: int, fail: int)
    cgWwWriteOut(n)
    emit8(0x48)
    emit8(0x85)
    emit8(0xC0)
    emitJccLit("<", fail)
end

# sendmsg(fd, &msghdr, 0) c SCM_RIGHTS, чтобы передать fd. msghdr+iov+cmsg
# строятся на стеке (96 байт).
func cgWwWriteOutFd(n: int, fdSlot: int, fail: int)
    emit8(0x48)
    emit8(0x81)
    emit8(0xEC)
    emit32(96)
    emit8(0x31)
    emit8(0xC0)
    emit8(0x48)
    emit8(0x89)
    emit8(0xE7)
    emit8(0xB9)
    emit32(24)
    emit8(0xF3)
    emit8(0xAB)
    emit8(0x48)
    emit8(0x8D)
    emit8(0x44)
    emit8(0x24)
    emit8(0x38)
    emit8(0x48)
    emit8(0x89)
    emit8(0x44)
    emit8(0x24)
    emit8(0x10)
    emit8(0x48)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x18)
    emit32(1)
    emit8(0x48)
    emit8(0x8D)
    emit8(0x44)
    emit8(0x24)
    emit8(0x48)
    emit8(0x48)
    emit8(0x89)
    emit8(0x44)
    emit8(0x24)
    emit8(0x20)
    emit8(0x48)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x28)
    emit32(24)
    cgVkLeaRip(0, cgWlOutRVA)
    emit8(0x48)
    emit8(0x89)
    emit8(0x44)
    emit8(0x24)
    emit8(0x38)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x40)
    emit32(n)
    emit8(0x48)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x48)
    emit32(20)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x50)
    emit32(1)
    emit8(0xC7)
    emit8(0x44)
    emit8(0x24)
    emit8(0x54)
    emit32(1)
    cgVkLeaRip(2, fdSlot)
    emit8(0x8B)
    emit8(0x02)
    emit8(0x89)
    emit8(0x44)
    emit8(0x24)
    emit8(0x58)
    cgVkLeaRip(2, cgWlFdRVA)
    emit8(0x8B)
    emit8(0x3A)
    emit8(0x48)
    emit8(0x89)
    emit8(0xE6)
    emit8(0x31)
    emit8(0xD2)
    cgNetSvc(46)
    emit8(0x48)
    emit8(0x85)
    emit8(0xC0)
    emit8(0x48)
    emit8(0x81)
    emit8(0xC4)
    emit32(96)
    emitJccLit("<", fail)
end

# rcx = &inbuf[r9] (r8 = inbuf base, r9d = parse offset).
func cgWwLeaEvent()
    emit8(0x4B)
    emit8(0x8D)
    emit8(0x0C)
    emit8(0x08)
end

# Сохранить регистровый аргумент в персистентные scratch-слоты.
func cgWwMovToR12(s: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC4 | ((s & 7) << 3))
end

func cgWwMovToR13(s: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC5 | ((s & 7) << 3))
end

func cgWwMovToR14(s: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC6 | ((s & 7) << 3))
end

func cgTryLinuxWLWindowCall(c: int) -> int
    var name: int = cgF(c, 0)
    var isWinBuiltin: int = 0
    if cgStrIs(name, "wl_create_window") == 1 || cgStrIs(name, "wl_present") == 1 || cgStrIs(name, "wl_process") == 1 || cgStrIs(name, "wl_close_window") == 1 || cgStrIs(name, "wl_fb") == 1 || cgStrIs(name, "wl_pixel") == 1
        isWinBuiltin = 1
    end
    if isWinBuiltin == 0
        return 0
    end
    if (cgStrIs(name, "wl_create_window") == 1 || cgStrIs(name, "wl_pixel") == 1) && cgCallArgc(c) != 3
        return 0
    end
    if cgStrIs(name, "wl_create_window") != 1 && cgStrIs(name, "wl_pixel") != 1 && cgCallArgc(c) != 0
        return 0
    end

    cgWlUsed = 1

    # Staging как в wl_linux/net/vulkan: spill, пауза аллокатора, push
    # callee-saved rdi (7) / rsi (6) и r12/r13/r14 (вне пула).
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    emit8(0x57)
    emit8(0x56)
    emit8(0x41)
    emit8(0x54)
    emit8(0x41)
    emit8(0x55)
    emit8(0x41)
    emit8(0x56)

    var wlExit: int = newLabel()

    if cgStrIs(name, "wl_create_window") == 1
        var done: int = newLabel()
        var noFd: int = newLabel()

        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        cgWwMovToR12(a0)
        freeReg(a0)
        # r12 = w
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        cgWwMovToR14(a1)
        freeReg(a1)
        # r14 = h
        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        cgWwMovToR13(a2)
        freeReg(a2)
        # r13 = title

        # fd must be open; reset the configured/closed flags.
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, [wlFdRVA]
        emit8(0x85)
        emit8(0xFF)
        # test edi, edi
        emitJccLit("<=", noFd)
        cgVkLeaRip(0, cgWlConfiguredRVA)
        emit8(0xC7)
        emit8(0x00)
        emit32(0)
        cgVkLeaRip(0, cgWlClosedRVA)
        emit8(0xC7)
        emit8(0x00)
        emit32(0)

        # ---- discovery: get_registry(new_id=2) + sync(new_id=3) = 24B ----
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 1, 1, 12)
        cgWwOut32(8, 2)
        cgWwOutHeader(12, 1, 0, 12)
        cgWwOut32(20, 3)
        cgWwWriteOutCheck(24, noFd)

        # ---- read loop: capture registry.global names until callback.done ----
        # r8 = &inbuf, rbx = n, r9d = offset.
        var rdTop: int = newLabel()
        var pxLoop: int = newLabel()
        var rdNext: int = newLabel()
        var skipEvent: int = newLabel()
        var chkXdg: int = newLabel()
        var chkShm: int = newLabel()
        var discDone: int = newLabel()
        emitLabel(rdTop)
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, fd
        cgVkLeaRip(6, cgWlInRVA)
        # rsi = &inbuf
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(4096)
        # rdx = 4096
        cgNetSvc(0)
        # read(fd, inbuf, 4096)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<=", noFd)
        # EOF/err -> fail
        emit8(0x89)
        emit8(0xC3)
        # mov ebx, eax (n)
        cgVkLeaRip(8, cgWlInRVA)
        # r8 = &inbuf
        emit8(0x45)
        emit8(0x31)
        emit8(0xC9)
        # xor r9d, r9d (offset=0)

        emitLabel(pxLoop)
        emit8(0x49)
        emit8(0x39)
        emit8(0xD9)
        # cmp r9, rbx
        emitJccLit(">=", rdNext)
        # batch consumed -> read again
        cgWwLeaEvent()
        # rcx = &inbuf[r9]
        emit8(0x8B)
        emit8(0x39)
        # mov edi, [rcx] (id)
        emit8(0x85)
        emit8(0xFF)
        # test edi, edi
        emitJccLit("<=", skipEvent)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x03)
        # cmp edi, 3 (callback.done)
        emitJccLit("==", discDone)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x02)
        # cmp edi, 2 (discovery registry)
        emitJccLit("!=", skipEvent)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x85)
        emit8(0xC0)
        # only wl_registry.global (op 0)
        emitJccLit("!=", skipEvent)

        # wl_registry.global payload: name@[+8], slen@[+12], bytes@[+16].
        emit8(0x8B)
        emit8(0x41)
        emit8(0x0C)
        # mov eax, [rcx+12] (slen)
        emit8(0x83)
        emit8(0xF8)
        emit8(0x0E)
        # cmp eax, 14 (len incl NUL)
        emitJccLit("!=", chkXdg)
        # "wl_compositor\0\0" as LE dword pairs.
        emit8(0x81)
        emit8(0x79)
        emit8(0x10)
        emit32(0x635F6C77)
        emitJccLit("!=", chkXdg)
        emit8(0x81)
        emit8(0x79)
        emit8(0x14)
        emit32(0x6F706D6F)
        emitJccLit("!=", chkXdg)
        emit8(0x81)
        emit8(0x79)
        emit8(0x18)
        emit32(0x6F746973)
        emitJccLit("!=", chkXdg)
        emit8(0x81)
        emit8(0x79)
        emit8(0x1C)
        emit32(0x00000072)
        emitJccLit("!=", chkXdg)
        emit8(0x8B)
        emit8(0x41)
        emit8(0x08)
        # mov eax, [rcx+8] (name)
        cgVkLeaRip(1, cgWlWNameRVA)
        emit8(0x89)
        emit8(0x01)
        # mov [rcx], eax
        emitJmp(skipEvent)

        emitLabel(chkXdg)
        emit8(0x83)
        emit8(0xF8)
        emit8(0x0C)
        # cmp eax, 12
        emitJccLit("!=", chkShm)
        # "xdg_wm_base" as 3 LE dwords.
        emit8(0x81)
        emit8(0x79)
        emit8(0x10)
        emit32(0x5F676478)
        emitJccLit("!=", chkShm)
        emit8(0x81)
        emit8(0x79)
        emit8(0x14)
        emit32(0x625F6D77)
        emitJccLit("!=", chkShm)
        emit8(0x81)
        emit8(0x79)
        emit8(0x18)
        emit32(0x00657361)
        emitJccLit("!=", chkShm)
        emit8(0x8B)
        emit8(0x41)
        emit8(0x08)
        cgVkLeaRip(1, cgWlXdgNameRVA)
        emit8(0x89)
        emit8(0x01)
        emitJmp(skipEvent)

        emitLabel(chkShm)
        emit8(0x83)
        emit8(0xF8)
        emit8(0x07)
        # cmp eax, 7
        emitJccLit("!=", skipEvent)
        # "wl_shm\0" as 2 LE dwords.
        emit8(0x81)
        emit8(0x79)
        emit8(0x10)
        emit32(0x735F6C77)
        emitJccLit("!=", skipEvent)
        emit8(0x81)
        emit8(0x79)
        emit8(0x14)
        emit32(0x00006D68)
        emitJccLit("!=", skipEvent)
        emit8(0x8B)
        emit8(0x41)
        emit8(0x08)
        cgVkLeaRip(1, cgWlShmNameRVA)
        emit8(0x89)
        emit8(0x01)

        emitLabel(skipEvent)
        cgWwLeaEvent()
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x06)
        # movzx eax, word[rcx+6] (size)
        emit8(0x49)
        emit8(0x01)
        emit8(0xC1)
        # add r9, rax
        emitJmp(pxLoop)

        emitLabel(rdNext)
        emitJmp(rdTop)

        emitLabel(discDone)

        # ---- registry.bind x3: compositor, xdg_wm_base, wl_shm ----
        # wl_compositor: (id2 op0 size40) name len14 "wl_compositor\0" v4 n4
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 2, 0, 40)
        cgVkLeaRip(1, cgWlWNameRVA)
        emit8(0x8B)
        emit8(0x09)
        # mov ecx, [rcx] (name)
        cgWwOutReg32(8, 1)
        cgWwOut32(12, 14)
        cgVkLeaRip(6, cgWlCompositorStrRVA)
        # rsi = "wl_compositor"
        cgVkLeaRip(7, cgWlOutRVA)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC7)
        emit8(0x10)
        # rdi = &out[16]
        emit8(0xB9)
        emit32(13)
        # ecx = 13
        emit8(0xF3)
        emit8(0xA4)
        # rep movsb
        cgWwOut32(32, 4)
        # version = 4
        cgWwOut32(36, 4)
        # new_id = wl_compositor
        cgWwWriteOutCheck(40, noFd)

        # xdg_wm_base: (id2 op0 size36) name len12 "xdg_wm_base" v4 n5
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 2, 0, 36)
        cgVkLeaRip(1, cgWlXdgNameRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(8, 1)
        cgWwOut32(12, 12)
        cgVkLeaRip(6, cgWlXdgWmBaseStrRVA)
        cgVkLeaRip(7, cgWlOutRVA)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC7)
        emit8(0x10)
        emit8(0xB9)
        emit32(12)
        emit8(0xF3)
        emit8(0xA4)
        cgWwOut32(28, 4)
        # version = 4
        cgWwOut32(32, 5)
        # new_id = xdg_wm_base
        cgWwWriteOutCheck(36, noFd)

        # wl_shm: (id2 op0 size32) name len7 "wl_shm\0" v1 n6
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 2, 0, 32)
        cgVkLeaRip(1, cgWlShmNameRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(8, 1)
        cgWwOut32(12, 7)
        cgVkLeaRip(6, cgWlShmStrRVA)
        cgVkLeaRip(7, cgWlOutRVA)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC7)
        emit8(0x10)
        emit8(0xB9)
        emit32(7)
        emit8(0xF3)
        emit8(0xA4)
        cgWwOut32(24, 1)
        # version = 1
        cgWwOut32(28, 6)
        # new_id = wl_shm
        cgWwWriteOutCheck(32, noFd)

        # ---- fixed group (64B): create_surface / get_xdg_surface /
        # get_toplevel / set_app_id("zenith-app") ----
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 4, 0, 12)
        # create_surface(n=7)
        cgWwOut32(8, 7)
        cgWwOutHeader(12, 5, 2, 16)
        # get_xdg_surface(n=8, o=7)
        cgWwOut32(20, 8)
        cgWwOut32(24, 7)
        cgWwOutHeader(28, 8, 1, 12)
        # get_toplevel(n=9) on xdg_surface
        cgWwOut32(36, 9)
        cgWwOutHeader(40, 9, 3, 24)
        # set_app_id on xdg_toplevel
        cgWwOut32(48, 11)
        # s len = 11
        cgWwOut32(52, 0x696E657A)
        # "zeni"
        cgWwOut32(56, 0x612D6874)
        # "th-a"
        cgWwOut32(60, 0x00007070)
        # "pp\0\0"
        cgWwWriteOutCheck(64, noFd)

        # ---- set_title: strlen(title)+1, message size grows ----
        emit8(0x4C)
        emit8(0x89)
        emit8(0xEE)
        # mov rsi, r13 (title)
        emit8(0x31)
        emit8(0xC9)
        # xor ecx, ecx
        var stTop: int = newLabel()
        var stDone: int = newLabel()
        emitLabel(stTop)
        emit8(0x80)
        emit8(0x3C)
        emit8(0x0E)
        emit8(0x00)
        # cmp byte [rsi+rcx], 0
        emitJccLit("==", stDone)
        emit8(0x48)
        emit8(0xFF)
        emit8(0xC1)
        # inc rcx
        emitJmp(stTop)
        emitLabel(stDone)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(0x01)
        # add rcx, 1 (incl NUL)
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOut32(0, 9)
        # id = xdg_toplevel
        cgWwOutReg32(8, 1)
        # [r10+8] = len (rcx)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC8)
        # mov rax, rcx
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x03)
        # add rax, 3
        emit8(0x48)
        emit8(0x83)
        emit8(0xE0)
        emit8(0xFC)
        # and rax, ~3
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(0x0C)
        # add rax, 12 (size)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC3)
        # mov rbx, rax (size)
        emit8(0x44)
        emit8(0x8B)
        emit8(0xC0)
        # mov r8d, eax
        emit8(0x49)
        emit8(0xC1)
        emit8(0xE0)
        emit8(0x10)
        # shl r8, 16
        emit8(0x41)
        emit8(0x81)
        emit8(0xC8)
        emit32(2)
        # or r8d, 2 (opcode)
        cgWwOutReg32(4, 8)
        # [r10+4] = op|size<<16
        emit8(0x4C)
        emit8(0x89)
        emit8(0xEE)
        # mov rsi, r13 (title)
        cgVkLeaRip(7, cgWlOutRVA)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC7)
        emit8(0x0C)
        # rdi = &out[12]
        emit8(0xF3)
        emit8(0xA4)
        # rep movsb (rcx bytes)
        cgWwWriteLen()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", noFd)

        # ---- shm framebuffer: memfd -> ftruncate -> mmap ----
        cgVkLeaRip(0, cgWlWinWRVA)
        emit8(0x44)
        emit8(0x89)
        emit8(0x20)
        # mov [wlWinWRVA], r12d (w)
        cgVkLeaRip(0, cgWlWinHRVA)
        emit8(0x44)
        emit8(0x89)
        emit8(0x30)
        # mov [wlWinHRVA], r14d (h)
        cgVkLeaRip(7, cgWlMemfdNameRVA)
        # rdi = "z-wl-fb"
        emit8(0x31)
        emit8(0xF6)
        # xor esi, esi (flags=0)
        cgNetSvc(319)
        # memfd_create
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", noFd)
        cgVkLeaRip(2, cgWlBufFdRVA)
        emit8(0x48)
        emit8(0x89)
        emit8(0x02)
        # mov [wlBufFdRVA], rax (memfd)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xE0)
        # mov rax, r12
        emit8(0x49)
        emit8(0x0F)
        emit8(0xAF)
        emit8(0xC6)
        # imul rax, r14 (w*h)
        emit8(0x48)
        emit8(0xC1)
        emit8(0xE0)
        emit8(0x02)
        # shl rax, 2 (w*h*4)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC3)
        # mov rbx, rax (len)
        cgVkLeaRip(7, cgWlBufFdRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x3F)
        # mov rdi, [wlBufFdRVA] (memfd)
        emit8(0x48)
        emit8(0x89)
        emit8(0xDE)
        # mov rsi, rbx (len)
        cgNetSvc(77)
        # ftruncate(memfd, len)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", noFd)
        emit8(0x31)
        emit8(0xFF)
        # xor edi, edi (addr=0)
        emit8(0x48)
        emit8(0x89)
        emit8(0xDE)
        # mov rsi, rbx (len)
        emit8(0xBA)
        emit32(3)
        # rdx = PROT_READ|PROT_WRITE
        emit8(0x41)
        emit8(0xBA)
        emit32(1)
        # r10d = MAP_SHARED
        cgVkLeaRip(8, cgWlBufFdRVA)
        emit8(0x45)
        emit8(0x8B)
        emit8(0x00)
        # mov r8d, [r8] (memfd)
        emit8(0x45)
        emit8(0x31)
        emit8(0xC9)
        # xor r9d, r9d (offset=0)
        cgNetSvc(9)
        # mmap
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", noFd)
        cgVkLeaRip(2, cgWlFbPtrRVA)
        emit8(0x48)
        emit8(0x89)
        emit8(0x02)
        # mov [wlFbPtrRVA], rax
        cgVkLeaRip(1, cgWlBufIdRVA)
        emit8(0xC7)
        emit8(0x01)
        emit32(11)
        # buffer id = 11

        # ---- wl_shm.create_pool(id=10, fd, len) ----
        # fd is type 'f': delivered ONLY via SCM_RIGHTS, no u32 slot in body.
        # Wire: header(8) + new_id(4) + size(4) = 16 bytes total.
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 6, 0, 16)
        cgWwOut32(8, 10)
        # new_id = wl_shm_pool
        emit8(0x48)
        emit8(0x89)
        emit8(0xDA)
        # mov rdx, rbx (len)
        cgWwOutReg32(12, 2)
        # size = len
        cgWwWriteOutFd(16, cgWlBufFdRVA, noFd)
        # sendmsg with memfd via SCM_RIGHTS

        # ---- create_buffer(n=11, offset=0, w, h, stride, ARGB8888) ----
        # new_id comes first in the wire, then offset/w/h/stride/format.
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 10, 0, 32)
        cgWwOut32(8, 11)
        # new_id = wl_buffer
        cgWwOut32(12, 0)
        # offset = 0
        cgWwOutReg32(16, 12)
        # width (r12d)
        cgWwOutReg32(20, 14)
        # height (r14d)
        emit8(0x41)
        emit8(0x8B)
        emit8(0xC4)
        # mov eax, r12d
        emit8(0xC1)
        emit8(0xE0)
        emit8(0x02)
        # shl eax, 2 (stride = w*4)
        cgWwOutReg32(24, 0)
        # stride
        cgWwOut32(28, 0x34325241)
        # ARGB8888 ("AR24")
        cgWwWriteOutCheck(32, noFd)

        # ---- first present: attach + damage_buffer + commit (52B) ----
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 7, 1, 20)
        # attach(buffer=11, 0, 0)
        cgVkLeaRip(1, cgWlBufIdRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(8, 1)
        cgWwOut32(12, 0)
        cgWwOut32(16, 0)
        cgWwOutHeader(20, 7, 9, 24)
        # damage_buffer(0, 0, w, h)
        cgWwOut32(28, 0)
        cgWwOut32(32, 0)
        cgVkLeaRip(1, cgWlWinWRVA)
        emit8(0x8B)
        emit8(0x09)
        # mov ecx, [wlWinWRVA]
        cgWwOutReg32(36, 1)
        cgVkLeaRip(1, cgWlWinHRVA)
        emit8(0x8B)
        emit8(0x09)
        # mov ecx, [wlWinHRVA]
        cgWwOutReg32(40, 1)
        cgWwOutHeader(44, 7, 6, 8)
        # commit
        cgWwWriteOutCheck(52, noFd)

        # ---- wait for xdg_surface.configure (blocking reads) ----
        var wTop: int = newLabel()
        var wParse: int = newLabel()
        var wSkip: int = newLabel()
        var chkTop: int = newLabel()
        var chkPing: int = newLabel()
        emitLabel(wTop)
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, fd
        cgVkLeaRip(6, cgWlInRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(4096)
        cgNetSvc(0)
        # read (blocking)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<=", noFd)
        # EOF -> fail
        emit8(0x89)
        emit8(0xC3)
        # mov ebx, eax (n)
        cgVkLeaRip(8, cgWlInRVA)
        # r8 = &inbuf
        emit8(0x45)
        emit8(0x31)
        emit8(0xC9)
        # xor r9d, r9d

        emitLabel(wParse)
        emit8(0x49)
        emit8(0x39)
        emit8(0xD9)
        # cmp r9, rbx
        emitJccLit(">=", wTop)
        cgWwLeaEvent()
        # rcx = &inbuf[r9]
        emit8(0x8B)
        emit8(0x39)
        # mov edi, [rcx] (id)
        emit8(0x85)
        emit8(0xFF)
        emitJccLit("<=", wSkip)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x08)
        # cmp edi, 8 (xdg_surface)
        emitJccLit("!=", chkTop)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", wSkip)
        # configure = op 0
        emit8(0x44)
        emit8(0x8B)
        emit8(0x69)
        emit8(0x08)
        # mov r13d, [rcx+8] (serial)
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 8, 4, 12)
        # ack_configure(serial) on xdg_surface
        cgWwOutReg32(8, 13)
        # [r10+8] = r13d
        cgWwOutHeader(12, 7, 6, 8)
        # commit on surface
        cgWwWriteOutCheck(20, noFd)
        cgVkLeaRip(0, cgWlConfiguredRVA)
        emit8(0xC7)
        emit8(0x00)
        emit32(1)
        # configured = 1
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax (return 0)
        emitJmp(done)

        emitLabel(chkTop)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x09)
        # cmp edi, 9 (xdg_toplevel)
        emitJccLit("!=", chkPing)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x83)
        emit8(0xF8)
        emit8(0x01)
        emitJccLit("!=", wSkip)
        # close = op 1
        cgVkLeaRip(0, cgWlClosedRVA)
        emit8(0xC7)
        emit8(0x00)
        emit32(1)
        # closed = 1
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax
        emitJmp(done)

        emitLabel(chkPing)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x05)
        # cmp edi, 5 (xdg_wm_base)
        emitJccLit("!=", wSkip)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", wSkip)
        # ping = op 0
        emit8(0x44)
        emit8(0x8B)
        emit8(0x69)
        emit8(0x08)
        # mov r13d, [rcx+8] (serial)
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 5, 3, 12)
        # pong(serial)
        cgWwOutReg32(8, 13)
        cgWwWriteOut(12)

        emitLabel(wSkip)
        cgWwLeaEvent()
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x06)
        # movzx eax, word[rcx+6] (size)
        emit8(0x49)
        emit8(0x01)
        emit8(0xC1)
        # add r9, rax
        emitJmp(wParse)

        emitLabel(noFd)
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(-1)
        # rax = -1
        emitLabel(done)
        cgWlLeave(wlExit)

    end

    # ---- wl_present() -> 0 | -1 ----
    if cgStrIs(name, "wl_present") == 1
        var done: int = newLabel()
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, fd
        emit8(0x85)
        emit8(0xFF)
        # test edi, edi
        emitJccLit("<=", done)
        # no window -> -1
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 7, 1, 20)
        # attach(buffer, 0, 0)
        cgVkLeaRip(1, cgWlBufIdRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(8, 1)
        cgWwOut32(12, 0)
        cgWwOut32(16, 0)
        cgWwOutHeader(20, 7, 9, 24)
        # damage_buffer(0, 0, w, h)
        cgWwOut32(28, 0)
        cgWwOut32(32, 0)
        cgVkLeaRip(1, cgWlWinWRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(36, 1)
        cgVkLeaRip(1, cgWlWinHRVA)
        emit8(0x8B)
        emit8(0x09)
        cgWwOutReg32(40, 1)
        cgWwOutHeader(44, 7, 6, 8)
        # commit
        cgWwWriteOut(52)
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax
        emitLabel(done)
        cgWlLeave(wlExit)

    end

    # ---- wl_process() -> 0 (close) | 1 (keep going) ----
    if cgStrIs(name, "wl_process") == 1
        var noData: int = newLabel()
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, fd
        emit8(0x85)
        emit8(0xFF)
        # test edi, edi
        emitJccLit("<=", noData)
        # not connected -> keep looping
        cgVkLeaRip(6, cgWlInRVA)
        # rsi = &inbuf
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC2)
        emit32(4096)
        # rdx = 4096
        emit8(0x41)
        emit8(0xBA)
        emit32(0x40)
        # r10d = MSG_DONTWAIT
        cgNetSvc(45)
        # recv(fd, inbuf, 4096, DONTWAIT)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<=", noData)
        # nothing pending / EOF
        emit8(0x89)
        emit8(0xC3)
        # mov ebx, eax (n)
        cgVkLeaRip(8, cgWlInRVA)
        # r8 = &inbuf
        emit8(0x45)
        emit8(0x31)
        emit8(0xC9)
        # xor r9d, r9d

        var pxLoop: int = newLabel()
        var chkPing: int = newLabel()
        var skipEvent: int = newLabel()
        emitLabel(pxLoop)
        emit8(0x49)
        emit8(0x39)
        emit8(0xD9)
        # cmp r9, rbx
        emitJccLit(">=", noData)
        # batch consumed
        cgWwLeaEvent()
        # rcx = &inbuf[r9]
        emit8(0x8B)
        emit8(0x39)
        # mov edi, [rcx] (id)
        emit8(0x85)
        emit8(0xFF)
        emitJccLit("<=", skipEvent)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x09)
        # cmp edi, 9 (xdg_toplevel)
        emitJccLit("!=", chkPing)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x83)
        emit8(0xF8)
        emit8(0x01)
        emitJccLit("!=", skipEvent)
        # close = op 1
        cgVkLeaRip(0, cgWlClosedRVA)
        emit8(0xC7)
        emit8(0x00)
        emit32(1)
        # closed = 1
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax (return 0)
        cgWlLeave(wlExit)

        emitLabel(chkPing)
        emit8(0x83)
        emit8(0xFF)
        emit8(0x05)
        # cmp edi, 5 (xdg_wm_base)
        emitJccLit("!=", skipEvent)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x04)
        # movzx eax, word[rcx+4]
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", skipEvent)
        # ping = op 0
        emit8(0x44)
        emit8(0x8B)
        emit8(0x69)
        emit8(0x08)
        # mov r13d, [rcx+8] (serial)
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 5, 3, 12)
        # pong(serial)
        cgWwOutReg32(8, 13)
        cgWwWriteOut(12)

        emitLabel(skipEvent)
        cgWwLeaEvent()
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x41)
        emit8(0x06)
        # movzx eax, word[rcx+6] (size)
        emit8(0x49)
        emit8(0x01)
        emit8(0xC1)
        # add r9, rax
        emitJmp(pxLoop)

        emitLabel(noData)
        emit8(0xB8)
        emit32(1)
        # rax = 1 (keep going)
        cgWlLeave(wlExit)

    end

    # ---- wl_close_window() -> 0 ----
    if cgStrIs(name, "wl_close_window") == 1
        var done: int = newLabel()
        var skipUnmap: int = newLabel()
        var skipFd: int = newLabel()
        cgVkLeaRip(2, cgWlFdRVA)
        emit8(0x8B)
        emit8(0x3A)
        # mov edi, fd
        emit8(0x85)
        emit8(0xFF)
        # test edi, edi
        emitJccLit("<=", done)
        # not connected -> nothing

        # destroy surface + buffer + pool (24B)
        cgVkLeaRip(10, cgWlOutRVA)
        cgWwOutHeader(0, 7, 0, 8)
        # wl_surface.destroy
        cgWwOutHeader(8, 11, 0, 8)
        # wl_buffer.destroy
        cgWwOutHeader(16, 10, 1, 8)
        # wl_shm_pool.destroy
        cgWwWriteOut(24)

        # munmap(fb, w*h*4)
        cgVkLeaRip(0, cgWlFbPtrRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)
        # mov rax, [wlFbPtrRVA]
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", skipUnmap)
        emit8(0x49)
        emit8(0x89)
        emit8(0xC4)
        # mov r12, rax (fb)
        cgVkLeaRip(1, cgWlWinWRVA)
        emit8(0x8B)
        emit8(0x09)
        # mov ecx, [wlWinWRVA] (w)
        cgVkLeaRip(0, cgWlWinHRVA)
        emit8(0x0F)
        emit8(0xAF)
        emit8(0x08)
        # imul ecx, [rax] (h)
        emit8(0xC1)
        emit8(0xE1)
        emit8(0x02)
        # shl ecx, 2
        emit8(0x48)
        emit8(0x89)
        emit8(0xCE)
        # mov rsi, rcx (len)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xE7)
        # mov rdi, r12 (fb)
        cgNetSvc(11)
        # munmap
        emitLabel(skipUnmap)
        cgVkLeaRip(1, cgWlFbPtrRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x01)
        emit32(0)
        # fb = 0

        # close(memfd)
        cgVkLeaRip(0, cgWlBufFdRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)
        # mov rax, [wlBufFdRVA]
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", skipFd)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC7)
        # mov rdi, rax
        cgNetSvc(3)
        # close
        emitLabel(skipFd)
        cgVkLeaRip(1, cgWlBufFdRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x01)
        emit32(0)
        # memfd = 0

        # close(display fd) and drop the connection state
        cgVkLeaRip(0, cgWlFdRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)
        # mov rax, [wlFdRVA]
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", done)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC7)
        # mov rdi, rax
        cgNetSvc(3)
        # close
        cgVkLeaRip(1, cgWlFdRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x01)
        emit32(0)
        # fd = 0

        emitLabel(done)
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax
        cgWlLeave(wlExit)

    end

    # ---- wl_fb() -> framebuffer address | 0 ----
    if cgStrIs(name, "wl_fb") == 1
        cgVkLeaRip(0, cgWlFbPtrRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)
        # mov rax, [wlFbPtrRVA]
        cgWlLeave(wlExit)

    end

    # ---- wl_pixel(x, y, color) -> 0 | -1 ----
    if cgStrIs(name, "wl_pixel") == 1
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        cgWwMovToR13(a0)
        freeReg(a0)
        # r13 = x
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        cgWwMovToR14(a1)
        freeReg(a1)
        # r14 = y
        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        cgWwMovToR12(a2)
        freeReg(a2)
        # r12 = color

        cgVkLeaRip(1, cgWlWinWRVA)
        # rcx = &w
        emit8(0x41)
        emit8(0x8B)
        emit8(0xC6)
        # mov eax, r14d (y)
        emit8(0x0F)
        emit8(0xAF)
        emit8(0x01)
        # imul eax, [rcx] (y*w)
        emit8(0x44)
        emit8(0x01)
        emit8(0xE8)
        # add eax, r13d (x)
        emit8(0xC1)
        emit8(0xE0)
        emit8(0x02)
        # shl eax, 2
        cgVkLeaRip(2, cgWlFbPtrRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x12)
        # mov rdx, [wlFbPtrRVA]
        emit8(0x48)
        emit8(0x85)
        emit8(0xD2)
        # test rdx, rdx
        emitJccLit("==", done)
        # no framebuffer -> -1
        emit8(0x48)
        emit8(0x01)
        emit8(0xD0)
        # add rax, rdx
        emit8(0x44)
        emit8(0x89)
        emit8(0x20)
        # mov [rax], r12d (color)
        emit8(0x31)
        emit8(0xC0)
        # xor eax, eax (return 0)
        emitLabel(done)
        cgWlLeave(wlExit)

    end
    # ================= Common exit: restore the allocator view ================
    emitLabel(wlExit)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end
