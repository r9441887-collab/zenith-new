            emit8(0xEC)
            emit8(0x08)
            emit8(0xC6)
            emit8(0x04)
            emit8(0x24)
            emit8(0x0A)
            emit8(0x48)
            emit8(0x89)
            emit8(0xE6)
            emit8(0xBA)
