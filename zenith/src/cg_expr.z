    if cgStrIs(n, "memQ") == 1 && argc == 2
        return cgLinMemRead(c, 8)
    end
    if cgStrIs(n, "memByteW") == 1 && argc == 3
        return cgLinMemWrite(c, 1)
    end
    if cgStrIs(n, "memQw") == 1 && argc == 3
