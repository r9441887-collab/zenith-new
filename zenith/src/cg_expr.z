            emitMovReg(0, r)
            freeReg(r)

            var again: int = newLabel()
            var done: int = newLabel()
            emit8(0x31)
            emit8(0xC9)
            emitLabel(again)
            emit8(0x80)
            emit8(0x3C)
            emit8(0x08)
            emit8(0x00)
            emitJccLit("==", done)
            emit8(0x48)
            emit8(0xFF)
            emit8(0xC1)
            emitJmp(again)
