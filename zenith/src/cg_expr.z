        emit8(0x83)
        emit8(0xEC)
        emit8(0x10)
        emitMovssXmmToMem(ay2, 4, 0)
        emit8(0xD9)
        emit8(0x04)
        emit8(0x24)
        emitMovssXmmToMem(ax2, 4, 0)
        emit8(0xD9)
        emit8(0x04)
        emit8(0x24)
        emit8(0xD9)
        emit8(0xF1)
        emit8(0xD9)
        emit8(0xC0)
        emit8(0xD9)
        emit8(0xFC)
        emit8(0xDC)
        emit8(0xE9)
        emit8(0xD9)
        emit8(0xC9)
        emit8(0xD9)
        emit8(0xF0)
        emit8(0xD9)
        emit8(0xE8)
        emit8(0xDE)
        emit8(0xC1)
        emit8(0xD9)
        emit8(0xFD)
        emit8(0xDD)
        emit8(0xD9)
        emit8(0xD9)
        emit8(0x1C)
        emit8(0x24)
