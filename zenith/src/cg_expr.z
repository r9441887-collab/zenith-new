# src/cg_expr.z — ход по AST: эмиттеры выражений, emitExpr, emitStmt, пул строк.
# Всё, что умеет ветвиться по ZAST: унарные/бинарные/вызовы/доступы,
# точки разрешения (`emitExpr`), эмиттеры инструкций (`emitStmt`,
# пока — ветка N_RETURN), строковый пул и заглушка `cgEmitCallExpr`.
# Слой самый верхний из внутренних: ему нужны и типы, и эмиттер, и ZAST.
#
# Use-chain (strictly linear — parseRun does not dedup spliced modules, so a
# diamond `use` prints "Duplicate function" and the layering would rot):
#
#   codegen.z -> cg_elf.z -> cg_expr.z -> cg_type.z -> cg_httpdl_blob.z -> cg_httpjson.z -> cg_emit.z -> cg_zast.z
#
# every arrow is a real dependency of the upper layer on the lower one;
# each module is `use`d exactly once in the whole tree.

use cg_type
use cg_shader
use cg_httpdl_blob
use cg_disasm_blob
use cg_tls_blob
use cg_js_blob
use cg_asm

# ===================== expression emitters =====================
#
# Ports of codegen.cpp: exprContainsCall (2077), exprHasArrayAccess (2095),
# emitUnaryExpr (414), emitStructAddrR10 (1245), emitStructRegs (1291),
# emitAddrOfExpr (1406), emitFloatMathCall (786), emitFloatExpr (1912),
# emitExprKeepAlive (2110) / R10 (2129) / float R10 (2145),
# emitBinaryExpr (2155), emitFtoiExpr (2759) and emitExpr (2777).

# ---- small helpers ----

# N_NUMBER value: f0 = low 32 bits, f1 = high 32 bits (parseembed.cpp:237).
# The two halves are OR-ed so a negative value (f1 = 0xFFFFFFFF) comes back
# as the original negative int64 through two's complement.
func cgNumVal(e: int) -> int
    return cgF(e, 0) | (cgF(e, 1) << 32)
end

# call arguments: a side list, f2 = start word, f3 = count
func cgCallArgc(c: int) -> int
    return cgF(c, 3)
end

func cgCallArg(c: int, i: int) -> int
    if i < 0 || i >= cgF(c, 3)
        return 0
    end
    return cgSide(cgF(c, 2) + i)
end

# float value of the IEEE-754 pattern `bits`
func cgF32FromBits(bits: int) -> float
    var f: float = 0.0
    var p: int = &f
    poke32(p, bits & 0xFFFFFFFF)
    return f
end

# C++ throws here and main.cpp prints "Codegen error: <what>"; the %of guard
# in emitBinaryExpr instead fprintf()s its own line and exit(1), so that one
# is flagged with cgErrPlain and must be printed without the prefix.
var cgErrPlain: int = 0

func cgErrSetPlain(msg: int)
    cgErr = 1
    cgErrPlain = 1
    var dst: int = &cgErrMsg
    var i: int = 0
    while i < 255
        var c: int = peek8(msg + i)
        poke8(dst + i, c)
        i = i + 1
        if c == 0
            return
        end
    end
    poke8(dst + 255, 0)
end

# is the plain (unprefixed) error slot set? main.z prints cgErrText() as-is
# when this is 1, "Codegen error: <text>" when it is 0.
func cgErrIsPlain() -> int
    return cgErrPlain
end

# ---- expression walk helpers ----

# exprContainsCall (codegen.cpp:2077) — every arm returns its own answer,
# only the final fallthrough is `false`.
func cgExprContainsCall(e: int) -> int
    if e == 0
        return 0
    end
    var tg: int = cgTag(e)
    if tg == N_CALL
        return 1
    end
    if tg == N_BINARY
        if cgExprContainsCall(cgF(e, 0)) == 1
            return 1
        end
        if cgExprContainsCall(cgF(e, 1)) == 1
            return 1
        end
        return 0
    end
    if tg == N_UNARY
        return cgExprContainsCall(cgF(e, 1))
    end
    if tg == N_MEMBER
        return cgExprContainsCall(cgF(e, 0))
    end
    if tg == N_ARRAYACC
        if cgExprContainsCall(cgF(e, 0)) == 1
            return 1
        end
        return cgExprContainsCall(cgF(e, 1))
    end
    if tg == N_DEREF
        return cgExprContainsCall(cgF(e, 0))
    end
    if tg == N_ADDROF
        return cgExprContainsCall(cgF(e, 1))
    end
    return 0
end

# exprHasArrayAccess (codegen.cpp:2095) — a call stops the walk: the
# keep-alive wrappers already guard r10 across calls.
func cgExprHasArrayAccess(e: int) -> int
    if e == 0
        return 0
    end
    var tg: int = cgTag(e)
    if tg == N_ARRAYACC
        return 1
    end
    if tg == N_CALL
        return 0
    end
    if tg == N_BINARY
        if cgExprHasArrayAccess(cgF(e, 0)) == 1
            return 1
        end
        if cgExprHasArrayAccess(cgF(e, 1)) == 1
            return 1
        end
        return 0
    end
    if tg == N_UNARY
        return cgExprHasArrayAccess(cgF(e, 1))
    end
    if tg == N_MEMBER
        return cgExprHasArrayAccess(cgF(e, 0))
    end
    if tg == N_DEREF
        return cgExprHasArrayAccess(cgF(e, 0))
    end
    return 0
end

# member path of `e`, stored outermost-last: rev[0] is the first field after
# the root (the C++ code builds the same order with path.insert(begin, ...)).
# Returns the path length; rev is capped at 256 (a longer chain cannot occur
# in practice, the C++ vector is unbounded).
func cgMemberPath(e: int, rev: int) -> int
    var rn: int = 0
    var cur: int = e
    while cgTag(cur) == N_MEMBER
        if rn < 256
            poke32(rev + rn * 4, cgF(cur, 1))
        end
        rn = rn + 1
        cur = cgF(cur, 0)
    end
    return rn
end

# ---- emitUnaryExpr (codegen.cpp:414) ----

func cgEmitUnaryExpr(u: int) -> int
    var op: int = cgF(u, 0)
    var operand: int = cgF(u, 1)
    if cgStrIs(op, "~") == 1
        var r: int = cgEmitExpr(operand)
        # NOT: F7 /2 (REX.W only needed for 64-bit)
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0xF7)
        emit8(0xD0 + r)
        return r
    end
    if cgStrIs(op, "!") == 1
        var r2: int = cgEmitExpr(operand)
        # test reg, reg (sets ZF if zero) — both ModRM fields carry the register
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0x85)
        emit8(0xC0 | ((r2 & 7) << 3) | (r2 & 7))
        # setz reg8
        if r2 >= 4
            emit8(0x40)
        end
        emit8(0x0F)
        emit8(0x94)
        emit8(0xC0 | (r2 & 7))
        # movzx r32, r8 — clears what SETcc left in the upper bits
        if r2 >= 4
            emit8(0x40)
        end
        emit8(0x0F)
        emit8(0xB6)
        emit8(0xC0 | (r2 << 3) | (r2 & 7))
        return r2
    end
    if cgStrIs(op, "-") == 1
        var r3: int = cgEmitExpr(operand)
        if cgIsFloatExpr(operand) == 1
            # Integer negation of raw f32 bits is not float negation: flip the
            # sign bit instead (same as xorps 0x80000000).
            if cgWordSize == 64
                emit8(0x48)
                emit8(0x81)
                emit8(0xF0)
                emit32(0x80000000)
            else
                emit8(0x81)
                emit8(0xF0)
                emit32(0x80000000)
            end
            return r3
        end
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0xF7)
        emit8(0xD8 | (r3 & 7))
        return r3
    end
    return -1
end

# ---- emitStructAddrR10 (codegen.cpp:1245) ----
#
# r10 = address of the struct lvalue `e`. Not used for calls (the callee
# already left its value in rax:rdx:r10).

func cgEmitStructAddrR10(e: int)
    if e == 0
        return
    end
    if cgTag(e) == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi < 0
            emitMovRegImm(0, 0)
            return
        end
        if cgViGlobal[vi] != 0
            emitGlobalLeaR10(cgViOff[vi])
        else
            emitLeaR10FromBP(cgViOff[vi])
        end
        return
    end
    if cgTag(e) == N_MEMBER
        var rev: [256]int
        var revBase: int = &rev
        var rn: int = cgMemberPath(e, revBase)
        var cur: int = e
        while cgTag(cur) == N_MEMBER
            cur = cgF(cur, 0)
        end
        if cgTag(cur) == N_IDENT
            var vi2: int = cgVarFind(cgF(cur, 0))
            if vi2 >= 0
                var vt: int = cgViType[vi2]
                var isPtrRoot: int = 0
                if cgTIsPtr(vt) != 0 && cgTk(vt) == TK_STRUCT
                    isPtrRoot = 1
                end
                if cgViGlobal[vi2] != 0
                    if isPtrRoot == 1
                        emitGlobalLoadR10(cgViOff[vi2])
                    else
                        emitGlobalLeaR10(cgViOff[vi2])
                    end
                else
                    if isPtrRoot == 1
                        emitLoadR10FromBP64(cgViOff[vi2])
                    else
                        emitLeaR10FromBP(cgViOff[vi2])
                    end
                end
                var curStruct: int = cgTStruct(vt)
                var totalOff: int = 0
                var found: int = 1
                if rn > 256
                    found = 0
                end
                var k: int = rn - 1
                while found == 1 && k >= 0
                    var si: int = cgSlFind(curStruct)
                    if si < 0
                        found = 0
                    else
                        var fr: int = cgSlField(si, peek32(revBase + k * 4))
                        if fr < 0
                            found = 0
                        else
                            totalOff = totalOff + cgSlFOff[fr]
                            curStruct = cgTStruct(cgSlFType[fr])
                        end
                    end
                    k = k - 1
                end
                if found == 1 && totalOff != 0
                    emit8(0x49)
                    emit8(0x81)
                    emit8(0xC2)
                    emit32(totalOff)
                end
                return
            end
        end
    end
end

# ---- emitStructRegs (codegen.cpp:1291) ----
#
# Big struct value of `e` in rax:rdx:r10 (k qwords).

func cgEmitStructRegs(e: int, k: int)
    if e != 0 && cgTag(e) == N_CALL
        var ignored: int = cgEmitExpr(e)
        return
    end
    cgEmitStructAddrR10(e)
    emit8(0x49)
    emit8(0x8B)
    emit8(0x02)
    emit8(0x49)
    emit8(0x8B)
    emit8(0x52)
    emit8(0x08)
    if k >= 3
        emit8(0x4D)
        emit8(0x8B)
        emit8(0x52)
        emit8(0x10)
    end
end

# ---- emitAddrOfExpr (codegen.cpp:1406) ----
#
# Address of an lvalue: `&x`, `&o.f`, `&a[i]`, `&(*p)`, `&func`.

func cgEmitAddrOfExpr(e: int) -> int
    if e == 0
        var rz: int = allocReg()
        emitMovRegImm(rz, 0)
        return rz
    end
    if cgTag(e) == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        var r: int = allocReg()
        if vi < 0
            # &function — same rip-relative LEA + fixup as a bare reference
            if cgIsUserFunc(cgF(e, 0)) == 1
                freeReg(r)
                emit8(0x48)
                emit8(0x8D)
                emit8(0x05)
                var fixupPos: int = cgCodeLen
                emit32(0)
                cgPushFuncRef(fixupPos, cgF(e, 0))
                return 0
            end
            emitMovRegImm(r, 0)
            return r
        end
        if cgViGlobal[vi] != 0
            emitGlobalLeaReg(r, cgViOff[vi])
        else
            emitLeaRegFromBP(r, cgViOff[vi])
        end
        return r
    end
    if cgTag(e) == N_DEREF
        # &*p == p
        return cgEmitExpr(cgF(e, 0))
    end
    if cgTag(e) == N_MEMBER
        var rev: [256]int
        var revBase: int = &rev
        var rn: int = cgMemberPath(e, revBase)
        var cur: int = e
        while cgTag(cur) == N_MEMBER
            cur = cgF(cur, 0)
        end
        var rootT: int = cgExprType(cur)
        var base: int
        if cgTIsPtr(rootT) != 0
            base = cgEmitExpr(cur)
        else
            base = cgEmitAddrOfExpr(cur)
        end
        if cgTk(rootT) != TK_STRUCT || cgTStruct(rootT) == 0
            return base
        end
        # Walk field by field: an intermediate POINTER field has to be
        # dereferenced between hops (`n1.next.val` = [ [n1+nextOff] + valOff ]).
        var curStruct: int = cgTStruct(rootT)
        var i: int = 0
        while i < rn && i < 256
            var si: int = cgSlFind(curStruct)
            if si < 0
                return base
            end
            var fieldName: int = peek32(revBase + (rn - 1 - i) * 4)
            var fr: int = cgSlField(si, fieldName)
            if fr < 0
                return base
            end
            var fo: int = cgSlFOff[fr]
            var ft: int = cgSlFType[fr]
            if fo != 0
                emit8(0x48)
                emit8(0x81)
                emit8(0xC0 | (base & 7))
                emit32(fo)
            end
            if i + 1 < rn && cgTIsPtr(ft) != 0
                emitLoadFromAddr(base, base, 0)
            end
            curStruct = cgTStruct(ft)
            i = i + 1
        end
        if rn > 256
            return base
        end
        return base
    end
    if cgTag(e) == N_ARRAYACC
        var elemT: int = cgExprType(e)
        var baseT: int = cgExprType(cgF(e, 0))
        var base2: int
        if cgTIsPtr(baseT) != 0
            base2 = cgEmitExpr(cgF(e, 0))
        else
            base2 = cgEmitAddrOfExpr(cgF(e, 0))
        end
        var idx: int = cgEmitExpr(cgF(e, 1))
        var stride: int = cgArrayElemStride(elemT)
        if stride != 1
            # imul idx, idx, stride
            emit8(0x48)
            emit8(0x69)
            emit8(0xC0 | ((idx & 7) << 3) | (idx & 7))
            emit32(stride)
        end
        emitAdd(idx, base2)
        freeReg(base2)
        return idx
    end
    var r9: int = allocReg()
    emitMovRegImm(r9, 0)
    return r9
end

# ---- emitFloatMathCall (codegen.cpp:786) ----
#
# Float-math intrinsics. Returns an XMM register index with the result, or -1
# when `c` is not a recognized math builtin.

func cgIsUnaryFloatMath(name: int) -> int
    if cgStrIs(name, "sqrt") == 1 || cgStrIs(name, "abs") == 1 || cgStrIs(name, "floor") == 1 || cgStrIs(name, "ceil") == 1 || cgStrIs(name, "trunc") == 1 || cgStrIs(name, "neg") == 1
        return 1
    end
    return 0
end

func cgEmitFloatMathCall(c: int) -> int
    var name: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    # ---- unary in-place helpers (sqrt/abs/floor/ceil/trunc/neg) ----
    if cgIsUnaryFloatMath(name) == 1 && argc == 1
        var a: int = cgEmitFloatExpr(cgCallArg(c, 0))
        if a < 0
            a = 0
        end
        if cgStrIs(name, "sqrt") == 1
            emitSqrtss(a, a)
        else if cgStrIs(name, "floor") == 1
            emitRoundss(a, a, 1)
        else if cgStrIs(name, "ceil") == 1
            emitRoundss(a, a, 2)
        else if cgStrIs(name, "trunc") == 1
            emitRoundss(a, a, 3)
        else if cgStrIs(name, "neg") == 1
            var m: int = allocXmmReg()
            if m < 0
                m = 0
            end
            # codegen.cpp passes -0.0f; emitMovssXmmImm takes its "whole
            # non-negative" branch for it (0 == -0.0f), so the emitted bytes
            # are the int load — reproduced here through the same helper.
            emitMovssXmmImmF(m, cgF32FromBits(0x80000000))
            emitXorps(a, m)
            freeXmmReg(m)
        else
            # abs: value & 0x7FFFFFFF
            var saved: int = cgRegsUsed
            cgRegsUsed = 0
            var m2: int = allocReg()
            emitMovRegImm(m2, 0x7FFFFFFF)
            var mm: int = allocXmmReg()
            if mm < 0
                mm = 0
            end
            emitMovdXmmFromGp(mm, m2)
            freeReg(m2)
            cgRegsUsed = saved
            emitAndps(a, mm)
            freeXmmReg(mm)
        end
        return a
    end

    # itof(n): the argument is integer-typed, so it goes through emitExpr
    if cgStrIs(name, "itof") == 1 && argc == 1
        var saved2: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var g: int = cgEmitExpr(cgCallArg(c, 0))
        if g < 0
            g = 0
        end
        var f: int = allocXmmReg()
        if f < 0
            f = 0
        end
        emitCvtsi2ss(f, g)
        freeReg(g)
        cgRegsUsed = saved2
        reloadRegs()
        return f
    end

    # ---- sin/cos/tan use x87 for accuracy ----
    if cgStrIs(name, "sin") == 1 || cgStrIs(name, "cos") == 1 || cgStrIs(name, "tan") == 1
        if argc != 1
            return -1
        end
        var a1: int = cgEmitFloatExpr(cgCallArg(c, 0))
        if a1 < 0
            a1 = 0
        end
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(0x10)
        emitMovssXmmToMem(a1, 4, 0)
        emit8(0xD9)
        emit8(0x04)
        emit8(0x24)
        if cgStrIs(name, "sin") == 1
            emit8(0xD9)
            emit8(0xFE)
        else if cgStrIs(name, "cos") == 1
            emit8(0xD9)
            emit8(0xFF)
        else
            emit8(0xD9)
            emit8(0xF2)
            emit8(0xDD)
            emit8(0xD8)
        end
        emit8(0xD9)
        emit8(0x1C)
        emit8(0x24)
        emitMovssXmmFromMem(a1, 4, 0)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x10)
        return a1
    end

    # ---- atan2 ----
    if cgStrIs(name, "atan2") == 1
        if argc != 2
            return -1
        end
        var arg0: int = cgCallArg(c, 0)
        var arg1: int = cgCallArg(c, 1)
        var ay: int = 0
        var aySpilled: int = 0
        if cgExprContainsCall(arg1) == 1
            ay = cgEmitFloatExpr(arg0)
            if ay < 0
                ay = 0
            end
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(0x08)
            emitMovssXmmToMem(ay, 4, 0)
            freeXmmReg(ay)
            aySpilled = 1
        else
            ay = cgEmitFloatExpr(arg0)
        end
        var ax: int = cgEmitFloatExpr(arg1)
        if aySpilled == 1
            var ly: int = allocXmmReg()
            if ly < 0
                ly = 0
            end
            emitMovssXmmFromMem(ly, 4, 0)
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
            ay = ly
        end
        if ay < 0
            ay = 0
        end
        if ax < 0
            ax = 0
        end
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(0x10)
        emitMovssXmmToMem(ay, 4, 0)
        emit8(0xD9)
        emit8(0x04)
        emit8(0x24)
        emitMovssXmmToMem(ax, 4, 0)
        emit8(0xD9)
        emit8(0x04)
        emit8(0x24)
        emit8(0xD9)
        emit8(0xF3)
        emit8(0xD9)
        emit8(0x1C)
        emit8(0x24)
        var res: int = allocXmmReg()
        if res < 0
            res = 0
        end
        emitMovssXmmFromMem(res, 4, 0)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x10)
        freeXmmReg(ay)
        freeXmmReg(ax)
        return res
    end

    # ---- min / max ----
    if cgStrIs(name, "min") == 1 || cgStrIs(name, "max") == 1
        if argc != 2
            return -1
        end
        var b0: int = cgCallArg(c, 0)
        var b1: int = cgCallArg(c, 1)
        var a2: int = 0
        var aSpilled: int = 0
        if cgExprContainsCall(b1) == 1
            a2 = cgEmitFloatExpr(b0)
            if a2 < 0
                a2 = 0
            end
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(0x08)
            emitMovssXmmToMem(a2, 4, 0)
            freeXmmReg(a2)
            aSpilled = 1
        else
            a2 = cgEmitFloatExpr(b0)
        end
        var bb: int = cgEmitFloatExpr(b1)
        if aSpilled == 1
            var lx: int = allocXmmReg()
            if lx < 0
                lx = 0
            end
            emitMovssXmmFromMem(lx, 4, 0)
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
            a2 = lx
        end
        if a2 < 0
            a2 = 0
        end
        if bb < 0
            bb = 0
        end
        if cgStrIs(name, "min") == 1
            emitMinss(a2, bb)
        else
            emitMaxss(a2, bb)
        end
        freeXmmReg(bb)
        return a2
    end

    # ---- fmod ----
    if cgStrIs(name, "fmod") == 1
        if argc != 2
            return -1
        end
        var f0: int = cgCallArg(c, 0)
        var f1: int = cgCallArg(c, 1)
        var a3: int = 0
        var aSp2: int = 0
        if cgExprContainsCall(f1) == 1
            a3 = cgEmitFloatExpr(f0)
            if a3 < 0
                a3 = 0
            end
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(0x08)
            emitMovssXmmToMem(a3, 4, 0)
            freeXmmReg(a3)
            aSp2 = 1
        else
            a3 = cgEmitFloatExpr(f0)
        end
        var b3: int = cgEmitFloatExpr(f1)
        if aSp2 == 1
            var lx2: int = allocXmmReg()
            if lx2 < 0
                lx2 = 0
            end
            emitMovssXmmFromMem(lx2, 4, 0)
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
            a3 = lx2
        end
        if a3 < 0
            a3 = 0
        end
        if b3 < 0
            b3 = 0
        end
        # t = trunc(a/b); result = a - t*b
        var t: int = allocXmmReg()
        if t < 0
            t = a3
        end
        emitMovssXmm(t, a3)
        emitDivss(t, b3)
        emitRoundss(t, t, 3)
