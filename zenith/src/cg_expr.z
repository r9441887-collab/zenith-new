# ===================== Linux GUI builtins: tryLinuxGUICall =====================
# codegen_builtins_linux.cpp:19..22 — X11-билтины живут в
# codegen_gui_x11.cpp и в этот бэкенд ещё не перенесены, поэтому заглушка
# возвращает false. Портирована ради структуры диспетчера: без неё в .z
# на месте третьей ветки codegen.cpp:5520 была бы ошибка, а C++ бы просто
# прошёл дальше.
func cgTryLinuxGUICall(c: int) -> int
    return 0
end

# ===================== Linux Vulkan builtins: tryLinuxVulkanCall =====================
# codegen_vulkan.cpp:103..399. Headless-ядро: версия API/инстанса, create/
# destroy, перечисление GPU и свойства физического устройства.
#
# Два источника адресов:
#  * `callRipImport` — динамический импорт через GOT (PT_INTERP + DT_NEEDED
#    libvulkan.so.1); в .z это cgPushElfImport(pos, sym, soname);
#  * `callRipSlot` — косвенный вызов по слоту .data-таблицы функций, RVA
#    которого уже финальный, поэтому disp считается прямо при эмиссии.
# Всё остальное — globalFixups (lea r,[rip+disp32] на слоты .data).

# lea reg, [rip + slotRVA]
func cgVkLeaRip(r: int, rva: int)
    if r >= 8
        emit8(0x4C)
    else
        emit8(0x48)
    end
    emit8(0x8D)
    emit8(0x05 | ((r & 7) << 3))
    cgPushGlobalFix(cgCodeLen, rva)
    emit32(0)
end

# call qword [rip+disp32] к слоту .data, который заполняет syscall-загрузчик
# (часть 21 «только syscall»): прямой импорт через PT_DYNAMIC запрещён,
# диспетчеризация по имени — потому что все три call-сайта передают
# строковый литерал, а не числовой slotRva (порядок слотов — тот же, что
# в buildLinuxImportData: 0=vkEnumerateInstanceVersion, 1=vkCreateInstance,
# 2=vkGetInstanceProcAddr).
func cgVkCallRipImport(symLit: int)
    var idx: int = -1
    if cgLitEq(symLit, "vkEnumerateInstanceVersion") == 1
        idx = 0
    end
    if cgLitEq(symLit, "vkCreateInstance") == 1
        idx = 1
    end
    if cgLitEq(symLit, "vkGetInstanceProcAddr") == 1
        idx = 2
    end
    if idx < 0
        cgErrSet("cgVkCallRipImport: неизвестный символ (syscall-only loader знает только 3 символа vulkan)")
        emit8(0xFF)
        emit8(0x15)
        emit32(0)
        return
    end
    cgVkCallRipSlot(cgVkImpSlotRVA[idx])
end

# call qword [rip+disp32] к слоту .data fn-table (RVA уже финальный).
# C++ считает disp прямо при эмиссии и ничего не пушит — в финальном
# образе это совпадает с patchDisp(), но тогда слот не попадает ни в один
# список фикстур и харнесс не может его замаскировать (пер-функциональный
# прогон вообще не вызывает buildLinuxImportData, т.е. rvTable = 0).
# push в globalFixups байтов не меняет: buildELF перепишет те же 4 байта
# той же формулой, а маска их оставит дикими.
func cgVkCallRipSlot(slotRva: int)
    emit8(0xFF)
    emit8(0x15)
    var pos: int = cgCodeLen
    cgPushGlobalFix(pos, slotRva)
    var disp: int = slotRva - (cgTextRVA + pos + 4)
    emit32(disp)
end

# хвост обработчера: pop резервных + jmp на общий выход
func cgVkFinish(vkExit: int)
    emit8(0x41)
    emit8(0x5C)
    emit8(0x5E)
    emit8(0x5F)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
    emitJmp(vkExit)
end

# rax = -1 (ошибка для билтина)
func cgVkSetNeg1()
    emit8(0x48)
    emit8(0xC7)
    emit8(0xC0)
    emit32(0xFFFFFFFF)
end

# rdi/rsi (пул 7/6) заняты — закрепить бит в cgRegsUsed
func cgVkGuard(wantReg: int)
    if wantReg == 6 || wantReg == 7
        cgRegsUsed = cgRegsUsed | (1 << wantReg)
    end
end

func cgVkMovToR12(src: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC4 | (src << 3))
end

func cgVkMovToR13(src: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC5 | (src << 3))
end

func cgVkMovToR14(src: int)
    emit8(0x49)
    emit8(0x89)
    emit8(0xC6 | (src << 3))
end

# resolveTableFn(idx, strRva) — vkGetInstanceProcAddr → слот fn-table
func cgVkResolveTableFn(idx: int, strRva: int)
    cgVkLeaRip(1, cgVkInstRVA)
    emit8(0x48)
    emit8(0x8B)
    emit8(0x39)
    cgVkLeaRip(6, strRva)
    cgVkCallRipImport("vkGetInstanceProcAddr")
    cgVkLeaRip(1, cgVkFnTableRVA + idx * 8)
    emit8(0x48)
    emit8(0x89)
    emit8(0x01)
end

func cgTryLinuxVulkanCall(c: int) -> int
    var name: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    var isVk: int = 0
    if cgStrIs(name, "vk_api_version") == 1 || cgStrIs(name, "vk_instance_create") == 1 || cgStrIs(name, "vk_instance_version") == 1 || cgStrIs(name, "vk_destroy_instance") == 1 || cgStrIs(name, "vk_gpu_count") == 1 || cgStrIs(name, "vk_gpu_name") == 1 || cgStrIs(name, "vk_gpu_api") == 1 || cgStrIs(name, "vk_gpu_vendor") == 1 || cgStrIs(name, "vk_gpu_device") == 1
        isVk = 1
    end
    if isVk == 0
        return 0
    end
    if cgStrIs(name, "vk_api_version") == 1 && argc != 0
        return 0
    end
    if cgStrIs(name, "vk_instance_create") == 1 && argc != 0
        return 0
    end
    if cgStrIs(name, "vk_instance_version") == 1 && argc != 0
        return 0
    end
    if cgStrIs(name, "vk_destroy_instance") == 1 && argc != 1
        return 0
    end
    if cgStrIs(name, "vk_gpu_count") == 1 && argc != 1
        return 0
    end
    if (cgStrIs(name, "vk_gpu_api") == 1 || cgStrIs(name, "vk_gpu_vendor") == 1 || cgStrIs(name, "vk_gpu_device") == 1) && argc != 2
        return 0
    end
    if cgStrIs(name, "vk_gpu_name") == 1 && argc != 3
        return 0
    end

    cgVkUsed = 1

    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)

    emit8(0x57)
    emit8(0x56)
    emit8(0x41)
    emit8(0x54)

    var vkExit: int = newLabel()

    # ---- vk_api_version() -> 4206592 (VK_API_VERSION_1_3) ----
    if cgStrIs(name, "vk_api_version") == 1
        var doneA: int = newLabel()
        emit8(0x48)
        emit8(0xC7)
        emit8(0xC0)
        emit32(0x403000)
        emitJmp(doneA)
        emitLabel(doneA)
        cgVkFinish(vkExit)
    else if cgStrIs(name, "vk_instance_version") == 1
        # ---- vk_instance_version() -> макс. поддерживаемая версия, иначе -1 ----
        var okV: int = newLabel()
        var doneV: int = newLabel()
        cgVkLeaRip(7, cgVkCountRVA)
        cgVkCallRipImport("vkEnumerateInstanceVersion")
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", okV)
        cgVkSetNeg1()
        emitJmp(doneV)
        emitLabel(okV)
        cgVkLeaRip(0, cgVkCountRVA)
        emit8(0x8B)
        emit8(0x00)
        emitLabel(doneV)
        cgVkFinish(vkExit)
    else if cgStrIs(name, "vk_instance_create") == 1
        # ---- vk_instance_create() -> VkInstance или -1 ----
        var failC: int = newLabel()
        var doneC: int = newLabel()

        # VkApplicationInfo в слоте .data:
        #  [0] sType=0, [8] pNext=0, [16] pApplicationName="Zenith",
        #  [24] applicationVersion=1, [32] pEngineName="Zenith",
        #  [40] engineVersion=1, [44] apiVersion=VK_API_VERSION_1_3.
        cgVkLeaRip(0, cgVkAppInfoRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x00)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x40)
        emit8(0x08)
        emit32(0)
        cgVkLeaRip(1, cgVkZenithStrRVA)
        emit8(0x48)
        emit8(0x89)
        emit8(0x48)
        emit8(0x10)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x40)
        emit8(0x18)
        emit32(1)
        emit8(0x48)
        emit8(0x89)
        emit8(0x48)
        emit8(0x20)
        emit8(0xC7)
        emit8(0x40)
        emit8(0x28)
        emit32(1)
        emit8(0xC7)
        emit8(0x40)
        emit8(0x2C)
        emit32(0x403000)

        # VkInstanceCreateInfo в слоте .data:
        #  [0] sType=1, [8] pNext=0, [0x10] flags=0, [0x18] pApplicationInfo,
        #  [0x20] layerCount, [0x28] ppLayers, [0x30] extCount, [0x38] ppExt.
        cgVkLeaRip(1, cgVkInstInfoRVA)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x01)
        emit32(1)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x08)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x10)
        emit32(0)
        cgVkLeaRip(2, cgVkAppInfoRVA)
        emit8(0x48)
        emit8(0x89)
        emit8(0x51)
        emit8(0x18)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x20)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x28)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x30)
        emit32(0)
        emit8(0x48)
        emit8(0xC7)
        emit8(0x41)
        emit8(0x38)
        emit32(0)

        # При включённом WSI слое подключаем VK_KHR_surface +
        # VK_KHR_wayland_surface, чтобы заработал vkCreateWaylandSurfaceKHR.
        if cgVkSurfaceUsed != 0
            cgVkLeaRip(1, cgVkInstInfoRVA)
            emit8(0xC7)
            emit8(0x41)
            emit8(0x30)
            emit32(2)
            cgVkLeaRip(2, cgVkExtArrayRVA)
            emit8(0x48)
            emit8(0x89)
            emit8(0x51)
            emit8(0x38)
        end

        cgVkLeaRip(7, cgVkInstInfoRVA)
        emit8(0x31)
        emit8(0xF6)
        cgVkLeaRip(2, cgVkInstRVA)
        cgVkCallRipImport("vkCreateInstance")
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", failC)

        # Таблица функций инстанса через vkGetInstanceProcAddr.
        cgVkResolveTableFn(0, cgVkDestroyStrRVA)
        cgVkResolveTableFn(1, cgVkEnumPhyStrRVA)
        cgVkResolveTableFn(2, cgVkPhyPropsStrRVA)
        cgVkResolveTableFn(3, cgVkDevProcStrRVA)

        cgVkLeaRip(1, cgVkInstRVA)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x01)
        emitJmp(doneC)
        emitLabel(failC)
        cgVkSetNeg1()
        emitLabel(doneC)
        cgVkFinish(vkExit)
    else if cgStrIs(name, "vk_destroy_instance") == 1
        # ---- vk_destroy_instance(h) -> 0 или -1 ----
        var failD: int = newLabel()
        var doneD: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkGuard(7)
        emit8(0x31)
        emit8(0xF6)
        cgVkCallRipSlot(cgVkFnTableRVA + 0)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", failD)
        emit8(0x31)
        emit8(0xC0)
        emitJmp(doneD)
        emitLabel(failD)
        cgVkSetNeg1()
        emitLabel(doneD)
        cgVkFinish(vkExit)
    else if cgStrIs(name, "vk_gpu_count") == 1
        # ---- vk_gpu_count(h) -> число device или -1 ----
        var failG: int = newLabel()
        var doneG: int = newLabel()
        var b0: int = cgEmitExpr(cgCallArg(c, 0))
        if b0 != 7
            emitMovReg(7, b0)
        end
        freeReg(b0)
        cgVkGuard(7)
        cgVkLeaRip(6, cgVkCountRVA)
        emit8(0x31)
        emit8(0xD2)
        cgVkCallRipSlot(cgVkFnTableRVA + 8)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", failG)
        cgVkLeaRip(0, cgVkCountRVA)
        emit8(0x8B)
        emit8(0x00)
        emitJmp(doneG)
        emitLabel(failG)
        cgVkSetNeg1()
        emitLabel(doneG)
        cgVkFinish(vkExit)
    else
        # ---- GPU-семейство: (h, idx[, &buf]) -> свойство физического устройства ----
        var failP: int = newLabel()
        var okP: int = newLabel()
        var doneP: int = newLabel()
        var g0: int = cgEmitExpr(cgCallArg(c, 0))
        cgVkMovToR12(g0)
        freeReg(g0)
        var g1: int = cgEmitExpr(cgCallArg(c, 1))
        cgVkMovToR13(g1)
        freeReg(g1)
        if cgStrIs(name, "vk_gpu_name") == 1
            var g2: int = cgEmitExpr(cgCallArg(c, 2))
            cgVkMovToR14(g2)
            freeReg(g2)
        end

        emit8(0x4C)
        emit8(0x89)
        emit8(0xE7)
        cgVkLeaRip(6, cgVkCountRVA)
        cgVkLeaRip(2, cgVkPhyBufRVA)
        cgVkCallRipSlot(cgVkFnTableRVA + 8)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("!=", failP)

        cgVkLeaRip(1, cgVkCountRVA)
        emit8(0x4C)
        emit8(0x39)
        emit8(0x29)
        emit8(0x0F)
        emit8(0x87)
        cgFixPush(cgCodeLen, okP)
        emit32(0)
        emitJmp(failP)
        emitLabel(okP)

        # dev = devices[idx]
        cgVkLeaRip(1, cgVkPhyBufRVA)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xE8)
        emit8(0x48)
        emit8(0xC1)
        emit8(0xE0)
        emit8(0x03)
        emit8(0x48)
        emit8(0x01)
        emit8(0xC8)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x38)
        cgVkLeaRip(6, cgVkPropsRVA)
        cgVkCallRipSlot(cgVkFnTableRVA + 16)

        if cgStrIs(name, "vk_gpu_name") == 1
            # memcpy: deviceName (props+20, 256 байт) -> buf
            cgVkLeaRip(6, cgVkPropsRVA)
            emit8(0x48)
            emit8(0x83)
            emit8(0xC6)
            emit8(0x14)
            emit8(0x4C)
            emit8(0x89)
            emit8(0xF7)
            emit8(0xB9)
            emit32(256)
            emit8(0xF3)
            emit8(0xA4)
            emit8(0x31)
            emit8(0xC0)
            emitJmp(doneP)
        else
            cgVkLeaRip(0, cgVkPropsRVA)
            if cgStrIs(name, "vk_gpu_api") == 1
                emit8(0x8B)
                emit8(0x00)
            end
            if cgStrIs(name, "vk_gpu_vendor") == 1
                emit8(0x8B)
                emit8(0x40)
                emit8(0x08)
            end
            if cgStrIs(name, "vk_gpu_device") == 1
                emit8(0x8B)
                emit8(0x40)
                emit8(0x0C)
            end
            emitJmp(doneP)
        end
        emitLabel(failP)
        cgVkSetNeg1()
        emitLabel(doneP)
        cgVkFinish(vkExit)
    end

    # =============== Общий выход: восстановление аллокатора ===============
    emitLabel(vkExit)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# tryLinuxNetCall (codegen_net_linux.cpp:31..570) — raw-syscall сокеты.
#
# Зеркало Windows ws2_32-бэкенда (codegen_net.cpp), поэтому исходники
# `app console` / `app linux` с net_* переносятся без правок:
#   TCP:  net_tcp_listen(port) / net_tcp_accept(s) / net_tcp_connect(host,port)
#          net_tcp_send(s,data,len) / net_tcp_recv(s,buf,len) / net_tcp_close(s)
#   UDP:  net_udp_open(port) / net_udp_send(s,host,port,data,len)
#          net_udp_recv(s,buf,len) / net_udp_peer_ip() / net_udp_peer_port()
#          net_udp_close(s)
#   Ctl:  net_set_nonblocking(s,on) / net_last_error()
#
# ABI сырого syscall: nr в rax, аргументы в rdi,rsi,rdx,r10,r8,r9 (четвёртый
# аргумент — r10, НЕ rcx). Успех — 0/положительное, отказ — -errno, который
# стягивается к контракту языка (-1), а положительный errno пишется в слот
# .data, читаемый net_last_error().
#
# Хост: "localhost" -> 127.0.0.1 (fast path), любой другой — только
# dotted-quad (у raw-syscall'ов нет резолвера).
#
# Регистры: rdi/rsi/r12 staging (callee-saved, переживают syscall — как в
# Windows-бэкенде), r8-r11 и r13-r15 — свободный scratch (пул аллокатора —
# только rax/rcx/rdx/rbx/rsi/rdi). Пролог: 3 push БЕЗ sub rsp,8 — в отличие
# от Vulkan-бэкенда (кодоген здесь не зовёт ни одной функции, выравнивание
# стека не нужно) и эпилог — ровно 3 pop.
#
# Хелперы cgVkLeaRip/cgVkGuard/cgVkMovToR12/cgVkSetNeg1 уже были вынесены из
# Vulkan-порта как общие; в C++ это локальные лямбды каждого бэкенда
# (leaRip/guard/movToR12), байты от этого не зависят.
# ============================================================================

# mov eax, nr ; syscall
func cgNetSvc(nr: int)
    emit8(0xB8)
    emit32(nr)
    emit8(0x0F)
    emit8(0x05)
end

# rax держит -errno: сохранить +errno в слот и выставить rax = -1.
# Трогает только rax/rcx/r10.
func cgNetStoreErr()
    emit8(0x48)
    emit8(0x89)
    emit8(0xC1)
    emit8(0x48)
    emit8(0xF7)
    emit8(0xD9)
    cgVkLeaRip(10, cgLinNetErrRVA)
    emit8(0x49)
    emit8(0x89)
    emit8(0x0A)
    cgVkSetNeg1()
end

# Разбор хоста из rsi в слот sockaddr_in:
#   "localhost" -> 127.0.0.1 (fast path, 4 compare/load)
#   "a.b.c.d"   -> парсер dotted-quad (недостающие октеты = 0)
# На выходе rdx = &peer; ломает rax, rcx, r8, r9, rsi и флаги.
func cgNetHostBuild()
    var bparse: int = newLabel()
    var hdone: int = newLabel()
    cgVkLeaRip(2, cgSockPeerRVA)
    emit8(0x81)
    emit8(0x3E)
    emit32(0x61636F6C)
    emitJccLit("!=", bparse)
    emit8(0x81)
    emit8(0x7E)
    emit8(0x04)
    emit32(0x736F686C)
    emitJccLit("!=", bparse)
    emit8(0x80)
    emit8(0x7E)
    emit8(0x08)
    emit8(0x74)
    emitJccLit("!=", bparse)
    emit8(0x80)
    emit8(0x7E)
    emit8(0x09)
    emit8(0x00)
    emitJccLit("!=", bparse)
    emit8(0xC7)
    emit8(0x42)
    emit8(0x04)
    emit32(0x0100007F)
    emitJmp(hdone)
    emitLabel(bparse)
    emit8(0x4C)
    emit8(0x8D)
    emit8(0x4A)
    emit8(0x04)
    emit8(0x45)
    emit8(0x31)
    emit8(0xC0)
    emit8(0x31)
    emit8(0xC9)
    var pqTop: int = newLabel()
    var pqDot: int = newLabel()
    var pqStore: int = newLabel()
    var pqDone: int = newLabel()
    emitLabel(pqTop)
    emit8(0x0F)
    emit8(0xB6)
    emit8(0x06)
    emit8(0x84)
    emit8(0xC0)
    emitJccLit("==", pqStore)
    emit8(0x3C)
    emit8(0x2E)
    emitJccLit("==", pqDot)
    emit8(0x2C)
    emit8(0x30)
    emit8(0x45)
    emit8(0x6B)
    emit8(0xC0)
    emit8(0x0A)
    emit8(0x44)
    emit8(0x01)
    emit8(0xC0)
    emit8(0x48)
    emit8(0xFF)
    emit8(0xC6)
    emitJmp(pqTop)
    emitLabel(pqDot)
    emit8(0x49)
    emit8(0x88)
    emit8(0x01)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC1)
    emit8(0x45)
    emit8(0x31)
    emit8(0xC0)
    emit8(0x48)
    emit8(0xFF)
    emit8(0xC6)
    emit8(0xFF)
    emit8(0xC1)
    emit8(0x83)
    emit8(0xF9)
    emit8(0x03)
    emitJccLit("==", pqTop)
    emitJmp(pqTop)
    emitLabel(pqStore)
    emit8(0x49)
    emit8(0x88)
    emit8(0x01)
    emitLabel(pqDone)
    emitLabel(hdone)
end

# AF_INET + htons(r12w) в семейство/порт; адрес остаётся INADDR_ANY,
# потому что слот уже заполнен emitHostBuild.
func cgNetStorePortAddr()
    emit8(0x66)
    emit8(0xC7)
    emit8(0x02)
    emit16(2)
    emit8(0x41)
    emit8(0x0F)
    emit8(0xB7)
    emit8(0xC4)
    emit8(0x86)
    emit8(0xE0)
    emit8(0x66)
    emit8(0x89)
    emit8(0x42)
    emit8(0x02)
end

# sockaddr_in для listen: AF_INET + htons(r12w) + INADDR_ANY (слот чист).
func cgNetStoreListenAddr()
    emit8(0x66)
    emit8(0xC7)
    emit8(0x02)
    emit16(2)
    emit8(0x41)
    emit8(0x0F)
    emit8(0xB7)
    emit8(0xC4)
    emit8(0x86)
    emit8(0xE0)
    emit8(0x66)
    emit8(0x89)
    emit8(0x42)
    emit8(0x02)
    emit8(0xC7)
    emit8(0x42)
    emit8(0x04)
    emit32(0)
end

# Форматирование одного октета byte[r15+4+off] в ipbuf как десятичное число;
# sep — разделитель ('.' между октетами, 0 как завершающий NUL).
func cgNetOctet(off: int, sep: int)
    emit8(0x41)
    emit8(0x0F)
    emit8(0xB6)
    emit8(0x47)
    emit8(4 + off)
    var skipH: int = newLabel()
    var printT: int = newLabel()
    var skipT: int = newLabel()
    emit8(0x3D)
    emit32(100)
    emitJccRaw(0x82, skipH)
    emit8(0x31)
    emit8(0xD2)
    emit8(0xB9)
    emit32(100)
    emit8(0xF7)
    emit8(0xF1)
    emit8(0x04)
    emit8(0x30)
    emit8(0x41)
    emit8(0x88)
    emit8(0x06)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC6)
    emit8(0x89)
    emit8(0xD0)
    emit8(0x31)
    emit8(0xD2)
    emit8(0xB9)
    emit32(10)
    emit8(0xF7)
    emit8(0xF1)
    emitJmp(printT)
    emitLabel(skipH)
    emit8(0x31)
    emit8(0xD2)
    emit8(0xB9)
    emit32(10)
    emit8(0xF7)
    emit8(0xF1)
    emit8(0x84)
    emit8(0xC0)
    emitJccLit("==", skipT)
    emitLabel(printT)
    emit8(0x04)
    emit8(0x30)
    emit8(0x41)
    emit8(0x88)
    emit8(0x06)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC6)
    emitLabel(skipT)
    emit8(0x89)
    emit8(0xD0)
    emit8(0x04)
    emit8(0x30)
    emit8(0x41)
    emit8(0x88)
    emit8(0x06)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC6)
    emit8(0x41)
    emit8(0xC6)
    emit8(0x06)
    emit8(sep)
    emit8(0x49)
    emit8(0xFF)
    emit8(0xC6)
end

# Общий эпилог ветки: pop r12 / pop rsi / pop rdi и прыжок к общему выходу.
# (У Vulkan он же плюс `add rsp, 8` — там был пролог `sub rsp, 8`.)
func cgNetFinish(netExit: int)
    emit8(0x41)
    emit8(0x5C)
    emit8(0x5E)
    emit8(0x5F)
    emitJmp(netExit)
end

# Тот же эпилог, но для веток, чей результат пережил `pop rax` в r11:
# net_tcp_send/net_tcp_recv (:316..320) и net_udp_recv (:469..475) кладут
# syscall-result в r11, потом снимают len с результата регистром rax и только
# после pops возвращают rax из r11. Порядок байтов дословно как в C++.
func cgNetFinishRestoreR11(netExit: int)
    emit8(0x41)
    emit8(0x5C)
    emit8(0x5E)
    emit8(0x5F)
    emit8(0x4C)
    emit8(0x89)
    emit8(0xD8)
    emitJmp(netExit)
end

func cgTryLinuxNetCall(c: int) -> int
    var name: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    var isTcp: int = 0
    if cgStrIs(name, "net_tcp_listen") == 1 || cgStrIs(name, "net_tcp_accept") == 1 || cgStrIs(name, "net_tcp_connect") == 1 || cgStrIs(name, "net_tcp_send") == 1 || cgStrIs(name, "net_tcp_recv") == 1 || cgStrIs(name, "net_tcp_close") == 1
        isTcp = 1
    end
    var isUdp: int = 0
    if cgStrIs(name, "net_udp_open") == 1 || cgStrIs(name, "net_udp_send") == 1 || cgStrIs(name, "net_udp_recv") == 1 || cgStrIs(name, "net_udp_peer_ip") == 1 || cgStrIs(name, "net_udp_peer_port") == 1 || cgStrIs(name, "net_udp_close") == 1
        isUdp = 1
    end
    var isCtl: int = 0
    if cgStrIs(name, "net_set_nonblocking") == 1 || cgStrIs(name, "net_last_error") == 1
        isCtl = 1
    end
    if isTcp == 0 && isUdp == 0 && isCtl == 0
        return 0
    end

    # ---- Arity guards (дословно как в Windows-бэкенде) ----
    if (cgStrIs(name, "net_tcp_listen") == 1 || cgStrIs(name, "net_udp_open") == 1 || cgStrIs(name, "net_tcp_accept") == 1 || cgStrIs(name, "net_tcp_close") == 1 || cgStrIs(name, "net_udp_close") == 1) && argc != 1
        return 0
    end
    if cgStrIs(name, "net_tcp_connect") == 1 && argc != 2
        return 0
    end
    if (cgStrIs(name, "net_tcp_send") == 1 || cgStrIs(name, "net_tcp_recv") == 1 || cgStrIs(name, "net_udp_recv") == 1) && argc != 3
        return 0
    end
    if cgStrIs(name, "net_udp_send") == 1 && argc != 5
        return 0
    end
    if cgStrIs(name, "net_set_nonblocking") == 1 && argc != 2
        return 0
    end
    if (cgStrIs(name, "net_last_error") == 1 || cgStrIs(name, "net_udp_peer_ip") == 1 || cgStrIs(name, "net_udp_peer_port") == 1) && argc != 0
        return 0
    end

    cgNetSocksUsed = 1

    # Слоты .data: их раскладывает cgBuildLinuxImportData под cgNetSocksUsed.
    # peerRVA = 16B sockaddr_in, peerLenRVA = 8B addrlen,
    # errRVA = 8B last error, ipbufRVA = 16B peer ip.
    var peerRVA: int = cgSockPeerRVA
    var peerLenRVA: int = cgSockPeerLenRVA
    var errRVA: int = cgLinNetErrRVA
    var ipbufRVA: int = cgLinNetIpBufRVA

    # Staging как в Windows-бэкенде: spill, пауза аллокатора, push callee-saved
    # rdi/rsi (пул 7/6) и r12 (вне пула).
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0

    emit8(0x57)
    emit8(0x56)
    emit8(0x41)
    emit8(0x54)

    var netExit: int = newLabel()

    # ---- net_tcp_listen(port) / net_udp_open(port) -> socket | -1 ----
    if (cgStrIs(name, "net_tcp_listen") == 1 || cgStrIs(name, "net_udp_open") == 1) && argc == 1
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkMovToR12(7)
        emit8(0xBF)
        emit32(2)
        if cgStrIs(name, "net_tcp_listen") == 1
            emit8(0xBE)
            emit32(1)
        else
            emit8(0xBE)
            emit32(2)
        end
        if cgStrIs(name, "net_tcp_listen") == 1
            emit8(0xBA)
            emit32(6)
        else
            emit8(0xBA)
            emit32(17)
        end
        cgNetSvc(41)
        var sockOk: int = newLabel()
        var bindOk: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", sockOk)
        cgNetStoreErr()
        emitJmp(done)
        emitLabel(sockOk)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC7)
        cgVkLeaRip(2, peerRVA)
        cgNetStoreListenAddr()
        emit8(0x48)
        emit8(0x89)
        emit8(0xD6)
        emit8(0xBA)
        emit32(16)
        cgNetSvc(49)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", bindOk)
        cgNetStoreErr()
        cgNetSvc(3)
        cgVkSetNeg1()
        emitJmp(done)
        emitLabel(bindOk)
        if cgStrIs(name, "net_tcp_listen") == 1
            emit8(0xBE)
            emit32(128)
            cgNetSvc(50)
            emit8(0x85)
            emit8(0xC0)
            var bindFail: int = newLabel()
            emitJccLit("!=", bindFail)
            emit8(0x48)
            emit8(0x89)
            emit8(0xF8)
            emitJmp(done)
            emitLabel(bindFail)
            cgNetStoreErr()
            cgNetSvc(3)
            cgVkSetNeg1()
        else
            emit8(0x48)
            emit8(0x89)
            emit8(0xF8)
        end
        emitJmp(done)
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_tcp_accept(server) -> client socket | -1 (blocking) ----
    if cgStrIs(name, "net_tcp_accept") == 1 && argc == 1
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        emit8(0x31)
        emit8(0xF6)
        emit8(0x31)
        emit8(0xD2)
        cgNetSvc(43)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", done)
        cgNetStoreErr()
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_tcp_connect(host, port) -> connected socket | -1 ----
    if cgStrIs(name, "net_tcp_connect") == 1 && argc == 2
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 6
            emitMovReg(6, a0)
        end
        freeReg(a0)
        cgVkGuard(6)
        var hostFail: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xF6)
        emitJccLit("==", hostFail)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        cgVkMovToR12(a1)
        freeReg(a1)
        cgNetHostBuild()
        cgNetStorePortAddr()
        var sockOk: int = newLabel()
        var connOk: int = newLabel()
        emit8(0xBF)
        emit32(2)
        emit8(0xBE)
        emit32(1)
        emit8(0xBA)
        emit32(6)
        cgNetSvc(41)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", sockOk)
        cgNetStoreErr()
        emitJmp(done)
        emitLabel(sockOk)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC7)
        cgVkLeaRip(6, peerRVA)
        emit8(0xBA)
        emit32(16)
        cgNetSvc(42)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("==", connOk)
        cgNetStoreErr()
        cgNetSvc(3)
        cgVkSetNeg1()
        emitJmp(done)
        emitLabel(connOk)
        emit8(0x48)
        emit8(0x89)
        emit8(0xF8)
        emitJmp(done)
        emitLabel(hostFail)
        cgVkSetNeg1()
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_tcp_send(sock, data, len) / net_tcp_recv(sock, buf, len) ----
    if (cgStrIs(name, "net_tcp_send") == 1 || cgStrIs(name, "net_tcp_recv") == 1) && argc == 3
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkGuard(7)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        if a1 != 6
            emitMovReg(6, a1)
        end
        freeReg(a1)
        cgVkGuard(6)
        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        if a2 != 0
            emitMovReg(0, a2)
        end
        freeReg(a2)
        emit8(0x50)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x14)
        emit8(0x24)
        emit8(0x45)
        emit8(0x31)
        emit8(0xD2)
        if cgStrIs(name, "net_tcp_send") == 1
            cgNetSvc(44)
        else
            cgNetSvc(45)
        end
        var ok: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", ok)
        cgNetStoreErr()
        emitLabel(ok)
        emit8(0x49)
        emit8(0x89)
        emit8(0xC3)
        emit8(0x58)
        cgNetFinishRestoreR11(netExit)
    end

    # ---- net_tcp_close(sock) / net_udp_close(sock) -> 0 | -1 ----
    if (cgStrIs(name, "net_tcp_close") == 1 || cgStrIs(name, "net_udp_close") == 1) && argc == 1
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgNetSvc(3)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", done)
        cgNetStoreErr()
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_udp_send(sock, host, port, data, len) -> bytes | -1 ----
    if cgStrIs(name, "net_udp_send") == 1 && argc == 5
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkGuard(7)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        if a1 != 6
            emitMovReg(6, a1)
        end
        freeReg(a1)
        cgVkGuard(6)
        var hostFail: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xF6)
        emitJccLit("==", hostFail)
        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        cgVkMovToR12(a2)
        freeReg(a2)
        var a3: int = cgEmitExpr(cgCallArg(c, 3))
        if a3 != 0
            emitMovReg(0, a3)
        end
        freeReg(a3)
        emit8(0x50)
        var a4: int = cgEmitExpr(cgCallArg(c, 4))
        if a4 != 0
            emitMovReg(0, a4)
        end
        freeReg(a4)
        emit8(0x50)
        cgNetHostBuild()
        cgNetStorePortAddr()
        cgVkLeaRip(8, peerRVA)
        emit8(0x41)
        emit8(0xB9)
        emit32(16)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x74)
        emit8(0x24)
        emit8(0x08)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x14)
        emit8(0x24)
        emit8(0x45)
        emit8(0x31)
        emit8(0xD2)
        cgNetSvc(44)
        var ok: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", ok)
        cgNetStoreErr()
        emitLabel(ok)
        emit8(0x49)
        emit8(0x89)
        emit8(0xC3)
        emit8(0x58)
        emit8(0x58)
        cgNetFinish(netExit)
        emitLabel(hostFail)
        cgVkSetNeg1()
        cgNetFinish(netExit)
    end

    # ---- net_udp_recv(sock, buf, len) -> bytes | -1 (sender в слоте peer) ----
    if cgStrIs(name, "net_udp_recv") == 1 && argc == 3
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkGuard(7)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        if a1 != 6
            emitMovReg(6, a1)
        end
        freeReg(a1)
        cgVkGuard(6)
        var a2: int = cgEmitExpr(cgCallArg(c, 2))
        if a2 != 0
            emitMovReg(0, a2)
        end
        freeReg(a2)
        emit8(0x50)
        cgVkLeaRip(9, peerLenRVA)
        emit8(0x41)
        emit8(0xC7)
        emit8(0x01)
        emit32(16)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x14)
        emit8(0x24)
        emit8(0x45)
        emit8(0x31)
        emit8(0xD2)
        cgVkLeaRip(8, peerRVA)
        cgNetSvc(45)

        # Успех — отформатировать адрес отправителя в ipbuf (чтобы peer_ip()
        # был дёшев); отказ — стянуть к -1 и записать errno.
        var fmtSkip: int = newLabel()
        var afterFmt: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit("<", fmtSkip)
        emit8(0x49)
        emit8(0x89)
        emit8(0xC2)
        cgVkLeaRip(15, peerRVA)
        cgVkLeaRip(14, ipbufRVA)

        cgNetOctet(0, 46)
        cgNetOctet(1, 46)
        cgNetOctet(2, 46)
        cgNetOctet(3, 0)
        emitJmp(afterFmt)
        emitLabel(fmtSkip)
        cgNetStoreErr()
        emit8(0x49)
        emit8(0x89)
        emit8(0xC2)
        emitLabel(afterFmt)
        emit8(0x4D)
        emit8(0x89)
        emit8(0xD3)
        emit8(0x58)
        cgNetFinishRestoreR11(netExit)
    end

    # ---- net_udp_peer_ip() -> строка (ipbuf, отформатирован в net_udp_recv) ----
    if cgStrIs(name, "net_udp_peer_ip") == 1 && argc == 0
        var done: int = newLabel()
        cgVkLeaRip(0, ipbufRVA)
        emitJmp(done)
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_udp_peer_port() -> int (ntohs порта отправителя последнего пакета) ----
    if cgStrIs(name, "net_udp_peer_port") == 1 && argc == 0
        var done: int = newLabel()
        cgVkLeaRip(0, peerRVA)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x40)
        emit8(0x02)
        emit8(0x86)
        emit8(0xE0)
        emitJmp(done)
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_set_nonblocking(sock, enable) -> 0 | -1 (fcntl F_GETFL/F_SETFL) ----
    if cgStrIs(name, "net_set_nonblocking") == 1 && argc == 2
        var done: int = newLabel()
        var a0: int = cgEmitExpr(cgCallArg(c, 0))
        if a0 != 7
            emitMovReg(7, a0)
        end
        freeReg(a0)
        cgVkGuard(7)
        var a1: int = cgEmitExpr(cgCallArg(c, 1))
        cgVkMovToR12(a1)
        freeReg(a1)
        emit8(0xBE)
        emit32(3)
        cgNetSvc(72)
        var getOk: int = newLabel()
        var setF: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", getOk)
        cgNetStoreErr()
        emitJmp(done)
        emitLabel(getOk)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xC0)
        emit8(0x4D)
        emit8(0x85)
        emit8(0xE4)
        emitJccLit("==", setF)
        emit8(0x4C)
        emit8(0x89)
        emit8(0xC0)
        emit8(0x0D)
        emit32(2048)
        emitLabel(setF)
        emit8(0x48)
        emit8(0x89)
        emit8(0xC2)
        emit8(0xBE)
        emit32(4)
        cgNetSvc(72)
        var ok: int = newLabel()
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0)
        emitJccLit(">=", ok)
        cgNetStoreErr()
        emitLabel(ok)
        emitJmp(done)
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ---- net_last_error() -> int (слот заполняет cgNetStoreErr) ----
    if cgStrIs(name, "net_last_error") == 1 && argc == 0
        var done: int = newLabel()
        cgVkLeaRip(0, errRVA)
        emit8(0x8B)
        emit8(0x00)
        emitJmp(done)
        emitLabel(done)
        cgNetFinish(netExit)
    end

    # ================= Общий выход: восстановление аллокатора ===============
    emitLabel(netExit)
    cgRegsUsed = 0
    freeReg(1)
    freeReg(2)
    freeReg(3)
    var r: int = allocReg()
    if r != 0
        emitMovReg(r, 0)
        freeReg(0)
    end
    cgRegsUsed = saved & ~(1 << r)
    reloadRegs()
    cgRegsUsed = saved | (1 << r)
    if r < 0
        cgLinResReg = 0
    else
        cgLinResReg = r
    end
    return 1
end

# ============================================================================
# codegen_httpdl.cpp — HTTP/HTTPS download builtins (`app linux`)
#
# Весь движок живёт в freestanding-блобе (src/httpdl_blob.h), который в .text
# кладёт cgEmitHttpDlBlob() из src/cg_httpdl_blob.z. Вызов через него:
# codegen stages op + args в rdi/rsi/rdx/rcx/r8/r9 и `call rel32` на точку
# входа блоба (HTTPDL_BLOB_ENTRY), результат возвращается в rax.
#
#   http_download(url, file)                              -> int
#   http_download_ask(url, file)                          -> int
#   http_download_speed(url, file)                        -> int
#   http_server(port[, cert, key])                        -> int
#   http_download_ghreleases(owner, repo, pattern, file)  -> int
#   http_download_ask_gh(owner, repo, branch, path, excl) -> int
#   http_download_msiso(version[, file])                  -> int
#   http_download_winpe(version[, file])                  -> int
#   http_download_winpe_media(version[, file])            -> int
#   iso_extract / http_download_iso(...)                  -> int
# ============================================================================

func cgIsHttpDlName(n: int) -> int
    if cgStrIs(n, "http_download") == 1
        return 1
    end
    if cgStrIs(n, "http_download_ask") == 1
        return 1
    end
    if cgStrIs(n, "http_download_speed") == 1
        return 1
    end
    if cgStrIs(n, "http_server") == 1
        return 1
    end
    if cgStrIs(n, "http_download_ghreleases") == 1
        return 1
    end
    if cgStrIs(n, "http_download_ask_gh") == 1
        return 1
    end
    if cgStrIs(n, "http_download_msiso") == 1
        return 1
    end
    if cgStrIs(n, "http_download_winpe") == 1
        return 1
    end
    if cgStrIs(n, "http_download_winpe_media") == 1
        return 1
    end
    if cgStrIs(n, "iso_extract") == 1
        return 1
    end
    if cgStrIs(n, "http_download_iso") == 1
        return 1
    end
    return 0
end

# ===================== detect*Usage =====================
# Пять обходчиков из codegen.cpp:8646..8656. Все они — один и тот же обход
# ZAST, отличается только предикат имени и ставящийся флаг; шаблон —
# cgDetectHttpDl* ниже. Порядок вызова в cgGenerateWide — как в C++.

# codegen_pe.cpp:220..225 — имена, поднимающие httpGetUsed.
func cgIsNetHttpGetName(n: int) -> int
    if cgStrIs(n, "http_get") == 1
        return 1
    end
    if cgStrIs(n, "http_last_error") == 1
        return 1
    end
    if cgStrIs(n, "http_json") == 1
        return 1
    end
    if cgStrIs(n, "http_download") == 1
        return 1
    end
    if cgStrIs(n, "http_download_ask") == 1
        return 1
    end
    if cgStrIs(n, "http_download_speed") == 1
        return 1
    end
    return 0
end

# codegen_disasm.cpp:39
func cgIsDisasmName(n: int) -> int
    if cgStrIs(n, "disasm") == 1
        return 1
    end
    if cgStrIs(n, "disasm_one") == 1
        return 1
    end
