    if cgStrIs(n, "memDel") == 1 && argc == 1
        var mdSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var mdR: int = cgEmitExpr(cgCallArg(c, 0))
        if mdR != 1
