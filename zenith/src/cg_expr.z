        emitJmp(spDone)

        emitLabel(spFree)
        emit8(0x50)
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emit8(0x48)
        emit8(0x0F)
        emit8(0xAF)
        emit8(0xC1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitLoadQwordDisp8(1, 0, 8)
        emitStoreQwordDisp8(1, 3, 16)
        emitLoadQwordDisp8(2, 0, 0)
        emit8(0x48)
        emit8(0xC1)
        emit8(0xE2)
        emit8(0x20)
        emit8(0x59)
        emitMovReg(0, 2)
        emitAdd(0, 1)
        emitIncQwordDisp8(3, 24)
        emitJmp(spDone)

        emitLabel(spFull)
        emit8(0x48)
        emit8(0x31)
        emit8(0xC0)

        emitLabel(spDone)
        freeReg(3)
        var spR: int = allocReg()
        if spR != 0
            emitMovReg(spR, 0)
            freeReg(0)
        end
        cgRegsUsed = spSaved & ~(1 << spR)
        reloadRegs()
        cgRegsUsed = spSaved | (1 << spR)
        if spR < 0
            return 0
        end
        return spR
    end

    if cgStrIs(name, "slotKill") == 1 && cgCallArgc(c) == 2
        var skSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var skS: int = cgEmitExpr(cgCallArg(c, 0))
        var skH: int = cgEmitExpr(cgCallArg(c, 1))
        if skS != 3
            emitMovReg(3, skS)
            freeReg(skS)
        end
        if skH != 0
            emitMovReg(0, skH)
            freeReg(skH)
        end
        emit8(0x89)
        emit8(0xC0)
        emitMovReg(2, 0)
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emitImul(0, 1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitIncQwordDisp8(0, 0)
        emitLoadQwordDisp8(1, 3, 16)
        emitStoreQwordDisp8(1, 0, 8)
        emitStoreQwordDisp8(2, 3, 16)
        emit8(0x48)
        emit8(0xFF)
        emit8(0x4B)
        emit8(0x18)
        freeReg(3)
        cgRegsUsed = skSaved
        reloadRegs()
        emitMovRegImm(0, 0)
        return 0
    end

    if cgStrIs(name, "slotGetI64") == 1 && cgCallArgc(c) == 3
        var giSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var giS: int = cgEmitExpr(cgCallArg(c, 0))
        var giH: int = cgEmitExpr(cgCallArg(c, 1))
        var giB: int = cgEmitExpr(cgCallArg(c, 2))
        if giS != 3
            emitMovReg(3, giS)
            freeReg(giS)
        end
        if giH != 0
            emitMovReg(0, giH)
            freeReg(giH)
        end
        emit8(0x89)
        emit8(0xC0)
        if giB != 2
            emitMovReg(2, giB)
            freeReg(giB)
        end
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emitImul(0, 1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitAdd(0, 2)
        emitLoadQwordDisp8(1, 0, 0)
        freeReg(3)
        var giR: int = allocReg()
        if giR != 1
            emitMovReg(giR, 1)
            freeReg(1)
        end
        cgRegsUsed = giSaved & ~(1 << giR)
        reloadRegs()
        cgRegsUsed = giSaved | (1 << giR)
        if giR < 0
            return 0
        end
        return giR
    end

    if cgStrIs(name, "slotSetI64") == 1 && cgCallArgc(c) == 4
        var siSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var siS: int = cgEmitExpr(cgCallArg(c, 0))
        var siH: int = cgEmitExpr(cgCallArg(c, 1))
        var siB: int = cgEmitExpr(cgCallArg(c, 2))
        var siV: int = cgEmitExpr(cgCallArg(c, 3))
        emit8(0x50 + siV)
        if siS != 3
            emitMovReg(3, siS)
            freeReg(siS)
        end
        if siH != 0
            emitMovReg(0, siH)
            freeReg(siH)
        end
        emit8(0x89)
        emit8(0xC0)
        if siB != 2
            emitMovReg(2, siB)
            freeReg(siB)
        end
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emitImul(0, 1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitAdd(0, 2)
        emit8(0x59)
        emitStoreQwordDisp8(1, 0, 0)
        freeReg(3)
        cgRegsUsed = siSaved
        reloadRegs()
        emitMovRegImm(0, 0)
        return 0
    end

    if cgStrIs(name, "slotGetF32") == 1 && cgCallArgc(c) == 3
        var gfSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var gfS: int = cgEmitExpr(cgCallArg(c, 0))
        var gfH: int = cgEmitExpr(cgCallArg(c, 1))
        var gfB: int = cgEmitExpr(cgCallArg(c, 2))
        if gfS != 3
            emitMovReg(3, gfS)
            freeReg(gfS)
        end
        if gfH != 0
            emitMovReg(0, gfH)
            freeReg(gfH)
        end
        emit8(0x89)
        emit8(0xC0)
        if gfB != 2
            emitMovReg(2, gfB)
            freeReg(gfB)
        end
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emitImul(0, 1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitAdd(0, 2)
        var gfX: int = allocXmmReg()
        emitMovssXmmFromMem(gfX, 0, 0)
        emitMovdGpFromXmm(1, gfX)
        freeXmmReg(gfX)
        freeReg(3)
        var gfR: int = allocReg()
        if gfR != 1
            emitMovReg(gfR, 1)
            freeReg(1)
        end
        cgRegsUsed = gfSaved & ~(1 << gfR)
        reloadRegs()
        cgRegsUsed = gfSaved | (1 << gfR)
        if gfR < 0
            return 0
        end
        return gfR
    end

    if cgStrIs(name, "slotSetF32") == 1 && cgCallArgc(c) == 4
        var sfSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var sfS: int = cgEmitExpr(cgCallArg(c, 0))
        var sfH: int = cgEmitExpr(cgCallArg(c, 1))
        var sfB: int = cgEmitExpr(cgCallArg(c, 2))
        var sfV: int = cgEmitExpr(cgCallArg(c, 3))
        var sfX: int = allocXmmReg()
        emitCvtsi2ss(sfX, sfV)
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(0x04)
        emitMovssXmmToMem(sfX, 4, 0)
        freeXmmReg(sfX)
        freeReg(sfV)
        if sfS != 3
            emitMovReg(3, sfS)
            freeReg(sfS)
        end
        if sfH != 0
            emitMovReg(0, sfH)
            freeReg(sfH)
        end
        emit8(0x89)
        emit8(0xC0)
        if sfB != 2
            emitMovReg(2, sfB)
            freeReg(sfB)
        end
        emitLoadQwordDisp8(1, 3, 8)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(16)
        emitImul(0, 1)
        emitAdd(0, 3)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC0)
        emit8(32)
        emitAdd(0, 2)
        var sfX2: int = allocXmmReg()
        emitMovssXmmFromMem(sfX2, 4, 0)
        emitMovssXmmToMem(sfX2, 0, 0)
        freeXmmReg(sfX2)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x04)
        freeReg(3)
        cgRegsUsed = sfSaved
        reloadRegs()
        emitMovRegImm(0, 0)
        return 0
    end

    if cgStrIs(name, "slotCount") == 1 && cgCallArgc(c) == 1
        var scntSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var scntS: int = cgEmitExpr(cgCallArg(c, 0))
        if scntS != 3
            emitMovReg(3, scntS)
            freeReg(scntS)
        end
        emitLoadQwordDisp8(0, 3, 24)
        freeReg(3)
        var scntR: int = allocReg()
        if scntR != 0
            emitMovReg(scntR, 0)
            freeReg(0)
        end
        cgRegsUsed = scntSaved & ~(1 << scntR)
        reloadRegs()
        cgRegsUsed = scntSaved | (1 << scntR)
        if scntR < 0
            return 0
        end
        return scntR
    end

    if cgStrIs(name, "slotReset") == 1 && cgCallArgc(c) == 1
        var srSaved: int = cgRegsUsed
        spillRegs()
        cgRegsUsed = 0
        var srS: int = cgEmitExpr(cgCallArg(c, 0))
        if srS != 3
            emitMovReg(3, srS)
            freeReg(srS)
        end
        emitMovQwordDisp8Imm32(3, 16, -1)
        emitMovQwordDisp8Imm32(3, 24, 0)
        freeReg(3)
        cgRegsUsed = srSaved
        reloadRegs()
        emitMovRegImm(0, 0)
        return 0
    end

    if cgStrIs(name, "slotDestroy") == 1 && cgCallArgc(c) == 1
        var sdR: int = cgEmitExpr(cgCallArg(c, 0))
        if sdR != 1
            emitMovReg(1, sdR)
            freeReg(sdR)
        end
        cgRegsUsed = 0
        emit8(0x48)
        emit8(0x8D)
        emit8(0x41)
        emit8(0xF0)
        emit8(0x48)
        emit8(0x8B)
        emit8(0x15)
        cgPushHeapFix(cgCodeLen, cgHeapFreeHeadRVA)
        emit32(0)
        emit8(0x48)
        emit8(0x89)
        emit8(0x10)
        emit8(0x48)
        emit8(0x89)
        emit8(0x05)
        cgPushHeapFix(cgCodeLen, cgHeapFreeHeadRVA)
        emit32(0)
        emitMovRegImm(0, 0)
        return 0
    end

    # Is the callee an `extern func` (codegen.cpp:6141..6158)? C++ also pulls
    # dllName-less auto-imports out of externFuncMap; the selfhost driver has
    # no embedded-DLL import map, so the ZAST `f11`/`f12` pair is the whole
    # story here.
    var isExtern: int = 0
    var dllId: int = 0
    var fs: int = cgH(H_FUNCS)
    var fl: int = cgH(H_FUNCS + 1)
    var i: int = 0
    while i < fl
        var fid: int = cgSide(fs + i)
        if cgTag(fid) == N_FUNC && cgF(fid, 11) == 1 && cgStrIdsEq(cgF(fid, 0), name) == 1
            isExtern = 1
            dllId = cgF(fid, 12)
        end
        i = i + 1
    end
    # Stand-in for the un-ported backend dispatch (see the block comment
    # above): C++ only reaches the direct-call arm for a real function, so
    # anything else here would be a builtin nobody has ported yet. An indirect
    # callee (a `ptr<func...>` variable or method field) leaves at its own arm
    # further down and is exempt.
    if isExtern == 0 && cgIsUserFunc(name) == 0 && cgCallCalleeKind(c) == 0
        # Диспетчер codegen.cpp:5506..5614: tryKOCall -> tryLinuxCall ->
        # tryLinuxGUICall -> tryLinuxVulkanCall -> tryLinuxVkSurfaceCall ->
        # tryLinuxNetCall -> tryHttpDlCall -> tryLinuxWLCall -> tryShaderCall.
        # Пройдены все девять позиций после tryKOCall: tryLinuxGUICall и
        # tryLinuxVkSurfaceCall — заглушки, возвращающие false ровно как в C++
        # (codegen_wl_wsi.cpp:19), поэтому их пропуск прозрачен;
        # tryLinuxNetCall, tryHttpDlCall, tryLinuxWLCall (c tryLinuxWLWindowCall)
        # и
        # tryShaderCall (без shader_file — `.z` не читает файлы при
        # компиляции, см. шапку src/cg_shader.z) портированы целиком.
        # tryTlsCall добавлен следом (codegen.cpp:5593), затем
        # tryDisasmCall (:5610) — их ветки в C++ стоят после закрытия блока
        # appType == Linux (см. ниже). tryJsCall (:5601) ещё не портирован.
        # Каждая отдаёт 0 и по схеме C++ уступает следующей.
        if cgIsLinux == 1
            if cgKoDriver() == 1 && cgTryKOCall(c) == 1
                return cgLinResReg
            end
            if cgTryLinuxCall(c) == 1
                return cgLinResReg
            end
            if cgTryLinuxGUICall(c) == 1
                return cgLinResReg
            end
            if cgTryLinuxVulkanCall(c) == 1
                return cgLinResReg
            end
            if cgTryLinuxNetCall(c) == 1
                return cgLinResReg
            end
            if cgTryHttpDlCall(c) == 1
                return cgLinResReg
            end
            if cgTryLinuxWLCall(c) == 1
                return cgLinResReg
            end
            if cgTryShaderCall(c) == 1
                return cgLinResReg
            end
            # codegen.cpp:5593..5613 — tls/js/disasm живут ВНЕ блока
            # appType == Linux (там Console || GUI || Linux), но для .z
            # бэкенда условия сводятся к cgKoDriver(): архитектура у нас
            # всегда x86_64, а appType на этой платформе — Linux. Порядок
            # регистрации — как в C++: tls (:5593), js (:5601), disasm (:5610).
            if cgTryTlsCall(c) == 1
                return cgLinResReg
            end
            if cgKoDriver() == 0 && cgTryJsCall(c) == 1
                return cgLinResReg
            end
            if cgKoDriver() == 0 && cgTryDisasmCall(c) == 1
                return cgLinResReg
            end
        end
        cgErrSet("call to a non-user function: backend builtin dispatch (codegen.cpp:5506) is not ported to codegen.z yet")
        var re: int = allocReg()
        if re < 0
            re = 0
        end
        emitMovRegImm(re, 0)
        return re
    end

    cgRegsUsed = 0
    cgXmmUsed = 0

    # Arguments are placed into 8-byte "slots". A struct passed by value
    # occupies ceil(totalSize/8) consecutive slots (its memory is copied
    # verbatim, qword by qword), so the caller and callee agree on layout.
    var argc: int = cgCallArgc(c)
    var totalSlots: int = 0
    i = 0
    while i < argc
        var ai0: int = cgCallArg(c, i)
        var span0: int = 1
        if cgIsFloatExpr(ai0) == 0
            if cgStructArgInfo(ai0) == 1
                span0 = cgSaSlots
            else
                var bigK0: int = cgStructValueQwords(ai0)
                if bigK0 >= 2
                    span0 = bigK0
                end
            end
        end
        totalSlots = totalSlots + span0
        i = i + 1
    end
    var stackSlots: int = 0
    if totalSlots > 4
        stackSlots = totalSlots - 4
    end
    var stackAlloc: int = 0
    if cgSysvAbi != 0
        if totalSlots > 6
            stackSlots = totalSlots - 6
        else
            stackSlots = 0
        end
        stackAlloc = stackSlots * 8
    else
        stackAlloc = 0x20 + stackSlots * 8
    end
    stackAlloc = ((stackAlloc + 15) / 16) * 16
    if stackAlloc <= 127
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(stackAlloc)
    else
        emit8(0x48)
        emit8(0x81)
        emit8(0xEC)
        emit32(stackAlloc)
    end

    var argIndex: int = 0
    cgPlacedGP = 0
    cgPlacedXmm = 0
    cgSpillBytes = 0

    i = 0
    while i < argc
        var ai: int = cgCallArg(c, i)
        var isFloatArg: int = cgIsFloatExpr(ai)
        var riskyArg: int = cgExprContainsCall(ai)
        var isS: int = 0
        var sGlobal: int = 0
        var sOffset: int = 0
        var sSlots: int = 1
        if isFloatArg == 0
            cgStructArgInfo(ai)
            isS = cgSaIs
            sGlobal = cgSaGlobal
            sOffset = cgSaOff
            sSlots = cgSaSlots
        end
        var span: int = 1
        if isS != 0
            span = sSlots
        end
        if span == 1 && isFloatArg == 0
            var bigK: int = cgStructValueQwords(ai)
            if bigK >= 2
                span = bigK
            end
        end

        # Snapshot the staged args BEFORE evaluation; restore must use the same
        # set, since the current arg's own slots are placed after the spill.
        var savedGP: int = cgPlacedGP
        var savedXmm: int = cgPlacedXmm
        if riskyArg != 0 && (savedGP | savedXmm) != 0
            cgSpillPlacedArgs(savedGP, savedXmm)
        end

        if isS != 0
            var k: int = 0
            while k < sSlots
                var r: int = allocReg()
                if sGlobal != 0
                    emitGlobalLoadReg(r, sOffset + k * 8)
                else
                    emitLoadRegFromBP64(r, sOffset + k * 8)
                end
                cgPlaceQword(argIndex + k, r)
                k = k + 1
            end
        else if isFloatArg != 0
            var maxFp: int = 4
            if cgSysvAbi != 0
                maxFp = 8
            end
            if argIndex < maxFp
                var xmmIdx: int = argIndex
                var x: int = cgEmitFloatExpr(ai)
                if x != xmmIdx
                    emitMovssXmm(xmmIdx, x)
                    freeXmmReg(x)
                end
                cgPlacedXmm = cgPlacedXmm | (1 << xmmIdx)
                cgXmmUsed = cgXmmUsed | (1 << xmmIdx)
            else
                var stackOff: int = 0
                if cgSysvAbi != 0
                    stackOff = (argIndex - 8) * 8 + cgSpillBytes
                else
                    stackOff = (argIndex - 4) * 8 + cgSpillBytes
                end
                var xf: int = cgEmitFloatExpr(ai)
                if stackOff < 128
                    emit8(0xF3)
                    emit8(0x0F)
                    emit8(0x11)
                    emit8(0x44)
                    emit8(0x24)
                    emit8(stackOff)
                else
                    emit8(0xF3)
                    emit8(0x0F)
                    emit8(0x11)
                    emit8(0x84)
                    emit8(0x24)
                    emit32(stackOff)
                end
                freeXmmReg(xf)
            end
        else
            var bigK2: int = cgStructValueQwords(ai)
            if bigK2 >= 2
                if cgTag(ai) == N_CALL
                    # Callee leaves the big struct value in rax:rdx:r10. Place
                    # each qword straight into its slot; do NOT round-trip
                    # through [rsp+0..0x17], which would clobber register args
                    # that cgSpillPlacedArgs() pushed onto the same stack slots.
                    cgEmitExpr(ai)
                    cgPlaceQword(argIndex + 0, 0)
                    cgPlaceQword(argIndex + 1, 2)
                    if bigK2 >= 3
                        cgPlaceQword(argIndex + 2, 10)
                    end
                else
                    cgEmitStructAddrR10(ai)
                    var j: int = 0
                    while j < bigK2
                        emitLoadFromAddrR10(0, j * 8)
                        cgPlaceQword(argIndex + j, 0)
                        j = j + 1
                    end
                end
            else
                var argReg: int = cgEmitExpr(ai)
                cgPlaceQword(argIndex, argReg)
            end
        end

        if riskyArg != 0 && (savedGP | savedXmm) != 0
            cgRestorePlacedArgs(savedGP, savedXmm)
        end
        argIndex = argIndex + span
        i = i + 1
    end

    # Indirect call through a function pointer (`ptr<func...>` variable or
    # field). The target is evaluated AFTER staging: the staged arg registers
    # are then marked busy (so allocReg skips them) and rax is free to receive
    # the address. A nested call inside the callee expression clobbers the
    # staged registers, so spill/restore them.
    var calleeKind: int = cgCallCalleeKind(c)
    if calleeKind != 0
        var riskyCallee: int = 0
        if calleeKind == 2
            riskyCallee = cgExprContainsCall(cgF(c, 1))
        end
        var sGP: int = cgPlacedGP
        var sXmm: int = cgPlacedXmm
        if riskyCallee != 0 && (sGP | sXmm) != 0
            cgSpillPlacedArgs(sGP, sXmm)
        end
        var cr: int = 0
        if calleeKind == 1
            cr = cgEmitIdentName(cgCalleeVar)
        else
            cr = cgEmitExpr(cgF(c, 1))
        end
        if cr != 0
            emitMovReg(0, cr)
            freeReg(cr)
        end
        if riskyCallee != 0 && (sGP | sXmm) != 0
            cgRestorePlacedArgs(sGP, sXmm)
        end
        emit8(0xFF)
        emit8(0xD0)
        if stackAlloc <= 127
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(stackAlloc)
        else
            emit8(0x48)
            emit8(0x81)
            emit8(0xC4)
            emit32(stackAlloc)
        end
        cgRegsUsed = 1
        cgXmmUsed = 0
        return 0
    end

    # C/C++ mixing (codegen.cpp:6127) has no selfhost equivalent — mixCtx is
    # a `--cxx` driver construct — so mixLocalCall is always false here.
    if isExtern != 0 && cgObjOutput == 0
        # A relocatable --obj object has no startup relocator to fill a GOT
        # slot, so that case falls to the plain rel32 below; this arm is the
        # dynamic-loader path of a normal ELF.
        if cgSysvAbi != 0
            # ДИРЕКТИВА «ТОЛЬКО СИСКОЛЛЫ» (05.10, часть 6; развёрнута
            # в части 21): extern-вызов через GOT/PT_INTERP/DT_NEEDED —
            # запрещён. Прямые вызовы libc/других DSO в selfhost-образах
            # не эмитятся ни при каком условии; всё, что нужно, уже
            # закрыто syscall-билтинами (cgTryLinuxCall), а vk-импорт
            # перешёл на свой syscall-загрузчик (cgEmitVkLoader).
            cgErrSet("extern call through the dynamic loader is forbidden (syscall-only directive); use builtins or raw syscalls")
            emit8(0xFF)
            emit8(0x15)
            emit32(0)
        else
            # Win64 `FF 15` through importCallFixups — layer 2 (PE).
            cgErrSet("Win64 DLL import call is not ported to codegen.z yet")
            emit8(0xFF)
            emit8(0x15)
            emit32(0)
        end
    else
        emit8(0xE8)
        cgPushCallFix(cgCodeLen, name)
        emit32(0)
    end

    if stackAlloc <= 127
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(stackAlloc)
    else
        emit8(0x48)
        emit8(0x81)
        emit8(0xC4)
        emit32(stackAlloc)
    end

    # All volatile regs clobbered by call; only RAX holds the return value
    cgRegsUsed = 1
    cgXmmUsed = 0
    # A float-returning call leaves its value in xmm0, and this integer context
    # wants a number: truncate xmm0 into rax. xmm0 itself is untouched, so
    # cgEmitFloatExpr's call path — which also lands here via cgEmitExpr(call) —
    # can still read the untruncated value from it.
    if cgIsFloatExpr(c) == 1
        emitCvttss2si(0, 0)
    end
    return 0
end

# Save/restore wrapper around the call emitter.
#
# cgPlacedGP / cgPlacedXmm / cgSpillBytes are the C++ locals of emitExpr's
# CallExpr branch (codegen.cpp:5674/5686): each *invocation* has its own, and
# a nested call inside an argument must not disturb the outer one's staged
# register mask or its pending spill depth — `f(a, g(x))` has to restore the
# args it pushed around `g(x)` and then keep writing stack slots at the outer
# spillBytes. In `.z` they have to be module state (cgPlaceQword and the two
# spill helpers need them), so the wrapper gives every invocation the C++
# semantics: save on entry, put back on return.
func cgEmitCallExpr(c: int) -> int
    var keepGP: int = cgPlacedGP
    var keepXmm: int = cgPlacedXmm
    var keepSpill: int = cgSpillBytes
    var res: int = cgEmitCallBody(c)
    cgPlacedGP = keepGP
    cgPlacedXmm = keepXmm
    cgSpillBytes = keepSpill
    return res
end

func cgEmitExpr(e: int) -> int
    # Implicit float -> int (codegen.cpp:2788). A CallExpr is deliberately
    # left alone: a float-returning call hands its value to emitFloatExpr
    # through xmm0 and going through emitFtoiExpr here would recurse.
    if e != 0 && cgTag(e) != N_CALL && cgIsFloatExpr(e) == 1
        return cgEmitFtoiExpr(e)
    end
    if e == 0
        var rz: int = allocReg()
        emitMovRegImm(rz, 0)
        return rz
    end
    var tg: int = cgTag(e)
    if tg == N_UNARY
        return cgEmitUnaryExpr(e)
    end
    if tg == N_NUMBER
        var rn: int = allocReg()
        emitMovRegImm(rn, cgNumVal(e))
        return rn
    end
    if tg == N_FLOAT
        var rf: int = allocReg()
        var lit: int = cgF(e, 0)
        var v: float = cgParseFloatPtr(cgStrPtr(lit), cgStrLen(lit))
        if cgF(e, 1) != 0
            v = 0.0 - v
        end
        emitMovRegImm(rf, cgF32Bits(v))
        return rf
    end
    if tg == N_IDENT
        return cgEmitIdentName(cgF(e, 0))
    end
    if tg == N_MEMBER
        var ft: int = cgExprType(e)
        var addr: int = cgEmitAddrOfExpr(e)
        if cgTk(ft) == TK_VOID
            freeReg(addr)
            var r3: int = allocReg()
            emitMovRegImm(r3, 0)
            return r3
        end
        var r4: int = allocReg()
        if (cgTk(ft) == TK_FLOAT || cgTk(ft) == TK_BOOL) && cgTIsPtr(ft) == 0
            emitLoad32FromAddr(r4, addr, 0)
        else
            emitLoadFromAddr(r4, addr, 0)
        end
        freeReg(addr)
        return r4
    end
    if tg == N_STRING
        var idx: int = cgStringPoolIdx(cgF(e, 0))
        var r5: int = allocReg()
        if cgKoDriver() == 1 && cgObjOutput == 0
            # Kernel-module mode: `mov r64, sign-ext-imm32` + R_X86_64_32S
            emit8(0x48)
            emit8(0xC7)
            emit8(0xC0 | r5)
            var kp: int = cgCodeLen
            emit32(0)
            if cgKoStrFixN < CG_POOL_STR_MAX
                cgKoStrFixPos[cgKoStrFixN] = kp
                cgKoStrFixIdx[cgKoStrFixN] = idx
                cgKoStrFixN = cgKoStrFixN + 1
            end
        else
            emit8(0x48)
            emit8(0x8D)
            emit8(0x05 | (r5 << 3))
            var sp: int = cgCodeLen
            emit32(0)
            cgPushStrFix(sp, idx)
        end
        return r5
    end
    if tg == N_ARRAYACC
        return cgEmitArrayAcc(e)
    end
    if tg == N_BINARY
        return cgEmitBinaryExpr(e, 0)
    end
    if tg == N_ADDROF
        if cgF(e, 1) != 0
            return cgEmitAddrOfExpr(cgF(e, 1))
        end
        var vi2: int = cgVarFind(cgF(e, 0))
        var r6: int = allocReg()
        if vi2 < 0
            if cgIsUserFunc(cgF(e, 0)) == 1
                freeReg(r6)
                emit8(0x48)
                emit8(0x8D)
                emit8(0x05)
                var fp2: int = cgCodeLen
                emit32(0)
                cgPushFuncRef(fp2, cgF(e, 0))
                return 0
            end
            emitMovRegImm(r6, 0)
            return r6
        end
        if cgViGlobal[vi2] != 0
            emitGlobalLeaReg(r6, cgViOff[vi2])
        else
            emitLeaRegFromBP(r6, cgViOff[vi2])
        end
        return r6
    end
    if tg == N_CALL
        return cgEmitCallExpr(e)
    end
    if tg == N_DEREF
        var pt: int = cgExprType(cgF(e, 0))
        var isFloatPt: int = 0
        if cgTIsPtr(pt) != 0 && cgTk(pt) == TK_FLOAT
            isFloatPt = 1
        end
        var isBoolPt: int = 0
        if cgTIsPtr(pt) != 0 && cgTk(pt) == TK_BOOL
            isBoolPt = 1
        end
        var r7: int = cgEmitExpr(cgF(e, 0))
        if r7 != 0
            emitMovReg(0, r7)
            freeReg(r7)
        else
            freeReg(0)
        end
        if isFloatPt == 1
            # int context: load the float and convert to int (like arr[i])
            var x: int = allocXmmReg()
            if x < 0
                x = 0
            end
            emitFloatLoadFromAddr(x, 0, 0)
            freeReg(0)
            var out: int = allocReg()
            if out < 0
                out = 0
            end
            emitCvtss2si(out, x)
            freeXmmReg(x)
            return out
        end
        if isBoolPt == 1
            emitLoad32FromAddr(0, 0, 0)
        else
            emit8(0x48)
            emit8(0x8B)
            emit8(0x00)
        end
        cgRegsUsed = 1
        return 0
    end
    var r8: int = allocReg()
    emitMovRegImm(r8, 0)
    return r8
end

# ArrayAccessExpr branch of emitExpr (codegen.cpp:2890)
func cgEmitArrayAcc(e: int) -> int
    var arr: int = e
    var arr0: int = cgF(arr, 0)
    var vi: int = -1
    if cgTag(arr0) == N_IDENT
        vi = cgVarFind(cgF(arr0, 0))
    end
    if vi >= 0
        var elemT: int = cgExprType(arr)
        var elementSize: int = cgArrayElemStride(elemT)
        # Bug A: the load path uses RAX as scratch, which can destroy a live
        # RAX holding an outer expression's value — push it when live.
        var raxLive: int = 0
        if (cgRegsUsed & 1) != 0
            raxLive = 1
        end
        if raxLive == 1
            emit8(0x50)
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(0x08)
        end
        var idxReg: int = cgEmitExpr(cgF(arr, 1))
        if idxReg != 0
            emitMovReg(0, idxReg)
            freeReg(idxReg)
            idxReg = 0
        end
        if cgTIsPtr(cgViType[vi]) != 0
            # pointer indexing: base = the pointer value itself
            if cgViGlobal[vi] != 0
                emitGlobalLoadR10(cgViOff[vi])
            else
                emitLoadR10FromBP64(cgViOff[vi])
            end
        else
            if cgViGlobal[vi] != 0
                emitGlobalLeaR10(cgViOff[vi])
            else
                emitLeaR10FromBP(cgViOff[vi])
            end
        end
        emit8(0x48)
        emit8(0x69)
        emit8(0xC0)
        emit32(elementSize)
        emit8(0x49)
        emit8(0x01)
        emit8(0xC2)
        var r: int = 0
        if cgTk(elemT) == TK_FLOAT && cgTIsPtr(elemT) == 0
            freeReg(0)
            var x: int = allocXmmReg()
            if x < 0
                x = 0
            end
            emit8(0xF3)
            emit8(0x41)
            emit8(0x0F)
            emit8(0x10)
            emit8(0x02 | ((x & 7) << 3))
            r = allocReg()
            emitCvtss2si(r, x)
            freeXmmReg(x)
        else
            emit8(0x49)
            emit8(0x8B)
            emit8(0x02)
            freeReg(0)
            r = allocReg()
            if r != 0
                emitMovReg(r, 0)
                freeReg(0)
            end
        end
        if raxLive == 1
            # RAX holds the loaded value (r == 0): park it elsewhere first
            if r == 0
                var spare: int = allocReg()
                if spare < 0
                    var i: int = 0
                    while i < CG_POOL_N
                        var pr: int = cgPoolAt(i)
                        if pr != 0 && (cgRegsUsed & (1 << pr)) == 0
                            spare = pr
                            cgRegsUsed = cgRegsUsed | (1 << pr)
                            i = CG_POOL_N
                        else
                            i = i + 1
                        end
                    end
                    if spare < 0
                        spare = 1
                    end
                end
                emitMovReg(spare, 0)
                freeReg(0)
                r = spare
            end
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
            emit8(0x58)
            cgRegsUsed = cgRegsUsed | 1
            cgRegsUsed = cgRegsUsed | (1 << r)
        end
        if r < 0
            return 0
        end
        return r
    end
    # Base is not a plain variable (`(*p)[i]`, `f()[i]`, `o.a[i]`): compute
    # the element address and load through it.
    var elemT2: int = cgExprType(arr)
    var addr2: int = cgEmitAddrOfExpr(arr)
    var r2: int = 0
    if cgTk(elemT2) == TK_FLOAT && cgTIsPtr(elemT2) == 0
        var x2: int = allocXmmReg()
        if x2 < 0
            x2 = 0
        end
        emitFloatLoadFromAddr(x2, addr2, 0)
        r2 = allocReg()
        if r2 < 0
            r2 = 0
        end
        emitCvtss2si(r2, x2)
        freeXmmReg(x2)
    else if cgTk(elemT2) == TK_BOOL && cgTIsPtr(elemT2) == 0
        r2 = allocReg()
        if r2 < 0
            r2 = 0
        end
        emitLoad32FromAddr(r2, addr2, 0)
    else
        r2 = allocReg()
        if r2 < 0
            r2 = 0
        end
        emitLoadFromAddr(r2, addr2, 0)
    end
    freeReg(addr2)
    return r2
end

# ===================== emitStmt (codegen.cpp:6233) =====================
#
# Only the ReturnStmt arm is ported so far; the harness in src/_cgemit.z
# drives it to reproduce what the C++ backend emits for `return <expr>`
# (a float return keeps the value in xmm0 and never goes through the
# emitExpr ftoi conversion). Every other statement kind reports it.

func cgEmitStmt(s: int) -> int
    var st: int = cgTag(s)

    # codegen.cpp:6235 дописывает dbgLines, но emitDebugInfo (codegen.h:41)
    # по умолчанию false и включается только ключом отладки драйвера — ветка
    # не влияет на байты тестовых программ и не перенесена.
    if st == N_RETURN
        var val: int = cgF(s, 0)
        if val != 0
            # Large structs (>8 bytes) are returned in rax:rdx:r10 (k<=3 qwords)
            var bigK: int = cgStructValueQwords(val)
            if bigK >= 2
                cgEmitStructRegs(val, bigK)
                cgRegsUsed = 0
            else
                var isFRet: int = 0
                if cgCurFuncRetType != 0
                    if cgTIsPtr(cgCurFuncRetType) == 0 && cgTk(cgCurFuncRetType) == TK_FLOAT
                        isFRet = 1
                    end
                end
                if cgIsFloatExpr(val) == 1
                    isFRet = 1
                end
                if isFRet == 1
                    var x: int = cgEmitFloatExpr(val)
                    if x != 0
                        emitMovssXmm(0, x)
                        freeXmmReg(x)
                    end
                    cgXmmUsed = cgXmmUsed | 1
                else
                    var r: int = cgEmitExpr(val)
                    if r != 0
                        emitMovReg(0, r)
                    end
                    cgRegsUsed = 0
                end
            end
        end
        if cgFuncEndLabel >= 0
            emitJmp(cgFuncEndLabel)
        end
        return 0
    end

    if st == N_EXPRSTMT
        var es: int = cgEmitExpr(cgF(s, 0))
        freeReg(es)
        return 0
    end

    if st == N_VARDECL
        var vdName: int = cgF(s, 0)
        var vdTp: int = cgFAddr(s, 1)
        var vdVi: int = cgVarFind(vdName)
        var vdOff: int = 0
        if vdVi >= 0
            vdOff = cgViOff[vdVi]
        end
        var vdInit: int = cgF(s, 7)
        if vdInit != 0
            if cgTk(vdTp) == TK_FLOAT && cgTIsPtr(vdTp) == 0
                var vdx: int = cgEmitFloatExpr(vdInit)
                emitFloatStoreToBP(vdx, vdOff)
                freeXmmReg(vdx)
            else
                var vdK: int = cgStructValueQwords(vdInit)
                if vdK >= 2
                    # Locals live on the stack frame, so a big-struct init is a
                    # multi-qword copy of rax:rdx:r10 into [rbp+off .. off+3*8].
                    cgEmitStructRegs(vdInit, vdK)
                    # rdx -> [rbp+off+8]
                    if vdOff + 8 >= -128 && vdOff + 8 <= 127
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x55)
                        emit8((vdOff + 8) & 0xFF)
                    else
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x95)
                        emit32(vdOff + 8)
                    end
                    # r10 -> [rbp+off+16] (only when it holds a real 3rd qword)
                    if vdK >= 3
                        if vdOff + 16 >= -128 && vdOff + 16 <= 127
                            emit8(0x4C)
                            emit8(0x89)
                            emit8(0x55)
                            emit8((vdOff + 16) & 0xFF)
                        else
                            emit8(0x4C)
                            emit8(0x89)
                            emit8(0x95)
                            emit32(vdOff + 16)
                        end
                    end
                    # rax -> [rbp+off]
                    emitStoreToBP64(vdOff)
                    cgRegsUsed = 0
                else
                    var vr: int = cgEmitExpr(vdInit)
                    if vr != 0
                        emitMovReg(0, vr)
                        freeReg(vr)
                    end
                    if cgTk(vdTp) == TK_BOOL && cgTIsPtr(vdTp) == 0
                        emitStoreToBP(vdOff)
                    else
                        emitStoreToBP64(vdOff)
                    end
                    freeReg(0)
                end
            end
        end
        # Fresh class-typed locals get their runtime class id written into the
        # hidden `__classid` slot at offset 0, so virtual dispatch works even
        # for objects that are never initialized by field assignments.
        if cgTk(vdTp) == TK_STRUCT && cgTIsPtr(vdTp) == 0 && cgF(s, 8) == 0
            var vdcid: int = cgClassIdFind(cgTStruct(vdTp))
            if vdcid >= 0
                emitMovRegImm(0, vdcid)
                emitStoreToBP64(vdOff)
                freeReg(0)
            end
        end
        return 0
    end

    if st == N_ASSIGN
        var asName: int = cgF(s, 0)
        var asVi: int = cgVarFind(asName)
        if asVi >= 0 && cgViConst[asVi] != 0
            cgErrSet("cannot assign to const variable '")
            cgErrAppendStrId(asName)
            cgErrAppendLit("'")
            return -1
        end
        var asIdx: int = cgF(s, 3)
        var asPs: int = cgF(s, 1)
        var asPl: int = cgF(s, 2)
        if asIdx != 0
            var iv: int = cgVarFind(asName)
            if iv >= 0
                # Element type: for `p[i] = ...` (pointer) the element is the
                # pointee, for `arr[i] = ...` it is the declared element type
                # (which may itself be a pointer: `arr: [N]ptr<T>`). C++
                # copies the Type and clears isPtr in the copy; ZAST types are
                # read-only, so the same happens in a scratch slot.
                var elemT: int = cgViType[iv]
                var et: int = cgTyNew()
                var tw: int = 0
                while tw < CG_TYPEW
                    poke32(et + tw * 4, peek32(elemT + tw * 4))
                    tw = tw + 1
                end
                var iArr: int = cgViArr[iv]
                if iArr == 0 && cgTIsPtr(et) != 0
                    poke32(et + 8, 0)
                end
                var elementSize: int = cgArrayElemStride(et)
                var iOff: int = cgViOff[iv]
                if cgViGlobal[iv] != 0
                    # Pointer indexing: base = the pointer value itself.
                    if cgTIsPtr(elemT) != 0
                        emitGlobalLoadR10(iOff)
                    else
                        emitGlobalLeaR10(iOff)
                    end
                else
                    if cgTIsPtr(elemT) != 0
                        emitLoadR10FromBP64(iOff)
                    else
                        emitLeaR10FromBP(iOff)
                    end
                end
                var idxReg: int = cgEmitExprKeepAliveR10(asIdx)
                if idxReg != 0
                    emitMovReg(0, idxReg)
                    freeReg(idxReg)
                    idxReg = 0
                end
                emit8(0x48)
                emit8(0x69)
                emit8(0xC0)
                emit32(elementSize)
                emit8(0x49)
                emit8(0x01)
                emit8(0xC2)
                freeReg(0)
                var elemIsFloat: int = 0
                if cgTk(elemT) == TK_FLOAT && (iArr == 0 || cgTIsPtr(elemT) == 0)
                    elemIsFloat = 1
                end
                if elemIsFloat == 1
                    # A nested array load in the value expression would clobber
                    # r10 (it is used as scratch base by every array access),
                    # so preserve the computed base+index across evaluation.
                    var guardF: int = cgExprHasArrayAccess(cgF(s, 4))
                    if guardF == 1
                        emit8(0x41)
                        emit8(0x52)
                        emit8(0x48)
                        emit8(0x83)
                        emit8(0xEC)
                        emit8(0x08)
                    end
                    var xf: int = cgEmitFloatExprKeepAliveR10(cgF(s, 4))
                    if guardF == 1
                        emit8(0x48)
                        emit8(0x83)
                        emit8(0xC4)
                        emit8(0x08)
                        emit8(0x41)
                        emit8(0x5A)
                    end
                    emit8(0xF3)
                    emit8(0x41)
                    emit8(0x0F)
                    emit8(0x11)
                    emit8(0x02 | ((xf & 7) << 3))
                    freeXmmReg(xf)
                else
                    var guard: int = cgExprHasArrayAccess(cgF(s, 4))
                    if guard == 1
                        emit8(0x41)
                        emit8(0x52)
                        emit8(0x48)
                        emit8(0x83)
                        emit8(0xEC)
                        emit8(0x08)
                    end
                    var rr: int = cgEmitExprKeepAliveR10(cgF(s, 4))
                    if rr != 0
                        emitMovReg(0, rr)
                    end
                    if guard == 1
                        emit8(0x48)
                        emit8(0x83)
                        emit8(0xC4)
                        emit8(0x08)
                        emit8(0x41)
                        emit8(0x5A)
                    end
                    emit8(0x49)
                    emit8(0x89)
                    emit8(0x02)
                    freeReg(rr)
                end
            end
        else if asPl != 0
            var mv: int = cgVarFind(asName)
            if mv >= 0
                # Build `name.p1.p2...` as an expression chain so the shared
                # hop-aware address walker applies (intermediate pointer fields
                # are dereferenced: `n1.next.val = v` stores through next).
                cgSynthReset()
                var chain: int = cgSynthNew(N_IDENT)
                cgSetF(chain, 0, asName)
                var pi: int = 0
                while pi < asPl
                    var mn: int = cgSynthNew(N_MEMBER)
                    cgSetF(mn, 0, chain)
                    cgSetF(mn, 1, cgSide(asPs + pi))
                    chain = mn
                    pi = pi + 1
                end
                var fldT: int = cgExprType(chain)
                if cgTk(fldT) != TK_VOID
                    var isFloatField: int = 0
                    var isBoolField: int = 0
                    var isBigField: int = 0
                    if cgTk(fldT) == TK_FLOAT && cgTIsPtr(fldT) == 0
                        isFloatField = 1
                    end
                    if cgTk(fldT) == TK_BOOL && cgTIsPtr(fldT) == 0
                        isBoolField = 1
                    end
                    if cgTIsPtr(fldT) == 0 && cgStructTypeSize(fldT) > 8
                        isBigField = 1
                    end
                    cgAddrToR10(chain)
                    if isBigField == 1
                        # Assigning a >8B struct VALUE to a >8B struct field.
                        # RHS evaluation may clobber r10 (it is our dst base), so
                        # spill the RHS qwords to [rsp+0..0x18] scratch, then
                        # recompute the dst address in r10 and copy down.
                        var bk: int = cgStructValueQwords(cgF(s, 4))
                        if bk < 2
                            bk = 2
                        end
                        cgEmitStructRegs(cgF(s, 4), bk)
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x04)
                        emit8(0x24)
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x54)
                        emit8(0x24)
                        emit8(8)
                        if bk >= 3
                            emit8(0x4C)
                            emit8(0x89)
                            emit8(0x54)
                            emit8(0x24)
                            emit8(16)
                        end
                        cgAddrToR10(chain)
                        var j: int = 0
                        while j < bk
                            emit8(0x48)
                            emit8(0x8B)
                            emit8(0x44)
                            emit8(0x24)
                            emit8(j * 8)
                            emitStoreToAddrR10(j * 8)
                            j = j + 1
                        end
                        cgRegsUsed = 0
                    else
                        var gR: int = cgExprHasArrayAccess(cgF(s, 4))
                        if gR == 1
                            emit8(0x41)
                            emit8(0x52)
                            emit8(0x48)
                            emit8(0x83)
                            emit8(0xEC)
                            emit8(0x08)
                        end
                        if isFloatField == 1
                            var mfx: int = cgEmitFloatExprKeepAliveR10(cgF(s, 4))
                            if gR == 1
                                emit8(0x48)
                                emit8(0x83)
                                emit8(0xC4)
                                emit8(0x08)
                                emit8(0x41)
                                emit8(0x5A)
                            end
                            emitFloatStoreToR10(mfx, 0)
                            freeXmmReg(mfx)
                        else
                            var mr: int = cgEmitExprKeepAliveR10(cgF(s, 4))
                            if mr != 0
                                emitMovReg(0, mr)
                            end
                            if gR == 1
                                emit8(0x48)
                                emit8(0x83)
                                emit8(0xC4)
                                emit8(0x08)
                                emit8(0x41)
                                emit8(0x5A)
                            end
                            # Bool fields are 4 bytes in the layout: a 64-bit
                            # store would clobber the next field.
                            if isBoolField == 1
                                emitStore32ToAddrR10(0)
                            else
                                emitStoreToAddrR10(0)
                            end
                            freeReg(mr)
                        end
                        if gR == 1
                            emit8(0x48)
                            emit8(0x83)
                            emit8(0xC4)
                            emit8(0x08)
                            emit8(0x41)
                            emit8(0x5A)
                        end
                        freeReg(0)
                    end
                end
            end
        else
            var pv: int = cgVarFind(asName)
            if pv < 0
                cgErrSet("undefined variable '")
                cgErrAppendStrId(asName)
                cgErrAppendLit("'")
                return -1
            end
            var pt: int = cgViType[pv]
            var poff: int = cgViOff[pv]
            var pgl: int = cgViGlobal[pv]
            if cgTk(pt) == TK_FLOAT && cgTIsPtr(pt) == 0
                var pf2: int = cgEmitFloatExpr(cgF(s, 4))
                if pgl != 0
                    emitGlobalFloatStore(pf2, poff)
                else
                    emitFloatStoreToBP(pf2, poff)
                end
                freeXmmReg(pf2)
            else
                var pbk: int = cgStructValueQwords(cgF(s, 4))
                if pbk >= 2
                    cgEmitStructRegs(cgF(s, 4), pbk)
                    if pgl != 0
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x15)
                        cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + (poff + 8))
                        emit32(0)
                        if pbk >= 3
                            emit8(0x4C)
                            emit8(0x89)
                            emit8(0x15)
                            cgPushGlobalFix(cgCodeLen, cgGlobalsRVA + (poff + 16))
                            emit32(0)
                        end
                        emitGlobalStoreReg64(poff)
                    else
                        if poff + 8 >= -128 && poff + 8 <= 127
                            emit8(0x48)
                            emit8(0x89)
                            emit8(0x55)
                            emit8((poff + 8) & 0xFF)
                        else
                            emit8(0x48)
                            emit8(0x89)
                            emit8(0x95)
                            emit32(poff + 8)
                        end
                        if pbk >= 3
                            if poff + 16 >= -128 && poff + 16 <= 127
                                emit8(0x4C)
                                emit8(0x89)
                                emit8(0x55)
                                emit8((poff + 16) & 0xFF)
                            else
                                emit8(0x4C)
                                emit8(0x89)
                                emit8(0x95)
                                emit32(poff + 16)
                            end
                        end
                        emitStoreToBP64(poff)
                    end
                    cgRegsUsed = 0
                else
                    var pr: int = cgEmitExpr(cgF(s, 4))
                    if pr != 0
                        emitMovReg(0, pr)
                        freeReg(pr)
                    end
                    if cgTk(pt) == TK_BOOL && cgTIsPtr(pt) == 0
                        if pgl != 0
                            emitGlobalStoreReg32(poff)
                        else
                            emitStoreToBP(poff)
                        end
                    else
                        if pgl != 0
                            emitGlobalStoreReg64(poff)
                        else
                            emitStoreToBP64(poff)
                        end
                    end
                    freeReg(0)
                end
            end
        end
        return 0
    end

    if st == N_PTRASSIGN
        spillRegs()
        cgRegsUsed = 0
        var pp: int = cgF(s, 0)
        var pval: int = cgF(s, 1)
        # The pointee type decides the store width: float/bool fields and
        # locals live in 4 bytes, everything else in a word.
        var ptrT: int = cgExprType(pp)
        if cgTk(ptrT) == TK_FLOAT && cgTIsPtr(ptrT) != 0
            # Value first (xmm), pointer second (rax). The xmm register is
            # parked on the stack while the pointer expression runs so a
            # nested call inside it cannot clobber the value.
            var px: int = cgEmitFloatExpr(pval)
            if px < 0
                px = 0
            end
            var riskyPtr: int = cgExprContainsCall(pp)
            if riskyPtr == 1
                emit8(0x48)
                emit8(0x83)
                emit8(0xEC)
                emit8(0x10)
                emit8(0xF3)
                emit8(0x0F)
                emit8(0x11)
                emit8((px & 7) << 3)
                emit8(0x24)
            end
            var ppr: int = cgEmitExpr(pp)
            if ppr != 0
                emitMovReg(0, ppr)
                freeReg(ppr)
            else
                freeReg(0)
            end
            if riskyPtr == 1
                emit8(0xF3)
                emit8(0x0F)
                emit8(0x10)
                emit8((px & 7) << 3)
                emit8(0x24)
                emit8(0x48)
                emit8(0x83)
                emit8(0xC4)
                emit8(0x10)
            end
            emit8(0xF3)
            emit8(0x0F)
            emit8(0x11)
            emit8((px & 7) << 3)
            freeXmmReg(px)
        else if cgTk(ptrT) == TK_BOOL && cgTIsPtr(ptrT) != 0
            var pv3: int = cgEmitExpr(pval)
            if pv3 != 0
                emitMovReg(0, pv3)
                freeReg(pv3)
            else
                freeReg(0)
            end
            emit8(0x50)
            var ppb: int = cgEmitExpr(pp)
            if ppb != 0
                emitMovReg(0, ppb)
                freeReg(ppb)
            else
                freeReg(0)
            end
            emit8(0x5A)
            emit8(0x89)
            emit8(0x10)
        else
            var pv4: int = cgEmitExpr(pval)
            if pv4 != 0
                emitMovReg(0, pv4)
                freeReg(pv4)
            else
                freeReg(0)
            end
            emit8(0x50)
            var ppp: int = cgEmitExpr(pp)
            if ppp != 0
                emitMovReg(0, ppp)
                freeReg(ppp)
            else
                freeReg(0)
            end
            emit8(0x5A)
            emit8(0x48)
            emit8(0x89)
            emit8(0x10)
        end
        cgRegsUsed = 0
        return 0
    end

    if st == N_IF
        var ifElse: int = newLabel()
        var ifEnd: int = newLabel()
        var ifCond: int = cgF(s, 0)
        var ifReg: int = 0
        if cgTag(ifCond) == N_BINARY
            if cgIsFloatExpr(ifCond) == 1
                ifReg = cgEmitBinaryExpr(ifCond, 1)
            else
                ifReg = cgEmitExpr(ifCond)
            end
        else
            ifReg = cgEmitExpr(ifCond)
        end
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0x85)
        emit8(0xC0 | ((ifReg & 7) << 3) | (ifReg & 7))
        freeReg(ifReg)
        emit8(0x0F)
        emit8(0x84)
        cgFixPush(cgCodeLen, ifElse)
        emit32(0)
        cgEmitBlock(cgF(s, 1), cgF(s, 2))
        emitJmp(ifEnd)
        emitLabel(ifElse)
        cgEmitBlock(cgF(s, 3), cgF(s, 4))
        emitLabel(ifEnd)
        return 0
    end

    if st == N_WHILE
        var wLoop: int = newLabel()
        var wEnd: int = newLabel()
        emitLabel(wLoop)
        var wCond: int = cgF(s, 0)
        var wReg: int = 0
        if cgTag(wCond) == N_BINARY
                if cgIsFloatExpr(wCond) == 1
                wReg = cgEmitBinaryExpr(wCond, 1)
            else
                wReg = cgEmitExpr(wCond)
            end
        else
            wReg = cgEmitExpr(wCond)
        end
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0x85)
        emit8(0xC0 | ((wReg & 7) << 3) | (wReg & 7))
        freeReg(wReg)
        emit8(0x0F)
        emit8(0x84)
        cgFixPush(cgCodeLen, wEnd)
        emit32(0)
        cgBreakPush(wEnd)
        cgContPush(wLoop)
        cgEmitBlock(cgF(s, 1), cgF(s, 2))
        cgContPop()
        cgBreakPop()
        emitJmp(wLoop)
        emitLabel(wEnd)
        return 0
    end

    if st == N_LOOP
        var lLoop: int = newLabel()
        var lEnd: int = newLabel()
        emitLabel(lLoop)
        cgBreakPush(lEnd)
        cgContPush(lLoop)
        cgEmitBlock(cgF(s, 0), cgF(s, 1))
        cgContPop()
        cgBreakPop()
        emitJmp(lLoop)
        emitLabel(lEnd)
        return 0
    end

    if st == N_SWITCH
        var swEnd: int = newLabel()
        cgBreakPush(swEnd)
        var swCond: int = cgEmitExpr(cgF(s, 0))
        if swCond != 0
            emitMovReg(0, swCond)
            freeReg(swCond)
            swCond = 0
        end
        cgRegsUsed = cgRegsUsed | 1
        var swDefault: int = newLabel()
        var swHasDef: int = 0
        var swCs: int = cgF(s, 1)
        var swCl: int = cgF(s, 2)
        var swN: int = 0
        var swI: int = 0
        while swI + 2 < swCl
            if cgSide(swCs + swI) != 0
                if swN < 4096
                    cgSwitchLabels[swN] = newLabel()
                    swN = swN + 1
                end
            else
                swHasDef = 1
            end
            swI = swI + 3
        end
        # dispatch: rax holds the switch value
        var swCi: int = 0
        swI = 0
        while swI + 2 < swCl
            var swCase: int = cgSide(swCs + swI)
            if swCase != 0
                var sv: int = cgEmitExpr(swCase)
                emit8(0x48)
                emit8(0x39)
                emit8(0xC0 + (sv & 7) * 8 + 0)
                freeReg(sv)
                if swCi < swN
                    emitJccRaw(0x84, cgSwitchLabels[swCi])
                end
                swCi = swCi + 1
            else
                emitJmp(swDefault)
            end
            swI = swI + 3
        end
        emitJmp(swEnd)
        # bodies
        swCi = 0
        swI = 0
        while swI + 2 < swCl
            var swCase2: int = cgSide(swCs + swI)
            if swCase2 != 0
                if swCi < swN
                    emitLabel(cgSwitchLabels[swCi])
                end
                swCi = swCi + 1
            else
                emitLabel(swDefault)
            end
            cgEmitBlock(cgSide(swCs + swI + 1), cgSide(swCs + swI + 2))
            emitJmp(swEnd)
            swI = swI + 3
        end
        if swHasDef == 0
            emitLabel(swDefault)
        end
        emitLabel(swEnd)
        cgBreakPop()
        freeReg(swCond)
        return 0
    end

    if st == N_BREAK
        if cgBreakStackN > 0
            emitJmp(cgBreakStack[cgBreakStackN - 1])
        end
        return 0
    end

    if st == N_CONTINUE
        if cgContStackN > 0
            emitJmp(cgContStack[cgContStackN - 1])
        end
        return 0
    end

    if st == N_FOR
        var foLoop: int = newLabel()
        var foCont: int = newLabel()
        var foEnd: int = newLabel()
        var foVi: int = cgVarFind(cgF(s, 0))
        var foOff: int = 0
        if foVi >= 0
            foOff = cgViOff[foVi]
        end

        var foStart: int = cgEmitExpr(cgF(s, 1))
        if foStart != 0
            emitMovReg(0, foStart)
            freeReg(foStart)
        end
        emitStoreToBP64(foOff)
        freeReg(0)

        # Determine if step is negative at compile time for correct comparison
        var foStep: int = cgF(s, 3)
        var foCount: int = 0
        if foStep != 0
            if cgTag(foStep) == N_NUMBER
                if cgNumVal(foStep) < 0
                    foCount = 1
                end
            end
        end

        emitLabel(foLoop)

        var foVar: int = allocReg()
        if foVar < 0
            foVar = 0
        end
        emitLoadRegFromBP64(foVar, foOff)
        cgKeepReg = foVar
        var foEndReg: int = cgEmitExprKeepAlive(cgF(s, 2))
        foVar = cgKeepReg
        emit8(0x48)
        emit8(0x39)
        emit8(0xC0 + foEndReg * 8 + foVar)
        freeReg(foEndReg)
        if foCount == 1
            emit8(0x0F)
            emit8(0x8E)
        else
            emit8(0x0F)
            emit8(0x8D)
        end
        cgFixPush(cgCodeLen, foEnd)
        emit32(0)
        freeReg(foVar)

        cgBreakPush(foEnd)
        cgContPush(foCont)
        cgEmitBlock(cgF(s, 4), cgF(s, 5))
        cgContPop()
        cgBreakPop()
        emitLabel(foCont)

        var foCur: int = allocReg()
        if foCur < 0
            foCur = 0
        end
        emitLoadRegFromBP64(foCur, foOff)
        if foStep != 0
            cgKeepReg = foCur
            var foStepReg: int = cgEmitExprKeepAlive(foStep)
            foCur = cgKeepReg
            emitAdd(foCur, foStepReg)
            freeReg(foStepReg)
        else
            emit8(0x48)
            emit8(0xFF)
            emit8(0xC0 + foCur)
        end
        if foCur != 0
            emitMovReg(0, foCur)
            freeReg(foCur)
        end
        emitStoreToBP64(foOff)
        freeReg(0)

        emitJmp(foLoop)
        emitLabel(foEnd)
        return 0
    end

    # N_ASM: codegen.cpp:6861-6865 — ws=f0 (0 = native = cgWordSize),
    # инструкции идут side-окном (f1,f2), по 4 strId на инструкцию
    # (mnemonic, op1, op2, op3); op3 энкодер не читает, как и в C++.
    if st == N_ASM
        var asmWs: int = cgF(s, 0)
        if asmWs == 0
            asmWs = cgWordSize
        end
        var asmStart: int = cgF(s, 1)
        var asmLen: int = cgF(s, 2)
        var asmI: int = 0
        while asmI + 4 <= asmLen
            var asmB: int = asmStart + asmI
            cgEmitAsmInstr(cgSide(asmB), cgSide(asmB + 1), cgSide(asmB + 2), cgSide(asmB + 3), asmWs)
            asmI = asmI + 4
        end
        return 0
    end

    # Неизвестный стейтмент: C++ билдер сюда не доходит (все виды покрыты).
    cgErrSet("emitStmt: statement kind is not ported to codegen.z yet")
    return -1
end

# Block = side list of statement ids (в ZAST нет узла Block). C++ рекурсит
# по Block::stmts из If/While/Loop/For/Switch — здесь одна общая обёртка.
func cgEmitBlock(start: int, len: int)
    var i: int = 0
    while i < len
        var sid: int = cgSide(start + i)
        if sid != 0
            cgEmitStmt(sid)
        end
        i = i + 1
    end
end

# scratch: метки веток switch (codegen.cpp:6592 std::vector<int> caseLabels)
var cgSwitchLabels: [4096]int

# codegen.cpp:6401 lambda addrToR10: адрес цепочки поля в r10. Вызывается и
# до, и после вычисления значения (спил правого операнда затирает r10), поэтому
# это отдельная функция, а не инлайн.
func cgAddrToR10(chain: int)
    var a: int = cgEmitAddrOfExpr(chain)
    if a != 10
        # mov r10, a   (REX.W|REX.R[+B], 8B /r)
        var rex: int = 0x4C
        if a >= 8
            rex = rex | 0x01
        end
        emit8(rex)
        emit8(0x8B)
        emit8(0xC0 | (2 << 3) | (a & 7))
        freeReg(a)
    end
end

# ===================== emitFunction (codegen.cpp:7645) =====================
#
# The code-buffer half of a function. The var-table half (varInfos.clear ->
# globalOffsets re-registration -> params -> allocateBlockVars -> spillBase ->
# frameSize) lives in cgSetupFunc (cg_type.z): C++ runs all of it before the
# first emit8, and tests want the frame layout without emitting bytes.
#
# Signature layout on the N_FUNC node: f0=name, f1/f2=params (stride 7:
# name + 6 Type words), f3..f8=returnType, f9/f10=body, f11=isExtern.
func cgEmitFunction(fid: int) -> int
    if fid == 0
        cgErrSet("emitFunction: bad function node")
        return 1
    end
    if cgF(fid, 11) != 0
        return 0
    end
    cgFuncOffsetPut(cgF(fid, 0), cgCodeLen)
    cgSetupFunc(fid)
    cgRegsUsed = 0
    cgXmmUsed = 0
    cgFuncEndLabel = newLabel()

    var ps: int = cgF(fid, 1)
    var n: int = cgF(fid, 2) / 7
    if n > CG_PARAM_MAX
        n = CG_PARAM_MAX
    end
    var paramBytes: int = cgParamBytes
    var frameSize: int = cgFrameSize

    # ---- prologue: push rbp; push rbx; mov rbp,rsp; sub rsp,frameSize ----
    emit8(0x55)
    emit8(0x53)
    emit8(0x48)
    emit8(0x89)
    emit8(0xE5)
    if frameSize > 0
        if frameSize <= 127
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(frameSize)
        else
            emit8(0x48)
            emit8(0x81)
            emit8(0xEC)
            emit32(frameSize)
        end
    end

    # ---- copy incoming parameters into their frame slots ----
    var maxReg: int = 4
    if cgSysvAbi != 0
        maxReg = 6
    end
    var paramSlot: int = 0
    var k: int = 0
    while k < n
        var w: int = ps + k * 7
        var tp: int = cgSideBase + (w + 1) * 4
        var slots: int = cgPSSlots[k]
        var isFl: int = 0
        if cgTk(tp) == TK_FLOAT && cgTIsPtr(tp) == 0
            isFl = 1
        end

        # register-passed slots
        var j: int = 0
        while j < slots
            var slot: int = paramSlot + j
            if slot >= maxReg
                break
            end
            var off: int = -(paramBytes - slot * 8)
            if isFl == 1
                emitFloatStoreToBP(slot, off)
            else
                if cgSysvAbi != 0
                    if slot == 0
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x7D)
                        emit8(off)
                    end
                    if slot == 1
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x75)
                        emit8(off)
                    end
                    if slot == 2
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x55)
                        emit8(off)
                    end
                    if slot == 3
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x4D)
                        emit8(off)
                    end
                    if slot == 4
                        emit8(0x4C)
                        emit8(0x89)
                        emit8(0x45)
                        emit8(off)
                    end
                    if slot == 5
                        emit8(0x4C)
                        emit8(0x89)
                        emit8(0x4D)
                        emit8(off)
                    end
                else
                    if slot == 0
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x4D)
                        emit8(off)
                    end
                    if slot == 1
                        emit8(0x48)
                        emit8(0x89)
                        emit8(0x55)
                        emit8(off)
                    end
                    if slot == 2
                        emit8(0x4C)
                        emit8(0x89)
                        emit8(0x45)
                        emit8(off)
                    end
                    if slot == 3
                        emit8(0x4C)
                        emit8(0x89)
                        emit8(0x4D)
                        emit8(off)
                    end
                end
            end
            j = j + 1
        end

        # stack-passed slots live in the caller's area (SysV [rbp+24+(slot-6)*8],
        # Win64 shadow home [rbp+24+slot*8]) — copy them into our own frame slot
        # so the body reads params only via varInfo offsets (all below rbp).
        var nRegs: int = 4
        if cgSysvAbi != 0
            nRegs = 6
        end
        j = 0
        while j < slots
            var slot2: int = paramSlot + j
            if slot2 >= nRegs
                var off2: int = -(paramBytes - slot2 * 8)
                var srcOff: int = 24 + slot2 * 8
                if cgSysvAbi != 0
                    srcOff = 24 + (slot2 - 6) * 8
                end
                if isFl == 1
                    emit8(0xF3)
                    emit8(0x0F)
                    emit8(0x10)
                    emit8(0x45)
                    emit8(srcOff)
                    emit8(0xF3)
                    emit8(0x0F)
                    emit8(0x11)
                    emit8(0x45)
                    emit8(off2)
                else
                    emit8(0x48)
                    emit8(0x8B)
                    emit8(0x45)
                    emit8(srcOff)
                    emit8(0x48)
                    emit8(0x89)
                    emit8(0x45)
                    emit8(off2)
                end
            end
            j = j + 1
        end

        paramSlot = paramSlot + slots
        k = k + 1
    end

    # ---- body ----
    var bs: int = cgF(fid, 9)
    var bl: int = cgF(fid, 10)
    var i: int = 0
    while i < bl
        var sid: int = cgSide(bs + i)
        if sid != 0
            cgEmitStmt(sid)
        end
        i = i + 1
    end

    emitLabel(cgFuncEndLabel)

    # ---- epilogue: add rsp,frameSize; pop rbx; pop rbp; ret ----
    if frameSize > 0
        if frameSize <= 127
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(frameSize)
        else
            emit8(0x48)
            emit8(0x81)
            emit8(0xC4)
            emit32(frameSize)
        end
    end
    emit8(0x5B)
    emit8(0x5D)
    emit8(0xC3)
    return 0
end

# ===================== emitGlobalInit (codegen.cpp:1803) =====================
#
# Runs the initializers of the user globals (and stamps the runtime class id
# into class-typed globals that have none). Deliberately stack-neutral: it
# pushes a minimal frame so the spill-based builtins (alloc/arena*/pool*/slot*)
# can save registers to [rbp - spillBase] while evaluating an initializer, then
# restores `locals`/`spillBase` exactly as C++ does. No-op when nothing needs
# initializing — which is the common case, so the bytes below are emitted only
# for programs that declare `var g: T = ...` at file scope.
#
# Called from emitLinuxEntryPoint / emitLinuxLibInit, i.e. AFTER every function
# has been emitted, so `cgCurFuncRetType` still holds the last function's — same
# as C++, where emitGlobalInit runs after the function loop too.
func cgEmitGlobalInit()
    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    var hasInit: int = 0
    var hasClassGlobal: int = 0
    var i: int = 0
    while i < gl
        var gid: int = cgSide(gs + i)
        if gid != 0
            if cgF(gid, 7) != 0
                hasInit = 1
            else
                var gt: int = cgFAddr(gid, 1)
                if cgTk(gt) == TK_STRUCT && cgTIsPtr(gt) == 0
                    if cgClassIdFind(cgTStruct(gt)) >= 0
                        hasClassGlobal = 1
                    end
                end
            end
        end
        i = i + 1
    end
    if hasInit == 0 && hasClassGlobal == 0
        return
    end

    emit8(0x55)
    emit8(0x48)
    emit8(0x89)
    emit8(0xE5)
    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x20)

    var savedLocals: int = cgLocals
    var savedSpill: int = cgSpillBase
    cgLocals = 0
    cgSpillBase = 8

    cgPopulateGlobalVarInfos()

    i = 0
    while i < gl
        var gid2: int = cgSide(gs + i)
        if gid2 != 0
            var inits: int = cgF(gid2, 7)
            if inits != 0
                var gi: int = cgGoFind(cgF(gid2, 0))
                var off: int = 0
                if gi >= 0
                    off = cgGoOff[gi]
                end
                var t: int = cgFAddr(gid2, 1)
                if cgTk(t) == TK_FLOAT && cgTIsPtr(t) == 0
                    var x: int = cgEmitFloatExpr(inits)
                    emitGlobalFloatStore(x, off)
                    freeXmmReg(x)
                else
                    var r: int = cgEmitExpr(inits)
                    if r != 0
                        emitMovReg(0, r)
                        freeReg(r)
                    end
                    emitGlobalStoreReg64(off)
                    freeReg(0)
                end
                cgRegsUsed = 0
                cgXmmUsed = 0
            end
        end
        i = i + 1
    end

    # Class-typed globals without an initializer: stamp the runtime class id
    # into the hidden `__classid` slot so virtual dispatch works on them.
    i = 0
    while i < gl
        var gid3: int = cgSide(gs + i)
        if gid3 != 0
            if cgF(gid3, 7) == 0
                var t3: int = cgFAddr(gid3, 1)
                if cgTk(t3) == TK_STRUCT && cgTIsPtr(t3) == 0
                    var cid: int = cgClassIdFind(cgTStruct(t3))
                    if cid >= 0
                        var gi3: int = cgGoFind(cgF(gid3, 0))
                        var off3: int = 0
                        if gi3 >= 0
                            off3 = cgGoOff[gi3]
                        end
                        emitMovRegImm(0, cid)
                        emitGlobalStoreReg64(off3)
                        freeReg(0)
                        cgRegsUsed = 0
                        cgXmmUsed = 0
                    end
                end
            end
        end
        i = i + 1
    end

    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x20)
    emit8(0x5D)
    cgLocals = savedLocals
    cgSpillBase = savedSpill
end

# ===================== KO builtins: tryKOCall =====================
# codegen_builtins_linux.cpp:493..814. В C++ это ПЕРВАЯ ветка диспетчера
# codegen.cpp:5510, и срабатывает она только при prog.koDriver (selfhost —
# cgKoDriverFlag, который --obj поднимает сам: main.cpp:1407, см. комментарий
# у cgObjOutput). Отсюда два отличия от tryLinuxCall:
#  * печать — это extern-символ `_printk`, `call rel32` (R_X86_64_PC32,
#    addend -4); фикстуру кладёт здесь tryKOCall, buildKO() не портирована;
#  * строка кладётся в rdi как есть (printk сам ищет '%'), формат "%d\n"
#    грузится только для int-аргумента.
#
# Порядок веток повторяет C++: сначала print-семейство (argc != 1 -> не наш,
# float -> жёсткая ошибка компиляции), затем ring-0 builtins под
# `if cgKoDriver() == 1`, и только потом `return 0` (-> tryLinuxCall).

# mov rdi, <fmt>. Настоящий .ko ложит sign-ext-imm32 (адреса ядра влезают в
# 32 бита); картинка --obj линкуется в PIE-хост, где R_X86_64_32S отвергается,
# поэтому там lea rdi,[rip+disp32] — тот же путь, что у строковых литералов.
func cgKoLoadFmt(idx: int)
    if cgObjOutput != 0
        emit8(0x48)
        emit8(0x8D)
        emit8(0x3D)
        cgPushStrFix(cgCodeLen, idx)
        emit32(0)
        return
    end
    emit8(0x48)
    emit8(0xC7)
    emit8(0xC7)
    var kp: int = cgCodeLen
    emit32(0)
    if cgKoStrFixN < CG_POOL_STR_MAX
        cgKoStrFixPos[cgKoStrFixN] = kp
        cgKoStrFixIdx[cgKoStrFixN] = idx
        cgKoStrFixN = cgKoStrFixN + 1
    end
end

# call rel32 к extern-символу ядра. sym — NUL-литерал в памяти самого
# компилятора (в .z строковый литерал = указатель), НЕ strId и НЕ индекс
# cgStrPool: кладь его в пул рдаты значила бы лишний байт в .rdata.
func cgKoCall(sym: int)
    emit8(0xE8)
    cgPushKoExtCall(cgCodeLen, sym)
    emit32(0)
end

# peek*(addr) -> byte/word/dword/qword: codegen_builtins_linux.cpp:636..652
func cgKoPeek(c: int, sizeBytes: int) -> int
    var pkSaved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var pkA: int = cgEmitExpr(cgCallArg(c, 0))
    if pkA != 0
        emitMovReg(0, pkA)
        freeReg(pkA)
    else
        freeReg(0)
    end
    if sizeBytes == 1
        emit8(0x0F)
        emit8(0xB6)
        emit8(0x00)
    else if sizeBytes == 2
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x00)
    else if sizeBytes == 4
        emit8(0x8B)
        emit8(0x00)
    else
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)
    end
    cgRegsUsed = pkSaved & ~1
    reloadRegs()
    cgRegsUsed = pkSaved | 1
    cgLinResReg = 0
    return 1
end

# poke*(addr, val): codegen_builtins_linux.cpp:653..674
func cgKoPoke(c: int, sizeBytes: int) -> int
    var pkSaved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var pkV: int = cgEmitExpr(cgCallArg(c, 1))
    if pkV != 0
        emitMovReg(0, pkV)
        freeReg(pkV)
    else
        freeReg(0)
    end
    emit8(0x50)
    var pkA: int = cgEmitExpr(cgCallArg(c, 0))
    if pkA != 0
        emitMovReg(0, pkA)
        freeReg(pkA)
    else
        freeReg(0)
    end
    emit8(0x5A)
    if sizeBytes == 1
        emit8(0x88)
        emit8(0x10)
    else if sizeBytes == 2
        emit8(0x66)
        emit8(0x89)
        emit8(0x10)
    else if sizeBytes == 4
        emit8(0x89)
        emit8(0x10)
    else
        emit8(0x48)
        emit8(0x89)
        emit8(0x10)
    end
    cgRegsUsed = pkSaved & ~1
    reloadRegs()
    cgRegsUsed = pkSaved | 1
    cgLinResReg = 0
    return 1
end

func cgTryKOCall(c: int) -> int
    var n: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    # ---- print/println: _printk(...)  (codegen_builtins_linux.cpp:496..550) ----
    if cgStrIs(n, "print") == 1 || cgStrIs(n, "printLn") == 1 || cgStrIs(n, "println") == 1
        if argc != 1
            return 0
        end
        var arg: int = cgCallArg(c, 0)
        if cgTag(arg) == N_STRING
            cgKoLoadFmt(cgStringPoolIdx(cgF(arg, 0)))
        else if cgIsFloatExpr(arg) == 1
            # C++ здесь бросает и валит компиляцию; cgErrSet делает то же.
            cgErrSet("print(float) is not supported in driver (kernel-module) mode; use an integer.")
            return 0
        else
            var isStrVar: int = 0
            if cgTag(arg) == N_IDENT
                var vi: int = cgVarFind(cgF(arg, 0))
                if vi >= 0
                    var tp: int = cgViType[vi]
                    if cgTk(tp) == TK_STRING && cgTIsPtr(tp) == 0
                        isStrVar = 1
                    end
                end
            end
            var r: int = cgEmitExpr(arg)
            if isStrVar == 1
                emitMovReg(7, r)
            else
                cgKoLoadFmt(cgStringPoolRawIdx("%d\n"))
                emitMovReg(6, r)
            end
            freeReg(r)
        end

        emit8(0x31)
        emit8(0xC0)
        cgKoCall("_printk")
        cgRegsUsed = 0
        cgXmmUsed = 0
        cgLinResReg = 0
        return 1
    end

    # ---- ring-0 hardware builtins (codegen_builtins_linux.cpp:557..811) ----
    if cgKoDriver() == 1
        # rdtsc() -> edx:eax -> rax
        if cgStrIs(n, "rdtsc") == 1 && argc == 0
            var rtSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            emit8(0x0F)
            emit8(0x31)
            emit8(0x48)
            emit8(0xC1)
            emit8(0xE2)
            emit8(0x20)
            emit8(0x48)
            emit8(0x09)
            emit8(0xC2)
            emit8(0x48)
            emit8(0x89)
            emit8(0xD0)
            cgRegsUsed = rtSaved & ~1
            reloadRegs()
            cgRegsUsed = rtSaved | 1
            cgLinResReg = 0
            return 1
        end

        # io_delay(): двойной out dx, al в 0x80
        if cgStrIs(n, "io_delay") == 1 && argc == 0
            var ioSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            emit8(0xBA)
            emit32(0x80)
            emit8(0xB0)
            emit8(0x00)
            emit8(0xEE)
            emit8(0xEE)
            cgRegsUsed = ioSaved
            reloadRegs()
            cgRegsUsed = 1
            cgLinResReg = 0
            return 1
        end

        # outb(port, val): out dx, al
        if cgStrIs(n, "outb") == 1 && argc == 2
            var obSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            var obPort: int = cgEmitExpr(cgCallArg(c, 0))
            if obPort != 0
                emitMovReg(0, obPort)
                freeReg(obPort)
            else
                freeReg(0)
            end
            emit8(0x50)
            var obVal: int = cgEmitExpr(cgCallArg(c, 1))
            if obVal != 0
                emitMovReg(0, obVal)
                freeReg(obVal)
            else
                freeReg(0)
            end
            emit8(0x50)
            emit8(0x58)
            emit8(0x5A)
            emit8(0xEE)
            cgRegsUsed = obSaved
            reloadRegs()
            cgRegsUsed = 1
            cgLinResReg = 0
            return 1
        end

        # inb(port) -> byte
        if cgStrIs(n, "inb") == 1 && argc == 1
            var ibSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            var ibPort: int = cgEmitExpr(cgCallArg(c, 0))
            if ibPort != 2
                emitMovReg(2, ibPort)
                freeReg(ibPort)
            else
                freeReg(2)
            end
            emit8(0xEC)
            emit8(0x0F)
            emit8(0xB6)
            emit8(0xC0)
            cgRegsUsed = ibSaved & ~1
            reloadRegs()
            cgRegsUsed = ibSaved | 1
            cgLinResReg = 0
            return 1
        end

        # ---- peek*/poke* (codegen_builtins_linux.cpp:675..682) ----
        if cgStrIs(n, "peek8") == 1 && argc == 1
            return cgKoPeek(c, 1)
        end
        if cgStrIs(n, "peek16") == 1 && argc == 1
            return cgKoPeek(c, 2)
        end
        if cgStrIs(n, "peek32") == 1 && argc == 1
            return cgKoPeek(c, 4)
        end
        if cgStrIs(n, "peek64") == 1 && argc == 1
            return cgKoPeek(c, 8)
        end
        if cgStrIs(n, "poke8") == 1 && argc == 2
            return cgKoPoke(c, 1)
        end
        if cgStrIs(n, "poke16") == 1 && argc == 2
            return cgKoPoke(c, 2)
        end
        if cgStrIs(n, "poke32") == 1 && argc == 2
            return cgKoPoke(c, 4)
        end
        if cgStrIs(n, "poke64") == 1 && argc == 2
            return cgKoPoke(c, 8)
        end

        # ---- kernel API imports (codegen_builtins_linux.cpp:702..810) ----
        # kalloc(size) / alloc(size) -> ptr. В --obj это просто malloc:
        # картинка выполняется в пользовательском хосте, а не в ядре.
        if (cgStrIs(n, "kalloc") == 1 || cgStrIs(n, "alloc") == 1) && argc == 1
            var kaSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            var kaR: int = cgEmitExpr(cgCallArg(c, 0))
            if kaR != 7
                emitMovReg(7, kaR)
                freeReg(kaR)
            else
                freeReg(7)
            end
            if cgObjOutput != 0
                cgKoCall("malloc")
            else
                emit8(0xBE)
                emit32(0xCC0)
                cgKoCall("__kmalloc_noprof")
            end
            cgRegsUsed = kaSaved & ~1
            reloadRegs()
            cgRegsUsed = kaSaved | 1
            cgLinResReg = 0
            return 1
        end

        # kfree(ptr) / free(ptr)
        if (cgStrIs(n, "kfree") == 1 || cgStrIs(n, "free") == 1) && argc == 1
            var kfSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            var kfR: int = cgEmitExpr(cgCallArg(c, 0))
            if kfR != 7
                emitMovReg(7, kfR)
                freeReg(kfR)
            else
                freeReg(7)
            end
            if cgObjOutput != 0
                cgKoCall("free")
            else
                cgKoCall("kfree")
            end
            cgRegsUsed = kfSaved
            reloadRegs()
            cgRegsUsed = 1
            cgLinResReg = 0
            return 1
        end

        # kzalloc(size): kalloc + rep stosb по rax
        if cgStrIs(n, "kzalloc") == 1 && argc == 1
            var kzSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            var kzR: int = cgEmitExpr(cgCallArg(c, 0))
            if kzR != 7
                emitMovReg(7, kzR)
                freeReg(kzR)
            else
                freeReg(7)
            end
            emit8(0x49)
            emit8(0x89)
            emit8(0xFC)
            emit8(0xBE)
            emit32(0xCC0)
            cgKoCall("__kmalloc_noprof")
            var dZero: int = newLabel()
            emit8(0x48)
            emit8(0x85)
            emit8(0xC0)
            emitJccLit("==", dZero)
            emit8(0x49)
            emit8(0x89)
            emit8(0xC7)
            emit8(0x48)
            emit8(0x89)
            emit8(0xC1)
            emit8(0x49)
            emit8(0x8B)
            emit8(0xD4)
            emit8(0xB0)
            emit8(0x00)
            emit8(0xF3)
            emit8(0x48)
            emit8(0xAA)
            emit8(0x4C)
            emit8(0x89)
            emit8(0xF8)
            emitLabel(dZero)
            cgRegsUsed = kzSaved & ~1
            reloadRegs()
            cgRegsUsed = kzSaved | 1
            cgLinResReg = 0
            return 1
        end

        # ktime_ms(): (ns + 500000) / 1000000
        if cgStrIs(n, "ktime_ms") == 1 && argc == 0
            var kmSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            cgKoCall("ktime_get_boot_fast_ns")
            emit8(0x48)
            emit8(0x05)
            emit32(500000)
            emit8(0x48)
            emit8(0x31)
            emit8(0xD2)
            emit8(0xBE)
            emit32(1000000)
            emit8(0x48)
            emit8(0xF7)
            emit8(0xF6)
            cgRegsUsed = kmSaved & ~1
            reloadRegs()
            cgRegsUsed = kmSaved | 1
            cgLinResReg = 0
            return 1
        end

        # ktime_ns()
        if cgStrIs(n, "ktime_ns") == 1 && argc == 0
            var knSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            cgKoCall("ktime_get_boot_fast_ns")
            cgRegsUsed = knSaved & ~1
            reloadRegs()
            cgRegsUsed = knSaved | 1
            cgLinResReg = 0
            return 1
        end

        # jiffies(): mov rax, [rip+disp32] + R_X86_64_PC32 на данные
        if cgStrIs(n, "jiffies") == 1 && argc == 0
            var jfSaved: int = cgRegsUsed
            spillRegs()
            cgRegsUsed = 0
            emit8(0x48)
            emit8(0x8B)
            emit8(0x05)
            var jfPos: int = cgCodeLen
            emit32(0)
            cgPushKoDataFix(jfPos, "jiffies")
            cgRegsUsed = jfSaved & ~1
            reloadRegs()
            cgRegsUsed = jfSaved | 1
            cgLinResReg = 0
            return 1
        end
    end

    return 0
end

# ===================== Linux builtins: print family =====================
# codegen_builtins_linux.cpp:25..254 (tryLinuxCall). В C++ это вторая ветка
# диспетчера codegen.cpp:5506 (после tryKOCall); в selfhost это первая
# встающая на место «backend builtin dispatch not ported» в cgEmitCallBody.
# SysV ABI для syscall: nr=rax, a1=rdi, a2=rsi, a3=rdx, a4=r10, a5=r8, a6=r9.
#
# Портированы ветки string и int + завершающий "\n". Ветка float
# (codegen_builtins_linux.cpp:102..186) пока не портирована и даёт
# громкий cgErrSet вместо тихого расхождения.
var cgLinResReg: int = 0

# mov edi,fd; mov eax,nr; syscall
func cgLinWsys(fd: int, nr: int)
    emit8(0xBF)
    emit32(fd)
    emit8(0xB8)
    emit32(nr)
    emit8(0x0F)
    emit8(0x05)
end

# write(fd, &[rsp], 1) — байт лежит в al
func cgLinWriteOneByte(fd: int)
    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    emit8(0x88)
    emit8(0x04)
    emit8(0x24)
    emit8(0x48)
    emit8(0x89)
    emit8(0xE6)
    emit8(0xBA)
    emit32(1)
    cgLinWsys(fd, 1)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
end

# memByte(p,off) / memQ(p,off) — читать p[off], ноль-расширение.
# Лямбда memRead из codegen_builtins_linux.cpp:425..447 (результат в rax).
func cgLinMemRead(c: int, sizeBytes: int) -> int
    var mrSaved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var mrP: int = cgEmitExpr(cgCallArg(c, 0))
    if mrP != 0
        emitMovReg(0, mrP)
        freeReg(mrP)
    else
        freeReg(0)
    end
    emit8(0x50)
    var mrO: int = cgEmitExpr(cgCallArg(c, 1))
    if mrO != 0
        emitMovReg(0, mrO)
        freeReg(mrO)
    else
        freeReg(0)
    end
    emit8(0x50)
    emit8(0x41)
    emit8(0x58)
    emit8(0x41)
    emit8(0x59)
    emit8(0x4D)
    emit8(0x01)
    emit8(0xC1)
    if sizeBytes == 1
        emit8(0x41)
        emit8(0x0F)
        emit8(0xB6)
        emit8(0x01)
    else if sizeBytes == 2
        emit8(0x41)
        emit8(0x0F)
        emit8(0xB7)
        emit8(0x01)
    else if sizeBytes == 4
        emit8(0x41)
        emit8(0x8B)
        emit8(0x01)
    else
        emit8(0x49)
        emit8(0x8B)
        emit8(0x01)
    end
    cgRegsUsed = mrSaved & ~1
    reloadRegs()
    cgRegsUsed = mrSaved | 1
    cgLinResReg = 0
    return 1
end

# memByteW(p,off,v) / memQw(p,off,v) — писать v в p[off]
# (codegen_builtins_linux.cpp:451..477).
func cgLinMemWrite(c: int, sizeBytes: int) -> int
    var mwSaved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var mwP: int = cgEmitExpr(cgCallArg(c, 0))
    if mwP != 0
        emitMovReg(0, mwP)
        freeReg(mwP)
    else
        freeReg(0)
    end
    emit8(0x50)
    var mwO: int = cgEmitExpr(cgCallArg(c, 1))
    if mwO != 0
        emitMovReg(0, mwO)
        freeReg(mwO)
    else
        freeReg(0)
    end
    emit8(0x50)
    var mwV: int = cgEmitExpr(cgCallArg(c, 2))
    if mwV != 0
        emitMovReg(0, mwV)
        freeReg(mwV)
    else
        freeReg(0)
    end
    emit8(0x50)
    emit8(0x41)
    emit8(0x58)
    emit8(0x41)
    emit8(0x59)
    emit8(0x41)
    emit8(0x5A)
    emit8(0x4D)
    emit8(0x01)
    emit8(0xCA)
    if sizeBytes == 1
        emit8(0x45)
        emit8(0x88)
        emit8(0x02)
    else if sizeBytes == 2
        emit8(0x66)
        emit8(0x45)
        emit8(0x89)
        emit8(0x02)
    else if sizeBytes == 4
        emit8(0x45)
        emit8(0x89)
        emit8(0x02)
    else
        emit8(0x4D)
        emit8(0x89)
        emit8(0x02)
    end
    cgRegsUsed = mwSaved & ~1
    reloadRegs()
    cgRegsUsed = mwSaved | 1
    cgLinResReg = 0
    return 1
end

func cgTryLinuxCall(c: int) -> int
    var n: int = cgF(c, 0)
    var argc: int = cgCallArgc(c)

    # ---- print/println/eprint...: write(fd, value) + "\n" (строка :28) ----
    if cgStrIs(n, "print") == 1 || cgStrIs(n, "printLn") == 1 || cgStrIs(n, "println") == 1 || cgStrIs(n, "eprint") == 1 || cgStrIs(n, "eprintLn") == 1 || cgStrIs(n, "eprintln") == 1
        if argc != 1
            return 0
        end
        var isErr: int = 0
        if cgStrIs(n, "eprint") == 1 || cgStrIs(n, "eprintLn") == 1 || cgStrIs(n, "eprintln") == 1
            isErr = 1
        end
        var wfd: int = 1
        if isErr == 1
            wfd = 2
        end
        var wantNl: int = 1
        if cgStrIs(n, "eprint") == 1
            wantNl = 0
        end

        var arg: int = cgCallArg(c, 0)
        # Строка — это 8-байтовый указатель на NUL-терминированный литерал в
        # .rdata, поэтому строковая ПЕРЕМЕННАЯ обрабатывается как литерал.
        # (Только StringExpr давал бы переменную в int-ветку — печать адреса.)
        var isStringArg: int = 0
        if cgTag(arg) == N_STRING
            isStringArg = 1
        end
        if isErr == 1
            isStringArg = 1
        end
        if isStringArg == 0
            if cgTag(arg) == N_IDENT
                var vi: int = cgVarFind(cgF(arg, 0))
                if vi >= 0
