#
# Float value of `e` in an XMM register. Callers expect an XMM index (that is
# what emitFloatStoreToBP etc. take), never a GPR index.

func cgEmitFloatExpr(e: int) -> int
    if e != 0 && cgTag(e) == N_CALL
        var mx: int = cgEmitFloatMathCall(e)
        if mx >= 0
            return mx
        end
    end
    if e != 0 && cgTag(e) == N_FLOAT
        var x: int = allocXmmReg()
        if x < 0
            x = 0
        end
        var lit: int = cgF(e, 0)
        var v: float = cgParseFloatPtr(cgStrPtr(lit), cgStrLen(lit))
        if cgF(e, 1) != 0
            v = 0.0 - v
        end
        emitMovssXmmImmF(x, v)
        return x
    end
    if e != 0 && cgTag(e) == N_NUMBER
        var x2: int = allocXmmReg()
        if x2 < 0
            x2 = 0
        end
        var saved: int = cgRegsUsed
        if (saved & 1) != 0
            emit8(0x50)
        end
        cgRegsUsed = 1
        var r: int = allocReg()
        emitMovRegImm(r, cgNumVal(e))
        emitCvtsi2ss(x2, r)
        freeReg(r)
        cgRegsUsed = saved
        if (saved & 1) != 0
            emit8(0x58)
        end
        return x2
    end
    # Implicit int -> float: anything that is not already a float expression
    # goes through the integer emitter and cvtsi2ss, instead of being
    # reinterpreted as raw f32 bits.
    if cgIsFloatExpr(e) == 0
        var r2: int = cgEmitExpr(e)
        var x3: int = allocXmmReg()
        if x3 < 0
            x3 = 0
        end
        emitCvtsi2ss(x3, r2)
        freeReg(r2)
        return x3
    end
    if cgTag(e) == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi >= 0
            var x4: int = allocXmmReg()
            if x4 < 0
                x4 = 0
            end
            if cgViGlobal[vi] != 0
                emitGlobalFloatLoad(x4, cgViOff[vi])
            else
                emitFloatLoadFromBP(x4, cgViOff[vi])
            end
            return x4
        end
        var x5: int = allocXmmReg()
        if x5 < 0
            x5 = 0
        end
        emitMovssXmmImmF(x5, 0.0)
        return x5
    end
    if cgTag(e) == N_MEMBER
        var ft: int = cgExprType(e)
        if (cgTk(ft) == TK_FLOAT || cgTk(ft) == TK_BOOL) && cgTIsPtr(ft) == 0
            var addr: int = cgEmitAddrOfExpr(e)
            var x6: int = allocXmmReg()
            if x6 < 0
                x6 = 0
            end
            emitFloatLoadFromAddr(x6, addr, 0)
            freeReg(addr)
            return x6
        end
    end
    if cgTag(e) == N_ARRAYACC
        var arr0: int = cgF(e, 0)
        var vi2: int = -1
        if cgTag(arr0) == N_IDENT
            vi2 = cgVarFind(cgF(arr0, 0))
        end
        var arrT: int = cgExprType(e)
        if vi2 >= 0 && cgTk(arrT) == TK_FLOAT && cgTIsPtr(arrT) == 0
            var x7: int = allocXmmReg()
            if x7 < 0
                x7 = 0
            end
            var idxReg: int = cgEmitExpr(cgF(e, 1))
            if idxReg != 0
                emitMovReg(0, idxReg)
                freeReg(idxReg)
                idxReg = 0
            end
            if cgTIsPtr(cgViType[vi2]) != 0
                if cgViGlobal[vi2] != 0
                    emitGlobalLoadR10(cgViOff[vi2])
                else
                    emitLoadR10FromBP64(cgViOff[vi2])
                end
            else
                if cgViGlobal[vi2] != 0
                    emitGlobalLeaR10(cgViOff[vi2])
                else
                    emitLeaR10FromBP(cgViOff[vi2])
                end
            end
            emit8(0x48)
            emit8(0x69)
            emit8(0xC0)
            emit32(4)
            emit8(0x49)
            emit8(0x01)
            emit8(0xC2)
            freeReg(0)
            emit8(0xF3)
            emit8(0x41)
            emit8(0x0F)
            emit8(0x10)
            emit8(0x02 | ((x7 & 7) << 3))
            return x7
        end
        # Generic base (`(*p)[i]`, `mk()[i]`): compute the element address.
        if cgTk(arrT) == TK_FLOAT && cgTIsPtr(arrT) == 0
            var addr2: int = cgEmitAddrOfExpr(e)
            var x8: int = allocXmmReg()
            if x8 < 0
                x8 = 0
            end
            emitFloatLoadFromAddr(x8, addr2, 0)
            freeReg(addr2)
            return x8
        end
    end
    if cgTag(e) == N_DEREF
        var pt: int = cgExprType(cgF(e, 0))
        if cgTIsPtr(pt) != 0 && cgTk(pt) == TK_FLOAT
            var addr3: int = cgEmitExpr(cgF(e, 0))
            var x9: int = allocXmmReg()
            if x9 < 0
                x9 = 0
            end
            emitFloatLoadFromAddr(x9, addr3, 0)
            freeReg(addr3)
            return x9
        end
    end
    if cgTag(e) == N_UNARY
        if cgStrIs(cgF(e, 0), "-") == 1
            var x10: int = cgEmitFloatExpr(cgF(e, 1))
            if x10 < 0
                x10 = 0
            end
            var saved3: int = cgRegsUsed
            if (saved3 & 1) != 0
                emit8(0x50)
            end
            cgRegsUsed = 1
            var r3: int = allocReg()
            emitMovRegImm(r3, 0)
            var y: int = allocXmmReg()
            if y < 0
                y = 0
            end
            emitCvtsi2ss(y, r3)
            freeReg(r3)
            cgRegsUsed = saved3
            if (saved3 & 1) != 0
                emit8(0x58)
            end
            emitSubss(y, x10)
            freeXmmReg(x10)
            return y
        end
    end
    if cgTag(e) == N_BINARY
        return cgEmitBinaryExpr(e, 1)
    end
    if cgTag(e) == N_CALL
        # A user function returning a float leaves it in xmm0. Emit the call,
        # then copy xmm0 into a fresh register: without that, a second call
        # operand of a 2-arg builtin would land in xmm0 and clobber this value.
        var rc: int = cgEmitExpr(e)
        freeReg(rc)
        cgXmmUsed = cgXmmUsed | 1
        var x11: int = allocXmmReg()
        if x11 < 0
            x11 = 0
        end
        if x11 != 0
            emitMovssXmm(x11, 0)
        end
        cgXmmUsed = cgXmmUsed & ~1
        return x11
    end
    var x12: int = allocXmmReg()
    if x12 < 0
        x12 = 0
    end
    emitMovssXmmImmF(x12, 0.0)
    return x12
end

# ---- emitExprKeepAlive (codegen.cpp:2110) ----
#
# Evaluate `e` while keeping a register live across the calls inside it.
# The C++ signature is `int emitExprKeepAlive(Expr*, int& keepReg)`: the
# register travels by reference, so a nested binary op keeps its OWN local
# tempReg and cannot disturb the caller's. Here it has to travel through the
# single module slot `cgKeepReg`, which a nested `cgEmitBinaryInt` inside `e`
# would happily overwrite — so the incoming value is captured on entry and
# written back on the no-call path. The caller reads `cgKeepReg` right after
# the call to pick up the register the value was actually popped into.

var cgKeepReg: int = 0

func cgEmitExprKeepAlive(e: int) -> int
    var keep: int = cgKeepReg
    if cgExprContainsCall(e) == 0
        var plain: int = cgEmitExpr(e)
        cgKeepReg = keep
        return plain
    end
    emit8(0x50 + keep)
    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    var result: int = cgEmitExpr(e)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
    var restored: int = allocReg()
    if restored < 0
        if result == 0
            restored = 1
        else
            restored = 0
        end
    end
    emit8(0x58 + restored)
    freeReg(keep)
    cgRegsUsed = cgRegsUsed | (1 << restored)
    cgKeepReg = restored
    return result
end

# emitExprKeepAliveR10 (codegen.cpp:2129): r10 is the untracked scratch base
# used by indexed assignments, so a nested `x[i]` in the expression would
# destroy the base address the store is about to write through.
func cgEmitExprKeepAliveR10(e: int) -> int
    if cgExprContainsCall(e) == 0 && cgExprHasArrayAccess(e) == 0
        return cgEmitExpr(e)
    end
    emit8(0x41)
    emit8(0x52)
    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    var result: int = cgEmitExpr(e)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
    emit8(0x41)
    emit8(0x5A)
    return result
end

func cgEmitFloatExprKeepAliveR10(e: int) -> int
    if cgExprContainsCall(e) == 0 && cgExprHasArrayAccess(e) == 0
        return cgEmitFloatExpr(e)
    end
    emit8(0x41)
    emit8(0x52)
    emit8(0x48)
    emit8(0x83)
    emit8(0xEC)
    emit8(0x08)
    var x: int = cgEmitFloatExpr(e)
    emit8(0x48)
    emit8(0x83)
    emit8(0xC4)
    emit8(0x08)
    emit8(0x41)
    emit8(0x5A)
    return x
end

# ---- emitBinaryExpr (codegen.cpp:2155) ----

func cgToFloatXmm(e: int, isF: int) -> int
    if isF == 1
        return cgEmitFloatExpr(e)
    end
    var g: int = cgEmitExpr(e)
    var x: int = allocXmmReg()
    if x < 0
        x = 0
    end
    emitCvtsi2ss(x, g)
    freeReg(g)
    return x
end

# scale the right operand of `p + k` / `p - k` by the pointee stride
func cgScaleRight(r: int, stride: int)
    if stride <= 1 || r < 0
        return
    end
    if (stride & (stride - 1)) == 0
        var sh: int = 0
        while (1 << sh) != stride
            sh = sh + 1
        end
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0xC1)
        emit8(0xE0 | (r & 7))
        emit8(sh)
    else
        if cgWordSize == 64
            emit8(0x48)
        end
        emit8(0x69)
        emit8(0xC0 | ((r & 7) << 3) | (r & 7))
        emit32(stride)
    end
end

# 0F 8x rel32 that SKIPS the "result = 1" store — the inverted conditions of
# the integer compare path (NOT the mapping emitJcc uses).
func cgEmitJccSkip(op: int, label: int)
    var jccOp: int = 0x84
    if cgStrIs(op, "==") == 1
        jccOp = 0x85
    else if cgStrIs(op, "!=") == 1
        jccOp = 0x84
    else if cgStrIs(op, "<") == 1
        jccOp = 0x8D
    else if cgStrIs(op, ">") == 1
        jccOp = 0x8E
    else if cgStrIs(op, "<=") == 1
        jccOp = 0x8F
    else
        jccOp = 0x8C
    end
    emit8(0x0F)
    emit8(jccOp)
    cgFixPush(cgCodeLen, label)
    emit32(0)
end

func cgEmitBinaryExpr(bin: int, isFloat: int) -> int
    var op: int = cgF(bin, 2)
