        emit8(0x89)
        emit8(0x0D)
        cgPushHeapFix(cgCodeLen, cgHeapOffsetRVA)
        emit32(0)
        emit8(0x48)
        emit8(0x89)
        emit8(0x5C)
        emit8(0x10)
        emit8(8)
        emit8(0x48)
        emit8(0x8D)
        emit8(0x44)
        emit8(0x10)
        emit8(16)
        emitJmp(mpDone)
