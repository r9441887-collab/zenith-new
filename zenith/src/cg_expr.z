        emitLabel(endAnd)
        return resAnd
    end

    # ---- short-circuit || ----
    if cgStrIs(op, "||") == 1
        var l2: int = cgEmitExpr(left)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0 | ((l2 & 7) << 3) | (l2 & 7))
        var trueOr: int = newLabel()
        emit8(0x0F)
        emit8(0x85)
        cgFixPush(cgCodeLen, trueOr)
