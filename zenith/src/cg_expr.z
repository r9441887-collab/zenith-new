# integer half of emitBinaryExpr (codegen.cpp:2300)
func cgEmitBinaryInt(op: int, left: int, right: int) -> int
    # Typed pointer arithmetic: `p + k` / `p - k` steps k pointee elements.
    # Only the left operand is checked, so `p - q` stays a raw difference.
    var lt: int = cgExprType(left)
    var rt: int = cgExprType(right)
    var ptrStride: int = 1
    if cgTIsPtr(lt) != 0 && cgTIsPtr(rt) == 0
        if cgStrIs(op, "+") == 1 || cgStrIs(op, "-") == 1
            var et: int = cgTyCopy(lt)
            poke32(et + 8, 0)
            ptrStride = cgArrayElemStride(et)
        end
    end

    var leftReg: int = cgEmitExpr(left)
    var tempReg: int = allocReg()

    if tempReg < 0
        if cgStrIs(op, "+") == 1 || cgStrIs(op, "-") == 1 || cgStrIs(op, "*") == 1 || cgStrIs(op, "&") == 1 || cgStrIs(op, "|") == 1 || cgStrIs(op, "^") == 1
            # All GPRs busy: spill the left operand and combine it into the
            # right register with a memory-operand form of the instruction —
            # popping into a guessed register could clobber a live value.
            emit8(0x50 + leftReg)
            var r1: int = cgEmitExpr(right)
            cgScaleRight(r1, ptrStride)
            if cgStrIs(op, "+") == 1
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x03)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            else if cgStrIs(op, "-") == 1
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0xF7)
                emit8(0xD8 | (r1 & 7))
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x03)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            else if cgStrIs(op, "*") == 1
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x0F)
                emit8(0xAF)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            else if cgStrIs(op, "&") == 1
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x23)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            else if cgStrIs(op, "|") == 1
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x0B)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            else
                # "^"
                if cgWordSize == 64
                    emit8(0x48)
                end
                emit8(0x33)
                emit8(0x04 | ((r1 & 7) << 3))
                emit8(0x24)
            end
            if cgWordSize == 64
                emit8(0x48)
            end
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
            freeReg(leftReg)
            return r1
        end

        # Other operators with every GPR busy: pop the left value back into a
        # freshly allocated register.
        emit8(0x50 + leftReg)
        var r2: int = cgEmitExpr(right)
        cgScaleRight(r2, ptrStride)
        var popReg: int = allocReg()
        if popReg < 0
            if r2 == 0
                popReg = 1
            else
                popReg = 0
            end
        end
        emit8(0x58 + popReg)
        if cgStrIs(op, "+") == 1
            emitAdd(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "-") == 1
            emitSub(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "*") == 1
            emitImul(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "/") == 1
            var saveRdx2: int = 0
            if (cgRegsUsed & 4) != 0 && r2 != 2 && popReg != 2
                saveRdx2 = 1
            end
            if saveRdx2 == 1
                emit8(0x52)
            end
            if r2 == 0 && popReg == 1
                emit8(0x48)
                emit8(0x87)
                emit8(0xC1)
            else
                emitMovReg(0, popReg)
                emit8(0x50 + r2)
                emit8(0x59)
            end
            if cgWordSize == 32
                emit8(0x99)
            else
                emit8(0x48)
                emit8(0x99)
            end
            if cgWordSize == 32
                emit8(0xF7)
            else
                emit8(0x48)
                emit8(0xF7)
            end
            emit8(0xF9)
            if saveRdx2 == 1
                emit8(0x5A)
            end
            freeReg(popReg)
            freeReg(r2)
            cgRegsUsed = cgRegsUsed | 1
            return 0
        else if cgStrIs(op, "%") == 1 || cgStrIs(op, "//") == 1
            var saveRdx3: int = 0
            if (cgRegsUsed & 4) != 0 && r2 != 2 && popReg != 2
                saveRdx3 = 1
            end
            if saveRdx3 == 1
                emit8(0x52)
            end
            if r2 == 0 && popReg == 1
                emit8(0x48)
                emit8(0x87)
                emit8(0xC1)
            else
                emitMovReg(0, popReg)
                emit8(0x50 + r2)
                emit8(0x59)
            end
            if cgWordSize == 32
                emit8(0x99)
            else
                emit8(0x48)
                emit8(0x99)
            end
            if cgWordSize == 32
                emit8(0xF7)
            else
                emit8(0x48)
                emit8(0xF7)
            end
            emit8(0xF9)
            if cgWordSize == 32
                emit8(0x89)
            else
                emit8(0x48)
                emit8(0x89)
            end
            emit8(0xD0)
            if saveRdx3 == 1
                emit8(0x5A)
            end
            freeReg(popReg)
            freeReg(r2)
            cgRegsUsed = cgRegsUsed | 1
            return 0
        else if cgStrIs(op, "&") == 1
            emitAnd(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "|") == 1
            emitOr(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "^") == 1
            emitXor(popReg, r2)
            freeReg(r2)
            return popReg
        else if cgStrIs(op, "<<") == 1 || cgStrIs(op, ">>") == 1
            var popReg2: int = popReg
            var valueInRcx: int = 0
            if popReg2 == 1 && r2 != 1
                valueInRcx = 1
                if r2 == 0
                    popReg2 = 2
                else
                    popReg2 = 0
                end
            end
            var saveRcx2: int = 0
            if r2 != 1
                saveRcx2 = 1
            end
            if saveRcx2 == 1
                emit8(0x51)
            end
            if r2 != 1
                emit8(0x50 + r2)
                if valueInRcx == 1
                    emitMovReg(0, 1)
                else
                    emitMovReg(0, popReg2)
                end
                emit8(0x59)
            else
                emitMovReg(0, popReg2)
            end
            if cgStrIs(op, "<<") == 1
                if cgWordSize == 32
                    emit8(0xD3)
                else
                    emit8(0x48)
                    emit8(0xD3)
                end
                emit8(0xE0)
            else
                if cgWordSize == 32
                    emit8(0xD3)
                else
                    emit8(0x48)
                    emit8(0xD3)
                end
                emit8(0xE8)
            end
            if saveRcx2 == 1
                emit8(0x59)
            end
            freeReg(popReg2)
            freeReg(r2)
            cgRegsUsed = cgRegsUsed | 1
            return 0
        else if isCmpOp(op) == 1
            emit8(0x48)
            emit8(0x39)
            emit8(0xC0 + popReg + r2 * 8)
            emitMovRegImm(r2, 0)
            var endLabel: int = newLabel()
            cgEmitJccSkip(op, endLabel)
            emitMovRegImm(r2, 1)
            emitLabel(endLabel)
            freeReg(popReg)
            return r2
        else
            freeReg(popReg)
            freeReg(r2)
            return r2
        end
    end

    emitMovReg(tempReg, leftReg)
    freeReg(leftReg)
    # A call inside the right operand would clobber tempReg, so keep it alive
    # on the stack across the evaluation.
    cgKeepReg = tempReg
    var rightReg: int = cgEmitExprKeepAlive(right)
    # emitExprKeepAlive pops the kept value into a *new* register (C++ passes
    # tempReg by reference: `emitExprKeepAlive(right, tempReg)`), so the
    # arithmetic below must use the register it was moved into, not tempReg.
    tempReg = cgKeepReg
    cgScaleRight(rightReg, ptrStride)

    if cgStrIs(op, "+") == 1
        emitAdd(rightReg, tempReg)
        freeReg(tempReg)
        return rightReg
    else if cgStrIs(op, "-") == 1
        emitSub(tempReg, rightReg)
        emitMovReg(rightReg, tempReg)
        freeReg(tempReg)
        return rightReg
    else if cgStrIs(op, "*") == 1
        emitImul(rightReg, tempReg)
        freeReg(tempReg)
        return rightReg
    else if cgStrIs(op, "/") == 1
        var saveRax4: int = 0
        if (cgRegsUsed & 1) != 0 && tempReg != 0 && rightReg != 0
            saveRax4 = 1
        end
        var saveRcx4: int = 0
        if (cgRegsUsed & 2) != 0 && rightReg != 1
            saveRcx4 = 1
        end
        var saveRdx4: int = 0
        if (cgRegsUsed & 4) != 0 && rightReg != 2 && tempReg != 2
            saveRdx4 = 1
        end
        if saveRax4 == 1
            emit8(0x50)
        end
        if saveRcx4 == 1
            emit8(0x51)
        end
        if saveRdx4 == 1
            emit8(0x52)
        end
        emit8(0x50 + rightReg)
        emitMovReg(0, tempReg)
        if cgWordSize == 32
            emit8(0x99)
        else
            emit8(0x48)
            emit8(0x99)
        end
        emit8(0x59)
        if cgWordSize == 32
            emit8(0xF7)
        else
            emit8(0x48)
            emit8(0xF7)
        end
        emit8(0xF9)
        if saveRdx4 == 1
            emit8(0x5A)
        end
        if saveRcx4 == 1
            emit8(0x59)
        end
        freeReg(rightReg)
        freeReg(tempReg)
        if saveRax4 == 1
            var dst4: int = findFreeRegOtherThan(cgRegsUsed, 0)
            emitMovReg(dst4, 0)
            emit8(0x58)
            cgRegsUsed = cgRegsUsed | (1 << dst4)
            return dst4
        end
        cgRegsUsed = cgRegsUsed | 1
        return 0
    else if cgStrIs(op, "%") == 1 || cgStrIs(op, "//") == 1
        var saveRax5: int = 0
        if (cgRegsUsed & 1) != 0 && tempReg != 0 && rightReg != 0
            saveRax5 = 1
        end
        var saveRcx5: int = 0
        if (cgRegsUsed & 2) != 0 && rightReg != 1
            saveRcx5 = 1
        end
        var saveRdx5: int = 0
        if (cgRegsUsed & 4) != 0 && rightReg != 2 && tempReg != 2
            saveRdx5 = 1
        end
        if saveRax5 == 1
            emit8(0x50)
        end
        if saveRcx5 == 1
            emit8(0x51)
        end
        if saveRdx5 == 1
            emit8(0x52)
        end
        emit8(0x50 + rightReg)
        emitMovReg(0, tempReg)
        if cgWordSize == 32
            emit8(0x99)
        else
            emit8(0x48)
            emit8(0x99)
        end
        emit8(0x59)
        if cgWordSize == 32
            emit8(0xF7)
        else
            emit8(0x48)
            emit8(0xF7)
        end
        emit8(0xF9)
        if cgWordSize == 32
            emit8(0x89)
        else
            emit8(0x48)
            emit8(0x89)
        end
        emit8(0xD0)
        if saveRdx5 == 1
            emit8(0x5A)
        end
        if saveRcx5 == 1
            emit8(0x59)
        end
        freeReg(rightReg)
        freeReg(tempReg)
        if saveRax5 == 1
            var dst5: int = findFreeRegOtherThan(cgRegsUsed, 0)
            emitMovReg(dst5, 0)
            emit8(0x58)
            cgRegsUsed = cgRegsUsed | (1 << dst5)
            return dst5
        end
        cgRegsUsed = cgRegsUsed | 1
        return 0
    else if cgStrIs(op, "&") == 1
        emitAnd(tempReg, rightReg)
        freeReg(rightReg)
        return tempReg
    else if cgStrIs(op, "|") == 1
        emitOr(tempReg, rightReg)
        freeReg(rightReg)
        return tempReg
    else if cgStrIs(op, "^") == 1
        emitXor(tempReg, rightReg)
        freeReg(rightReg)
        return tempReg
    else if cgStrIs(op, "<<") == 1 || cgStrIs(op, ">>") == 1
        var saveRcx6: int = 0
        if (cgRegsUsed & 2) != 0 && rightReg != 1
            saveRcx6 = 1
        end
        var temp2: int = tempReg
        if temp2 == 1 && rightReg != 1
            # value occupies rcx; move it out before CL is loaded
            var spare: int = -1
            var i: int = 0
            while i < CG_POOL_N
                var pr: int = cgPoolAt(i)
                if pr != 1 && pr != rightReg && (cgRegsUsed & (1 << pr)) == 0
                    spare = pr
                    i = CG_POOL_N
                else
                    i = i + 1
                end
            end
            if spare < 0
                cgErrSet("register allocation failed: no free register to hold a shift operand")
                return 0
            end
            emitMovReg(spare, 1)
            freeReg(1)
            cgRegsUsed = cgRegsUsed | (1 << spare)
            temp2 = spare
        end
        if saveRcx6 == 1
            emit8(0x51)
        end
        if rightReg != 1
            emit8(0x50 + rightReg)
            emit8(0x59)
        end
        # Shift IN PLACE in tempReg: any register may be the destination, so
        # the value is not forced through RAX.
        if cgStrIs(op, "<<") == 1
            if cgWordSize == 32
                emit8(0xD3)
            else
                emit8(0x48)
                emit8(0xD3)
            end
            emit8(0xE0 | (temp2 & 7))
        else
            if cgWordSize == 32
                emit8(0xD3)
            else
                emit8(0x48)
                emit8(0xD3)
            end
            emit8(0xE8 | (temp2 & 7))
        end
        if saveRcx6 == 1
            emit8(0x59)
        end
        freeReg(rightReg)
        return temp2
    else if isCmpOp(op) == 1
        emit8(0x48)
        emit8(0x39)
        emit8(0xC0 + tempReg + rightReg * 8)
        emitMovRegImm(rightReg, 0)
        var endLabel2: int = newLabel()
        cgEmitJccSkip(op, endLabel2)
        emitMovRegImm(rightReg, 1)
        emitLabel(endLabel2)
        freeReg(tempReg)
        return rightReg
    else
        freeReg(tempReg)
        return rightReg
    end
end

func isCmpOp(op: int) -> int
    if cgStrIs(op, "==") == 1 || cgStrIs(op, "!=") == 1 || cgStrIs(op, "<") == 1 || cgStrIs(op, ">") == 1 || cgStrIs(op, "<=") == 1 || cgStrIs(op, ">=") == 1
        return 1
    end
    return 0
end

# float half of emitBinaryExpr (codegen.cpp:2661)
func cgEmitBinaryFloat(op: int, left: int, right: int) -> int
    # If the right operand contains a call, evaluating it can clobber the
    # register holding the left operand (calls reset cgXmmUsed), so spill the
    # left result to the stack and reload it afterwards.
    var leftXmm: int = 0
    var leftSpilled: int = 0
    if cgExprContainsCall(right) == 1
        leftXmm = cgEmitFloatExpr(left)
        if leftXmm < 0
            leftXmm = 0
        end
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(0x08)
        emitMovssXmmToMem(leftXmm, 4, 0)
        freeXmmReg(leftXmm)
        leftSpilled = 1
    else
        leftXmm = cgEmitFloatExpr(left)
    end
    var rightXmm: int = cgEmitFloatExpr(right)
    if leftSpilled == 1
        var lx: int = allocXmmReg()
        if lx < 0
            lx = 0
        end
        emitMovssXmmFromMem(lx, 4, 0)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x08)
        leftXmm = lx
    end

    var resultXmm: int = rightXmm
    if cgStrIs(op, "+") == 1
        emitAddss(leftXmm, rightXmm)
        resultXmm = leftXmm
        freeXmmReg(rightXmm)
    else if cgStrIs(op, "-") == 1
        var tempXmm: int = allocXmmReg()
        if tempXmm < 0
            tempXmm = leftXmm
            emitSubss(tempXmm, rightXmm)
            freeXmmReg(rightXmm)
        else
            emitMovssXmm(tempXmm, leftXmm)
            emitSubss(tempXmm, rightXmm)
            freeXmmReg(leftXmm)
            freeXmmReg(rightXmm)
        end
        resultXmm = tempXmm
    else if cgStrIs(op, "*") == 1
        emitMulss(leftXmm, rightXmm)
        resultXmm = leftXmm
        freeXmmReg(rightXmm)
    else if cgStrIs(op, "/") == 1
        var tempXmm2: int = allocXmmReg()
        if tempXmm2 < 0
            tempXmm2 = leftXmm
            emitDivss(tempXmm2, rightXmm)
            freeXmmReg(rightXmm)
        else
            emitMovssXmm(tempXmm2, leftXmm)
            emitDivss(tempXmm2, rightXmm)
            freeXmmReg(leftXmm)
            freeXmmReg(rightXmm)
        end
        resultXmm = tempXmm2
    else if isCmpOp(op) == 1
        emitUcomiss(leftXmm, rightXmm)
        freeXmmReg(leftXmm)
        freeXmmReg(rightXmm)
        var r: int = allocReg()
        if r < 0
            r = 0
        end
        # SETcc (0F 9x) on a byte register: rsi/rdi and r8+ need REX, which
        # must precede the instruction. r is always in {0,1,2,3,6,7} here.
        var setOp: int = 0x93
        if cgStrIs(op, "==") == 1
            setOp = 0x94
        else if cgStrIs(op, "!=") == 1
            setOp = 0x95
        else if cgStrIs(op, "<") == 1
            setOp = 0x92
        else if cgStrIs(op, ">") == 1
            setOp = 0x97
        else if cgStrIs(op, "<=") == 1
            setOp = 0x96
        else
            setOp = 0x93
        end
        if r >= 4
            emit8(0x40)
        end
        emit8(0x0F)
        emit8(setOp)
        emit8(0xC0 | (r & 7))
        if r >= 4
            emit8(0x40)
        end
        emit8(0x0F)
        emit8(0xB6)
        emit8(0xC0 | ((r & 7) << 3) | (r & 7))
        return r
    end
    # Float arithmetic (+, -, *, /): the result stays in an XMM register and
    # must be returned as-is — callers expect an XMM index.
    return resultXmm
end

# emitFtoiExpr (codegen.cpp:2759): float -> int on the integer side
func cgEmitFtoiExpr(e: int) -> int
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var fx: int = cgEmitFloatExpr(e)
    if fx < 0
        fx = 0
    end
    var rOut: int = allocReg()
    if rOut < 0
        rOut = 0
    end
    emitCvttss2si(rOut, fx)
    freeXmmReg(fx)
    # The result register must be marked busy for the caller and must not be
    # reloaded from the spill slots (which would clobber it).
    cgRegsUsed = saved & ~(1 << rOut)
    reloadRegs()
    cgRegsUsed = saved | (1 << rOut)
    if rOut < 0
        return 0
    end
    return rOut
end

# ===================== emitExpr (codegen.cpp:2777) =====================
#
# String literals pool their bytes in the container; the fixup tables are
# filled here and patched by the backend (codegen_elf.cpp).
# C++ keeps `std::vector<std::string>` — ZAST strings are not deduplicated by
# azStr, so the pool holds strIds and compares content.

const CG_POOL_STR_MAX: int = 4096
var cgStrPoolN: int = 0
var cgStrPoolId: [4096]int
var cgStrFixN: int = 0
var cgStrFixPos: [4096]int
var cgStrFixIdx: [4096]int
var cgKoStrFixN: int = 0
var cgKoStrFixPos: [4096]int
var cgKoStrFixIdx: [4096]int

# codegen.h:316..331 `KOExtCallFixup { codePos, symbol }` — внешние символы
# ядра, к которым зовёт tryKOCall: `call rel32` (R_X86_64_PC32, addend -4)
# и `mov rax,[rip+disp32]` для данных (jiffies). Символы — NUL-литералы
# из исходника, поэтому храним указатель, а не strId. buildKO()
# (src/codegen_ko.cpp:473..505) их ещё не портирован, но фикстуры обязаны
# записываться с первого же вызова, иначе позиции уедут.
var cgKoExtCallN: int = 0
var cgKoExtCallPos: [1024]int
var cgKoExtCallSym: [1024]int
var cgKoDataFixN: int = 0
var cgKoDataFixPos: [256]int
var cgKoDataFixSym: [256]int

func cgPushKoExtCall(at: int, sym: int)
    if cgKoExtCallN < 1024
        cgKoExtCallPos[cgKoExtCallN] = at
        cgKoExtCallSym[cgKoExtCallN] = sym
        cgKoExtCallN = cgKoExtCallN + 1
    end
end

func cgPushKoDataFix(at: int, sym: int)
    if cgKoDataFixN < 256
        cgKoDataFixPos[cgKoDataFixN] = at
        cgKoDataFixSym[cgKoDataFixN] = sym
        cgKoDataFixN = cgKoDataFixN + 1
    end
end

# driver-owned output flags (Program::objOutput / koDriver live in the driver).
# `--obj` forces BOTH of them in C++ (main.cpp:1407 sets koDriver=true whenever
# objOutput=true), while the ZAST header only carries the `app ... driver`
# syntax bit. The selfhost driver therefore has to publish koDriver itself,
# otherwise the .z side would take the `!koDriver` arm where the C++ reference
# takes the KO one (alloc/arena/slotCreate, string pool, ...).
var cgObjOutput: int = 0
var cgKoDriverFlag: int = 0

func cgKoDriver() -> int
    if cgKoDriverFlag != 0
        return 1
    end
    if (cgH(H_FLAGS) & CGF_KODRIVER) != 0
        return 1
    end
    return 0
end

func cgStringPoolIdx(strId: int) -> int
    var i: int = 0
    while i < cgStrPoolN
        if cgStrIdsEq(cgStrPoolId[i], strId) == 1
            return i
        end
        i = i + 1
    end
    if cgStrPoolN < CG_POOL_STR_MAX
        cgStrPoolId[cgStrPoolN] = strId
        cgStrPoolN = cgStrPoolN + 1
        return cgStrPoolN - 1
    end
    return cgStrPoolN - 1
end

# Backends also pool strings they manufacture themselves (pause's prompt,
# Create:File's path) — those are raw `.z` literals, not ZAST strIds. The pool
# stays one array: cgStrPoolId[i] < 0 marks a raw entry whose pointer lives in
# cgStrPoolRaw[i], which keeps the C++ `stringPool` ordering (dedup by content
# across both kinds) intact for emitFunction/ELF later.  Indexed by the pool
# position (cgStrPoolN, up to CG_POOL_STR_MAX), not by a raw-only count — so
# it must be the same size as cgStrPoolId or a raw entry pushed after the pool
# has grown past 256 writes past the end.
var cgStrPoolRaw: [4096]int

func cgStringPoolRawIdx(lit: int) -> int
    var i: int = 0
    while i < cgStrPoolN
        if cgStrPoolId[i] < 0
            if cgLitEq(cgStrPoolRaw[i], lit) == 1
                return i
            end
        else
            if cgStrIs(cgStrPoolId[i], lit) == 1
                return i
            end
        end
        i = i + 1
    end
    if cgStrPoolN < CG_POOL_STR_MAX
        cgStrPoolId[cgStrPoolN] = -1
        cgStrPoolRaw[cgStrPoolN] = lit
        cgStrPoolN = cgStrPoolN + 1
        return cgStrPoolN - 1
    end
    return cgStrPoolN - 1
end

# record a rip-relative LEA slot pointing at string-pool entry `idx`
# (C++ `strFixups.push_back({code.size(), idx})`).
func cgPushStrFix(at: int, idx: int)
    if cgStrFixN < CG_POOL_STR_MAX
        cgStrFixPos[cgStrFixN] = at
        cgStrFixIdx[cgStrFixN] = idx
        cgStrFixN = cgStrFixN + 1
    end
end

# codegen.h:762 `struct JsFixup { size_t codePos; Slot slot; }` — rip-relative
# lea в js_result()/js_error() буферы в .data. Патчит buildELF
# (codegen_elf.cpp:906) на jsResultRVA/jsErrorRVA. Сами билтины
# (`tryJsCall`, codegen_js.cpp) в слой 1 ещё не портированы, поэтому список
# пока пуст — но пустой он и в эталоне для программ без js_*.
const CG_JS_SLOT_RESULT: int = 0
const CG_JS_SLOT_ERROR: int = 1
var cgJsFixN: int = 0
var cgJsFixPos: [4096]int
var cgJsFixSlot: [4096]int

func cgPushJsFix(at: int, slot: int)
    if cgJsFixN < 4096
        cgJsFixPos[cgJsFixN] = at
        cgJsFixSlot[cgJsFixN] = slot
        cgJsFixN = cgJsFixN + 1
    end
end

# ============== collectStrings (codegen_pe.cpp:169..340) ==============
#
# Обходит тела всех не-extern функций и инициализаторы глобалов и кладёт
# каждый строковый литерал в stringPool (дедуп по содержимому —
# cgStringPoolIdx). Нужен ДО computeSectionRVAs/buildImportData: LEA-фикстуры
# индексируют пул по stringOffsets, а сама эмиссия функций добавляет в пул
# свои строки уже ПОСЛЕ построения stringOffsets — отсюда и предварительное
# наполнение. Порядок обхода = порядок C++ (он задаёт номера в пуле).

func cgCollectExprStrings(e: int)
    if e == 0
        return
    end
    var t: int = cgTag(e)
    if t == N_STRING
        cgStringPoolIdx(cgF(e, 0))
    else if t == N_BINARY
        cgCollectExprStrings(cgF(e, 0))
        cgCollectExprStrings(cgF(e, 1))
    else if t == N_CALL
        var na: int = cgCallArgc(e)
        var ai: int = 0
        while ai < na
            cgCollectExprStrings(cgCallArg(e, ai))
            ai = ai + 1
        end
    else if t == N_MEMBER
        cgCollectExprStrings(cgF(e, 0))
    else if t == N_ARRAYACC
        cgCollectExprStrings(cgF(e, 0))
        cgCollectExprStrings(cgF(e, 1))
    end
end

# side list of statement node ids == a block (there is no Block node in ZAST)
func cgCollectBlockStrings(start: int, len: int)
    if start == 0 || len <= 0
        return
    end
    var i: int = 0
    while i < len
        cgCollectStmtStrings(cgSide(start + i))
        i = i + 1
    end
end

func cgCollectStmtStrings(sid: int)
    if sid == 0
        return
    end
    var t: int = cgTag(sid)
    if t == N_RETURN
        cgCollectExprStrings(cgF(sid, 0))
    else if t == N_EXPRSTMT
        cgCollectExprStrings(cgF(sid, 0))
    else if t == N_ASSIGN
        # C++ AssignStmt: только `value`. `indexExpr` (i в `a[i] = v`) ходит
        # отдельно — по нему бродит detectNetwork*, а не collectStrings.
        cgCollectExprStrings(cgF(sid, 4))
    else if t == N_VARDECL
        cgCollectExprStrings(cgF(sid, 7))
    else if t == N_IF
        cgCollectExprStrings(cgF(sid, 0))
        cgCollectBlockStrings(cgF(sid, 1), cgF(sid, 2))
        cgCollectBlockStrings(cgF(sid, 3), cgF(sid, 4))
    else if t == N_WHILE
        cgCollectExprStrings(cgF(sid, 0))
        cgCollectBlockStrings(cgF(sid, 1), cgF(sid, 2))
    else if t == N_LOOP
        cgCollectBlockStrings(cgF(sid, 0), cgF(sid, 1))
    else if t == N_SWITCH
        cgCollectExprStrings(cgF(sid, 0))
        var cs: int = cgF(sid, 1)
        var cl: int = cgF(sid, 2)
        var j: int = 0
        while j < cl
            # запись кейса = [condition, bodyStart, bodyLen] (parser.z:1695)
            cgCollectExprStrings(cgSide(cs + j))
            cgCollectBlockStrings(cgSide(cs + j + 1), cgSide(cs + j + 2))
            j = j + 3
        end
    else if t == N_FOR
        cgCollectExprStrings(cgF(sid, 1))
        cgCollectExprStrings(cgF(sid, 2))
        cgCollectExprStrings(cgF(sid, 3))
        cgCollectBlockStrings(cgF(sid, 4), cgF(sid, 5))
    end
    # N_PTRASSIGN и N_ASM в C++ collectStmtStrings НЕТ (там это отдельные
    # PtrAssignStmt/AsmStmt, а веток для них в цепочке dynamic_cast не
    # объявлено) — литерал в `*p = "s"` в эталоне в пул НЕ попадает.
    # Воспроизводим ровно так же, иначе поехали бы номера строк дальше.
end

func cgCollectStrings()
    var fs: int = cgH(H_FUNCS)
    var fl: int = cgH(H_FUNCS + 1)
    var i: int = 0
    while i < fl
        var fid: int = cgSide(fs + i)
        if fid != 0
            if cgTag(fid) == N_FUNC
                if cgF(fid, 11) == 0
                    cgCollectBlockStrings(cgF(fid, 9), cgF(fid, 10))
                end
            end
        end
        i = i + 1
    end

    var gs: int = cgH(H_GLOBALS)
    var gl: int = cgH(H_GLOBALS + 1)
    var g: int = 0
    while g < gl
        var gid: int = cgSide(gs + g)
        if gid != 0
            cgCollectExprStrings(cgF(gid, 7))
        end
        g = g + 1
    end

    # DX11: codegen_pe.cpp:300 предварительно кладёт в пул 16 байт IID,
    # четыре строки шейдерных билтинов ("main"/"vs_5_0"/"ps_5_0"/"POSITION")
    # и пути диагностики dxDiagPath(kDxDiagFiles[i]) — их эмиттеры добавляют
    # в пул во время кодогена, то есть ПОСЛЕ того, как stringOffsets уже
    # построены. Всё это состояние живёт в codegen_dx11_shaders.cpp и в
    # слой 1 (Linux/x86) не входит: ошибка должна быть громкой, а не тихо
    # сдвигающей LEA-цели.
    if cgH(H_RENDERTYPE) == CG_RT_DX11
        cgErrSet("collectStrings: DX11 string pre-add не портирован (слой 2)")
    end
end

# C++ emitExpr's IdentExpr arm (codegen.cpp:2810..2836), factored out by
# *name*: the indirect-call path below needs `emitExpr(<temporary IdentExpr
# with name = fpVar>)` and `.z` has no AST allocator, so the ident load is a
# name-parameterised function instead. `cgEmitExpr`'s N_IDENT arm and the
# func-pointer callee path are therefore the same code.
func cgEmitIdentName(name: int) -> int
    var vi: int = cgVarFind(name)
    if vi >= 0
        var r1: int = allocReg()
        var vt: int = cgViType[vi]
        var narrowVar: int = 0
        if (cgTk(vt) == TK_FLOAT || cgTk(vt) == TK_BOOL) && cgTIsPtr(vt) == 0
            narrowVar = 1
        end
        if cgViGlobal[vi] != 0
            if narrowVar == 1
                emitGlobalLoadReg32(r1, cgViOff[vi])
            else
                emitGlobalLoadReg(r1, cgViOff[vi])
            end
            return r1
        end
        if narrowVar == 1
            emitLoadRegFromBP(r1, cgViOff[vi])
        else
            emitLoadRegFromBP64(r1, cgViOff[vi])
        end
        return r1
    end
    # A known function used as a value: emit a function reference
    if cgIsUserFunc(name) == 1
        emit8(0x48)
        emit8(0x8D)
        emit8(0x05)
        var fixupPos: int = cgCodeLen
        emit32(0)
        cgPushFuncRef(fixupPos, name)
        return 0
    end
    # A misspelled name must fail the build, not silently compute 0.
    cgErrSet("undefined variable")
    var r2: int = allocReg()
    if r2 < 0
        r2 = 0
    end
    emitMovRegImm(r2, 0)
    return r2
end

# ===================== generic user-function call path =====================
#
# Ports codegen.cpp:5616..6201 (the tail of emitExpr's CallExpr branch: the
# slot/frame arithmetic, the three lambdas spillPlacedArgs/restorePlacedArgs/
# placeQwordIntoSlot, argument staging, the indirect func-pointer call and the
# direct/extern rel32 call). Three sections that live *above* it in C++ are
# still C++ and are noted where they belong:
#
#   * the inline builtin block (codegen.cpp:3022..5505: alloc/free/arena/pool/
#     slot/peek/poke/http/net/...) — lands here as it gets ported;
#   * the backend dispatch (codegen.cpp:5506..5614: tryKOCall, tryLinuxCall,
#     ...) — a `try*` function evaluates its arguments through emitExpr and
#     emitExpr calls the dispatcher, so the two are mutually recursive.
#     `.z` forbids `use` cycles ("include cycle"), so when those land they
#     either move into this module or invert the edge through a
#     `ptr<func(...)>` hook. Decided when the first `try*` is ported;
#   * virtual dispatch (codegen.cpp:5890..6003) — ZAST carries no
#     isVirtual/vtable (selfhost/ast.z azBuild has no slot for them), so a
#     virtual call would silently take the direct-call arm below. Flagged
#     here so the gap is visible instead of quiet.
#
# Until the two dispatch blocks land, a name that is neither a non-extern
# Zenith function nor an `extern func` is reported instead of falling through
# to the generic ABI path — C++ would only get there because a try* matched
# it, so a fall-through would emit a call to an unresolved symbol.

var cgSaIs: int = 0
var cgSaGlobal: int = 0
var cgSaOff: int = 0
var cgSaSlots: int = 1

# codegen.cpp:5622 structArgInfo (a lambda capturing isStruct/isGlobal/
# offset/slots; the outputs live in the cgSa* module vars here).
func cgStructArgInfo(e: int) -> int
    cgSaIs = 0
    cgSaGlobal = 0
    cgSaOff = 0
    cgSaSlots = 1
    if cgTag(e) == N_IDENT
        var vi: int = cgVarFind(cgF(e, 0))
        if vi >= 0
            var tp: int = cgViType[vi]
            if cgTk(tp) == TK_STRUCT
                var it: int = cgSlFind(cgTStruct(tp))
                if it >= 0
                    cgSaIs = 1
                    cgSaGlobal = cgViGlobal[vi]
                    cgSaOff = cgViOff[vi]
                    if cgTIsPtr(tp) != 0
                        cgSaSlots = 1
                    else
                        cgSaSlots = (cgSlSize[it] + 7) / 8
                        if cgSaSlots < 1
                            cgSaSlots = 1
                        end
                    end
                end
            end
        end
    end
    return cgSaIs
end

# Bytes currently pushed onto rsp by cgSpillPlacedArgs (pending restore), and
# the staged-argument register masks. The C++ lambdas capture these by
# reference; `.z` has no closures, so the three values are module state that
# only the two spill helpers and cgPlaceQword touch (nested risky arguments
# pair the calls, which is what keeps the depth right).
var cgSpillBytes: int = 0
var cgPlacedGP: int = 0
var cgPlacedXmm: int = 0

func cgSpillPlacedArgs(gp: int, xmm: int)
    var nRegs: int = 4
    if cgSysvAbi != 0
        nRegs = 6
    end
    var nPushed: int = 0
    var s: int = 0
    while s < nRegs
        if (gp & (1 << s)) != 0
            if cgSysvAbi != 0
                if s == 0
                    emit8(0x57)
                else if s == 1
                    emit8(0x56)
                else if s == 2
                    emit8(0x52)
                else if s == 3
                    emit8(0x51)
                else if s == 4
                    emit8(0x41)
                    emit8(0x50)
                else
                    emit8(0x41)
                    emit8(0x51)
                end
            else
                if s == 0
                    emit8(0x51)
                else if s == 1
                    emit8(0x52)
                else if s == 2
                    emit8(0x41)
                    emit8(0x50)
                else
                    emit8(0x41)
                    emit8(0x51)
                end
            end
            nPushed = nPushed + 1
        end
        s = s + 1
    end
    s = 0
    while s < 4
        if (xmm & (1 << s)) != 0
            emit8(0x48)
            emit8(0x83)
            emit8(0xEC)
            emit8(0x08)
            emit8(0xF3)
            emit8(0x0F)
            emit8(0x11)
            emit8(0x04 | (s << 3))
            emit8(0x24)
            nPushed = nPushed + 1
        end
        s = s + 1
    end
    if (nPushed & 1) != 0
        emit8(0x48)
        emit8(0x83)
        emit8(0xEC)
        emit8(0x08)
        nPushed = nPushed + 1
    end
    cgSpillBytes = cgSpillBytes + nPushed * 8
end

func cgRestorePlacedArgs(gp: int, xmm: int)
    var nRegs: int = 4
    if cgSysvAbi != 0
        nRegs = 6
    end
    var nPushed: int = 0
    var s: int = 0
    while s < nRegs
        if (gp & (1 << s)) != 0
            nPushed = nPushed + 1
        end
        s = s + 1
    end
    s = 0
    while s < 4
        if (xmm & (1 << s)) != 0
            nPushed = nPushed + 1
        end
        s = s + 1
    end
    if (nPushed & 1) != 0
        emit8(0x48)
        emit8(0x83)
        emit8(0xC4)
        emit8(0x08)
        nPushed = nPushed + 1
    end
    cgSpillBytes = cgSpillBytes - nPushed * 8
    s = 3
    while s >= 0
        if (xmm & (1 << s)) != 0
            emit8(0xF3)
            emit8(0x0F)
            emit8(0x10)
            emit8(0x04 | (s << 3))
            emit8(0x24)
            emit8(0x48)
            emit8(0x83)
            emit8(0xC4)
            emit8(0x08)
        end
        s = s - 1
    end
    s = nRegs - 1
    while s >= 0
        if (gp & (1 << s)) != 0
            if cgSysvAbi != 0
                if s == 0
                    emit8(0x5F)
                else if s == 1
                    emit8(0x5E)
                else if s == 2
                    emit8(0x5A)
                else if s == 3
                    emit8(0x59)
                else if s == 4
                    emit8(0x41)
                    emit8(0x58)
                else
                    emit8(0x41)
                    emit8(0x59)
                end
            else
                if s == 0
                    emit8(0x59)
                else if s == 1
                    emit8(0x5A)
                else if s == 2
                    emit8(0x41)
                    emit8(0x58)
                else
                    emit8(0x41)
                    emit8(0x59)
                end
            end
        end
        s = s - 1
    end
    # gp is a *slot* bitmask (bit s = register-argument slot s).
    s = 0
    while s < nRegs
        if (gp & (1 << s)) != 0
            if cgSysvAbi != 0
                # slots 0..5 -> rdi(7), rsi(6), rdx(2), rcx(1), r8, r9
                if s == 0
                    cgRegsUsed = cgRegsUsed | (1 << 7)
                else if s == 1
                    cgRegsUsed = cgRegsUsed | (1 << 6)
                else if s == 2
                    cgRegsUsed = cgRegsUsed | (1 << 2)
                else if s == 3
                    cgRegsUsed = cgRegsUsed | (1 << 1)
                end
            else
                if s == 0
                    cgRegsUsed = cgRegsUsed | (1 << 1)
                else if s == 1
                    cgRegsUsed = cgRegsUsed | (1 << 2)
                end
            end
        end
        s = s + 1
    end
    if xmm != 0
        cgXmmUsed = cgXmmUsed | xmm
    end
end

# codegen.cpp:5775 placeQwordIntoSlot — put the 64-bit value that already sits
# in `valueReg` into argument slot `slot`.
func cgPlaceQword(slot: int, valueReg: int)
    if cgSysvAbi != 0
        # SysV ABI: integer/pointer args -> rdi,rsi,rdx,rcx,r8,r9 (slots 0..5),
        # then stack (slots 6+). kAllocPool indexes: 0=rax,1=rcx,2=rdx,3=rbx,
        # 6=rsi,7=rdi. r8/r9 are outside the alloc pool.
        if slot == 0
            if valueReg != 7
                emitMovReg(7, valueReg)
                freeReg(valueReg)
            end
            cgRegsUsed = cgRegsUsed | (1 << 7)
            cgPlacedGP = cgPlacedGP | (1 << 0)
        else if slot == 1
            if valueReg != 6
                emitMovReg(6, valueReg)
                freeReg(valueReg)
            end
            cgRegsUsed = cgRegsUsed | (1 << 6)
            cgPlacedGP = cgPlacedGP | (1 << 1)
        else if slot == 2
            if valueReg != 2
                emitMovReg(2, valueReg)
                freeReg(valueReg)
            end
            cgRegsUsed = cgRegsUsed | (1 << 2)
            cgPlacedGP = cgPlacedGP | (1 << 2)
        else if slot == 3
            if valueReg != 1
                emitMovReg(1, valueReg)
                freeReg(valueReg)
            end
            cgRegsUsed = cgRegsUsed | (1 << 1)
            cgPlacedGP = cgPlacedGP | (1 << 3)
        else if slot == 4
            # -> r8
            if valueReg == 0
                emit8(0x49)
                emit8(0x89)
                emit8(0xC0)
            else if valueReg == 1
                emit8(0x49)
                emit8(0x89)
                emit8(0xC8)
            else if valueReg == 2
                emit8(0x49)
                emit8(0x89)
                emit8(0xD0)
            else if valueReg == 3
                emit8(0x49)
                emit8(0x89)
                emit8(0xD8)
            else if valueReg == 6
                emit8(0x49)
                emit8(0x89)
                emit8(0xF0)
            else if valueReg == 7
                emit8(0x49)
                emit8(0x89)
                emit8(0xF8)
            else
                emitMovReg(0, valueReg)
                emit8(0x49)
                emit8(0x89)
                emit8(0xC0)
            end
            freeReg(valueReg)
            cgPlacedGP = cgPlacedGP | (1 << 4)
        else if slot == 5
            # -> r9
            if valueReg == 0
                emit8(0x49)
                emit8(0x89)
                emit8(0xC1)
            else if valueReg == 1
                emit8(0x49)
                emit8(0x89)
                emit8(0xC9)
            else if valueReg == 2
                emit8(0x49)
                emit8(0x89)
                emit8(0xD1)
            else if valueReg == 3
                emit8(0x49)
                emit8(0x89)
                emit8(0xD9)
            else if valueReg == 6
                emit8(0x49)
                emit8(0x89)
                emit8(0xF1)
            else if valueReg == 7
                emit8(0x49)
                emit8(0x89)
                emit8(0xF9)
            else
                emitMovReg(0, valueReg)
                emit8(0x49)
                emit8(0x89)
                emit8(0xC1)
            end
            freeReg(valueReg)
            cgPlacedGP = cgPlacedGP | (1 << 5)
        else
            # SysV: stack args start at [rsp] right after the return address.
            # The call-site frame reserves spillBytes; we stage push-down args
            # starting at offset 0 (SysV has no 32-byte shadow).
            var stackOff: int = (slot - 6) * 8 + cgSpillBytes
            if valueReg != 0
                emitMovReg(0, valueReg)
                freeReg(valueReg)
            end
            if stackOff < 128
                emit8(0x48)
                emit8(0x89)
                emit8(0x44)
                emit8(0x24)
                emit8(stackOff)
            else
                emit8(0x48)
                emit8(0x89)
                emit8(0x84)
                emit8(0x24)
                emit32(stackOff)
            end
        end
        return
    end
    if slot == 0
        if valueReg != 1
            emitMovReg(1, valueReg)
            freeReg(valueReg)
        end
        cgRegsUsed = cgRegsUsed | (1 << 1)
        cgPlacedGP = cgPlacedGP | (1 << 0)
    else if slot == 1
        if valueReg != 2
            emitMovReg(2, valueReg)
            freeReg(valueReg)
        end
        cgRegsUsed = cgRegsUsed | (1 << 2)
        cgPlacedGP = cgPlacedGP | (1 << 1)
    else if slot == 2
        if valueReg == 0
            emit8(0x49)
            emit8(0x89)
            emit8(0xC0)
        else if valueReg == 1
            emit8(0x49)
            emit8(0x89)
            emit8(0xC8)
        else if valueReg == 2
            emit8(0x49)
            emit8(0x89)
            emit8(0xD0)
        else if valueReg == 3
            emit8(0x49)
            emit8(0x89)
            emit8(0xD8)
        else
            emitMovReg(0, valueReg)
            emit8(0x49)
            emit8(0x89)
            emit8(0xC0)
        end
        freeReg(valueReg)
        cgPlacedGP = cgPlacedGP | (1 << 2)
    else if slot == 3
        if valueReg == 0
            emit8(0x49)
            emit8(0x89)
            emit8(0xC1)
        else if valueReg == 1
            emit8(0x49)
            emit8(0x89)
            emit8(0xC9)
        else if valueReg == 2
            emit8(0x49)
            emit8(0x89)
            emit8(0xD1)
        else if valueReg == 3
            emit8(0x49)
            emit8(0x89)
            emit8(0xD9)
        else
            emitMovReg(0, valueReg)
            emit8(0x49)
            emit8(0x89)
            emit8(0xC1)
        end
        freeReg(valueReg)
        cgPlacedGP = cgPlacedGP | (1 << 3)
    else
        var stackOff: int = 0x20 + (slot - 4) * 8 + cgSpillBytes
        if valueReg != 0
            emitMovReg(0, valueReg)
            freeReg(valueReg)
        end
        if stackOff < 128
            emit8(0x48)
            emit8(0x89)
            emit8(0x44)
            emit8(0x24)
            emit8(stackOff)
        else
            emit8(0x48)
            emit8(0x89)
            emit8(0x84)
            emit8(0x24)
            emit32(stackOff)
        end
    end
end

# ---- peek/poke family (codegen.cpp:4506..4648) ----
# These nine arms emit no relocation and touch no driver state (no objOutput/
# koDriver gate), so they are byte-identical in every mode — lifted verbatim,
# including the push/pop dance of poke: C++ evaluates val, pushes it, then
# evaluates addr on top of that push.
func cgEmitPeek(c: int, width: int) -> int
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var addrReg: int = cgEmitExpr(cgCallArg(c, 0))
    if addrReg != 0
        emitMovReg(0, addrReg)
        freeReg(addrReg)
    else
        freeReg(0)
    end
    if width == 64
        emit8(0x48)
        emit8(0x8B)
        emit8(0x00)          # mov rax, [rax]
    else
        if width == 8
            emit8(0x0F)
            emit8(0xB6)
            emit8(0x00)      # movzx eax, byte ptr [rax]
        else
            if width == 16
                emit8(0x0F)
                emit8(0xB7)
                emit8(0x00)  # movzx eax, word ptr [rax]
            else
                emit8(0x8B)
                emit8(0x00)  # mov eax, [rax]
            end
        end
    end
    cgRegsUsed = saved & ~1
    reloadRegs()
    cgRegsUsed = saved | 1
    return 0
end

func cgEmitPoke(c: int, width: int) -> int
    var saved: int = cgRegsUsed
    spillRegs()
    cgRegsUsed = 0
    var valReg: int = cgEmitExpr(cgCallArg(c, 1))
    if valReg != 0
        emitMovReg(0, valReg)
        freeReg(valReg)
    else
        freeReg(0)
    end
    emit8(0x50)              # push rax (val)
    var addrReg: int = cgEmitExpr(cgCallArg(c, 0))
    if addrReg != 0
        emitMovReg(0, addrReg)
        freeReg(addrReg)
    else
        freeReg(0)
    end
    if width == 64
        emit8(0x50)              # push rax (addr)
        emit8(0x41)
        emit8(0x58)          # pop r8 (addr)
        emit8(0x41)
        emit8(0x59)          # pop r9 (val)
        emit8(0x4D)
        emit8(0x89)
        emit8(0x08)          # mov [r8], r9
    else
        emit8(0x5A)          # pop rdx (val)
        if width == 8
            emit8(0x88)
            emit8(0x10)      # mov [rax], dl
        else
            if width == 16
                emit8(0x66)
                emit8(0x89)
                emit8(0x10)  # mov [rax], dx
            else
