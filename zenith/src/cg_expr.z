        emit8(0x48)
        emit8(0x85)
        emit8(0xC0 | ((r1 & 7) << 3) | (r1 & 7))
        freeReg(r1)
        var trueLabel: int = newLabel()
        emit8(0x0F)
        emit8(0x85)
        cgFixPush(cgCodeLen, trueLabel)
