        cgRegsUsed = cgRegsUsed | 1
        return 0
    end

    # ---- short-circuit && ----
    if cgStrIs(op, "&&") == 1
        var l1: int = cgEmitExpr(left)
        emit8(0x48)
        emit8(0x85)
        emit8(0xC0 | ((l1 & 7) << 3) | (l1 & 7))
