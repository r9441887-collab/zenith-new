        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
        emit8(15)
        emit8(0x48)
        emit8(0x83)
        emit8(0xE1)
        emit8(0xF0)
        emit8(0x48)
        emit8(0x83)
        emit8(0xC1)
