# Zenith compiler — Linux build
# Compiles all src/*.cpp into a native Linux `zenith` executable.
#
# Run from the directory holding this file:  make -f Makefile.linux -j$(nproc)

CXX      ?= g++
CXXFLAGS ?= -O2 -std=c++17 -w -MMD -MP
SRC_DIR   := src
SRCS      := $(wildcard $(SRC_DIR)/*.cpp)
OBJS      := $(SRCS:$(SRC_DIR)/%.cpp=build/linux/%.o)
DEPS      := $(OBJS:.o=.d)
BIN       := build/linux/zenith

.PHONY: all clean test test-a64 test-pow2 test-peephole test-bugfind test-irbugfind test-js

# The compiler's front-end tokenizer: selfhost/lexer.z compiled into a
# standalone spawn (src/lexbridge.cpp). tools/lextool is committed so a fresh
# clone can build; this rule regenerates it whenever the selfhost lexer moves.
LEXTOOL := tools/lextool

all: $(BIN) $(LEXTOOL)

$(LEXTOOL): selfhost/lextool.z selfhost/lexer.z tools/lextool_main.cpp $(BIN)
	@mkdir -p $(dir $@)
	$(BIN) selfhost/lextool.z --cxx tools/lextool_main.cpp -o $(LEXTOOL)
	@test -f $(LEXTOOL).elf && mv -f $(LEXTOOL).elf $(LEXTOOL) && chmod +x $(LEXTOOL)

# JS engine blob: tools/jsrt.c + tools/js_host_linux.c -> src/js_blob.h.
# The header is checked in, but regenerated here so the blob embedded in the
# compiler can never drift from the engine sources; gen_js_blob.sh fails the
# build if the image carries absolute relocations (a blob copied into .text at
# an unknown address cannot hold pointers into its link address).
JS_BLOB := src/js_blob.h
JS_SRCS := tools/jsrt.c tools/js_host_linux.c tools/jsrt.ld tools/gen_js_blob.sh

$(JS_BLOB): $(JS_SRCS)
	bash tools/gen_js_blob.sh

# Assembler blob: tools/asmrt.asm (+ its .inc files) -> src/asm_blob.h.
# Same reason as the JS blob: the header is checked in but rebuilt here so the
# assembler the compiler embeds can never drift from its source. gen_asm_blob.sh
# rejects any absolute relocation (the blob is copied into .text at an address
# nobody knows when it is linked) and pads the image out to __bss_end so the
# assembler's arena travels with the code. Needs nasm.
ASM_BLOB := src/asm_blob.h
ASM_SRCS := tools/asmrt.asm tools/asmrt_core.inc tools/asmrt_enc.inc \
            tools/asmrt_mem.inc tools/asmrt_num.inc tools/asmrt_oper.inc \
            tools/asmrt_ops.inc tools/asmrt_parse.inc \
            tools/asmrt.ld tools/gen_asm_blob.sh

$(ASM_BLOB): $(ASM_SRCS)
	bash tools/gen_asm_blob.sh

$(BIN): $(OBJS) $(JS_BLOB) $(ASM_BLOB)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)

build/linux/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

-include $(DEPS)

clean:
	rm -rf build/linux

# AArch64 encoder audit: compares every enc* in src/asm_a64.h against
# tools/a64_enc_golden.txt, whose encodings were produced by clang's
# assembler. Catches a bit layout that drifted from the architecture.
A64_TEST  := build/linux/a64_enc_test
A64_ACTUAL := build/linux/a64_enc.actual
A64_GOLD  := tools/a64_enc_golden.txt

test-a64: $(A64_TEST)
	@$(A64_TEST) > $(A64_ACTUAL)
	@if diff -u $(A64_GOLD) $(A64_ACTUAL) > /dev/null; then \
	    echo "a64 encoders: $$($(A64_TEST) | wc -l) instructions match the golden file"; \
	else \
	    echo "a64 encoder mismatch:"; diff -u $(A64_GOLD) $(A64_ACTUAL); exit 1; \
	fi

$(A64_TEST): tools/a64_enc_test.cpp src/asm_a64.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ tools/a64_enc_test.cpp

# AArch64 machine-word peephole: drives src/a64peephole.cpp over hand-built
# AsmBuf windows and checks both the rewritten words and the fixup remapping.
# A pass that changes code but leaves a stale label offset behind is worse
# than no pass, so the remapping has its own cases.
PEEP_TEST := build/linux/a64_peephole_test

test-peephole: $(PEEP_TEST)
	@$(PEEP_TEST)

$(PEEP_TEST): tools/a64_peephole_test.cpp src/a64peephole.cpp src/a64peephole.h src/asm_a64.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ tools/a64_peephole_test.cpp src/a64peephole.cpp

# Power-of-two rewrite: the speed level (-3r) turns 'x / 2^n' into shifts and
# 'x * k' into shift+add. A wrong answer there is still a plausible number, so
# the only way to catch it is to run the rewritten program and compare it with
# the same program built at -0r. Both AArch64 paths must agree; the classic x86
# path is excluded on purpose (its 6-register allocator refuses the tree).
# Needs qemu-aarch64-static; skipped with a notice when it is missing.
POW2_SRC   := tools/opt_pow2.z
POW2_DIR   := build/linux/pow2
POW2_QEMU  := $(shell command -v qemu-aarch64-static 2>/dev/null)

.PHONY: test-pow2

test-pow2: $(BIN) $(LEXTOOL)
	@if [ -z "$(POW2_QEMU)" ]; then \
	    echo "test-pow2: qemu-aarch64-static not found, skipped"; exit 0; \
	fi
	@mkdir -p $(POW2_DIR)
	@for f in p0 p3 p3i; do \
	    case $$f in \
	      p0)  args="-0r" ;; \
	      p3)  args="-3r" ;; \
	      p3i) args="-3r --ir" ;; \
	    esac; \
	    if ! $(BIN) $(POW2_SRC) $$args -o $(POW2_DIR)/$$f.elf \
	         > $(POW2_DIR)/$$f.log 2>&1; then \
	        echo "test-pow2: compile failed for '$$args'"; cat $(POW2_DIR)/$$f.log; exit 1; \
	    fi; \
	    chmod +x $(POW2_DIR)/$$f.elf; \
	done
	@$(POW2_QEMU) $(POW2_DIR)/p0.elf > $(POW2_DIR)/p0.txt
	@for f in p3 p3i; do \
	    $(POW2_QEMU) $(POW2_DIR)/$$f.elf > $(POW2_DIR)/$$f.txt; \
	    if diff -q $(POW2_DIR)/p0.txt $(POW2_DIR)/$$f.txt > /dev/null; then \
	        echo "pow2 $$f: $$(($$(wc -l < $(POW2_DIR)/p0.txt) - 1)) values match -0r"; \
	    else \
	        echo "pow2 $$f: MISMATCH against -0r"; \
	        diff -u $(POW2_DIR)/p0.txt $(POW2_DIR)/$$f.txt | head -20; exit 1; \
	    fi; \
	done

# Static bug finder (AST): parses hand-written sources and checks the
# [ZT-BUGxxx] codes runBugFind emits — one positive case per rule plus
# clean/exempt idioms that must stay silent.
BUGFIND_TEST := build/linux/bugfind_test

test-bugfind: $(BUGFIND_TEST)
	@$(BUGFIND_TEST)

$(BUGFIND_TEST): tools/bugfind_test.cpp src/bugfind.cpp src/bugfind.h src/ast.h src/lexer.h src/parser.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ tools/bugfind_test.cpp src/bugfind.cpp src/lexbridge.cpp src/parser.cpp

# IR bug finder: builds IR functions by hand (no parser involved) and checks
# the [ZT-IRxxx] codes — div/mod by zero, bad shifts, overflow, constant
# branches, float conversions — plus the exempt shapes (while 1, switch
# dispatch, for-header meet, one-sided plain operands, dead code).
IRBUGFIND_TEST := build/linux/irbugfind_test

test-irbugfind: $(IRBUGFIND_TEST)
	@$(IRBUGFIND_TEST)

$(IRBUGFIND_TEST): tools/irbugfind_test.cpp src/irbugfind.cpp src/irbugfind.h src/ir.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ tools/irbugfind_test.cpp src/irbugfind.cpp

# Linux JS host end-to-end: compiles tools/js_linux_test.z for the Linux target
# and runs it. The test drives every host callback the blob provides
# (tools/js_host_linux.c: fs/print/exec/env/args/uname/sleep/stat/mkdir/readdir/
# unlink/cwd) plus js_result()/js_error() and prints "JS LINUX HOST: ALL OK"
# only if all of them behaved.
JS_TEST_ELF := build/linux/js_linux_test.elf

test-js: $(BIN) $(LEXTOOL)
	@$(BIN) tools/js_linux_test.z -o $(JS_TEST_ELF)
	@chmod +x $(JS_TEST_ELF)
	@out=$$($(JS_TEST_ELF)); printf '%s\n' "$$out"; \
	echo "$$out" | grep -q 'JS LINUX HOST: ALL OK' || { echo "test-js: checks failed"; exit 1; }; \
	echo "$$out" | grep -q 'call of non-function' || { echo "test-js: js_error() empty"; exit 1; }

test: $(LEXTOOL) test-a64 test-peephole test-pow2 test-bugfind test-irbugfind test-js
