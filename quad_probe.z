app gui dx tool

# quad_probe.z - FULLSCREEN red quad (2 triangles, NO depth buffer).
# Draws a quad that covers the whole NDC window and probes the CENTER
# pixel. This is the cleanest possible GPU-pipeline test:
#   - NO depth (no CreateDepthStencilView involved)
#   - NO constant buffer
#   - NO texture/sampler
#   - geometry provably covers pixel (400,300)
# If build/probe.bin center (bytes [4..7]) is NOT 00 00 00 ff on your
# machine, the GPU pipeline turns pixels and depth/cube code is suspect.
# If it IS black even here, the base D3D11 pipeline itself doesn't draw.

func main() -> int
    createWindow(800, 600, "QuadProbe")

    # 6 vertices, 2 triangles covering [-1,1]^2 (8 bytes each = pos.xy)
    var p: int = alloc(64)
    # tri A
    poke32(p + 0, 0xBF800000)   # (-1,-1)
    poke32(p + 4, 0xBF800000)
    poke32(p + 8, 0x3F800000)   # ( 1,-1)
    poke32(p + 12, 0xBF800000)
    poke32(p + 16, 0xBF800000)  # (-1, 1)
    poke32(p + 20, 0x3F800000)
    # tri B
    poke32(p + 24, 0x3F800000)  # ( 1,-1)
    poke32(p + 28, 0xBF800000)
    poke32(p + 32, 0xBF800000)  # (-1, 1)
    poke32(p + 36, 0x3F800000)
    poke32(p + 40, 0x3F800000)  # ( 1, 1)
    poke32(p + 44, 0x3F800000)

    var vs: int = dxCreateVertexShader("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var ps: int = dxCreatePixelShader("float4 main() : SV_Target { return float4(1, 0, 0, 1); }")
    var layout: int = dxCreateInputLayout("float4 main(float2 p : POSITION) : SV_Position { return float4(p, 0, 1); }")
    var vbuf: int = dxCreateBuffer(48, p)

    dxSetShaders(vs, ps)
    dxSetInputLayout(layout)
    dxSetVertexBuffer(vbuf, 8)
    dxSetTopology(4)

    var n: int = 0
    loop
        if processMessages() == 0
            break
        end
        dxDraw(6)
        dxProbeGPU()
        present()
        n = n + 1
        sleep(0.016)
        if getKey(0x1B) == 1
            break
        end
        if n == 120
            break
        end
    end

    closeWindow()
    return 0
end