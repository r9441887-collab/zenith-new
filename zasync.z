app console

func main() -> int
    js_reset()

    var r1: int = js_eval("await Promise.resolve(42)")
    if r1 != 42
        print("FAIL r1=")
        print(r1)
        print("\n")
        return 1
    end

    var r2: int = js_eval("async function f(n) { var v = await Promise.resolve(n); return v * 2; } await f(21)")
    if r2 != 42
        print("FAIL r2=")
        print(r2)
        print("\n")
        return 2
    end

    var r3: int = js_eval("var q = 0; async function g() { var v = await new Promise(function(res) { res(10); }); return v + 1; } await g()")
    if r3 != 11
        print("FAIL r3=")
        print(r3)
        print("\n")
        return 3
    end

    js_eval("var s = ''; Promise.resolve(1).then(function() { s += 'm'; }); setTimeout(function() { s += 't'; }, 0); s += 's'; 0")
    var r4: int = js_eval("s.length")
    if r4 != 3
        print("FAIL r4=")
        print(r4)
        print("\n")
        return 4
    end

    js_eval("var n = 0; var iv = setInterval(function() { n++; if (n >= 2) { clearInterval(iv); } }, 0); 0")
    var r5: int = js_eval("n")
    if r5 != 2
        print("FAIL r5=")
        print(r5)
        print("\n")
        return 5
    end

    js_eval("var a = []; Promise.all([Promise.resolve(30), Promise.resolve(12)]).then(function(v) { a.push(v[0] + v[1]); }); 0")
    var r6: int = js_eval("a[0]")
    if r6 != 42
        print("FAIL r6=")
        print(r6)
        print("\n")
        return 6
    end

    js_eval("var h = 0; Promise.reject('x').catch(function(e) { h = 1; }); 0")
    var r7: int = js_eval("h")
    if r7 != 1
        print("FAIL r7=")
        print(r7)
        print("\n")
        return 7
    end

    print("ASYNC Z TESTS OK (1,7)\n")
    return 0
end