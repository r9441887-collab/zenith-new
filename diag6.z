app gui dx tool

func main() -> int
    createWindow(800, 600, "DX11")
    var m: int = alloc(4)
    poke32(m, 0x11223344)
    fileSave("C:\\Users\\user\\Desktop\\b\\zenith\\build\\pre.bin", m, 4)
    dxProbeGPU()
    var m2: int = alloc(4)
    poke32(m2, 0x55667788)
    fileSave("C:\\Users\\user\\Desktop\\b\\zenith\\build\\post.bin", m2, 4)
    var running: int = 1
    while running == 1
        present()
        if getKey(0x1B) == 1
            running = 0
        end
    end
    closeWindow()
    return 0
end
