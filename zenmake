#!/bin/sh
# zenmake — launcher.
#
# Keeps zenmake.z (Zenith source of the build driver) in sync with the binary
# that runs it: if zenmake.z is newer than build/zen/zenmake.elf the launcher
# recompiles it with the bootstrap compiler and then execs the result. No
# `make`, no g++ — the only toolchain involved is build/linux/zenith.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
BOOT="$ROOT/build/linux/zenith"
SRC="$ROOT/zenmake.z"
OUT="$ROOT/build/zen/zenmake.elf"

if [ ! -x "$BOOT" ]; then
    # `zenmake --mix clean` removes build/linux, i.e. the compiler that would
    # rebuild the driver itself. A previously built driver can still drive the
    # whole build (including rebuilding build/linux/zenith), so run it rather
    # than refuse; only a tree that has never been bootstrapped is fatal.
    if [ -x "$OUT" ]; then
        cd "$ROOT" || exit 1
        exec "$OUT" "$@"
    fi
    echo "zenmake: bootstrap compiler '$BOOT' not found." >&2
    echo "zenmake: build it once with 'make -f Makefile.linux'." >&2
    exit 1
fi

if [ ! -x "$OUT" ] || [ "$SRC" -nt "$OUT" ]; then
    mkdir -p "$ROOT/build/zen"
    "$BOOT" "$SRC" --no-bugfind -o "$ROOT/build/zen/zenmake" \
        >"$ROOT/build/zen/zenmake.build.log" 2>&1 || {
        echo "zenmake: failed to build itself:" >&2
        tail -30 "$ROOT/build/zen/zenmake.build.log" >&2
        exit 1
    }
    chmod +x "$OUT"
fi

cd "$ROOT" || exit 1
exec "$OUT" "$@"
